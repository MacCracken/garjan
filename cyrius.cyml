[package]
name = "garjan"
version = "${file:VERSION}"
description = "garjan — environmental & nature sound synthesis (thunder, rain, wind, fire, impacts, surfaces, fluids, ambience). Cyrius port of a 6,186-line Rust library."
license = "GPL-3.0-only"
repository = "https://github.com/MacCracken/garjan"
language = "cyrius"
cyrius = "6.7.9"

[build]
entry = "src/main.cyr"
output = "build/garjan"

# `[lib]` declares the distlib bundle `cyrius distlib` writes into
# `dist/garjan.cyr` — every module concatenated in dependency order (deps
# before dependents). Populated as modules are ported (foundations first,
# then the 17 synths, then builder/bridge). Every module is self-contained
# (no `include` lines); the entry / test harness orders them. naad + its
# transitive deps (hisab/goonj/sakshi) resolve from THIS manifest's [deps].
[lib]
modules = [
    # foundations (Tier 0-2) — deps before dependents
    "src/error.cyr",
    "src/logging.cyr",
    "src/dsp.cyr",
    "src/rng.cyr",
    "src/lod.cyr",
    "src/material.cyr",
    "src/modal.cyr",
    "src/contact.cyr",
    "src/aero.cyr",
    "src/creature.cyr",
    "src/voice.cyr",
    # synthesizers (Tier 3)
    "src/fire.cyr",
    "src/weather.cyr",
    "src/water.cyr",
    "src/precipitation.cyr",
    "src/bubble.cyr",
    "src/impact.cyr",
    "src/footstep.cyr",
    "src/friction.cyr",
    "src/creak.cyr",
    "src/rolling.cyr",
    "src/foliage.cyr",
    "src/whoosh.cyr",
    "src/whistle.cyr",
    "src/cloth.cyr",
    "src/insect.cyr",
    "src/wingflap.cyr",
    "src/underwater.cyr",
    "src/surf.cyr",
    "src/texture.cyr",
    # integration (Tier 4)
    "src/bridge.cyr",
    "src/builder.cyr",
]

# stdlib: alloc/vec/str for heap+buffers; math (clamp/min/max/lerp/F64_*) +
# ganita for f64_pow (garjan's only direct ganita call) AND, more importantly,
# for the 18 symbols hisab needs (ganita_f64_acos/atan2/cosh/hypot/pow/sinh + the
# ganita_mat_* linear-algebra family), goonj's 6 and naad's 3 -- dropping it breaks the deps,
# not garjan's own code. NOTE sin/cos/exp/sqrt/abs are cycc INTRINSICS, not
# ganita: verify with `grep -l '^fn f64_sin(' lib/*.cyr` (no match). bayan
# (JSON parse) + fmt + str drive the `#derive(Serialize)` codec; bench for
# .bcyr harnesses; assert for .tcyr.
[deps]
stdlib = [
    "syscalls",
    "string",
    "alloc",
    "str",
    "fmt",
    "vec",
    "io",
    "args",
    "assert",
    "math",
    "ganita",
    "bayan",
    "bench",
]

# naad — audio synthesis primitives. garjan consumes the noise/filter/
# modulation surface (NoiseGenerator, BiquadFilter, StateVariableFilter,
# Lfo) from the single monolithic dist bundle. The bundle references
# hisab + goonj + sakshi symbols, resolved from THIS manifest below.
[deps.naad]
git = "https://github.com/MacCracken/naad.git"
tag = "2.3.0"
modules = ["dist/naad.cyr"]

# hisab — math/geometry. Referenced by naad's bundle (HVec3/HComplex/FFT/
# ganita least-squares). Pinned to the tag naad itself consumes.
[deps.hisab]
git = "https://github.com/MacCracken/hisab.git"
tag = "3.4.0"
modules = ["dist/hisab.cyr"]

# goonj — acoustics engine. Referenced by naad's acoustics/* modules
# (present in the monolithic bundle). Pulls sakshi + hisab transitively.
[deps.goonj]
git = "https://github.com/MacCracken/goonj.git"
tag = "2.1.0"
modules = ["dist/goonj.cyr"]

# sakshi — structured logging. garjan calls it directly (src/logging.cyr →
# sakshi_warn/info/debug/error/fatal) to wire the `logging` layer the Rust
# crate gated behind `tracing`. Also arrives transitively via hisab/goonj.
[deps.sakshi]
git = "https://github.com/MacCracken/sakshi.git"
tag = "2.5.8"
modules = ["dist/sakshi.cyr"]
