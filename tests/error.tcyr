# error.tcyr -- parity tests for src/error.cyr (the L0 base).
# Stdlib (alloc/math/assert) auto-included via cyrius.cyml.

include "src/error.cyr"

fn main() {
    alloc_init();

    test_group("error_codes");
    assert_eq(GARJAN_OK, 0, "OK is 0");
    assert(garjan_is_err(GARJAN_OK) == 0, "OK is not an error");
    assert(garjan_is_err(GARJAN_ERR_INVALID_PARAMETER) == 1, "InvalidParameter is an error");
    assert(garjan_is_err(GARJAN_ERR_SYNTHESIS_FAILED) == 1, "SynthesisFailed is an error");
    assert(garjan_is_err(GARJAN_ERR_COMPUTATION) == 1, "Computation is an error");

    test_group("is_finite");
    assert(garjan_is_finite(F64_ONE) == 1, "1.0 is finite");
    assert(garjan_is_finite(0) == 1, "0.0 is finite");
    assert(garjan_is_finite(f64_neg(F64_TAU)) == 1, "-tau is finite");
    assert(garjan_is_finite(GARJAN_POS_INF) == 0, "+inf is not finite");
    assert(garjan_is_finite(GARJAN_NEG_INF) == 0, "-inf is not finite");
    assert(garjan_is_finite(0x7FF8000000000000) == 0, "NaN is not finite");

    # --- 2.0.3: allocation failure must be DETECTABLE ---
    # The stdlib `alloc` signals exhaustion by returning 0, and 0 is GARJAN_OK,
    # so `garjan_is_err(alloc(n))` is FALSE on failure. Every constructor here
    # writes through its allocation on the next line, so before 2.0.3 an OOM
    # was a store to address 0. garjan_alloc maps that 0 onto a negative code.
    test_group("garjan_alloc");
    assert_eq(alloc(0 - 1), 0, "raw alloc reports failure as 0");
    assert_eq(garjan_is_err(alloc(0 - 1)), 0, "...which garjan_is_err CANNOT detect");
    assert_eq(garjan_alloc(0 - 1), GARJAN_ERR_ALLOCATION, "garjan_alloc maps it to a negative code");
    assert_eq(garjan_is_err(garjan_alloc(0 - 1)), 1, "...which garjan_is_err DOES detect");
    assert_eq(garjan_is_err(garjan_alloc(ALLOC_MAX + 1)), 1, "oversized request rejected");
    assert(garjan_alloc(64) > 0, "a valid request still returns a real pointer");


    return assert_summary();
}

var exit_code = main();
syscall(60, exit_code);
