# cloth.tcyr -- parity tests for src/cloth.cyr (naad synth + modal + serde).
include "src/error.cyr"
include "src/logging.cyr"
include "src/dsp.cyr"
include "src/rng.cyr"
include "src/lod.cyr"
include "src/material.cyr"
include "src/modal.cyr"
include "src/contact.cyr"
include "src/aero.cyr"
include "src/creature.cyr"
include "src/cloth.cyr"

fn main() {
    alloc_init();

    test_group("cloth_new");
    var c = cloth_new(CLOTH_FLAG, f64_from(44100));
    assert(garjan_is_err(c) == 0, "cloth_new ok");
    assert(garjan_is_err(cloth_new(CLOTH_FLAG, 0)) == 1, "cloth_new rejects sr=0");
    # Flag config: base_flap_rate = 8.0, amplitude = 0.3, no modal bank.
    assert(f64_lt(f64_abs(f64_sub(Cloth_base_flap_rate(c), f64_from(8))), GARJAN_EPSILON) == 1, "flag base_flap_rate 8");
    assert(Cloth_modal_bank(c) == 0, "flag has no modal bank");

    # Sail config: use_modal = 1 -> modal bank present.
    var sail = cloth_new(CLOTH_SAIL, f64_from(44100));
    assert(garjan_is_err(sail) == 0, "cloth_new sail ok");
    assert(Cloth_modal_bank(sail) != 0, "sail has a modal bank");

    test_group("synthesize");
    # Wind at 0 -> silence (below threshold), but correct sample count + finite.
    var silent = cloth_synthesize(c, f64_div(f64_from(1), f64_from(10)));   # 0.1s
    assert(garjan_is_err(silent) == 0, "silent synthesize ok");
    assert_eq(vec_len(silent), 4410, "0.1s @ 44100 = 4410 samples");
    var si = 0;
    var silent_energy = 0;
    while (si < vec_len(silent)) {
        silent_energy = f64_add(silent_energy, f64_abs(vec_get(silent, si)));
        si = si + 1;
    }
    assert(f64_lt(silent_energy, GARJAN_EPSILON) == 1, "no wind -> silence");

    # With wind, we get finite nonzero audio.
    cloth_set_wind_speed(c, F64_ONE);
    var buf = cloth_synthesize(c, f64_div(f64_from(1), f64_from(10)));   # 0.1s
    assert(garjan_is_err(buf) == 0, "windy synthesize ok");
    assert_eq(vec_len(buf), 4410, "windy 0.1s = 4410 samples");
    var i = 0;
    var allfinite = 1;
    var energy = 0;
    while (i < vec_len(buf)) {
        var s = vec_get(buf, i);
        if (garjan_is_finite(s) == 0) { allfinite = 0; }
        energy = f64_add(energy, f64_abs(s));
        i = i + 1;
    }
    assert(allfinite == 1, "all cloth samples finite");
    assert(f64_gt(energy, 0) == 1, "cloth produces sound (nonzero energy)");
    assert(garjan_is_err(cloth_synthesize(c, 0)) == 1, "synthesize rejects duration=0");

    test_group("cloth_serde");
    var g = cloth_new(CLOTH_SAIL, f64_from(48000));
    cloth_set_wind_speed(g, f64_div(f64_from(7), f64_from(10)));
    # advance state so rng/dc_blocker are non-default
    cloth_synthesize(g, f64_div(f64_from(1), f64_from(100)));
    var sb = str_builder_new();
    cloth_to_json(g, sb);
    var j = str_data(str_builder_build(sb));
    var g2 = cloth_from_json_str(j);
    var sb2 = str_builder_new();
    cloth_to_json(g2, sb2);
    assert(memeq(j, str_data(str_builder_build(sb2)), strlen(j)) == 1, "cloth params json roundtrip idempotent");
    # restored synth resumes the SAME rng sequence
    assert_eq(rng_next_u32(Cloth_rng(g)), rng_next_u32(Cloth_rng(g2)), "restored cloth resumes rng");
    # restored synth rebuilt its modal bank
    assert(Cloth_modal_bank(g2) != 0, "restored sail has modal bank");

    return assert_summary();
}
var ec = main();
syscall(60, ec);
