# voice.tcyr -- parity tests for src/voice.cyr (steal logic + serde).
include "src/error.cyr"
include "src/voice.cyr"

# Joins three literal pieces into one NUL-terminated JSON document.
fn json_doc4v(a, b, c) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, a);
    str_builder_add_cstr(sb, b);
    str_builder_add_cstr(sb, c);
    return str_data(str_builder_build(sb));
}

# Runs the parity tests for src/voice.cyr. Returns the failure count, used as the exit code.
fn main() {
    alloc_init();

    test_group("allocate_and_fill");
    var p = voice_pool_new(3, STEAL_NONE);
    assert_eq(voice_pool_max_voices(p), 3, "max 3");
    assert_eq(voice_pool_allocate(p, 5, 100), 0, "first alloc -> slot 0");
    assert_eq(voice_pool_allocate(p, 5, 101), 1, "second -> slot 1");
    assert_eq(voice_pool_allocate(p, 5, 102), 2, "third -> slot 2");
    assert_eq(voice_pool_active_count(p), 3, "3 active");
    assert_eq(voice_pool_allocate(p, 5, 103), VOICE_NONE, "full + None policy -> reject");

    test_group("release");
    voice_pool_release(p, 1);
    assert_eq(voice_pool_active_count(p), 2, "2 active after release");
    assert_eq(voice_pool_allocate(p, 5, 104), 1, "reuse freed slot 1");

    test_group("steal_oldest");
    var q = voice_pool_new(2, STEAL_OLDEST);
    voice_pool_allocate(q, 1, 1);   # slot 0
    voice_pool_allocate(q, 1, 2);   # slot 1
    voice_pool_tick(q);             # both age 1
    voice_pool_tick(q);             # both age 2 (ties -> last max = slot 1)
    var stolen = voice_pool_allocate(q, 1, 3);
    assert_eq(stolen, 1, "steal oldest picks last max on tie");

    test_group("steal_lowest_priority");
    var r = voice_pool_new(2, STEAL_LOWEST_PRIORITY);
    voice_pool_allocate(r, 8, 1);   # slot 0 pri 8
    voice_pool_allocate(r, 3, 2);   # slot 1 pri 3 (lowest)
    assert_eq(voice_pool_allocate(r, 5, 3), 1, "steal lowest-priority slot (5>=3)");
    # a lower-priority newcomer than all present cannot steal
    var r2 = voice_pool_new(1, STEAL_LOWEST_PRIORITY);
    voice_pool_allocate(r2, 9, 1);
    assert_eq(voice_pool_allocate(r2, 2, 2), VOICE_NONE, "too-low priority cannot steal");

    test_group("voiceslot_serde");
    var vs = voice_slot_new();
    VoiceSlot_set_active(vs, 1);
    VoiceSlot_set_priority(vs, 7);
    VoiceSlot_set_age(vs, 42);
    VoiceSlot_set_tag(vs, 99);
    var sb = str_builder_new();
    VoiceSlot_to_json(vs, sb);
    var j = str_data(str_builder_build(sb));
    var vs2 = VoiceSlot_from_json_str(j);
    assert_eq(VoiceSlot_priority(vs2), 7, "serde priority");
    assert_eq(VoiceSlot_age(vs2), 42, "serde age");
    var sb2 = str_builder_new();
    VoiceSlot_to_json(vs2, sb2);
    assert(memeq(j, str_data(str_builder_build(sb2)), strlen(j)) == 1, "VoiceSlot json roundtrip");

    test_group("voicepool_serde");
    var vp = voice_pool_new(3, STEAL_LOWEST_PRIORITY);
    voice_pool_allocate(vp, 5, 111);
    voice_pool_allocate(vp, 9, 222);
    voice_pool_tick(vp);
    var pb = str_builder_new();
    voice_pool_to_json(vp, pb);
    var pj = str_data(str_builder_build(pb));
    var vp2 = voice_pool_from_json_str(pj);
    assert_eq(voice_pool_max_voices(vp2), 3, "pool serde max_voices");
    assert_eq(voice_pool_active_count(vp2), 2, "pool serde active count");
    assert_eq(VoiceSlot_tag(voice_pool_slot(vp2, 1)), 222, "pool serde slot tag");
    var pb2 = str_builder_new();
    voice_pool_to_json(vp2, pb2);
    assert(memeq(pj, str_data(str_builder_build(pb2)), strlen(pj)) == 1, "VoicePool json roundtrip idempotent");

    # --- 2.0.2 regression: pool is sized from the slots ARRAY, not max_voices ---
    # Rust derives Deserialize on `slots: Vec<VoiceSlot>`, so serde allocates
    # exactly as many slots as the array carries. Before 2.0.2 the port passed
    # the raw max_voices scalar to voice_pool_new, so this ~40-byte document
    # drove two billion VoiceSlot allocations against a never-freeing arena.
    test_group("from_json bounds max_voices by slots array");
    var hostile = voice_pool_from_json_str("{\"steal_policy\":0,\"max_voices\":2000000000,\"slots\":[]}");
    assert(garjan_is_err(hostile) == 0, "hostile pool still constructs");
    assert(voice_pool_max_voices(hostile) <= 1, "max_voices bounded by empty slots array");

    # --- 2.5.3: found by tests/garjan.fcyr ---
    # voice_pool_new's error return was dereferenced, so a bad policy was a SIGSEGV.
    test_group("hostile pool documents are refused");
    assert(garjan_is_err(voice_pool_from_json_str("{\"steal_policy\":99,\"max_voices\":1,\"slots\":[]}")) == 1,
      "out-of-range steal_policy refused");
    assert(garjan_is_err(voice_pool_from_json_str("{\"steal_policy\":-1,\"max_voices\":1,\"slots\":[]}")) == 1,
      "negative steal_policy refused");
    assert(garjan_is_err(voice_pool_from_json_str("{\"steal_policy\":0,\"max_voices\":1}")) == 1,
      "a document without slots refused");
    assert(garjan_is_err(voice_pool_from_json_str("not json")) == 1, "a non-document refused");
    assert(garjan_is_err(voice_pool_from_json_str("{\"steal_policy\":0,\"max_voices\":1,\"slots\":[]}")) == 0,
      "an empty slots array still loads");

    # --- 2.6.3: Rust's u64 age saturates, and its u8 / bool / u32 fields bound the rest ---
    test_group("voice fields keep Rust's bounds");
    var vb_p = voice_pool_from_json_str(json_doc4v("{\"steal_policy\":0,\"max_voices\":2,\"slots\":[",
        "{\"active\":1,\"priority\":0,\"age\":9223372036854775807,\"tag\":0},",
        "{\"active\":1,\"priority\":0,\"age\":5,\"tag\":0}]}"));
    assert(garjan_is_err(vb_p) == 0, "a pool at the top age loads");
    voice_pool_tick(vb_p);
    assert_eq(VoiceSlot_age(voice_pool_slot(vb_p, 0)), 9223372036854775807, "age saturates");
    assert_eq(voice_pool_allocate(vb_p, 1, 1), 0, "the oldest slot is stolen");
    var vb_q = voice_pool_new(2, STEAL_OLDEST);
    assert(garjan_is_err(voice_pool_allocate(vb_q, 256, 1)) == 1, "priority 256 refused");
    assert(garjan_is_err(voice_pool_allocate(vb_q, 0 - 1, 1)) == 1, "priority -1 refused");
    assert(garjan_is_err(voice_pool_allocate(vb_q, 1, 0 - 1)) == 1, "a negative tag refused");
    assert(garjan_is_err(voice_pool_from_json_str(
          "{\"steal_policy\":0,\"max_voices\":1,\"slots\":[{\"active\":2,\"priority\":0,\"age\":0,\"tag\":0}]}")) == 1,
      "active 2 refused");
    assert(garjan_is_err(voice_pool_from_json_str(json_doc4v("{\"steal_policy\":0,\"max_voices\":1,\"slots\":",
            "[{\"active\":0,\"priority\":300,", "\"age\":0,\"tag\":0}]}"))) == 1,
      "priority 300 refused");
    assert(garjan_is_err(voice_pool_from_json_str(
          "{\"steal_policy\":0,\"max_voices\":1,\"slots\":[{\"active\":0,\"priority\":0,\"age\":-1,\"tag\":0}]}")) == 1,
      "a negative age refused");

    return assert_summary();
}
var ec = main();
syscall(60, ec);
