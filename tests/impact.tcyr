# impact.tcyr -- parity tests for src/impact.cyr (modal-bank synth + serde).
include "src/error.cyr"
include "src/logging.cyr"
include "src/dsp.cyr"
include "src/rng.cyr"
include "src/lod.cyr"
include "src/material.cyr"
include "src/modal.cyr"
include "src/contact.cyr"
include "src/aero.cyr"
include "src/creature.cyr"
include "src/impact.cyr"

fn main() {
    alloc_init();

    test_group("impact_new");
    var im = impact_new(MATERIAL_METAL, f64_from(44100));
    assert(garjan_is_err(im) == 0, "impact_new ok");
    assert(garjan_is_err(impact_new(MATERIAL_METAL, 0)) == 1, "impact_new rejects sr=0");
    assert_eq(impact_material(im), MATERIAL_METAL, "material stored");
    # new_interaction is equivalent to new(surface, sr)
    var ii = impact_new_interaction(MATERIAL_WOOD, MATERIAL_STONE, f64_from(44100));
    assert(garjan_is_err(ii) == 0, "impact_new_interaction ok");
    assert_eq(impact_material(ii), MATERIAL_STONE, "interaction uses surface material");

    test_group("force_and_exc");
    assert(f64_lt(f64_abs(f64_sub(impact_type_force(IMPACT_CRASH), F64_ONE)), GARJAN_EPSILON) == 1, "crash force = 1.0");
    assert(f64_lt(f64_abs(f64_sub(impact_type_force(IMPACT_TAP), f64_div(f64_from(2), f64_from(10)))), GARJAN_EPSILON) == 1, "tap force = 0.2");
    assert_eq(impact_type_exc_type(IMPACT_TAP), EXCITATION_HALF_SINE, "tap uses half-sine");
    assert_eq(impact_type_exc_type(IMPACT_STRIKE), EXCITATION_NOISE_BURST, "strike uses noise burst");

    test_group("synthesize");
    # metal decay = 1.5s -> duration = 1.5*2 + 0.05 = 3.05s @ 44100 = 134505 samples
    var buf = impact_synthesize(im, IMPACT_STRIKE);
    assert(garjan_is_err(buf) == 0, "synthesize ok");
    assert_eq(vec_len(buf), 134505, "3.05s @ 44100 = 134505 samples");
    var i = 0;
    var allfinite = 1;
    var energy = 0;
    while (i < vec_len(buf)) {
        var s = vec_get(buf, i);
        if (garjan_is_finite(s) == 0) { allfinite = 0; }
        energy = f64_add(energy, f64_abs(s));
        i = i + 1;
    }
    assert(allfinite == 1, "all impact samples finite");
    assert(f64_gt(energy, 0) == 1, "impact produces sound (nonzero energy)");

    test_group("shatter");
    # shatter path exercises the rng debris loop; must stay finite
    var gl = impact_new(MATERIAL_GLASS, f64_from(44100));
    var sbuf = impact_synthesize(gl, IMPACT_SHATTER);
    assert(garjan_is_err(sbuf) == 0, "shatter synthesize ok");
    var j = 0;
    var sfin = 1;
    var senergy = 0;
    while (j < vec_len(sbuf)) {
        var sv = vec_get(sbuf, j);
        if (garjan_is_finite(sv) == 0) { sfin = 0; }
        senergy = f64_add(senergy, f64_abs(sv));
        j = j + 1;
    }
    assert(sfin == 1, "all shatter samples finite");
    assert(f64_gt(senergy, 0) == 1, "shatter produces sound");

    test_group("impact_serde");
    var g = impact_new(MATERIAL_WOOD, f64_from(48000));
    # advance state so rng/dc_blocker are non-default
    impact_synthesize(g, IMPACT_SHATTER);
    var sb = str_builder_new();
    impact_to_json(g, sb);
    var jj = str_data(str_builder_build(sb));
    var g2 = impact_from_json_str(jj);
    var sb2 = str_builder_new();
    impact_to_json(g2, sb2);
    assert(memeq(jj, str_data(str_builder_build(sb2)), strlen(jj)) == 1, "impact params json roundtrip idempotent");
    # restored synth resumes the SAME rng sequence
    assert_eq(rng_next_u32(Impact_rng(g)), rng_next_u32(Impact_rng(g2)), "restored impact resumes rng");
    # restored synth reports the same material
    assert_eq(impact_material(g2), MATERIAL_WOOD, "restored material matches");

    # --- 2.0.4: streaming must not grow the arena ---
    # impact_generate built a fresh Exciter (+ its Rng) per block -- 64 B each
    # against an allocator that never frees. It now reuses one cached exciter.
    test_group("zero-alloc streaming");
    var ia = impact_new(MATERIAL_METAL, f64_from(44100));
    var ia_out = vec_new();
    var ia_n = 0;
    while (ia_n < 256) { vec_push(ia_out, 0); ia_n = ia_n + 1; }
    impact_process_block(ia, IMPACT_STRIKE, ia_out);
    var ia_before = alloc_used();
    var ia_b = 0;
    while (ia_b < 50) { impact_process_block(ia, IMPACT_STRIKE, ia_out); ia_b = ia_b + 1; }
    assert_eq(alloc_used() - ia_before, 0, "50 impact blocks allocate 0 bytes");

    return assert_summary();
}
var ec = main();
syscall(60, ec);
