# underwater.tcyr -- parity tests for src/underwater.cyr (naad synth + serde).
include "src/error.cyr"
include "src/logging.cyr"
include "src/dsp.cyr"
include "src/rng.cyr"
include "src/lod.cyr"
include "src/material.cyr"
include "src/modal.cyr"
include "src/contact.cyr"
include "src/aero.cyr"
include "src/creature.cyr"
include "src/underwater.cyr"

fn main() {
    alloc_init();

    test_group("underwater_new");
    var u = underwater_new(UNDERWATER_DEPTH_MEDIUM, f64_from(44100));
    assert(garjan_is_err(u) == 0, "underwater_new ok");
    assert(garjan_is_err(underwater_new(UNDERWATER_DEPTH_MEDIUM, 0)) == 1, "underwater_new rejects sr=0");
    # Medium: rumble_amp = 0.25, bubble_rate = 2.0, surface_noise_amp = 0.08.
    assert(f64_lt(f64_abs(f64_sub(Underwater_rumble_amp(u), f64_div(f64_from(25), f64_from(100)))), GARJAN_EPSILON) == 1, "medium rumble_amp 0.25");
    assert(f64_lt(f64_abs(f64_sub(Underwater_bubble_rate(u), f64_from(2))), GARJAN_EPSILON) == 1, "medium bubble_rate 2.0");
    assert(f64_lt(f64_abs(f64_sub(Underwater_lp_cutoff(u), f64_from(1200))), GARJAN_EPSILON) == 1, "medium lp_cutoff 1200");

    test_group("synthesize");
    var buf = underwater_synthesize(u, f64_div(f64_from(1), f64_from(10)));   # 0.1s
    assert(garjan_is_err(buf) == 0, "synthesize ok");
    assert_eq(vec_len(buf), 4410, "0.1s @ 44100 = 4410 samples");
    var i = 0;
    var allfinite = 1;
    var energy = 0;
    while (i < vec_len(buf)) {
        var s = vec_get(buf, i);
        if (garjan_is_finite(s) == 0) { allfinite = 0; }
        energy = f64_add(energy, f64_abs(s));
        i = i + 1;
    }
    assert(allfinite == 1, "all underwater samples finite");
    assert(f64_gt(energy, 0) == 1, "underwater produces sound (nonzero energy)");
    assert(garjan_is_err(underwater_synthesize(u, 0)) == 1, "synthesize rejects duration=0");

    test_group("intensity_gate");
    # Below 0.001 -> silent output, but cursor still advances.
    var q = underwater_new(UNDERWATER_DEPTH_DEEP, f64_from(44100));
    underwater_set_intensity(q, 0);
    var qbuf = underwater_synthesize(q, f64_div(f64_from(1), f64_from(100)));   # 0.01s
    var qi = 0;
    var qenergy = 0;
    while (qi < vec_len(qbuf)) {
        qenergy = f64_add(qenergy, f64_abs(vec_get(qbuf, qi)));
        qi = qi + 1;
    }
    assert(f64_lt(qenergy, GARJAN_EPSILON) == 1, "silent when intensity < 0.001");
    assert_eq(Underwater_sample_position(q), 441, "cursor advances while silent");

    test_group("underwater_serde");
    var g = underwater_new(UNDERWATER_DEPTH_SHALLOW, f64_from(48000));
    # advance state so rng/dc_blocker are non-default
    underwater_synthesize(g, f64_div(f64_from(1), f64_from(100)));
    var sb = str_builder_new();
    underwater_to_json(g, sb);
    var j = str_data(str_builder_build(sb));
    var g2 = underwater_from_json_str(j);
    var sb2 = str_builder_new();
    underwater_to_json(g2, sb2);
    assert(memeq(j, str_data(str_builder_build(sb2)), strlen(j)) == 1, "underwater params json roundtrip idempotent");
    # restored synth resumes the SAME rng sequence
    assert_eq(rng_next_u32(Underwater_rng(g)), rng_next_u32(Underwater_rng(g2)), "restored underwater resumes rng");

    return assert_summary();
}
var ec = main();
syscall(60, ec);
