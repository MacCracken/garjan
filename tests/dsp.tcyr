# dsp.tcyr -- parity tests for src/dsp.cyr (DcBlocker + validators + serde).

include "src/error.cyr"
include "src/logging.cyr"
include "src/dsp.cyr"

# Runs the parity tests for src/dsp.cyr. Returns the failure count, used as the exit code.
fn main() {
    alloc_init();

    # ---- validators ----
    test_group("validators");
    assert_eq(garjan_validate_sample_rate(f64_from(44100)), GARJAN_OK, "44100 sr ok");
    assert(garjan_is_err(garjan_validate_sample_rate(0)) == 1, "0 sr invalid");
    assert(garjan_is_err(garjan_validate_sample_rate(f64_neg(F64_ONE))) == 1, "-1 sr invalid");
    assert(garjan_is_err(garjan_validate_sample_rate(GARJAN_POS_INF)) == 1, "inf sr invalid");
    assert_eq(garjan_validate_duration(F64_ONE), GARJAN_OK, "1.0 dur ok");
    assert(garjan_is_err(garjan_validate_duration(0)) == 1, "0 dur invalid");

    # ---- DcBlocker: y[0] == x[0], output finite, DC gradually removed ----
    test_group("dcblocker");
    var db = garjan_dcblocker_new(f64_from(44100));
    var y0 = garjan_dcblocker_process(db, F64_ONE);
    assert(f64_lt(f64_abs(f64_sub(y0, F64_ONE)), GARJAN_EPSILON) == 1, "first output == input");
    var i = 0;
    var allfinite = 1;
    var last = y0;
    while (i < 8000) {
        last = garjan_dcblocker_process(db, F64_ONE);
        if (garjan_is_finite(last) == 0) { allfinite = 0; }
        i = i + 1;
    }
    assert(allfinite == 1, "all DcBlocker outputs finite");
    assert(f64_lt(last, F64_HALF) == 1, "DC offset removed (output decays under 0.5)");

    # ---- serde roundtrip (DcBlocker) ----
    test_group("dcblocker_serde");
    var d = garjan_dcblocker_new(f64_from(48000));
    var sb = str_builder_new();
    DcBlocker_to_json(d, sb);
    var j = str_data(str_builder_build(sb));
    var d2 = DcBlocker_from_json_str(j);
    var sb2 = str_builder_new();
    DcBlocker_to_json(d2, sb2);
    var j2 = str_data(str_builder_build(sb2));
    assert(memeq(j, j2, strlen(j)) == 1, "DcBlocker json roundtrip idempotent");

    # --- 2.6.2: writes lib/vec.cyr's header directly, so pin that layout at every bump ---
    test_group("garjan_vec_zeros");
    var vz0 = garjan_vec_zeros(0);
    assert_eq(vec_len(vz0), 0, "zero length");
    var vz = garjan_vec_zeros(1000);
    assert_eq(vec_len(vz), 1000, "length");
    assert_eq(vec_cap(vz), 1000, "capacity is exact, not doubled");
    var vz_i = 0;
    var vz_sum = 0;
    while (vz_i < 1000) { vz_sum = vz_sum + vec_get(vz, vz_i); vz_i = vz_i + 1; }
    assert_eq(vz_sum, 0, "every slot is zero");
    vec_set(vz, 999, 7);
    assert_eq(vec_get(vz, 999), 7, "the last slot is writable");
    vec_push(vz, 9);
    assert_eq(vec_len(vz), 1001, "growing past the end still works");
    assert_eq(vec_get(vz, 999), 7, "growth keeps the contents");
    assert_eq(vec_get(vz, 1000), 9, "growth appends");
    var vz_small = garjan_vec_zeros(4);
    assert_eq(vec_len(vz_small), 4, "below the default capacity");
    assert_eq(vec_get(vz_small, 3), 0, "below the default capacity is zeroed");

    return assert_summary();
}

var exit_code = main();
syscall(60, exit_code);
