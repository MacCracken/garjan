# fire.tcyr -- parity tests for src/fire.cyr (naad synth + serde).
include "src/error.cyr"
include "src/logging.cyr"
include "src/dsp.cyr"
include "src/rng.cyr"
include "src/fire.cyr"

fn main() {
    alloc_init();

    test_group("fire_new");
    var f = fire_new(F64_HALF, f64_from(44100));
    assert(garjan_is_err(f) == 0, "fire_new ok");
    assert(garjan_is_err(fire_new(F64_HALF, 0)) == 1, "fire_new rejects sr=0");
    # crackle_rate = 5 + 0.5*30 = 20
    assert(f64_lt(f64_abs(f64_sub(Fire_crackle_rate(f), f64_from(20))), GARJAN_EPSILON) == 1, "crackle_rate 20");

    test_group("synthesize");
    var buf = fire_synthesize(f, f64_div(f64_from(1), f64_from(10)));   # 0.1s
    assert(garjan_is_err(buf) == 0, "synthesize ok");
    assert_eq(vec_len(buf), 4410, "0.1s @ 44100 = 4410 samples");
    var i = 0;
    var allfinite = 1;
    var energy = 0;
    while (i < vec_len(buf)) {
        var s = vec_get(buf, i);
        if (garjan_is_finite(s) == 0) { allfinite = 0; }
        energy = f64_add(energy, f64_abs(s));
        i = i + 1;
    }
    assert(allfinite == 1, "all fire samples finite");
    assert(f64_gt(energy, 0) == 1, "fire produces sound (nonzero energy)");
    assert(garjan_is_err(fire_synthesize(f, 0)) == 1, "synthesize rejects duration=0");

    test_group("fire_serde");
    var g = fire_new(f64_div(f64_from(7), f64_from(10)), f64_from(48000));
    # advance state so rng/dc_blocker are non-default
    fire_synthesize(g, f64_div(f64_from(1), f64_from(100)));
    var sb = str_builder_new();
    fire_to_json(g, sb);
    var j = str_data(str_builder_build(sb));
    var g2 = fire_from_json_str(j);
    var sb2 = str_builder_new();
    fire_to_json(g2, sb2);
    assert(memeq(j, str_data(str_builder_build(sb2)), strlen(j)) == 1, "fire params json roundtrip idempotent");
    # restored synth resumes the SAME rng sequence
    assert_eq(rng_next_u32(Fire_rng(g)), rng_next_u32(Fire_rng(g2)), "restored fire resumes rng");

    # --- 2.0.2 regression: hostile JSON must not yield a wild object ---
    # sample_rate = 0 makes naad's filter_biquad_new fail, so fire_build_naad
    # returns early WITHOUT assigning roar_filter/crackle_filter. Before 2.0.2
    # fire_from_json_str discarded that error and handed back a non-negative
    # pointer whose naad fields were 0, and the first process_block segfaulted.
    test_group("from_json rejects bad sample_rate");
    var evil = fire_from_json_str("{\"intensity\":0.5,\"crackle_rate\":20.0,\"sample_rate\":0.0,\"sample_position\":0,\"rng_state\":1,\"rng_inc\":1,\"dcb_x_prev\":0.0,\"dcb_y_prev\":0.0,\"dcb_r\":0.999}");
    assert(garjan_is_err(evil) == 1, "fire_from_json_str rejects sample_rate=0");

    # --- 2.5.0: serde carries the naad components' LIVE state ---
    # Rust derived Serialize over those fields, so a Rust save/restore resumed
    # seamlessly; the port rebuilt them from scratch and resumed with zeroed
    # filter memory (architecture note 001). The check that matters is not JSON
    # equality -- that passed throughout -- but whether CONTINUED OUTPUT after a
    # restore matches the synth that was never saved.
    test_group("serde restores live DSP state");
    var sa = fire_new(F64_HALF, f64_from(44100));
    var warm = vec_new();
    var wi = 0;
    while (wi < 1024) { vec_push(warm, 0); wi = wi + 1; }
    fire_process_block(sa, warm);                 # advance filters + noise

    var ssb = str_builder_new();
    fire_to_json(sa, ssb);
    var sj = str_data(str_builder_build(ssb));
    var sr2 = fire_from_json_str(sj);
    assert(garjan_is_err(sr2) == 0, "warmed fire restores");

    # Guard the guard: the state must actually be non-zero, or matching it
    # would prove nothing.
    assert(BiquadFilter_z1(Fire_roar_filter(sa)) != 0, "roar filter has non-zero memory to carry");
    assert_eq(BiquadFilter_z1(Fire_roar_filter(sr2)), BiquadFilter_z1(Fire_roar_filter(sa)),
      "roar filter z1 restored");
    assert_eq(BiquadFilter_z2(Fire_roar_filter(sr2)), BiquadFilter_z2(Fire_roar_filter(sa)),
      "roar filter z2 restored");

    var ca = vec_new();
    var cb = vec_new();
    wi = 0;
    while (wi < 1024) { vec_push(ca, 0); vec_push(cb, 0); wi = wi + 1; }
    fire_process_block(sa, ca);
    fire_process_block(sr2, cb);
    var csame = 1;
    wi = 0;
    while (wi < vec_len(ca)) {
        if (vec_get(ca, wi) != vec_get(cb, wi)) { csame = 0; }
        wi = wi + 1;
    }
    assert_eq(csame, 1, "continued output after restore is sample-identical");

    # A pre-2.5.0 document has no "dsp" member; it must still load.
    var oldfmt = fire_from_json_str("{\"intensity\":0.5,\"crackle_rate\":20.0,\"sample_rate\":44100.0,\"sample_position\":0,\"rng_state\":1,\"rng_inc\":19999,\"dcb_x_prev\":0.0,\"dcb_y_prev\":0.0,\"dcb_r\":0.999}");
    assert(garjan_is_err(oldfmt) == 0, "a document without \"dsp\" still loads");


    return assert_summary();
}
var ec = main();
syscall(60, ec);
