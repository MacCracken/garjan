# footstep.tcyr -- parity tests for src/footstep.cyr (naad synth + serde).
include "src/error.cyr"
include "src/logging.cyr"
include "src/dsp.cyr"
include "src/rng.cyr"
include "src/lod.cyr"
include "src/material.cyr"
include "src/modal.cyr"
include "src/contact.cyr"
include "src/aero.cyr"
include "src/creature.cyr"
include "src/footstep.cyr"

fn main() {
    alloc_init();

    test_group("footstep_new");
    var f = footstep_new(TERRAIN_GRAVEL, MOVEMENT_WALK, f64_from(44100));
    assert(garjan_is_err(f) == 0, "footstep_new ok");
    assert(garjan_is_err(footstep_new(TERRAIN_GRAVEL, MOVEMENT_WALK, 0)) == 1, "footstep_new rejects sr=0");
    # WALK step_interval = 0.5s -> 22050 samples @ 44100
    assert_eq(Footstep_step_interval_samples(f), 22050, "walk step interval 22050");
    # gravel has no resonant material -> modal_bank == 0
    assert(Footstep_modal_bank(f) == 0, "gravel no modal bank");

    test_group("synthesize");
    var buf = footstep_synthesize(f, f64_div(f64_from(1), f64_from(10)));   # 0.1s
    assert(garjan_is_err(buf) == 0, "synthesize ok");
    assert_eq(vec_len(buf), 4410, "0.1s @ 44100 = 4410 samples");
    var i = 0;
    var allfinite = 1;
    var energy = 0;
    while (i < vec_len(buf)) {
        var s = vec_get(buf, i);
        if (garjan_is_finite(s) == 0) { allfinite = 0; }
        energy = f64_add(energy, f64_abs(s));
        i = i + 1;
    }
    assert(allfinite == 1, "all footstep samples finite");
    assert(f64_gt(energy, 0) == 1, "footstep produces sound (nonzero energy)");
    assert(garjan_is_err(footstep_synthesize(f, 0)) == 1, "synthesize rejects duration=0");

    test_group("modal_terrain");
    # wood terrain builds a modal bank and its samples stay finite
    var w = footstep_new(TERRAIN_WOOD, MOVEMENT_RUN, f64_from(48000));
    assert(garjan_is_err(w) == 0, "wood footstep ok");
    assert(Footstep_modal_bank(w) != 0, "wood has modal bank");
    var wbuf = footstep_synthesize(w, f64_div(f64_from(1), f64_from(20)));  # 0.05s
    assert(garjan_is_err(wbuf) == 0, "wood synthesize ok");
    var j = 0;
    var wfinite = 1;
    var wenergy = 0;
    while (j < vec_len(wbuf)) {
        var ws = vec_get(wbuf, j);
        if (garjan_is_finite(ws) == 0) { wfinite = 0; }
        wenergy = f64_add(wenergy, f64_abs(ws));
        j = j + 1;
    }
    assert(wfinite == 1, "all wood samples finite");
    assert(f64_gt(wenergy, 0) == 1, "wood produces sound");

    test_group("footstep_serde");
    var g = footstep_new(TERRAIN_METAL, MOVEMENT_SNEAK, f64_from(48000));
    # advance state so rng/dc_blocker are non-default
    footstep_synthesize(g, f64_div(f64_from(1), f64_from(50)));
    var sb = str_builder_new();
    footstep_to_json(g, sb);
    var jstr = str_data(str_builder_build(sb));
    var g2 = footstep_from_json_str(jstr);
    var sb2 = str_builder_new();
    footstep_to_json(g2, sb2);
    assert(memeq(jstr, str_data(str_builder_build(sb2)), strlen(jstr)) == 1, "footstep params json roundtrip idempotent");
    # restored synth resumes the SAME main rng sequence
    assert_eq(rng_next_u32(Footstep_rng(g)), rng_next_u32(Footstep_rng(g2)), "restored footstep resumes rng");

    return assert_summary();
}
var ec = main();
syscall(60, ec);
