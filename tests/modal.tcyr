# modal.tcyr -- parity tests for src/modal.cyr.
include "src/error.cyr"
include "src/logging.cyr"
include "src/dsp.cyr"
include "src/rng.cyr"
include "src/material.cyr"
include "src/modal.cyr"

# Runs the parity tests for src/modal.cyr. Returns the failure count, used as the exit code.
fn main() {
    alloc_init();

    test_group("beam_ratios");
    assert(f64_lt(f64_abs(f64_sub(modal_beam_ratio(1), F64_ONE)), GARJAN_EPSILON) == 1, "beam_ratio(1)=1.0");
    assert(f64_lt(f64_abs(f64_sub(modal_beam_ratio(2), f64_div(f64_from(2757), f64_from(1000)))), GARJAN_EPSILON) == 1,
      "beam_ratio(2)=2.757");

    test_group("modespec_serde");
    var ms = modal_modespec_new(f64_from(440), F64_HALF, F64_ONE);
    var sb = str_builder_new();
    ModeSpec_to_json(ms, sb);
    var j = str_data(str_builder_build(sb));
    var ms2 = ModeSpec_from_json_str(j);
    assert(f64_lt(f64_abs(f64_sub(ModeSpec_frequency(ms2), f64_from(440))), GARJAN_EPSILON) == 1,
      "modespec serde freq");

    test_group("generate_modes");
    var props = material_properties(MATERIAL_METAL);
    var specs = generate_modes(props, MODE_PATTERN_PLATE, 12, f64_div(f64_from(5), f64_from(100)));
    assert(vec_len(specs) > 0, "generated some modes");
    var allfinite = 1;
    var i = 0;
    while (i < vec_len(specs)) {
        if (garjan_is_finite(ModeSpec_frequency(vec_get(specs, i))) == 0) { allfinite = 0; }
        i = i + 1;
    }
    assert(allfinite == 1, "all mode freqs finite");

    test_group("modal_bank");
    var bank = modal_bank_new(specs, f64_from(44100));
    assert(garjan_is_err(bank) == 0, "bank built ok");
    assert(modal_bank_mode_count(bank) > 0, "bank has modes");
    # impulse response: feed 1.0 then zeros; output must be finite and ring
    var y0 = modal_bank_process_sample(bank, F64_ONE);
    var energy = 0;
    i = 0;
    var okfin = 1;
    while (i < 4000) {
        var y = modal_bank_process_sample(bank, 0);
        if (garjan_is_finite(y) == 0) { okfin = 0; }
        energy = f64_add(energy, f64_abs(y));
        i = i + 1;
    }
    assert(okfin == 1, "modal bank output finite");
    assert(f64_gt(energy, 0) == 1, "modal bank rings (nonzero energy)");
    # bad sample rate rejected
    assert(garjan_is_err(modal_bank_new(specs, 0)) == 1, "bank rejects sr=0");

    test_group("exciter");
    var imp = exciter_new(EXCITATION_IMPULSE, 0, F64_ONE);
    exciter_trigger(imp);
    assert(f64_lt(f64_abs(f64_sub(exciter_next_sample(imp), F64_ONE)), GARJAN_EPSILON) == 1,
      "impulse first sample = amp");
    assert(f64_lt(f64_abs(exciter_next_sample(imp)), GARJAN_EPSILON) == 1, "impulse spent after 1 sample");
    assert_eq(exciter_is_active(imp), 0, "impulse inactive after spent");
    var burst = exciter_new(EXCITATION_NOISE_BURST, 100, F64_HALF);
    exciter_trigger(burst);
    var okb = 1;
    i = 0;
    while (i < 100) {
        if (garjan_is_finite(exciter_next_sample(burst)) == 0) { okb = 0; }
        i = i + 1;
    }
    assert(okb == 1, "noise burst finite");
    # Matches Rust: active through exactly `duration` samples; the NEXT call spends it.
    assert_eq(exciter_is_active(burst), 1, "noise burst still active after exactly duration");
    exciter_next_sample(burst);
    assert_eq(exciter_is_active(burst), 0, "noise burst spent on next call");

    # --- 2.0.4: exciter_reset == exciter_new + exciter_trigger, bit-exact ---
    # impact_generate reuses one Exciter per block instead of building a fresh
    # one, so the reset path must reproduce a fresh exciter's stream exactly --
    # including the rng re-seed, or NOISE_BURST would drift after block 1.
    test_group("exciter_reset equivalence");
    var er_ty = 0;
    var er_same = 1;
    while (er_ty < 3) {
        var er_a = exciter_new(er_ty, f64_from(500), garjan_frac(8, 10));
        exciter_trigger(er_a);
        var er_b = exciter_new(EXCITATION_IMPULSE, 0, 0);
        exciter_reset(er_b, er_ty, f64_from(500), garjan_frac(8, 10));
        var er_i = 0;
        while (er_i < 600) {
            if (exciter_next_sample(er_a) != exciter_next_sample(er_b)) { er_same = 0; }
            er_i = er_i + 1;
        }
        er_ty = er_ty + 1;
    }
    assert_eq(er_same, 1, "exciter_reset matches exciter_new+trigger for all 3 types");
    # and a REUSED exciter must match a fresh one on every repeat
    var er_re = exciter_new(EXCITATION_IMPULSE, 0, 0);
    var er_rep = 1;
    var er_r = 0;
    while (er_r < 3) {
        var er_f = exciter_new(EXCITATION_NOISE_BURST, f64_from(400), F64_HALF);
        exciter_trigger(er_f);
        exciter_reset(er_re, EXCITATION_NOISE_BURST, f64_from(400), F64_HALF);
        var er_k = 0;
        while (er_k < 400) {
            if (exciter_next_sample(er_f) != exciter_next_sample(er_re)) { er_rep = 0; }
            er_k = er_k + 1;
        }
        er_r = er_r + 1;
    }
    assert_eq(er_rep, 1, "reused exciter matches a fresh one on every repeat");

    # --- 2.6.3: ADR-0006 in modal, and Rust's saturating u64 seed ---
    test_group("modal enum ids are refused");
    var me_props = material_properties(MATERIAL_METAL);
    assert(garjan_is_err(exciter_new(99, 10, F64_ONE)) == 1, "exciter_new refuses 99");
    assert(garjan_is_err(exciter_new(0 - 1, 10, F64_ONE)) == 1, "exciter_new refuses -1");
    var me_ex = exciter_new(EXCITATION_IMPULSE, 10, F64_ONE);
    assert(garjan_is_err(exciter_reset(me_ex, 99, 10, F64_ONE)) == 1, "exciter_reset refuses 99");
    assert_eq(Exciter_excitation_type(me_ex), EXCITATION_IMPULSE, "a refused reset changes nothing");
    assert(garjan_is_err(generate_modes(me_props, 99, 4, F64_ONE)) == 1, "generate_modes refuses 99");
    assert(garjan_is_err(generate_modes(me_props, F64_HALF, 4, F64_ONE)) == 1, "generate_modes refuses an f64");
    test_group("generate_modes seeds as Rust's u64 cast does");
    var ms_props = material_properties_new(f64_from(0 - 100), f64_from(200), F64_ONE, F64_HALF, F64_HALF);
    var msm = generate_modes(ms_props, MODE_PATTERN_DAMPED, 3, F64_ONE);
    var ms_want = vec_new();
    vec_push(ms_want, f64_div(f64_from(0 - 10787), f64_from(100)));
    vec_push(ms_want, f64_div(f64_from(0 - 9434), f64_from(100)));
    vec_push(ms_want, f64_div(f64_from(0 - 9721), f64_from(100)));
    var ms_i = 0;
    var ms_worst = 0;
    while (ms_i < 3) {
        ms_worst = f64_max(ms_worst, f64_abs(f64_sub(ModeSpec_frequency(vec_get(msm, ms_i)), vec_get(ms_want, ms_i))));
        ms_i = ms_i + 1;
    }
    assert(f64_lt(ms_worst, f64_div(F64_ONE, f64_from(20))) == 1, "negative resonance matches Rust's seed");

    return assert_summary();
}
var ec = main();
syscall(60, ec);
