# --- aero.cyr ---

# aero.cyr -- shared types for aerodynamic synthesis.
#
# Ports rust-old/src/aero.rs (WhooshType, WhistleSource, ClothType enums +
# their config() tuples). Enums -> module-prefixed int constants; config
# tuples -> transient config structs (accessor-read, no serde). Booleans
# become 0/1 ints. f32 -> f64. Standalone (stdlib math only).

# ---- WhooshType ----
var WHOOSH_SWING      = 0;
var WHOOSH_PROJECTILE = 1;
var WHOOSH_VEHICLE    = 2;
var WHOOSH_THROW      = 3;

# config (envelope_duration_s, brightness, low_freq_content).
#derive(accessors)
struct WhooshConfig { duration; brightness; low_freq; }

#must_use
fn aero_whoosh_config(ty) {
    if (garjan_enum_invalid(ty, WHOOSH_THROW) == 1) { return GARJAN_ERR_INVALID_PARAMETER; }
    var c = garjan_alloc(sizeof(WhooshConfig));
    if (garjan_is_err(c) == 1) { return c; }
    if (ty == WHOOSH_SWING) {
        WhooshConfig_set_duration(c, f64_div(f64_from(3), f64_from(10)));       # 0.3
        WhooshConfig_set_brightness(c, f64_div(f64_from(7), f64_from(10)));     # 0.7
        WhooshConfig_set_low_freq(c, f64_div(f64_from(2), f64_from(10)));       # 0.2
    } elif (ty == WHOOSH_PROJECTILE) {
        WhooshConfig_set_duration(c, f64_div(f64_from(15), f64_from(100)));     # 0.15
        WhooshConfig_set_brightness(c, f64_div(f64_from(9), f64_from(10)));     # 0.9
        WhooshConfig_set_low_freq(c, f64_div(f64_from(1), f64_from(10)));       # 0.1
    } elif (ty == WHOOSH_VEHICLE) {
        WhooshConfig_set_duration(c, f64_div(f64_from(15), f64_from(10)));      # 1.5
        WhooshConfig_set_brightness(c, f64_div(f64_from(4), f64_from(10)));     # 0.4
        WhooshConfig_set_low_freq(c, f64_div(f64_from(6), f64_from(10)));       # 0.6
    } else {
        # Throw
        WhooshConfig_set_duration(c, f64_div(f64_from(5), f64_from(10)));       # 0.5
        WhooshConfig_set_brightness(c, f64_div(f64_from(5), f64_from(10)));     # 0.5
        WhooshConfig_set_low_freq(c, f64_div(f64_from(3), f64_from(10)));       # 0.3
    }
    return c;
}

