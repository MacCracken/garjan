# garjan.cyr -- bundled distribution
# Version: 2.5.1
# Generated by: cyrius distlib
# Do not edit -- rebuild with: cyrius distlib

# --- error.cyr ---

# error.cyr -- garjan error codes + shared finite/tolerance base helpers.
# The L0 base module: included FIRST by every build/test entry. Module files
# do not `include` each other -- the entry orders them.
#
# Ports rust-old/src/error.rs (the `GarjanError` enum + `Result<T>` alias)
# plus the finite-test helper the whole crate leans on. Rust carried a
# String payload per error variant; the Cyrius port uses integer codes --
# fns return GARJAN_OK (0) on success or a negative code on failure, and
# constructors return a heap pointer on success or a negative code. Human
# strings come from garjan_err_name().
#
# All public symbols are GARJAN_/garjan_-prefixed so they never collide with
# the naad/hisab/goonj/sakshi bundles garjan links against (Cyrius resolves
# duplicate top-level defs "last-wins", so prefixing is mandatory here).

# ================================================================
# Error codes (was `enum GarjanError`). One per Rust variant.
# ================================================================
var GARJAN_OK                    = 0;
var GARJAN_ERR_INVALID_PARAMETER = (0 - 1);   # a synthesis parameter out of range
var GARJAN_ERR_SYNTHESIS_FAILED  = (0 - 2);   # a synthesis operation failed
var GARJAN_ERR_COMPUTATION       = (0 - 3);   # a numeric computation went invalid
# Not a port of a Rust variant -- Rust aborts the process on allocation
# failure, so it had no such error to carry. See ADR-005.
var GARJAN_ERR_ALLOCATION        = (0 - 4);   # heap exhausted (alloc returned 0)

# ================================================================
# Shared f64 tolerances / sentinels (IEEE-754 bit patterns). The Rust
# source was f32; the Cyrius port is f64 throughout (naad/hisab are
# f64-only). GARJAN_EPSILON preserves f32::EPSILON (2^-23), the guard
# threshold the Rust code used, promoted cleanly to f64.
# ================================================================
var GARJAN_EPSILON     = 0x3E80000000000000;   # f32::EPSILON = 2^-23 ~ 1.192e-7
var GARJAN_POS_INF     = 0x7FF0000000000000;   # +inf
var GARJAN_NEG_INF     = 0xFFF0000000000000;   # -inf
var GARJAN_F32_MIN_POS = 0x3810000000000000;   # f32::MIN_POSITIVE ~ 1.175e-38

# 1 if `code` is an error (negative), 0 otherwise.
#must_use
fn garjan_is_err(code) {
    if (code < 0) { return 1; }
    return 0;
}

# Static name for an error code (diagnostics / logging).
#must_use
fn garjan_err_name(code) {
    if (code == GARJAN_OK) { return "ok"; }
    if (code == GARJAN_ERR_INVALID_PARAMETER) { return "invalid parameter"; }
    if (code == GARJAN_ERR_SYNTHESIS_FAILED) { return "synthesis failed"; }
    if (code == GARJAN_ERR_COMPUTATION) { return "computation error"; }
    if (code == GARJAN_ERR_ALLOCATION) { return "allocation failed"; }
    return "unknown error";
}

# Allocate `size` bytes, or return GARJAN_ERR_ALLOCATION.
#
# The stdlib `alloc` reports exhaustion by returning 0 -- and 0 is GARJAN_OK,
# so `garjan_is_err(alloc(n))` is FALSE on failure. Every constructor in this
# crate writes through its allocation on the very next line, which turned an
# out-of-memory condition into a store to address 0 rather than a clean error.
# This wrapper maps that 0 onto a negative code, so the `if (garjan_is_err(p)
# == 1) { return p; }` idiom the constructors already use catches it.
#
# Deliberately does NOT log. error.cyr is the L0 module, and several test
# entries (aero, creature, rng, voice) include it WITHOUT logging.cyr; since
# cyrius 6.5.36 a *reachable* undefined function is a hard build error, so a
# garjan_log_error call here would break those builds.
#must_use
fn garjan_alloc(size) {
    var p = alloc(size);
    if (p == 0) { return GARJAN_ERR_ALLOCATION; }
    return p;
}

# 1 iff `id` falls outside the closed range [0, max_id] that a ported Rust enum
# occupies. Rust's enums made an out-of-range id UNREPRESENTABLE -- the type
# system rejected it at the call site. The port carries them as plain integers,
# so without this an invalid id falls through an if/elif chain's final `else`
# and silently selects the LAST variant's table: wrong material, wrong terrain,
# wrong intensity, no error. See ADR-0006.
#
# Deliberately does NOT log, for the same reason garjan_alloc does not:
# error.cyr is the L0 module and the aero/creature/rng/voice test entries
# include it WITHOUT logging.cyr, and a reachable undefined function is a hard
# build error since cyrius 6.5.36.
#must_use
fn garjan_enum_invalid(id, max_id) {
    if (id < 0) { return 1; }
    if (id > max_id) { return 1; }
    return 0;
}

# Finite test: 1 iff x is neither +/-inf nor NaN. abs(x) < +inf holds for
# every finite x, fails for infinities (inf < inf is false) and NaN (any
# NaN comparison is false). Mirrors Rust `f32::is_finite`.
#must_use
fn garjan_is_finite(x) {
    return f64_lt(f64_abs(x), GARJAN_POS_INF);
}

# Exact fraction num/den as f64 (readable constant idiom for cold-path config).
#must_use
fn garjan_frac(num, den) {
    return f64_div(f64_from(num), f64_from(den));
}

# --- logging.cyr ---

# logging.cyr -- structured logging, wired through sakshi.
#
# The Rust crate gated diagnostics behind the `logging` feature (tracing::
# warn!/error!). The Cyrius port wires them for real via sakshi (same pattern
# goonj/src/logging.cyr uses). Logging is always compiled in; verbosity is
# controlled at runtime with sakshi_set_level. These thin wrappers take a
# NUL-terminated cstring and forward (ptr, len) to sakshi. They are called
# for their side effect (not #must_use); each returns 0.
#
# Requires the sakshi bundle (auto-prepended via cyrius.cyml) + strlen (stdlib).

fn garjan_log_fatal(msg) { sakshi_fatal(msg, strlen(msg)); return 0; }
fn garjan_log_error(msg) { sakshi_error(msg, strlen(msg)); return 0; }
fn garjan_log_warn(msg)  { sakshi_warn(msg, strlen(msg));  return 0; }
fn garjan_log_info(msg)  { sakshi_info(msg, strlen(msg));  return 0; }
fn garjan_log_debug(msg) { sakshi_debug(msg, strlen(msg)); return 0; }

# --- dsp.cyr ---

# dsp.cyr -- shared DSP utilities: DC blocker + parameter validators.
#
# Ports rust-old/src/dsp.rs (DcBlocker + validate_duration/validate_sample_rate
# + map_naad_error). f32 -> f64 throughout. The Rust validators emitted a
# tracing::warn! behind the `logging` feature; the Cyrius port wires that for
# real via src/logging.cyr (garjan_log_warn). Result<()> -> GARJAN_OK / negative
# code. Requires: error.cyr (codes + garjan_is_finite), logging.cyr (warn/error).

# ================================================================
# DcBlocker -- one-pole highpass removing DC offset:
#   y[n] = x[n] - x[n-1] + R * y[n-1],  R ~ 10 Hz cutoff at any sample rate.
# Fields are TYPED for #derive(Serialize) (untyped f64 would serialize as its
# raw bit pattern and fail to roundtrip).
# ================================================================
#derive(accessors)
#derive(Serialize)
struct DcBlocker {
    x_prev: f64;
    y_prev: f64;
    r: f64;
}

# R = clamp(1 - TAU*10/sample_rate, 0.9, 0.9999).
#must_use
fn garjan_dcblocker_new(sample_rate) {
    var raw = f64_sub(F64_ONE, f64_div(f64_mul(F64_TAU, f64_from(10)), sample_rate));
    var r = f64_clamp(raw, 0x3FECCCCCCCCCCCCD, 0x3FEFFF2E48E8A71E);   # 0.9 .. 0.9999
    var self = garjan_alloc(sizeof(DcBlocker));
    if (garjan_is_err(self) == 1) { return self; }
    DcBlocker_set_x_prev(self, 0);
    DcBlocker_set_y_prev(self, 0);
    DcBlocker_set_r(self, r);
    return self;
}

# Process one sample, removing DC offset.
#inline
fn garjan_dcblocker_process(self, x) {
    var y = f64_add(f64_sub(x, DcBlocker_x_prev(self)), f64_mul(DcBlocker_r(self), DcBlocker_y_prev(self)));
    DcBlocker_set_x_prev(self, x);
    DcBlocker_set_y_prev(self, y);
    return y;
}

# ================================================================
# Validators -- GARJAN_OK if positive and finite, else log + ERR code.
# Port validate_duration / validate_sample_rate (Result<()> -> code).
# ================================================================
# ================================================================
# Upper bounds on caller-supplied size parameters.
#
# rust-old/src/dsp.rs validated duration and sample_rate as positive-and-finite
# ONLY, so these caps are a deliberate divergence from the oracle -- ADR-0007.
# Without them a positive, finite duration of 1e8 s sizes a 4.4-trillion-sample
# buffer and the process dies allocating it.
#
# The binding constraint is the SAMPLE COUNT, not either input alone: 600 s is
# fine at 44.1 kHz (26.5 M samples) and ruinous at 768 kHz (461 M). Chosen so
# the worst case stays inside ALLOC_MAX (2 GiB) even with the ~3x overhead the
# vec doubling costs -- 44.1 M samples is ~353 MB ideal, ~1.05 GB as built.
# Generous for real use; tighten freely.
# ================================================================
var GARJAN_MIN_SAMPLE_RATE_HZ = 1;          # below this is not audio
var GARJAN_MAX_SAMPLE_RATE_HZ = 768000;     # highest standard hi-res rate
var GARJAN_MAX_DURATION_S     = 600;        # 10 minutes per synthesize call
var GARJAN_MAX_SAMPLES        = 44100000;   # 1000 s at 44.1 kHz

#must_use
fn garjan_validate_duration(duration) {
    if (f64_le(duration, 0) == 1) {
        garjan_log_warn("garjan: invalid duration (must be positive and finite)");
        return GARJAN_ERR_INVALID_PARAMETER;
    }
    if (garjan_is_finite(duration) == 0) {
        garjan_log_warn("garjan: invalid duration (must be positive and finite)");
        return GARJAN_ERR_INVALID_PARAMETER;
    }
    if (f64_gt(duration, f64_from(GARJAN_MAX_DURATION_S)) == 1) {
        garjan_log_warn("garjan: duration exceeds GARJAN_MAX_DURATION_S");
        return GARJAN_ERR_INVALID_PARAMETER;
    }
    return GARJAN_OK;
}

#must_use
fn garjan_validate_sample_rate(sample_rate) {
    if (f64_le(sample_rate, 0) == 1) {
        garjan_log_warn("garjan: invalid sample_rate (must be positive and finite)");
        return GARJAN_ERR_INVALID_PARAMETER;
    }
    if (garjan_is_finite(sample_rate) == 0) {
        garjan_log_warn("garjan: invalid sample_rate (must be positive and finite)");
        return GARJAN_ERR_INVALID_PARAMETER;
    }
    if (f64_lt(sample_rate, f64_from(GARJAN_MIN_SAMPLE_RATE_HZ)) == 1) {
        garjan_log_warn("garjan: sample_rate below GARJAN_MIN_SAMPLE_RATE_HZ");
        return GARJAN_ERR_INVALID_PARAMETER;
    }
    if (f64_gt(sample_rate, f64_from(GARJAN_MAX_SAMPLE_RATE_HZ)) == 1) {
        garjan_log_warn("garjan: sample_rate above GARJAN_MAX_SAMPLE_RATE_HZ");
        return GARJAN_ERR_INVALID_PARAMETER;
    }
    return GARJAN_OK;
}

# Guard the buffer size a synthesize call is about to allocate. duration and
# sample_rate are each individually in range, but their PRODUCT is what gets
# allocated, so it needs its own bound.
#must_use
fn garjan_validate_sample_count(num) {
    if (num < 0) {
        garjan_log_warn("garjan: negative sample count");
        return GARJAN_ERR_INVALID_PARAMETER;
    }
    if (num > GARJAN_MAX_SAMPLES) {
        garjan_log_warn("garjan: sample count exceeds GARJAN_MAX_SAMPLES");
        return GARJAN_ERR_INVALID_PARAMETER;
    }
    return GARJAN_OK;
}

# ================================================================
# map_naad_error -- log a naad backend init failure and map it to a garjan
# error code. Ports dsp::map_naad_error. Call after a naad constructor:
#   var f = filter_biquad_new(...);
#   if (garjan_is_err(f) == 1) { return garjan_map_naad_error(f); }
# ================================================================
#must_use
fn garjan_map_naad_error(code) {
    if (garjan_is_err(code) == 1) {
        garjan_log_error("garjan: naad backend component init failed");
        return GARJAN_ERR_SYNTHESIS_FAILED;
    }
    return GARJAN_OK;
}

# ================================================================
# naad component state transfer (2.5.0).
#
# `*_build_naad` rebuilds naad's components from the stored scalars, which
# loses their LIVE state -- biquad delay memory, SVF integrators, LFO phase,
# noise-generator position. Rust derived Serialize over those fields, so a Rust
# save/restore resumed seamlessly; the port did not. See architecture note 001.
#
# Two implementation choices worth knowing before editing:
#
# 1. State is stored as raw i64 BIT PATTERNS via bayan_json_v_int, not as JSON
#    floats. In Cyrius an f64 *is* an i64 bit pattern, so this is exact by
#    construction -- no decimal formatting to lose. These values are opaque
#    machine state, never read by a human.
#
# 2. bayan's object API is ASYMMETRIC, deliberately (there is a banner in
#    lib/bayan.cyr): `bayan_json_v_obj_set` takes its key as a **Str**, while
#    `bayan_json_v_obj_get` takes a **cstring**. Passing a cstring to obj_set
#    builds a tree that SEGFAULTS when serialized. Use str_from() on set.
# ================================================================

# ---- BiquadFilter: z1/z2 delay memory (coefficients are re-derived) ----
#must_use
fn garjan_state_biquad(f) {
    var a = bayan_json_v_arr_new();
    bayan_json_v_arr_push(a, bayan_json_v_int_new(BiquadFilter_z1(f)));
    bayan_json_v_arr_push(a, bayan_json_v_int_new(BiquadFilter_z2(f)));
    return a;
}

fn garjan_state_biquad_load(f, n) {
    if (n == 0) { return 0; }
    if (bayan_json_v_arr_len(n) < 2) { return 0; }
    BiquadFilter_set_z1(f, bayan_json_v_int(bayan_json_v_arr_get(n, 0)));
    BiquadFilter_set_z2(f, bayan_json_v_int(bayan_json_v_arr_get(n, 1)));
    return 0;
}

# ---- StateVariableFilter: the two integrator states ----
#must_use
fn garjan_state_svf(f) {
    var a = bayan_json_v_arr_new();
    bayan_json_v_arr_push(a, bayan_json_v_int_new(StateVariableFilter_ic1eq(f)));
    bayan_json_v_arr_push(a, bayan_json_v_int_new(StateVariableFilter_ic2eq(f)));
    return a;
}

fn garjan_state_svf_load(f, n) {
    if (n == 0) { return 0; }
    if (bayan_json_v_arr_len(n) < 2) { return 0; }
    StateVariableFilter_set_ic1eq(f, bayan_json_v_int(bayan_json_v_arr_get(n, 0)));
    StateVariableFilter_set_ic2eq(f, bayan_json_v_int(bayan_json_v_arr_get(n, 1)));
    return 0;
}

# ---- Lfo: phase, sample-and-hold value, and its own rng state ----
#must_use
fn garjan_state_lfo(l) {
    var a = bayan_json_v_arr_new();
    bayan_json_v_arr_push(a, bayan_json_v_int_new(Lfo_phase(l)));
    bayan_json_v_arr_push(a, bayan_json_v_int_new(Lfo_sh_value(l)));
    bayan_json_v_arr_push(a, bayan_json_v_int_new(load64(Lfo_rng(l))));
    return a;
}

fn garjan_state_lfo_load(l, n) {
    if (n == 0) { return 0; }
    if (bayan_json_v_arr_len(n) < 3) { return 0; }
    Lfo_set_phase(l, bayan_json_v_int(bayan_json_v_arr_get(n, 0)));
    Lfo_set_sh_value(l, bayan_json_v_int(bayan_json_v_arr_get(n, 1)));
    store64(Lfo_rng(l), bayan_json_v_int(bayan_json_v_arr_get(n, 2)));
    return 0;
}

# ---- NoiseGenerator ----
# The xorshift32 state lives BEHIND the `rng` pointer, so it is load64/store64
# rather than an accessor. Which of the remaining fields matter depends on the
# generator's type -- white uses only the rng, brown adds brown_prev, pink adds
# the counter, running sum and all 16 octave values -- so the 16 octaves are
# emitted only for pink and the loader reads however many are present.
#must_use
fn garjan_state_noise(ng) {
    var a = bayan_json_v_arr_new();
    bayan_json_v_arr_push(a, bayan_json_v_int_new(load64(NoiseGenerator_rng(ng))));
    bayan_json_v_arr_push(a, bayan_json_v_int_new(NoiseGenerator_brown_prev(ng)));
    bayan_json_v_arr_push(a, bayan_json_v_int_new(NoiseGenerator_pink_counter(ng)));
    bayan_json_v_arr_push(a, bayan_json_v_int_new(NoiseGenerator_pink_running_sum(ng)));
    if (NoiseGenerator_noise_type(ng) == NOISE_PINK) {
        var oc = NoiseGenerator_pink_octaves(ng);
        var i = 0;
        while (i < vec_len(oc)) {
            bayan_json_v_arr_push(a, bayan_json_v_int_new(vec_get(oc, i)));
            i = i + 1;
        }
    }
    return a;
}

fn garjan_state_noise_load(ng, n) {
    if (n == 0) { return 0; }
    var len = bayan_json_v_arr_len(n);
    if (len < 4) { return 0; }
    store64(NoiseGenerator_rng(ng), bayan_json_v_int(bayan_json_v_arr_get(n, 0)));
    NoiseGenerator_set_brown_prev(ng, bayan_json_v_int(bayan_json_v_arr_get(n, 1)));
    NoiseGenerator_set_pink_counter(ng, bayan_json_v_int(bayan_json_v_arr_get(n, 2)));
    NoiseGenerator_set_pink_running_sum(ng, bayan_json_v_int(bayan_json_v_arr_get(n, 3)));
    var oc = NoiseGenerator_pink_octaves(ng);
    var i = 0;
    while (i + 4 < len) {
        if (i < vec_len(oc)) {
            vec_set(oc, i, bayan_json_v_int(bayan_json_v_arr_get(n, i + 4)));
        }
        i = i + 1;
    }
    return 0;
}

# ---- splice ----
# Emit a #derive(Serialize) params object with a "dsp" member added before its
# closing brace. The derive-generated parser IGNORES keys it does not know
# (verified), so `*Params_from_json_str` still reads the scalars out of the
# combined document and the value-tree parser reads "dsp" from the same string.
fn garjan_emit_with_dsp(sb, params_sb, dsp) {
    var s = str_builder_build(params_sb);
    str_builder_add(sb, str_from_buf(str_data(s), str_len(s) - 1));   # drop the '}'
    str_builder_add_cstr(sb, ",\"dsp\":");
    str_builder_add(sb, bayan_json_v_build(dsp));
    str_builder_add_cstr(sb, "}");
    return 0;
}

# Fetch the "dsp" object from a serialized synth, or 0 if absent (a document
# written before 2.5.0 simply restores without live state, as it used to).
#must_use
fn garjan_dsp_node(json) {
    var root = bayan_json_v_parse_buf(json, strlen(json));
    if (root == 0) { return 0; }
    return bayan_json_v_obj_get(root, "dsp");
}

# ---- ModalBank: the per-resonator state pair, interleaved re/im ----
# Length varies with how many modes survived construction (< 20 Hz, >= Nyquist
# and non-positive decay are excluded), so the loader writes only as many as the
# rebuilt bank actually has. `mb` may legitimately be 0 -- footstep and rolling
# leave it unset for non-resonant materials.
#must_use
fn garjan_state_modal(mb) {
    var a = bayan_json_v_arr_new();
    if (mb == 0) { return a; }
    var re = ModalBank_state_re(mb);
    var im = ModalBank_state_im(mb);
    var i = 0;
    while (i < vec_len(re)) {
        bayan_json_v_arr_push(a, bayan_json_v_int_new(vec_get(re, i)));
        bayan_json_v_arr_push(a, bayan_json_v_int_new(vec_get(im, i)));
        i = i + 1;
    }
    return a;
}

fn garjan_state_modal_load(mb, n) {
    if (mb == 0) { return 0; }
    if (n == 0) { return 0; }
    var re = ModalBank_state_re(mb);
    var im = ModalBank_state_im(mb);
    var cnt = bayan_json_v_arr_len(n) / 2;
    var i = 0;
    while (i < cnt) {
        if (i < vec_len(re)) {
            vec_set(re, i, bayan_json_v_int(bayan_json_v_arr_get(n, i * 2)));
            vec_set(im, i, bayan_json_v_int(bayan_json_v_arr_get(n, i * 2 + 1)));
        }
        i = i + 1;
    }
    return 0;
}

# ---- Exciter: playback position, active flag, and its Rng (a garjan Rng
# struct, not a bare xorshift word like the naad components use) ----
#must_use
fn garjan_state_exciter(ex) {
    var a = bayan_json_v_arr_new();
    if (ex == 0) { return a; }
    bayan_json_v_arr_push(a, bayan_json_v_int_new(Exciter_position(ex)));
    bayan_json_v_arr_push(a, bayan_json_v_int_new(Exciter_active(ex)));
    var r = Exciter_rng(ex);
    bayan_json_v_arr_push(a, bayan_json_v_int_new(Rng_state(r)));
    bayan_json_v_arr_push(a, bayan_json_v_int_new(Rng_inc(r)));
    return a;
}

fn garjan_state_exciter_load(ex, n) {
    if (ex == 0) { return 0; }
    if (n == 0) { return 0; }
    if (bayan_json_v_arr_len(n) < 4) { return 0; }
    Exciter_set_position(ex, bayan_json_v_int(bayan_json_v_arr_get(n, 0)));
    Exciter_set_active(ex, bayan_json_v_int(bayan_json_v_arr_get(n, 1)));
    var r = Exciter_rng(ex);
    Rng_set_state(r, bayan_json_v_int(bayan_json_v_arr_get(n, 2)));
    Rng_set_inc(r, bayan_json_v_int(bayan_json_v_arr_get(n, 3)));
    return 0;
}

# --- rng.cyr ---

# rng.cyr -- PCG32 PRNG for stochastic environmental synthesis.
#
# Ports rust-old/src/rng.rs (the `Rng` struct + next_u32/next_f32/
# next_f32_unsigned/next_f32_range/poisson). u64 state is held in i64 slots;
# Cyrius `>>` is a LOGICAL shift and bare `* + -` wrap at 64 bits (2's
# complement), so the PCG update ports directly with no masking gymnastics.
# f32 -> f64 for the float draws. Requires: error.cyr (nothing hard) + stdlib
# math (f64_clamp) / ganita is not needed (only exp, a builtin).
#
# Fields are TYPED i64 for #derive(Serialize). u64 states with the high bit
# set serialize as negative decimals but roundtrip bit-exactly via str_to_int.

var RNG_U32_MASK = 0xFFFFFFFF;
var RNG_PCG_MUL  = 6364136223846793005;   # PCG32 LCG multiplier
var RNG_POISSON_MAX = 0x403E000000000000;  # 30.0 (Knuth rate clamp)

#derive(accessors)
#derive(Serialize)
struct Rng {
    state: i64;
    inc: i64;
}

# Advance the generator, returning the next 32-bit output. Not #must_use:
# the PCG seeding path (rng_new) calls it purely to advance state.
#inline
fn rng_next_u32(self) {
    var old = Rng_state(self);
    Rng_set_state(self, (old * RNG_PCG_MUL) + Rng_inc(self));   # wraps at 64 bits
    var xor_shifted = (((old >> 18) ^ old) >> 27) & RNG_U32_MASK;
    var rot = (old >> 59) & 31;
    var neg_rot = (0 - rot) & 31;
    return ((xor_shifted >> rot) | (xor_shifted << neg_rot)) & RNG_U32_MASK;
}

# Seed the generator (PCG32 seeding: two warm-up draws around a state bump).
#must_use
fn rng_new(seed) {
    var self = garjan_alloc(sizeof(Rng));
    if (garjan_is_err(self) == 1) { return self; }
    rng_seed(self, seed);
    return self;
}

# Re-seed an EXISTING Rng in place, reproducing exactly the state rng_new(seed)
# would have produced. Factored out of rng_new so a caller can restart a
# sequence without allocating -- the arena never frees, so a hot path that
# wanted a fresh Rng per call had no way to ask for one cheaply. Any change
# here changes rng_new too, which is the point: one definition of the seeding
# sequence keeps them bit-identical.
fn rng_seed(self, seed) {
    Rng_set_state(self, 0);
    Rng_set_inc(self, (seed << 1) | 1);
    rng_next_u32(self);
    Rng_set_state(self, Rng_state(self) + seed);   # wrapping_add
    rng_next_u32(self);
    return 0;
}

# Value in [-1.0, 1.0]. bits = (next_u32 >> 1), scaled by 1/i32::MAX.
#inline
#must_use
fn rng_next_f32(self) {
    var bits = rng_next_u32(self) >> 1;                       # 0 .. 2^31-1
    return f64_mul(f64_from(bits), f64_div(F64_ONE, f64_from(2147483647)));
}

# Value in [0.0, 1.0): next_u32 * 1/u32::MAX.
#inline
#must_use
fn rng_next_f32_unsigned(self) {
    return f64_mul(f64_from(rng_next_u32(self)), f64_div(F64_ONE, f64_from(4294967295)));
}

# Value in [lo, hi): lo + (hi-lo) * unsigned.
#inline
#must_use
fn rng_next_f32_range(self, lo, hi) {
    return f64_add(lo, f64_mul(f64_sub(hi, lo), rng_next_f32_unsigned(self)));
}

# Poisson-distributed count (Knuth), rate clamped to [0, 30].
#must_use
fn rng_poisson(self, rate) {
    var r = f64_clamp(rate, 0, RNG_POISSON_MAX);
    var l = f64_exp(f64_neg(r));
    var k = 0;
    var p = F64_ONE;
    while (1 == 1) {
        k = k + 1;
        p = f64_mul(p, rng_next_f32_unsigned(self));
        if (f64_lt(p, l) == 1) { break; }
    }
    return k - 1;
}

# --- lod.cyr ---

# lod.cyr -- Level-of-Detail quality scaling.
#
# Ports rust-old/src/lod.rs (the `Quality` enum + mode_factor/event_factor/
# scale_modes/scale_rate). The enum becomes QUALITY_* int constants; a Quality
# value is a plain i64 and serializes trivially as a field of any serde struct.
# f32 -> f64. Standalone (no deps beyond stdlib math).

var QUALITY_FULL    = 0;   # all modes, all events, all filters
var QUALITY_REDUCED = 1;   # half modes, half events, simplified filtering
var QUALITY_MINIMAL = 2;   # quarter modes, quarter events, filter bypass

# Mode-count multiplier: 1.0 / 0.5 / 0.25.
#must_use
fn lod_mode_factor(q) {
    if (q == QUALITY_FULL) { return F64_ONE; }
    if (q == QUALITY_REDUCED) { return F64_HALF; }
    return f64_div(F64_ONE, f64_from(4));
}

# Stochastic event-rate multiplier: 1.0 / 0.5 / 0.25.
#must_use
fn lod_event_factor(q) {
    if (q == QUALITY_FULL) { return F64_ONE; }
    if (q == QUALITY_REDUCED) { return F64_HALF; }
    return f64_div(F64_ONE, f64_from(4));
}

# Scale a mode count by the quality factor, minimum 1.
#must_use
fn lod_scale_modes(q, count) {
    var scaled = f64_to(f64_mul(f64_from(count), lod_mode_factor(q)));
    if (scaled < 1) { return 1; }
    return scaled;
}

# Scale an event rate by the quality factor.
#must_use
fn lod_scale_rate(q, rate) {
    return f64_mul(rate, lod_event_factor(q));
}

# --- material.cyr ---

# material.cyr -- surface material acoustic properties.
#
# Ports rust-old/src/material.rs (Material enum + MaterialProperties +
# MaterialModeConfig + mode_config/properties). f32 -> f64. Structs are typed
# for #derive(Serialize). `pattern` is a MODE_PATTERN_* int (from modal.cyr).
# Requires: modal.cyr (MODE_PATTERN_* constants). Constants use f64_from /
# f64_div for readability.

# ---- Material ----
var MATERIAL_METAL   = 0;
var MATERIAL_WOOD    = 1;
var MATERIAL_STONE   = 2;
var MATERIAL_EARTH   = 3;
var MATERIAL_GLASS   = 4;
var MATERIAL_FABRIC  = 5;
var MATERIAL_LEAF    = 6;
var MATERIAL_WATER   = 7;
var MATERIAL_PLASTIC = 8;
var MATERIAL_CERAMIC = 9;

# ---- MaterialProperties (resonance Hz, bandwidth Hz, decay s, brightness 0-1, transient 0-1) ----
#derive(accessors)
#derive(Serialize)
struct MaterialProperties {
    resonance: f64;
    bandwidth: f64;
    decay: f64;
    brightness: f64;
    transient: f64;
}

#must_use
fn material_properties_new(resonance, bandwidth, decay, brightness, transient) {
    var p = garjan_alloc(sizeof(MaterialProperties));
    if (garjan_is_err(p) == 1) { return p; }
    MaterialProperties_set_resonance(p, resonance);
    MaterialProperties_set_bandwidth(p, bandwidth);
    MaterialProperties_set_decay(p, decay);
    MaterialProperties_set_brightness(p, brightness);
    MaterialProperties_set_transient(p, transient);
    return p;
}

# ---- MaterialModeConfig (pattern MODE_PATTERN_*, mode_count, damping_factor) ----
#derive(accessors)
#derive(Serialize)
struct MaterialModeConfig {
    pattern: i64;
    mode_count: i64;
    damping_factor: f64;
}

#must_use
fn material_mode_config_new(pattern, mode_count, damping_factor) {
    var c = garjan_alloc(sizeof(MaterialModeConfig));
    if (garjan_is_err(c) == 1) { return c; }
    MaterialModeConfig_set_pattern(c, pattern);
    MaterialModeConfig_set_mode_count(c, mode_count);
    MaterialModeConfig_set_damping_factor(c, damping_factor);
    return c;
}

# Modal synthesis configuration for a material.
#must_use
fn material_mode_config(m) {
    if (garjan_enum_invalid(m, MATERIAL_CERAMIC) == 1) { return GARJAN_ERR_INVALID_PARAMETER; }
    if (m == MATERIAL_METAL)   { return material_mode_config_new(MODE_PATTERN_PLATE,        12, garjan_frac(5, 100)); }
    if (m == MATERIAL_WOOD)    { return material_mode_config_new(MODE_PATTERN_BEAM,          8, garjan_frac(8, 10));  }
    if (m == MATERIAL_STONE)   { return material_mode_config_new(MODE_PATTERN_PLATE,         6, f64_from(3));         }
    if (m == MATERIAL_EARTH)   { return material_mode_config_new(MODE_PATTERN_DAMPED,        4, f64_from(10));        }
    if (m == MATERIAL_GLASS)   { return material_mode_config_new(MODE_PATTERN_PLATE,        10, garjan_frac(1, 10));  }
    if (m == MATERIAL_FABRIC)  { return material_mode_config_new(MODE_PATTERN_DAMPED,        3, f64_from(15));        }
    if (m == MATERIAL_LEAF)    { return material_mode_config_new(MODE_PATTERN_BEAM,          5, f64_from(5));         }
    if (m == MATERIAL_WATER)   { return material_mode_config_new(MODE_PATTERN_HARMONIC,      6, f64_from(2));         }
    if (m == MATERIAL_PLASTIC) { return material_mode_config_new(MODE_PATTERN_STIFF_STRING,  6, garjan_frac(15, 10)); }
    return material_mode_config_new(MODE_PATTERN_PLATE, 8, garjan_frac(3, 10));   # Ceramic
}

# Default acoustic properties for a material.
#must_use
fn material_properties(m) {
    if (garjan_enum_invalid(m, MATERIAL_CERAMIC) == 1) { return GARJAN_ERR_INVALID_PARAMETER; }
    if (m == MATERIAL_METAL)   { return material_properties_new(f64_from(2500), f64_from(200),  garjan_frac(15, 10),
          garjan_frac(9, 10),   garjan_frac(7, 10)); }
    if (m == MATERIAL_WOOD)    { return material_properties_new(f64_from(800),  f64_from(400),  garjan_frac(3, 10),
          garjan_frac(5, 10),   garjan_frac(6, 10)); }
    if (m == MATERIAL_STONE)   { return material_properties_new(f64_from(3000), f64_from(800),  garjan_frac(5, 100),
          garjan_frac(8, 10),   garjan_frac(9, 10)); }
    if (m == MATERIAL_EARTH)   { return material_properties_new(f64_from(200),  f64_from(300),  garjan_frac(2, 100),
          garjan_frac(1, 10),   garjan_frac(4, 10)); }
    if (m == MATERIAL_GLASS)   { return material_properties_new(f64_from(4000), f64_from(150),  garjan_frac(8, 10),
          garjan_frac(95, 100), F64_ONE); }
    if (m == MATERIAL_FABRIC)  { return material_properties_new(f64_from(300),  f64_from(500),  garjan_frac(1, 100),
          garjan_frac(1, 10),   garjan_frac(2, 10)); }
    if (m == MATERIAL_LEAF)    { return material_properties_new(f64_from(1500), f64_from(1000), garjan_frac(2, 100),
          garjan_frac(6, 10),   garjan_frac(5, 10)); }
    if (m == MATERIAL_WATER)   { return material_properties_new(f64_from(600),  f64_from(400),  garjan_frac(1, 10),
          garjan_frac(4, 10),   garjan_frac(3, 10)); }
    if (m == MATERIAL_PLASTIC) { return material_properties_new(f64_from(1800), f64_from(600),  garjan_frac(15, 100),
          garjan_frac(5, 10),   garjan_frac(6, 10)); }
    return material_properties_new(f64_from(1200), f64_from(300), garjan_frac(4, 10), garjan_frac(7, 10),
      garjan_frac(7, 10));   # Ceramic
}

# --- modal.cyr ---

# modal.cyr -- modal synthesis: a bank of damped complex resonators.
#
# Ports rust-old/src/modal.rs (ModeSpec, ModePattern, ModalBank [SoA],
# generate_modes, ExcitationType, Exciter). f32 -> f64. Result<Self> ->
# pointer / negative GARJAN_* code. Vec<f32> -> stdlib vec. enum-with-data
# ExcitationType -> EXCITATION_* int + a duration_samples field on Exciter.
# Requires: error.cyr (codes/is_finite), dsp.cyr (garjan_validate_sample_rate),
# rng.cyr (Rng), material.cyr (MaterialProperties, used by generate_modes).
# ModalBank/Exciter hold vec/pointer fields -> #derive(Serialize) can't express
# them; their JSON codecs are hand-rolled in the serde pass.

# ---- ModePattern ----
var MODE_PATTERN_HARMONIC     = 0;   # f_k = f0*k (strings, tubes)
var MODE_PATTERN_BEAM         = 1;   # free-free beam (wood, marimba)
var MODE_PATTERN_PLATE        = 2;   # f_k = f0*k^1.7 (metal, glass, ceramic)
var MODE_PATTERN_STIFF_STRING = 3;   # f0*k*sqrt(1 + B*k^2)
var MODE_PATTERN_DAMPED       = 4;   # all near f0 with small random spread

# ---- ModeSpec (frequency Hz, amplitude linear, decay T60 s) ----
#derive(accessors)
#derive(Serialize)
struct ModeSpec {
    frequency: f64;
    amplitude: f64;
    decay: f64;
}

#must_use
fn modal_modespec_new(frequency, amplitude, decay) {
    var s = garjan_alloc(sizeof(ModeSpec));
    if (garjan_is_err(s) == 1) { return s; }
    ModeSpec_set_frequency(s, frequency);
    ModeSpec_set_amplitude(s, amplitude);
    ModeSpec_set_decay(s, decay);
    return s;
}

# Free-free beam mode ratios (B_k/B_1)^2, k = 1..16. Values as num/1000.
#must_use
fn modal_beam_ratio(k) {
    if (k == 1)  { return F64_ONE; }
    if (k == 2)  { return f64_div(f64_from(2757),   f64_from(1000)); }
    if (k == 3)  { return f64_div(f64_from(5404),   f64_from(1000)); }
    if (k == 4)  { return f64_div(f64_from(8933),   f64_from(1000)); }
    if (k == 5)  { return f64_div(f64_from(13344),  f64_from(1000)); }
    if (k == 6)  { return f64_div(f64_from(18637),  f64_from(1000)); }
    if (k == 7)  { return f64_div(f64_from(24812),  f64_from(1000)); }
    if (k == 8)  { return f64_div(f64_from(31870),  f64_from(1000)); }
    if (k == 9)  { return f64_div(f64_from(39810),  f64_from(1000)); }
    if (k == 10) { return f64_div(f64_from(48632),  f64_from(1000)); }
    if (k == 11) { return f64_div(f64_from(58336),  f64_from(1000)); }
    if (k == 12) { return f64_div(f64_from(68922),  f64_from(1000)); }
    if (k == 13) { return f64_div(f64_from(80390),  f64_from(1000)); }
    if (k == 14) { return f64_div(f64_from(92741),  f64_from(1000)); }
    if (k == 15) { return f64_div(f64_from(105973), f64_from(1000)); }
    return f64_div(f64_from(120088), f64_from(1000));   # k == 16
}

# ---- ModalBank (SoA: 5 parallel vecs + sample_rate) ----
#derive(accessors)
struct ModalBank { state_re; state_im; coeff_re; coeff_im; amplitude; sample_rate; }

# Build from a vec of ModeSpec pointers. Excludes modes < 20 Hz, >= Nyquist,
# or with decay <= 0. Returns a pointer, or a negative code on bad sample_rate.
#must_use
fn modal_bank_new(specs, sample_rate) {
    var e = garjan_validate_sample_rate(sample_rate);
    if (garjan_is_err(e) == 1) { return e; }
    var nyquist = f64_mul(sample_rate, F64_HALF);
    var decay_floor = f64_div(f64_from(1), f64_from(1000));       # 0.001
    var neg6908 = f64_neg(f64_div(f64_from(6908), f64_from(1000)));  # -6.908
    var radius_cap = f64_div(f64_from(9999), f64_from(10000));    # 0.9999

    var state_re = vec_new();
    var state_im = vec_new();
    var coeff_re = vec_new();
    var coeff_im = vec_new();
    var amplitude = vec_new();

    var n = vec_len(specs);
    var i = 0;
    while (i < n) {
        var spec = vec_get(specs, i);
        var freq = ModeSpec_frequency(spec);
        var dec = ModeSpec_decay(spec);
        if (f64_ge(freq, f64_from(20)) == 1) {
            if (f64_lt(freq, nyquist) == 1) {
                if (f64_gt(dec, 0) == 1) {
                    var omega = f64_div(f64_mul(F64_TAU, freq), sample_rate);
                    var d = f64_max(dec, decay_floor);
                    var radius = f64_clamp(f64_exp(f64_div(neg6908, f64_mul(d, sample_rate))), 0, radius_cap);
                    vec_push(coeff_re, f64_mul(radius, f64_cos(omega)));
                    vec_push(coeff_im, f64_mul(radius, f64_sin(omega)));
                    vec_push(amplitude, ModeSpec_amplitude(spec));
                    vec_push(state_re, 0);
                    vec_push(state_im, 0);
                }
            }
        }
        i = i + 1;
    }

    var self = garjan_alloc(sizeof(ModalBank));
    if (garjan_is_err(self) == 1) { return self; }
    ModalBank_set_state_re(self, state_re);
    ModalBank_set_state_im(self, state_im);
    ModalBank_set_coeff_re(self, coeff_re);
    ModalBank_set_coeff_im(self, coeff_im);
    ModalBank_set_amplitude(self, amplitude);
    ModalBank_set_sample_rate(self, sample_rate);
    return self;
}

#inline
#must_use
fn modal_bank_mode_count(self) {
    return vec_len(ModalBank_amplitude(self));
}

# Process one excitation sample through all modes (SoA loop).
#inline
#must_use
fn modal_bank_process_sample(self, excitation) {
    var cre = ModalBank_coeff_re(self);
    var cim = ModalBank_coeff_im(self);
    var sre = ModalBank_state_re(self);
    var sim = ModalBank_state_im(self);
    var amp = ModalBank_amplitude(self);
    var n = vec_len(amp);
    var out = 0;
    var i = 0;
    while (i < n) {
        var cr = vec_get(cre, i);
        var ci = vec_get(cim, i);
        var xr = vec_get(sre, i);
        var xi = vec_get(sim, i);
        var new_re = f64_sub(f64_add(excitation, f64_mul(cr, xr)), f64_mul(ci, xi));
        var new_im = f64_add(f64_mul(ci, xr), f64_mul(cr, xi));
        vec_set(sre, i, new_re);
        vec_set(sim, i, new_im);
        out = f64_add(out, f64_mul(vec_get(amp, i), new_re));
        i = i + 1;
    }
    return out;
}

# Process a block: output[i] = process_sample(excitation[i]) for min(len) samples.
fn modal_bank_process_block(self, excitation, output) {
    var len = vec_len(excitation);
    var olen = vec_len(output);
    if (olen < len) { len = olen; }
    var i = 0;
    while (i < len) {
        vec_set(output, i, modal_bank_process_sample(self, vec_get(excitation, i)));
        i = i + 1;
    }
    return 0;
}

# Reset all mode states to zero.
fn modal_bank_reset(self) {
    var sre = ModalBank_state_re(self);
    var sim = ModalBank_state_im(self);
    var n = vec_len(sre);
    var i = 0;
    while (i < n) {
        vec_set(sre, i, 0);
        vec_set(sim, i, 0);
        i = i + 1;
    }
    return 0;
}

# ---- Mode generation ----
# Generates a vec of ModeSpec pointers for a material's properties + pattern.
#must_use
fn generate_modes(props, pattern, count, damping_factor) {
    var f0 = MaterialProperties_resonance(props);
    var brightness = MaterialProperties_brightness(props);
    var pdecay = MaterialProperties_decay(props);
    # rolloff_exp = 2.0 - 1.5 * brightness
    var rolloff_exp = f64_sub(f64_from(2), f64_mul(f64_div(f64_from(15), f64_from(10)), brightness));
    var rng = rng_new(f64_to(f64_mul(f0, f64_from(1000))));
    if (garjan_is_err(rng) == 1) { return rng; }

    var half = F64_HALF;
    var c1_5056 = f64_div(f64_from(15056), f64_from(10000));
    var plate_exp = f64_div(f64_from(17), f64_from(10));       # 1.7
    var stiff_b = f64_div(f64_from(1), f64_from(1000));        # 0.001
    var damp_span = f64_div(f64_from(1), f64_from(10));        # 0.1
    var decay_floor = stiff_b;                                 # 0.001
    var freq_cap = f64_from(20000);

    var out = vec_new();
    var k = 1;
    while (k <= count) {
        var kf = f64_from(k);
        var freq = 0;
        if (pattern == MODE_PATTERN_HARMONIC) {
            freq = f64_mul(f0, kf);
        } elif (pattern == MODE_PATTERN_BEAM) {
            if (k <= 16) {
                freq = f64_mul(f0, modal_beam_ratio(k));
            } else {
                var kfp = f64_add(kf, half);
                freq = f64_div(f64_mul(f0, f64_mul(kfp, kfp)), f64_mul(c1_5056, c1_5056));
            }
        } elif (pattern == MODE_PATTERN_PLATE) {
            freq = f64_mul(f0, f64_pow(kf, plate_exp));
        } elif (pattern == MODE_PATTERN_STIFF_STRING) {
            var inner = f64_add(F64_ONE, f64_mul(stiff_b, f64_mul(kf, kf)));
            freq = f64_mul(f0, f64_mul(kf, f64_sqrt(inner)));
        } else {
            # Damped: f0 * (1 + range(-0.1, 0.1))
            freq = f64_mul(f0, f64_add(F64_ONE, rng_next_f32_range(rng, f64_neg(damp_span), damp_span)));
        }

        if (f64_gt(freq, freq_cap) == 1) {
            k = k + 1;
            continue;
        }

        var amplitude = f64_div(F64_ONE, f64_pow(kf, rolloff_exp));
        var freq_ratio = f64_div(freq, f0);
        var fm1 = f64_sub(freq_ratio, F64_ONE);
        var decay = f64_div(pdecay, f64_add(F64_ONE, f64_mul(damping_factor, f64_mul(fm1, fm1))));
        decay = f64_max(decay, decay_floor);
        var ga_spec1 = modal_modespec_new(freq, amplitude, decay);
        if (garjan_is_err(ga_spec1) == 1) { return ga_spec1; }
        vec_push(out, ga_spec1);
        k = k + 1;
    }
    return out;
}

# ---- ExcitationType (data-carrying variant duration lives on Exciter) ----
# Seed for every Exciter's internal Rng. Shared by exciter_new and
# exciter_reset so the two produce identical excitation sequences.
var EXCITER_RNG_SEED = 31337;

var EXCITATION_IMPULSE    = 0;
var EXCITATION_NOISE_BURST = 1;
var EXCITATION_HALF_SINE  = 2;

# ---- Exciter (drives a modal bank). rng is a live pointer; serde hand-rolled. ----
#derive(accessors)
struct Exciter { excitation_type; duration_samples; amplitude; position; active; rng; }

#must_use
fn exciter_new(excitation_type, duration_samples, amplitude) {
    var self = garjan_alloc(sizeof(Exciter));
    if (garjan_is_err(self) == 1) { return self; }
    Exciter_set_excitation_type(self, excitation_type);
    Exciter_set_duration_samples(self, duration_samples);
    Exciter_set_amplitude(self, amplitude);
    Exciter_set_position(self, 0);
    Exciter_set_active(self, 0);
    var ga_rng2 = rng_new(EXCITER_RNG_SEED);
    if (garjan_is_err(ga_rng2) == 1) { return ga_rng2; }
    Exciter_set_rng(self, ga_rng2);
    return self;
}

# Reconfigure an existing Exciter in place and restart it: exactly equivalent
# to exciter_new(type, dur, amp) followed by exciter_trigger, minus the two
# allocations (Exciter + its Rng). The rng is re-seeded to EXCITER_RNG_SEED so
# the excitation sequence is bit-identical to a freshly built exciter's --
# callers in a per-block path use this instead of building a new one, because
# the arena never frees.
fn exciter_reset(self, excitation_type, duration_samples, amplitude) {
    Exciter_set_excitation_type(self, excitation_type);
    Exciter_set_duration_samples(self, duration_samples);
    Exciter_set_amplitude(self, amplitude);
    rng_seed(Exciter_rng(self), EXCITER_RNG_SEED);
    Exciter_set_position(self, 0);
    Exciter_set_active(self, 1);
    return 0;
}

# Trigger: restart excitation from the beginning.
fn exciter_trigger(self) {
    Exciter_set_position(self, 0);
    Exciter_set_active(self, 1);
    return 0;
}

# Next excitation sample; 0.0 when spent.
#inline
#must_use
fn exciter_next_sample(self) {
    if (Exciter_active(self) == 0) { return 0; }
    var ty = Exciter_excitation_type(self);
    var pos = Exciter_position(self);
    var amp = Exciter_amplitude(self);
    var dur = Exciter_duration_samples(self);
    var sample = 0;
    if (ty == EXCITATION_IMPULSE) {
        if (pos == 0) {
            Exciter_set_active(self, 0);
            sample = amp;
        } else {
            sample = 0;
        }
    } elif (ty == EXCITATION_NOISE_BURST) {
        if (pos < dur) {
            sample = f64_mul(amp, rng_next_f32(Exciter_rng(self)));
        } else {
            Exciter_set_active(self, 0);
            sample = 0;
        }
    } else {
        # HalfSine
        if (pos < dur) {
            var t = f64_div(f64_from(pos), f64_from(dur));
            sample = f64_mul(amp, f64_sin(f64_mul(F64_PI, t)));
        } else {
            Exciter_set_active(self, 0);
            sample = 0;
        }
    }
    Exciter_set_position(self, pos + 1);
    return sample;
}

#inline
#must_use
fn exciter_is_active(self) {
    return Exciter_active(self);
}

# --- contact.cyr ---

# contact.cyr -- shared types for contact/surface synthesis (footstep,
# friction, rolling, foliage, creak).
#
# Ports rust-old/src/contact.rs (Terrain, MovementType, FrictionType,
# RollingBody, FoliageType, CreakSource enums + NoisePreference +
# TerrainNoiseConfig + config accessors). f32 -> f64. Option<Material> ->
# MATERIAL_* const or CONTACT_NO_MATERIAL (-1). CONTACT_NOISE_* deliberately
# share naad's NOISE_WHITE/PINK/BROWN values (0/1/2) so a synth can pass them
# straight to noise_new. Requires: material.cyr (MATERIAL_* constants).

var CONTACT_NO_MATERIAL = (0 - 1);   # Option<Material>::None

# ---- NoisePreference (maps 1:1 to naad NOISE_WHITE/PINK/BROWN) ----
var CONTACT_NOISE_WHITE = 0;
var CONTACT_NOISE_PINK  = 1;
var CONTACT_NOISE_BROWN = 2;

# ---- Terrain ----
var TERRAIN_GRAVEL = 0;
var TERRAIN_SAND   = 1;
var TERRAIN_MUD    = 2;
var TERRAIN_SNOW   = 3;
var TERRAIN_WOOD   = 4;
var TERRAIN_METAL  = 5;
var TERRAIN_TILE   = 6;
var TERRAIN_WET    = 7;

# Material for modal resonance, or CONTACT_NO_MATERIAL if the terrain is inert.
#must_use
fn terrain_resonant_material(t) {
    if (t == TERRAIN_WOOD)  { return MATERIAL_WOOD; }
    if (t == TERRAIN_METAL) { return MATERIAL_METAL; }
    if (t == TERRAIN_TILE)  { return MATERIAL_CERAMIC; }
    if (t == TERRAIN_WET)   { return MATERIAL_CERAMIC; }
    return CONTACT_NO_MATERIAL;
}

# TerrainNoiseConfig (transient; noise_type CONTACT_NOISE_*, filter_freq Hz,
# filter_q, highpass 0/1, amplitude). No serde (internal helper type).
#derive(accessors)
struct TerrainNoiseConfig { noise_type; filter_freq; filter_q; highpass; amplitude; }

#must_use
fn terrain_noise_config(t) {
    if (garjan_enum_invalid(t, TERRAIN_WET) == 1) { return GARJAN_ERR_INVALID_PARAMETER; }
    var c = garjan_alloc(sizeof(TerrainNoiseConfig));
    if (garjan_is_err(c) == 1) { return c; }
    if (t == TERRAIN_GRAVEL) {
        TerrainNoiseConfig_set_noise_type(c, CONTACT_NOISE_PINK);
        TerrainNoiseConfig_set_filter_freq(c, f64_from(1500));
        TerrainNoiseConfig_set_filter_q(c, F64_ONE);
        TerrainNoiseConfig_set_highpass(c, 1);
        TerrainNoiseConfig_set_amplitude(c, f64_div(f64_from(4), f64_from(10)));
    } elif (t == TERRAIN_SAND) {
        TerrainNoiseConfig_set_noise_type(c, CONTACT_NOISE_BROWN);
        TerrainNoiseConfig_set_filter_freq(c, f64_from(2000));
        TerrainNoiseConfig_set_filter_q(c, f64_div(f64_from(7), f64_from(10)));
        TerrainNoiseConfig_set_highpass(c, 0);
        TerrainNoiseConfig_set_amplitude(c, f64_div(f64_from(2), f64_from(10)));
    } elif (t == TERRAIN_MUD) {
        TerrainNoiseConfig_set_noise_type(c, CONTACT_NOISE_BROWN);
        TerrainNoiseConfig_set_filter_freq(c, f64_from(800));
        TerrainNoiseConfig_set_filter_q(c, F64_ONE);
        TerrainNoiseConfig_set_highpass(c, 0);
        TerrainNoiseConfig_set_amplitude(c, f64_div(f64_from(3), f64_from(10)));
    } elif (t == TERRAIN_SNOW) {
        TerrainNoiseConfig_set_noise_type(c, CONTACT_NOISE_WHITE);
        TerrainNoiseConfig_set_filter_freq(c, f64_from(4000));
        TerrainNoiseConfig_set_filter_q(c, F64_HALF);
        TerrainNoiseConfig_set_highpass(c, 0);
        TerrainNoiseConfig_set_amplitude(c, f64_div(f64_from(1), f64_from(10)));
    } elif (t == TERRAIN_WOOD) {
        TerrainNoiseConfig_set_noise_type(c, CONTACT_NOISE_PINK);
        TerrainNoiseConfig_set_filter_freq(c, f64_from(1000));
        TerrainNoiseConfig_set_filter_q(c, f64_div(f64_from(15), f64_from(10)));
        TerrainNoiseConfig_set_highpass(c, 0);
        TerrainNoiseConfig_set_amplitude(c, f64_div(f64_from(15), f64_from(100)));
    } elif (t == TERRAIN_METAL) {
        TerrainNoiseConfig_set_noise_type(c, CONTACT_NOISE_WHITE);
        TerrainNoiseConfig_set_filter_freq(c, f64_from(3000));
        TerrainNoiseConfig_set_filter_q(c, f64_from(2));
        TerrainNoiseConfig_set_highpass(c, 1);
        TerrainNoiseConfig_set_amplitude(c, f64_div(f64_from(2), f64_from(10)));
    } elif (t == TERRAIN_TILE) {
        TerrainNoiseConfig_set_noise_type(c, CONTACT_NOISE_WHITE);
        TerrainNoiseConfig_set_filter_freq(c, f64_from(2500));
        TerrainNoiseConfig_set_filter_q(c, f64_div(f64_from(15), f64_from(10)));
        TerrainNoiseConfig_set_highpass(c, 0);
        TerrainNoiseConfig_set_amplitude(c, f64_div(f64_from(25), f64_from(100)));
    } else {
        # Wet
        TerrainNoiseConfig_set_noise_type(c, CONTACT_NOISE_WHITE);
        TerrainNoiseConfig_set_filter_freq(c, f64_from(3500));
        TerrainNoiseConfig_set_filter_q(c, F64_ONE);
        TerrainNoiseConfig_set_highpass(c, 0);
        TerrainNoiseConfig_set_amplitude(c, f64_div(f64_from(3), f64_from(10)));
    }
    return c;
}

# ---- MovementType ----
var MOVEMENT_WALK      = 0;
var MOVEMENT_RUN       = 1;
var MOVEMENT_SNEAK     = 2;
var MOVEMENT_JUMP_LAND = 3;

# config (step_interval_s, force, excitation_duration_s). step_interval 0 = one-shot.
#derive(accessors)
struct MovementConfig { step_interval; force; excitation_duration; }

#must_use
fn movement_config(m) {
    if (garjan_enum_invalid(m, MOVEMENT_JUMP_LAND) == 1) { return GARJAN_ERR_INVALID_PARAMETER; }
    var c = garjan_alloc(sizeof(MovementConfig));
    if (garjan_is_err(c) == 1) { return c; }
    if (m == MOVEMENT_WALK) {
        MovementConfig_set_step_interval(c, F64_HALF);
        MovementConfig_set_force(c, F64_HALF);
        MovementConfig_set_excitation_duration(c, f64_div(f64_from(4), f64_from(1000)));    # 0.004
    } elif (m == MOVEMENT_RUN) {
        MovementConfig_set_step_interval(c, f64_div(f64_from(3), f64_from(10)));            # 0.3
        MovementConfig_set_force(c, f64_div(f64_from(7), f64_from(10)));                    # 0.7
        MovementConfig_set_excitation_duration(c, f64_div(f64_from(25), f64_from(10000)));  # 0.0025
    } elif (m == MOVEMENT_SNEAK) {
        MovementConfig_set_step_interval(c, f64_div(f64_from(7), f64_from(10)));            # 0.7
        MovementConfig_set_force(c, f64_div(f64_from(15), f64_from(100)));                  # 0.15
        MovementConfig_set_excitation_duration(c, f64_div(f64_from(10), f64_from(1000)));   # 0.010
    } else {
        # JumpLand (0.0 interval = one-shot)
        MovementConfig_set_step_interval(c, 0);
        MovementConfig_set_force(c, F64_ONE);
        MovementConfig_set_excitation_duration(c, f64_div(f64_from(15), f64_from(10000)));  # 0.0015
    }
    return c;
}

