        BubbleConfig_set_freq_spread(c, f64_from(300));
        BubbleConfig_set_decay(c, f64_div(f64_from(3), f64_from(100)));         # 0.03
    } elif (ty == BUBBLE_BOILING) {
        BubbleConfig_set_base_freq(c, f64_from(800));
        BubbleConfig_set_event_rate(c, f64_from(30));
        BubbleConfig_set_freq_spread(c, f64_from(600));
        BubbleConfig_set_decay(c, f64_div(f64_from(1), f64_from(100)));         # 0.01
    } elif (ty == BUBBLE_VISCOUS) {
        BubbleConfig_set_base_freq(c, f64_from(150));
        BubbleConfig_set_event_rate(c, f64_from(2));
        BubbleConfig_set_freq_spread(c, f64_from(100));
        BubbleConfig_set_decay(c, f64_div(f64_from(8), f64_from(100)));         # 0.08
    } else {
        # Pouring
        BubbleConfig_set_base_freq(c, f64_from(600));
        BubbleConfig_set_event_rate(c, f64_from(40));
        BubbleConfig_set_freq_spread(c, f64_from(400));
        BubbleConfig_set_decay(c, f64_div(f64_from(5), f64_from(1000)));        # 0.005
    }
    return c;
}

# --- voice.cyr ---

# voice.cyr -- priority-based polyphony with voice stealing.
#
# Ports rust-old/src/voice.rs (StealPolicy, VoiceSlot, VoicePool). f32/int
# types -> f64/i64. Option<usize> (allocate) -> VOICE_NONE (-1) sentinel.
# VoiceSlot derives Serialize (all-scalar). VoicePool holds a Vec<VoiceSlot>,
# which #derive(Serialize) cannot express -- its JSON codec is hand-rolled in
# the serde test pass. Standalone (stdlib alloc/vec only).

var VOICE_NONE = (0 - 1);   # Option<usize>::None

# ---- StealPolicy (order matches Rust: Oldest, LowestPriority, None) ----
var STEAL_OLDEST          = 0;
var STEAL_LOWEST_PRIORITY = 1;
var STEAL_NONE            = 2;

# VoiceSlot -- all scalar, typed for #derive(Serialize).
#   active: 0/1;  priority: 0..255 (higher = harder to steal);
#   age: ticks since activation;  tag: user-defined sound id.
#derive(accessors)
#derive(Serialize)
struct VoiceSlot {
    active: i64;
    priority: i64;
    age: i64;
    tag: i64;
}

#must_use
fn voice_slot_new() {
    var s = garjan_alloc(sizeof(VoiceSlot));
    if (garjan_is_err(s) == 1) { return s; }
    VoiceSlot_set_active(s, 0);
    VoiceSlot_set_priority(s, 0);
    VoiceSlot_set_age(s, 0);
    VoiceSlot_set_tag(s, 0);
    return s;
}

# VoicePool -- fixed pool of slots + steal policy.
#derive(accessors)
struct VoicePool { slots; steal_policy; max_voices; }

#must_use
fn voice_pool_new(max_voices_arg, steal_policy) {
    if (garjan_enum_invalid(steal_policy, STEAL_NONE) == 1) { return GARJAN_ERR_INVALID_PARAMETER; }
    var max_voices = max_voices_arg;
    if (max_voices < 1) { max_voices = 1; }
    var slots = vec_new();
    var i = 0;
    while (i < max_voices) {
        var ga_slot1 = voice_slot_new();
        if (garjan_is_err(ga_slot1) == 1) { return ga_slot1; }
        vec_push(slots, ga_slot1);
        i = i + 1;
    }
    var p = garjan_alloc(sizeof(VoicePool));
    if (garjan_is_err(p) == 1) { return p; }
    VoicePool_set_slots(p, slots);
    VoicePool_set_steal_policy(p, steal_policy);
    VoicePool_set_max_voices(p, max_voices);
    return p;
}

#inline
#must_use
fn voice_pool_max_voices(p) { return VoicePool_max_voices(p); }

#must_use
fn voice_pool_active_count(p) {
    var slots = VoicePool_slots(p);
    var n = vec_len(slots);
    var count = 0;
    var i = 0;
    while (i < n) {
        if (VoiceSlot_active(vec_get(slots, i)) == 1) { count = count + 1; }
        i = i + 1;
    }
    return count;
}

# Internal: overwrite slot `idx` with a fresh active voice.
fn _voice_pool_assign(p, idx, priority, tag) {
    var s = vec_get(VoicePool_slots(p), idx);
    VoiceSlot_set_active(s, 1);
    VoiceSlot_set_priority(s, priority);
    VoiceSlot_set_age(s, 0);
    VoiceSlot_set_tag(s, tag);
    return 0;
}

# Allocate a voice. Returns a slot index, or VOICE_NONE if the pool is full
# and cannot steal. Ports VoicePool::allocate (Option<usize>).
#must_use
fn voice_pool_allocate(p, priority, tag) {
    var slots = VoicePool_slots(p);
    var n = vec_len(slots);

    # First: an inactive slot (position() -> first match).
    var i = 0;
    while (i < n) {
        if (VoiceSlot_active(vec_get(slots, i)) == 0) {
            _voice_pool_assign(p, i, priority, tag);
            return i;
        }
        i = i + 1;
    }

    # Full -- steal per policy.
    var mode = VoicePool_steal_policy(p);
    if (mode == STEAL_NONE) { return VOICE_NONE; }

    if (mode == STEAL_OLDEST) {
        # max_by_key(age): LAST maximum on ties -> use >=.
        var best = 0;
        var best_age = VoiceSlot_age(vec_get(slots, 0));
        i = 1;
        while (i < n) {
            var a = VoiceSlot_age(vec_get(slots, i));
            if (a >= best_age) { best = i; best_age = a; }
            i = i + 1;
        }
        _voice_pool_assign(p, best, priority, tag);
        return best;
    }

    # STEAL_LOWEST_PRIORITY: min_by(priority asc, then age desc), FIRST on tie.
    var best = 0;
    var best_pri = VoiceSlot_priority(vec_get(slots, 0));
    var best_age = VoiceSlot_age(vec_get(slots, 0));
    i = 1;
    while (i < n) {
        var s = vec_get(slots, i);
        var pri = VoiceSlot_priority(s);
        var age = VoiceSlot_age(s);
        var better = 0;
        if (pri < best_pri) { better = 1; }
        elif (pri == best_pri) { if (age > best_age) { better = 1; } }
        if (better == 1) { best = i; best_pri = pri; best_age = age; }
        i = i + 1;
    }
    # Only steal if the new voice is at least as important.
    if (priority >= best_pri) {
        _voice_pool_assign(p, best, priority, tag);
        return best;
    }
    return VOICE_NONE;
}

# Release a voice slot (bounds-checked; no-op if out of range).
fn voice_pool_release(p, index) {
    var slots = VoicePool_slots(p);
    if (index < 0) { return 0; }
    if (index >= vec_len(slots)) { return 0; }
    var s = vec_get(slots, index);
    VoiceSlot_set_active(s, 0);
    VoiceSlot_set_age(s, 0);
    return 0;
}

# Advance age for all active voices (call once per audio block).
fn voice_pool_tick(p) {
    var slots = VoicePool_slots(p);
    var n = vec_len(slots);
    var i = 0;
    while (i < n) {
        var s = vec_get(slots, i);
        if (VoiceSlot_active(s) == 1) { VoiceSlot_set_age(s, VoiceSlot_age(s) + 1); }
        i = i + 1;
    }
    return 0;
}

# Slot pointer at index, or 0 (None) if out of range.
#must_use
fn voice_pool_slot(p, index) {
    var slots = VoicePool_slots(p);
    if (index < 0) { return 0; }
    if (index >= vec_len(slots)) { return 0; }
    return vec_get(slots, index);
}

# Release all voices.
fn voice_pool_release_all(p) {
    var slots = VoicePool_slots(p);
    var n = vec_len(slots);
    var i = 0;
    while (i < n) {
        var s = vec_get(slots, i);
        VoiceSlot_set_active(s, 0);
        VoiceSlot_set_age(s, 0);
        i = i + 1;
    }
    return 0;
}

# ---- serde (hand-rolled: VoicePool holds a Vec<VoiceSlot>, which
# #derive(Serialize) can't express). Emits {steal_policy, max_voices,
# slots:[VoiceSlot...]} reusing the derived VoiceSlot codec; parses back with
# bayan. Roundtrip is idempotent because both to_json paths share this fn. ----
fn voice_pool_to_json(p, sb) {
    var slots = VoicePool_slots(p);
    var n = vec_len(slots);
    str_builder_add_cstr(sb, "{\"steal_policy\":");
    str_builder_add_int(sb, VoicePool_steal_policy(p));
    str_builder_add_cstr(sb, ",\"max_voices\":");
    str_builder_add_int(sb, VoicePool_max_voices(p));
    str_builder_add_cstr(sb, ",\"slots\":[");
    var i = 0;
    while (i < n) {
        if (i > 0) { str_builder_add_cstr(sb, ","); }
        VoiceSlot_to_json(vec_get(slots, i), sb);
        i = i + 1;
    }
    str_builder_add_cstr(sb, "]}");
    return 0;
}

# Uses the nesting-capable value-tree parser (bayan_json_v_parse_buf) since
# the object has a nested slots array; v_obj_get keys are plain cstrings.
#must_use
fn voice_pool_from_json_str(json) {
    var root = bayan_json_v_parse_buf(json, strlen(json));
    var sp = bayan_json_v_int(bayan_json_v_obj_get(root, "steal_policy"));
    var mv = bayan_json_v_int(bayan_json_v_obj_get(root, "max_voices"));
    var slots_val = bayan_json_v_obj_get(root, "slots");
    var n = bayan_json_v_arr_len(slots_val);
    # The pool is sized from the `slots` ARRAY, never from the `max_voices`
    # scalar. Rust derives Deserialize on `slots: Vec<VoiceSlot>`, so serde
    # allocates exactly as many slots as the array carries and never calls
    # VoicePool::new -- for a well-formed round-trip the two agree, so this
    # clamp is a no-op there. It is not a no-op for a hostile document:
    # `{"max_voices":2000000000,"slots":[]}` is ~40 bytes and used to drive
    # voice_pool_new's push loop two billion times, one VoiceSlot alloc per
    # iteration, against a bump allocator that never frees.
    if (mv > n) { mv = n; }
    var p = voice_pool_new(mv, sp);
    var dst = VoicePool_slots(p);
    var cap = vec_len(dst);
    var i = 0;
    while (i < n) {
        if (i < cap) {
            var elem = bayan_json_v_arr_get(slots_val, i);
            var s = vec_get(dst, i);
            VoiceSlot_set_active(s, bayan_json_v_int(bayan_json_v_obj_get(elem, "active")));
            VoiceSlot_set_priority(s, bayan_json_v_int(bayan_json_v_obj_get(elem, "priority")));
            VoiceSlot_set_age(s, bayan_json_v_int(bayan_json_v_obj_get(elem, "age")));
            VoiceSlot_set_tag(s, bayan_json_v_int(bayan_json_v_obj_get(elem, "tag")));
        }
        i = i + 1;
    }
    return p;
}

# --- fire.cyr ---

# fire.cyr -- fire synthesis: roar (brown noise LP) + stochastic crackle (HP).
#
# Ports rust-old/src/fire.rs. The Cyrius port always uses the naad backend
# (no feature flags), so it ports process_block_naad and drops the fallback.
# f32 -> f64. Result<Self> -> pointer / negative GARJAN_* code. The Rust
# naad components are reconstructed on deserialize rather than restored, which
# is a divergence from Rust (architecture note 001); rng + dc_blocker state ARE
# serialized (via the flattened FireParams below).
# Requires: error, logging, dsp, rng foundations + the naad bundle
# (noise_new/noise_next_sample, filter_biquad_new/filter_biquad_process_sample).

# ---- FireParams: the serializable slice (the scalar fields only,
# with rng + dc_blocker FLATTENED so #derive(Serialize)'s fast single-pass
# from_json_str works). Synced to/from the live Fire on (de)serialize. ----
#derive(accessors)
#derive(Serialize)
struct FireParams {
    intensity: f64;
    crackle_rate: f64;
    sample_rate: f64;
    sample_position: i64;
    rng_state: i64;
    rng_inc: i64;
    dcb_x_prev: f64;
    dcb_y_prev: f64;
    dcb_r: f64;
}

# ---- Fire: live synth = scalars + live rng/dc_blocker + naad component ptrs. ----
#derive(accessors)
struct Fire {
    intensity;
    crackle_rate;
    sample_rate;
    sample_position;
    rng;
    dc_blocker;
    roar_noise;
    roar_filter;
    crackle_noise;
    crackle_filter;
}

# Build/refresh the naad components from sample_rate. Shared by fire_new and
# fire_from_json_str (mirrors naad_binaural_rebuild). Returns GARJAN_OK or a
# negative code if a naad constructor rejects its params.
fn fire_build_naad(self) {
    var sr = Fire_sample_rate(self);
    var rf = filter_biquad_new(NAAD_FILTER_LOWPASS, sr, f64_from(600), f64_div(f64_from(7), f64_from(10)));
    if (garjan_is_err(rf) == 1) { return garjan_map_naad_error(rf); }
    var cf = filter_biquad_new(NAAD_FILTER_HIGHPASS, sr, f64_from(2000), F64_ONE);
    if (garjan_is_err(cf) == 1) { return garjan_map_naad_error(cf); }
    Fire_set_roar_filter(self, rf);
    Fire_set_crackle_filter(self, cf);
    Fire_set_roar_noise(self, noise_new(NOISE_BROWN, 6661));
    Fire_set_crackle_noise(self, noise_new(NOISE_WHITE, 6662));
    return GARJAN_OK;
}

# Creates a new fire synthesizer. Returns a pointer or a negative code.
#must_use
fn fire_new(intensity, sample_rate) {
    var e = garjan_validate_sample_rate(sample_rate);
    if (garjan_is_err(e) == 1) { return e; }
    var inten = f64_clamp(intensity, 0, F64_ONE);

    var self = garjan_alloc(sizeof(Fire));
    if (garjan_is_err(self) == 1) { return self; }
    Fire_set_intensity(self, inten);
    # crackle_rate = 5.0 + intensity * 30.0
    Fire_set_crackle_rate(self, f64_add(f64_from(5), f64_mul(inten, f64_from(30))));
    Fire_set_sample_rate(self, sample_rate);
    Fire_set_sample_position(self, 0);
    var ga_rng1 = rng_new(6661);
    if (garjan_is_err(ga_rng1) == 1) { return ga_rng1; }
    Fire_set_rng(self, ga_rng1);
    var ga_dcb2 = garjan_dcblocker_new(sample_rate);
    if (garjan_is_err(ga_dcb2) == 1) { return ga_dcb2; }
    Fire_set_dc_blocker(self, ga_dcb2);
    var b = fire_build_naad(self);
    if (garjan_is_err(b) == 1) { return b; }
    return self;
}

# Fills `output` (a vec of f64) with fire audio (streaming). Ports
# process_block: naad synthesis, then DC-block, then advance position.
fn fire_process_block(self, output) {
    var num = vec_len(output);
    var roar_noise = Fire_roar_noise(self);
    var roar_filter = Fire_roar_filter(self);
    var crackle_noise = Fire_crackle_noise(self);
    var crackle_filter = Fire_crackle_filter(self);
    var rng = Fire_rng(self);
    var inten = Fire_intensity(self);
    var sr = Fire_sample_rate(self);

    # Roar: brown noise through lowpass, scaled by intensity*0.3.
    var roar_amp = f64_mul(inten, f64_div(f64_from(3), f64_from(10)));
    var i = 0;
    while (i < num) {
        var n = noise_next_sample(roar_noise);
        vec_set(output, i, f64_mul(filter_biquad_process_sample(roar_filter, n), roar_amp));
        i = i + 1;
    }

    # Crackle: stochastic impulses through highpass.
    var block_size = f64_to(f64_mul(sr, f64_div(f64_from(1), f64_from(100))));   # sr*0.01
    if (block_size < 1) { block_size = 1; }
    var crackles_per_block = f64_mul(Fire_crackle_rate(self), f64_div(f64_from(1), f64_from(100)));
    # Crackle amplitude range, hoisted: rebuilt once per crackle before.
    var amp_lo = f64_div(f64_from(1), f64_from(10));
    var amp_hi = f64_div(f64_from(6), f64_from(10));

    var block_start = 0;
    while (block_start < num) {
        var block_end = block_start + block_size;
        if (block_end > num) { block_end = num; }
        var n_crackles = rng_poisson(rng, crackles_per_block);
        # Block width is fixed for the whole crackle loop below.
        var width = f64_from(block_end - block_start);
        var c = 0;
        while (c < n_crackles) {
            var offset = f64_to(rng_next_f32_range(rng, 0, width));
            var idx = block_start + offset;
            if (idx < num) {
                var crackle_amp = f64_mul(inten, rng_next_f32_range(rng, amp_lo, amp_hi));
                var decay_len = f64_to(rng_next_f32_range(rng, f64_from(5), f64_from(30)));
                # decay_len is fixed for this crackle's decay loop; converting it
                # once instead of on every sample of the tail.
                var decay_len_f = f64_from(decay_len);
                var span = decay_len;
                if (num - idx < span) { span = num - idx; }
                var j = 0;
                while (j < span) {
                    var env = f64_sub(F64_ONE, f64_div(f64_from(j), decay_len_f));
                    var cn = noise_next_sample(crackle_noise);
                    var contrib = f64_mul(crackle_amp, f64_mul(env, filter_biquad_process_sample(crackle_filter, cn)));
                    vec_set(output, idx + j, f64_add(vec_get(output, idx + j), contrib));
                    j = j + 1;
                }
            }
            c = c + 1;
        }
        block_start = block_start + block_size;
    }

    # DC-block the whole buffer, then advance the sample cursor.
    var dc = Fire_dc_blocker(self);
    i = 0;
    while (i < num) {
        vec_set(output, i, garjan_dcblocker_process(dc, vec_get(output, i)));
        i = i + 1;
    }
    Fire_set_sample_position(self, Fire_sample_position(self) + num);
    return 0;
}

# Synthesize `duration` seconds of fire audio into a fresh vec. Returns the
# vec pointer, or a negative code on invalid duration.
#must_use
fn fire_synthesize(self, duration) {
    var e = garjan_validate_duration(duration);
    if (garjan_is_err(e) == 1) { return e; }
    var num = f64_to(f64_mul(Fire_sample_rate(self), duration));
    var ga_ncheck = garjan_validate_sample_count(num);
    if (garjan_is_err(ga_ncheck) == 1) { return ga_ncheck; }
    var output = vec_new();
    var i = 0;
    while (i < num) {
        vec_push(output, 0);
        i = i + 1;
    }
    fire_process_block(self, output);
    return output;
}

# ---- serde: snapshot live state -> FireParams -> JSON, and back. ----
#must_use
fn fire_to_json(self, sb) {
    var p = garjan_alloc(sizeof(FireParams));
    if (garjan_is_err(p) == 1) { return p; }
    FireParams_set_intensity(p, Fire_intensity(self));
    FireParams_set_crackle_rate(p, Fire_crackle_rate(self));
    FireParams_set_sample_rate(p, Fire_sample_rate(self));
    FireParams_set_sample_position(p, Fire_sample_position(self));
    var rng = Fire_rng(self);
    FireParams_set_rng_state(p, Rng_state(rng));
    FireParams_set_rng_inc(p, Rng_inc(rng));
    var dc = Fire_dc_blocker(self);
    FireParams_set_dcb_x_prev(p, DcBlocker_x_prev(dc));
    FireParams_set_dcb_y_prev(p, DcBlocker_y_prev(dc));
    FireParams_set_dcb_r(p, DcBlocker_r(dc));

    # Scalars via the derive, then the naad components' LIVE state spliced in
    # as "dsp" -- without it a restore resumes with zeroed filter memory.
    var psb = str_builder_new();
    var pe = FireParams_to_json(p, psb);
    if (garjan_is_err(pe) == 1) { return pe; }
    var dsp = bayan_json_v_obj_new();
    bayan_json_v_obj_set(dsp, str_from("rf"), garjan_state_biquad(Fire_roar_filter(self)));
    bayan_json_v_obj_set(dsp, str_from("cf"), garjan_state_biquad(Fire_crackle_filter(self)));
    bayan_json_v_obj_set(dsp, str_from("rn"), garjan_state_noise(Fire_roar_noise(self)));
    bayan_json_v_obj_set(dsp, str_from("cn"), garjan_state_noise(Fire_crackle_noise(self)));
    return garjan_emit_with_dsp(sb, psb, dsp);
}

# Rebuild a Fire from JSON: restore scalars + rng + dc_blocker state, then
# reconstruct the naad components fresh (rebuilt, not restored -- architecture note 001).
#must_use
fn fire_from_json_str(json) {
    var p = FireParams_from_json_str(json);
    # Deserialize must validate what the constructor validates. Before 2.5.1
    # this path relied on a downstream naad component rejecting a bad
    # sample_rate -- which bubble's build_naad cannot do, since it only
    # calls noise_new -- and it never re-checked the enum id at all, so a
    # hostile document could restore an out-of-range one that *_new rejects.
    var vsr = garjan_validate_sample_rate(FireParams_sample_rate(p));
    if (garjan_is_err(vsr) == 1) { return vsr; }
    var self = garjan_alloc(sizeof(Fire));
    if (garjan_is_err(self) == 1) { return self; }
    Fire_set_intensity(self, FireParams_intensity(p));
    Fire_set_crackle_rate(self, FireParams_crackle_rate(p));
    Fire_set_sample_rate(self, FireParams_sample_rate(p));
    Fire_set_sample_position(self, FireParams_sample_position(p));

    var rng = rng_new(0);
    if (garjan_is_err(rng) == 1) { return rng; }
    Rng_set_state(rng, FireParams_rng_state(p));
    Rng_set_inc(rng, FireParams_rng_inc(p));
    Fire_set_rng(self, rng);

    var dc = garjan_dcblocker_new(FireParams_sample_rate(p));
    if (garjan_is_err(dc) == 1) { return dc; }
    DcBlocker_set_x_prev(dc, FireParams_dcb_x_prev(p));
    DcBlocker_set_y_prev(dc, FireParams_dcb_y_prev(p));
    DcBlocker_set_r(dc, FireParams_dcb_r(p));
    Fire_set_dc_blocker(self, dc);

    var b = fire_build_naad(self);
    if (garjan_is_err(b) == 1) { return b; }

    # Restore the components' live state on top of the freshly built ones. A
    # document written before 2.5.0 has no "dsp" member; garjan_dsp_node
    # returns 0 and the synth simply resumes without it, as it always did.
    var dsp = garjan_dsp_node(json);
    if (dsp != 0) {
        garjan_state_biquad_load(Fire_roar_filter(self), bayan_json_v_obj_get(dsp, "rf"));
        garjan_state_biquad_load(Fire_crackle_filter(self), bayan_json_v_obj_get(dsp, "cf"));
        garjan_state_noise_load(Fire_roar_noise(self), bayan_json_v_obj_get(dsp, "rn"));
        garjan_state_noise_load(Fire_crackle_noise(self), bayan_json_v_obj_get(dsp, "cn"));
    }
    return self;
}

# --- weather.cyr ---

# weather.cyr -- weather synthesis: rain, thunder, wind.
#
# Ports rust-old/src/weather.rs. The Cyrius port always uses the naad backend
# (no feature flags), so it ports the naad code paths and drops the fallbacks.
# f32 -> f64. Result<Self> -> pointer / negative GARJAN_* code. The Rust
# naad components (NoiseGenerator/BiquadFilter/
# StateVariableFilter/Lfo) are reconstructed on deserialize; rng + dc_blocker
# state ARE serialized (via the flattened *Params structs below).
#
# Three generators: Rain (+ RainIntensity enum), Thunder, Wind.
# Requires: error, logging, dsp, rng foundations + the naad bundle
# (noise_new/noise_next_sample, filter_biquad_new/filter_biquad_process_sample,
# filter_svf_new/filter_svf_process_sample_lowpass,
# modulation_lfo_new/modulation_lfo_next_value).

# ================================================================
# RainIntensity (enum) -> integer constants, declaration order.
# ================================================================
var RAIN_INTENSITY_LIGHT      = 0;
var RAIN_INTENSITY_MODERATE   = 1;
var RAIN_INTENSITY_HEAVY      = 2;
var RAIN_INTENSITY_TORRENTIAL = 3;

# Drops per second for a RainIntensity (Rust drops_per_second match).
#must_use
fn rain_intensity_drops_per_second(intensity) {
    if (intensity == RAIN_INTENSITY_LIGHT) { return f64_from(20); }
    if (intensity == RAIN_INTENSITY_MODERATE) { return f64_from(80); }
    if (intensity == RAIN_INTENSITY_HEAVY) { return f64_from(250); }
    return f64_from(600);
}

# Amplitude scaling for a RainIntensity (Rust amplitude match).
#must_use
fn rain_intensity_amplitude(intensity) {
    if (intensity == RAIN_INTENSITY_LIGHT) { return f64_div(f64_from(15), f64_from(100)); }
    if (intensity == RAIN_INTENSITY_MODERATE) { return f64_div(f64_from(3), f64_from(10)); }
    if (intensity == RAIN_INTENSITY_HEAVY) { return F64_HALF; }
    return f64_div(f64_from(8), f64_from(10));
}

# ---------------------------------------------------------------------------
# Rain
# ---------------------------------------------------------------------------

# ---- RainParams: the serializable slice (the scalar fields only,
# rng + dc_blocker FLATTENED). intensity is the RainIntensity int tag. ----
#derive(accessors)
#derive(Serialize)
struct RainParams {
    intensity: i64;
    sample_rate: f64;
    sample_position: i64;
    rng_state: i64;
    rng_inc: i64;
    dcb_x_prev: f64;
    dcb_y_prev: f64;
    dcb_r: f64;
}

# ---- Rain: live synth = scalars + live rng/dc_blocker + naad component ptrs. ----
#derive(accessors)
struct Rain {
    intensity;
    sample_rate;
    sample_position;
    rng;
    dc_blocker;
    drop_noise;
    rain_filter;
}

# Build/refresh the naad components from sample_rate. Shared by rain_new and
# rain_from_json_str. Returns GARJAN_OK or a negative code on naad failure.
fn rain_build_naad(self) {
    var sr = Rain_sample_rate(self);
    var rf = filter_biquad_new(NAAD_FILTER_BANDPASS, sr, f64_from(3000), F64_TWO);
    if (garjan_is_err(rf) == 1) { return garjan_map_naad_error(rf); }
    Rain_set_rain_filter(self, rf);
    Rain_set_drop_noise(self, noise_new(NOISE_WHITE, 7919));
    return GARJAN_OK;
}

# Creates a new rain synthesizer. Returns a pointer or a negative code.
#must_use
fn rain_new(intensity, sample_rate) {
    if (garjan_enum_invalid(intensity, RAIN_INTENSITY_TORRENTIAL) == 1) { return GARJAN_ERR_INVALID_PARAMETER; }
    var e = garjan_validate_sample_rate(sample_rate);
    if (garjan_is_err(e) == 1) { return e; }

    var self = garjan_alloc(sizeof(Rain));
    if (garjan_is_err(self) == 1) { return self; }
    Rain_set_intensity(self, intensity);
    Rain_set_sample_rate(self, sample_rate);
    Rain_set_sample_position(self, 0);
    var ga_rng1 = rng_new(7919);
    if (garjan_is_err(ga_rng1) == 1) { return ga_rng1; }
    Rain_set_rng(self, ga_rng1);
    var ga_dcb2 = garjan_dcblocker_new(sample_rate);
    if (garjan_is_err(ga_dcb2) == 1) { return ga_dcb2; }
    Rain_set_dc_blocker(self, ga_dcb2);
    var b = rain_build_naad(self);
    if (garjan_is_err(b) == 1) { return b; }
    return self;
}

# Fills `output` (a vec of f64) with rain audio (streaming). Ports
# process_block: zero, stochastic drops (naad noise), filter, DC-block.
fn rain_process_block(self, output) {
    var num = vec_len(output);
    var drop_noise = Rain_drop_noise(self);
    var rain_filter = Rain_rain_filter(self);
    var rng = Rain_rng(self);
    var intensity = Rain_intensity(self);
    var sr = Rain_sample_rate(self);

    # Zero the buffer.
    var z = 0;
    while (z < num) {
        vec_set(output, z, 0);
        z = z + 1;
    }

    var amp = rain_intensity_amplitude(intensity);
    var block_size = f64_to(f64_mul(sr, f64_div(f64_from(1), f64_from(100))));   # sr*0.01
    var step = block_size;
    if (step < 1) { step = 1; }
    var drops_per_block = f64_mul(rain_intensity_drops_per_second(intensity), f64_div(f64_from(1), f64_from(100)));
    # Hoisted out of the drop / decay loops below.
    var drop_lo = f64_div(f64_from(3), f64_from(10));
    var neg_five = f64_neg(f64_from(5));

    var block_start = 0;
    while (block_start < num) {
        var block_end = block_start + block_size;
        if (block_end > num) { block_end = num; }
        var n_drops = rng_poisson(rng, drops_per_block);
        # Block width is fixed for the whole drop loop below.
        var width = f64_from(block_end - block_start);
        var d = 0;
        while (d < n_drops) {
            var offset = f64_to(rng_next_f32_range(rng, 0, width));
            var idx = block_start + offset;
            if (idx < num) {
                var drop_amp = f64_mul(amp, rng_next_f32_range(rng, drop_lo, F64_ONE));
                var decay_samples = f64_to(rng_next_f32_range(rng, f64_from(20), f64_from(80)));
                # Fixed for this drop's decay tail; converted once, not per sample.
                var decay_samples_f = f64_from(decay_samples);
                var span = decay_samples;
                if (num - idx < span) { span = num - idx; }
                var j = 0;
                while (j < span) {
                    var t = f64_div(f64_from(j), decay_samples_f);
                    var env = f64_exp(f64_mul(neg_five, t));
                    var dn = noise_next_sample(drop_noise);
                    var contrib = f64_mul(drop_amp, f64_mul(env, dn));
                    vec_set(output, idx + j, f64_add(vec_get(output, idx + j), contrib));
                    j = j + 1;
                }
            }
            d = d + 1;
        }
        block_start = block_start + step;
    }

    # Apply the bandpass filter over the whole buffer, then DC-block.
    filter_biquad_process_buffer(rain_filter, output);
    var dc = Rain_dc_blocker(self);
    var i = 0;
    while (i < num) {
        vec_set(output, i, garjan_dcblocker_process(dc, vec_get(output, i)));
        i = i + 1;
    }
    Rain_set_sample_position(self, Rain_sample_position(self) + num);
    return 0;
}

# Synthesize `duration` seconds of rain audio into a fresh vec. Returns the
# vec pointer, or a negative code on invalid duration.
#must_use
fn rain_synthesize(self, duration) {
    var e = garjan_validate_duration(duration);
    if (garjan_is_err(e) == 1) { return e; }
    var num = f64_to(f64_mul(Rain_sample_rate(self), duration));
    var ga_ncheck = garjan_validate_sample_count(num);
    if (garjan_is_err(ga_ncheck) == 1) { return ga_ncheck; }
    var output = vec_new();
    var i = 0;
    while (i < num) {
        vec_push(output, 0);
        i = i + 1;
    }
    rain_process_block(self, output);
    return output;
}

# ---- serde: snapshot live state -> RainParams -> JSON, and back. ----
#must_use
fn rain_to_json(self, sb) {
    var p = garjan_alloc(sizeof(RainParams));
    if (garjan_is_err(p) == 1) { return p; }
    RainParams_set_intensity(p, Rain_intensity(self));
    RainParams_set_sample_rate(p, Rain_sample_rate(self));
    RainParams_set_sample_position(p, Rain_sample_position(self));
    var rng = Rain_rng(self);
    RainParams_set_rng_state(p, Rng_state(rng));
    RainParams_set_rng_inc(p, Rng_inc(rng));
    var dc = Rain_dc_blocker(self);
    RainParams_set_dcb_x_prev(p, DcBlocker_x_prev(dc));
    RainParams_set_dcb_y_prev(p, DcBlocker_y_prev(dc));
    RainParams_set_dcb_r(p, DcBlocker_r(dc));
    # Scalars via the derive, then the naad components' LIVE state spliced
    # in as "dsp" -- without it a restore resumes with zeroed filter memory.
    var psb = str_builder_new();
    var pe = RainParams_to_json(p, psb);
    if (garjan_is_err(pe) == 1) { return pe; }
    var dsp = bayan_json_v_obj_new();
    bayan_json_v_obj_set(dsp, str_from("rf"), garjan_state_biquad(Rain_rain_filter(self)));
    bayan_json_v_obj_set(dsp, str_from("dn"), garjan_state_noise(Rain_drop_noise(self)));
    return garjan_emit_with_dsp(sb, psb, dsp);
}

# Rebuild a Rain from JSON: restore scalars + rng + dc_blocker, reconstruct naad.
#must_use
fn rain_from_json_str(json) {
    var p = RainParams_from_json_str(json);
    # Deserialize must validate what the constructor validates. Before 2.5.1
    # this path relied on a downstream naad component rejecting a bad
    # sample_rate -- which bubble's build_naad cannot do, since it only
    # calls noise_new -- and it never re-checked the enum id at all, so a
    # hostile document could restore an out-of-range one that *_new rejects.
    var vsr = garjan_validate_sample_rate(RainParams_sample_rate(p));
    if (garjan_is_err(vsr) == 1) { return vsr; }
    if (garjan_enum_invalid(RainParams_intensity(p), RAIN_INTENSITY_TORRENTIAL) == 1) {
        return GARJAN_ERR_INVALID_PARAMETER;
    }
    var self = garjan_alloc(sizeof(Rain));
    if (garjan_is_err(self) == 1) { return self; }
    Rain_set_intensity(self, RainParams_intensity(p));
    Rain_set_sample_rate(self, RainParams_sample_rate(p));
    Rain_set_sample_position(self, RainParams_sample_position(p));

    var rng = rng_new(0);
    if (garjan_is_err(rng) == 1) { return rng; }
    Rng_set_state(rng, RainParams_rng_state(p));
    Rng_set_inc(rng, RainParams_rng_inc(p));
    Rain_set_rng(self, rng);

    var dc = garjan_dcblocker_new(RainParams_sample_rate(p));
    if (garjan_is_err(dc) == 1) { return dc; }
    DcBlocker_set_x_prev(dc, RainParams_dcb_x_prev(p));
    DcBlocker_set_y_prev(dc, RainParams_dcb_y_prev(p));
    DcBlocker_set_r(dc, RainParams_dcb_r(p));
    Rain_set_dc_blocker(self, dc);

    var b = rain_build_naad(self);
    if (garjan_is_err(b) == 1) { return b; }

    # Restore the components' live state onto the freshly built ones. A
    # document written before 2.5.0 has no "dsp" member; garjan_dsp_node
    # returns 0 and the synth resumes without it, exactly as it used to.
    var dsp = garjan_dsp_node(json);
    if (dsp != 0) {
        garjan_state_biquad_load(Rain_rain_filter(self), bayan_json_v_obj_get(dsp, "rf"));
        garjan_state_noise_load(Rain_drop_noise(self), bayan_json_v_obj_get(dsp, "dn"));
    }
    return self;
}

# ---------------------------------------------------------------------------
# Thunder
# ---------------------------------------------------------------------------

# ---- ThunderParams: the serializable slice. ----
#derive(accessors)
#derive(Serialize)
struct ThunderParams {
    distance_m: f64;
    sample_rate: f64;
    sample_position: i64;
    rng_state: i64;
    rng_inc: i64;
    dcb_x_prev: f64;
    dcb_y_prev: f64;
    dcb_r: f64;
}

# ---- Thunder: live synth = scalars + live rng/dc_blocker + naad component ptrs. ----
#derive(accessors)
struct Thunder {
    distance_m;
    sample_rate;
    sample_position;
    rng;
    dc_blocker;
    crack_noise;
    rumble_noise;
    rumble_filter;
}

# Build/refresh the naad components from sample_rate + distance_m. Shared by
# thunder_new and thunder_from_json_str. Returns GARJAN_OK or a negative code.
fn thunder_build_naad(self) {
    var sr = Thunder_sample_rate(self);
    var distance_m = Thunder_distance_m(self);
    # cutoff = (5000 / (1 + distance_m*0.002)).clamp(60, 5000)
    var denom = f64_add(F64_ONE, f64_mul(distance_m, f64_div(f64_from(2), f64_from(1000))));
    var cutoff = f64_clamp(f64_div(f64_from(5000), denom), f64_from(60), f64_from(5000));
    var rf = filter_biquad_new(NAAD_FILTER_LOWPASS, sr, cutoff, f64_div(f64_from(7), f64_from(10)));
    if (garjan_is_err(rf) == 1) { return garjan_map_naad_error(rf); }
    Thunder_set_rumble_filter(self, rf);
    Thunder_set_crack_noise(self, noise_new(NOISE_WHITE, 1337));
    Thunder_set_rumble_noise(self, noise_new(NOISE_BROWN, 1338));
    return GARJAN_OK;
}

# Creates a new thunder synthesizer. Returns a pointer or a negative code.
#must_use
fn thunder_new(distance_m, sample_rate) {
    var e = garjan_validate_sample_rate(sample_rate);
    if (garjan_is_err(e) == 1) { return e; }
    var dist = f64_max(distance_m, f64_from(10));

    var self = garjan_alloc(sizeof(Thunder));
    if (garjan_is_err(self) == 1) { return self; }
    Thunder_set_distance_m(self, dist);
    Thunder_set_sample_rate(self, sample_rate);
    Thunder_set_sample_position(self, 0);
    var ga_rng3 = rng_new(1337);
    if (garjan_is_err(ga_rng3) == 1) { return ga_rng3; }
    Thunder_set_rng(self, ga_rng3);
    var ga_dcb4 = garjan_dcblocker_new(sample_rate);
    if (garjan_is_err(ga_dcb4) == 1) { return ga_dcb4; }
    Thunder_set_dc_blocker(self, ga_dcb4);
    var b = thunder_build_naad(self);
    if (garjan_is_err(b) == 1) { return b; }
    return self;
}

# Fills `output` (a vec of f64) with thunder audio (streaming). Ports
# process_block_naad, then DC-blocks the whole buffer and advances position.
fn thunder_process_block(self, output) {
    var num = vec_len(output);
    var crack_noise = Thunder_crack_noise(self);
    var rumble_noise = Thunder_rumble_noise(self);
    var rumble_filter = Thunder_rumble_filter(self);
    var sr = Thunder_sample_rate(self);
    var distance_m = Thunder_distance_m(self);
    var sample_position = Thunder_sample_position(self);

    # delay_samples = (distance_m / 343 * sample_rate) as usize
    var delay_s = f64_div(distance_m, f64_from(343));
    var delay_samples = f64_to(f64_mul(delay_s, sr));
    # amp = (100 / distance_m).min(1)
    var amp = f64_min(f64_div(f64_from(100), distance_m), F64_ONE);
    # crack_len (close thunder only)
    var crack_len = 0;
    if (f64_lt(distance_m, f64_from(500)) == 1) {
        crack_len = f64_to(f64_mul(sr, f64_div(f64_from(5), f64_from(100))));   # sr*0.05
    }
    # decay_time = 0.5 + distance_m*0.001
    var decay_time = f64_add(F64_HALF, f64_mul(distance_m, f64_div(f64_from(1), f64_from(1000))));

    # Loop-invariants, hoisted out of the per-sample loop below. Every one of
    # these was rebuilt on each of the 44,100 samples per second of audio.
    var crack_div = crack_len;
    if (crack_div < 1) { crack_div = 1; }
    var crack_div_f = f64_from(crack_div);
    var neg_ten = f64_neg(f64_from(10));
    var crack_gain = f64_div(f64_from(8), f64_from(10));
    var neg_two = f64_neg(F64_TWO);
    var rumble_scale = f64_mul(sr, decay_time);
    var rumble_gain = f64_div(f64_from(6), f64_from(10));

    var i = 0;
    while (i < num) {
        var abs_pos = sample_position + i;
        vec_set(output, i, 0);
        if (abs_pos < delay_samples) {
            i = i + 1;
        } else {
            var pos_after_delay = abs_pos - delay_samples;
            if (pos_after_delay < crack_len) {
                var t_crack = f64_div(f64_from(pos_after_delay), crack_div_f);
                var env_crack = f64_exp(f64_mul(neg_ten, t_crack));
                var cn = noise_next_sample(crack_noise);
                var contrib_crack = f64_mul(f64_mul(f64_mul(amp, env_crack), cn), crack_gain);
                # output[i] was just set to 0 above, so the read-back is a known
                # 0 -- kept as an add rather than a plain store so a -0.0
                # contribution still normalises exactly as it did before.
                vec_set(output, i, f64_add(0, contrib_crack));
            } else {
                var rumble_pos = pos_after_delay - crack_len;
                var t_rumble = f64_div(f64_from(rumble_pos), rumble_scale);
                var env_rumble = f64_exp(f64_mul(neg_two, t_rumble));
                var rn = noise_next_sample(rumble_noise);
                var filtered = filter_biquad_process_sample(rumble_filter, rn);
                var contrib_rumble = f64_mul(f64_mul(f64_mul(amp, env_rumble), filtered),
                  rumble_gain);
                vec_set(output, i, f64_add(0, contrib_rumble));
            }
            i = i + 1;
        }
    }

    # DC-block the whole buffer, then advance the sample cursor.
    var dc = Thunder_dc_blocker(self);
    var k = 0;
    while (k < num) {
        vec_set(output, k, garjan_dcblocker_process(dc, vec_get(output, k)));
        k = k + 1;
    }
    Thunder_set_sample_position(self, Thunder_sample_position(self) + num);
    return 0;
}

# Synthesize `duration` seconds of thunder audio into a fresh vec.
#must_use
fn thunder_synthesize(self, duration) {
    var e = garjan_validate_duration(duration);
    if (garjan_is_err(e) == 1) { return e; }
    var num = f64_to(f64_mul(Thunder_sample_rate(self), duration));
    var ga_ncheck = garjan_validate_sample_count(num);
    if (garjan_is_err(ga_ncheck) == 1) { return ga_ncheck; }
    var output = vec_new();
    var i = 0;
    while (i < num) {
        vec_push(output, 0);
        i = i + 1;
    }
    thunder_process_block(self, output);
    return output;
}

# ---- serde: snapshot live state -> ThunderParams -> JSON, and back. ----
#must_use
fn thunder_to_json(self, sb) {
    var p = garjan_alloc(sizeof(ThunderParams));
    if (garjan_is_err(p) == 1) { return p; }
    ThunderParams_set_distance_m(p, Thunder_distance_m(self));
    ThunderParams_set_sample_rate(p, Thunder_sample_rate(self));
    ThunderParams_set_sample_position(p, Thunder_sample_position(self));
    var rng = Thunder_rng(self);
    ThunderParams_set_rng_state(p, Rng_state(rng));
    ThunderParams_set_rng_inc(p, Rng_inc(rng));
    var dc = Thunder_dc_blocker(self);
    ThunderParams_set_dcb_x_prev(p, DcBlocker_x_prev(dc));
    ThunderParams_set_dcb_y_prev(p, DcBlocker_y_prev(dc));
    ThunderParams_set_dcb_r(p, DcBlocker_r(dc));
    # Scalars via the derive, then the naad components' LIVE state spliced
    # in as "dsp" -- without it a restore resumes with zeroed filter memory.
    var psb = str_builder_new();
    var pe = ThunderParams_to_json(p, psb);
    if (garjan_is_err(pe) == 1) { return pe; }
    var dsp = bayan_json_v_obj_new();
    bayan_json_v_obj_set(dsp, str_from("rf"), garjan_state_biquad(Thunder_rumble_filter(self)));
    bayan_json_v_obj_set(dsp, str_from("cn"), garjan_state_noise(Thunder_crack_noise(self)));
    bayan_json_v_obj_set(dsp, str_from("rn"), garjan_state_noise(Thunder_rumble_noise(self)));
    return garjan_emit_with_dsp(sb, psb, dsp);
}

# Rebuild a Thunder from JSON: restore scalars + rng + dc_blocker, reconstruct naad.
#must_use
fn thunder_from_json_str(json) {
    var p = ThunderParams_from_json_str(json);
    # Deserialize must validate what the constructor validates. Before 2.5.1
    # this path relied on a downstream naad component rejecting a bad
    # sample_rate -- which bubble's build_naad cannot do, since it only
    # calls noise_new -- and it never re-checked the enum id at all, so a
    # hostile document could restore an out-of-range one that *_new rejects.
    var vsr = garjan_validate_sample_rate(ThunderParams_sample_rate(p));
    if (garjan_is_err(vsr) == 1) { return vsr; }
    var self = garjan_alloc(sizeof(Thunder));
    if (garjan_is_err(self) == 1) { return self; }
    Thunder_set_distance_m(self, ThunderParams_distance_m(p));
    Thunder_set_sample_rate(self, ThunderParams_sample_rate(p));
    Thunder_set_sample_position(self, ThunderParams_sample_position(p));

    var rng = rng_new(0);
    if (garjan_is_err(rng) == 1) { return rng; }
    Rng_set_state(rng, ThunderParams_rng_state(p));
    Rng_set_inc(rng, ThunderParams_rng_inc(p));
    Thunder_set_rng(self, rng);

    var dc = garjan_dcblocker_new(ThunderParams_sample_rate(p));
    if (garjan_is_err(dc) == 1) { return dc; }
    DcBlocker_set_x_prev(dc, ThunderParams_dcb_x_prev(p));
    DcBlocker_set_y_prev(dc, ThunderParams_dcb_y_prev(p));
    DcBlocker_set_r(dc, ThunderParams_dcb_r(p));
    Thunder_set_dc_blocker(self, dc);

    var b = thunder_build_naad(self);
    if (garjan_is_err(b) == 1) { return b; }

    # Restore the components' live state onto the freshly built ones. A
    # document written before 2.5.0 has no "dsp" member; garjan_dsp_node
    # returns 0 and the synth resumes without it, exactly as it used to.
    var dsp = garjan_dsp_node(json);
    if (dsp != 0) {
        garjan_state_biquad_load(Thunder_rumble_filter(self), bayan_json_v_obj_get(dsp, "rf"));
        garjan_state_noise_load(Thunder_crack_noise(self), bayan_json_v_obj_get(dsp, "cn"));
        garjan_state_noise_load(Thunder_rumble_noise(self), bayan_json_v_obj_get(dsp, "rn"));
    }
    return self;
}

# ---------------------------------------------------------------------------
# Wind
# ---------------------------------------------------------------------------

# ---- WindParams: the serializable slice. ----
#derive(accessors)
#derive(Serialize)
struct WindParams {
    speed: f64;
    gustiness: f64;
    sample_rate: f64;
    sample_position: i64;
    rng_state: i64;
    rng_inc: i64;
    dcb_x_prev: f64;
    dcb_y_prev: f64;
    dcb_r: f64;
}

# ---- Wind: live synth = scalars + live rng/dc_blocker + naad component ptrs. ----
#derive(accessors)
struct Wind {
    speed;
    gustiness;
    sample_rate;
    sample_position;
    rng;
    dc_blocker;
    noise_gen;
    shape_filter;
    gust_lfo;
}

# Build/refresh the naad components from speed/gustiness/sample_rate. Shared by
# wind_new and wind_from_json_str. Returns GARJAN_OK or a negative code.
fn wind_build_naad(self) {
    var sr = Wind_sample_rate(self);
    var speed = Wind_speed(self);
    var gustiness = Wind_gustiness(self);
    # cutoff = ((speed/30).clamp(0.05, 1) * 8000).clamp(50, 8000)
    var ratio = f64_clamp(f64_div(speed, f64_from(30)), f64_div(f64_from(5), f64_from(100)), F64_ONE);
    var cutoff = f64_clamp(f64_mul(ratio, f64_from(8000)), f64_from(50), f64_from(8000));
    var sf = filter_svf_new(cutoff, F64_HALF, sr);
    if (garjan_is_err(sf) == 1) { return garjan_map_naad_error(sf); }
    Wind_set_shape_filter(self, sf);
    # gust_rate = 0.3 + gustiness*2
    var gust_rate = f64_add(f64_div(f64_from(3), f64_from(10)), f64_mul(gustiness, F64_TWO));
    var lfo = modulation_lfo_new(MODULATION_LFO_SINE, gust_rate, sr);
    if (garjan_is_err(lfo) == 1) { return garjan_map_naad_error(lfo); }
    Wind_set_gust_lfo(self, lfo);
    Wind_set_noise_gen(self, noise_new(NOISE_PINK, 4201));
    return GARJAN_OK;
}

# Creates a new wind synthesizer. Returns a pointer or a negative code.
#must_use
fn wind_new(speed, gustiness, sample_rate) {
    var e = garjan_validate_sample_rate(sample_rate);
    if (garjan_is_err(e) == 1) { return e; }
    var spd = f64_max(speed, 0);
    var gust = f64_clamp(gustiness, 0, F64_ONE);

    var self = garjan_alloc(sizeof(Wind));
    if (garjan_is_err(self) == 1) { return self; }
    Wind_set_speed(self, spd);
    Wind_set_gustiness(self, gust);
    Wind_set_sample_rate(self, sample_rate);
    Wind_set_sample_position(self, 0);
    var ga_rng5 = rng_new(4201);
    if (garjan_is_err(ga_rng5) == 1) { return ga_rng5; }
    Wind_set_rng(self, ga_rng5);
    var ga_dcb6 = garjan_dcblocker_new(sample_rate);
    if (garjan_is_err(ga_dcb6) == 1) { return ga_dcb6; }
    Wind_set_dc_blocker(self, ga_dcb6);
    var b = wind_build_naad(self);
    if (garjan_is_err(b) == 1) { return b; }
    return self;
}

# Fills `output` (a vec of f64) with wind audio (streaming). Ports
# process_block_naad, then DC-blocks the whole buffer and advances position.
fn wind_process_block(self, output) {
    var num = vec_len(output);
    var noise_gen = Wind_noise_gen(self);
    var shape_filter = Wind_shape_filter(self);
    var gust_lfo = Wind_gust_lfo(self);
    var speed = Wind_speed(self);
    var gustiness = Wind_gustiness(self);

    # base_amp = (speed/30).min(1) * 0.5
    var base_amp = f64_mul(f64_min(f64_div(speed, f64_from(30)), F64_ONE), F64_HALF);
    # gust_scale = gustiness * 0.5
    var gust_scale = f64_mul(gustiness, F64_HALF);

    # DC-blocked inline rather than in a second pass over the buffer. The
    # generation loop writes each index exactly once, in order, so the blocker
    # sees the identical inputs in the identical order -- bit-identical output,
    # minus a vec_get + vec_set per sample.
    var dc = Wind_dc_blocker(self);
    var i = 0;
    while (i < num) {
        var n = noise_next_sample(noise_gen);
        var filtered = filter_svf_process_sample_lowpass(shape_filter, n);
        var gust = f64_add(F64_ONE, f64_mul(gust_scale, modulation_lfo_next_value(gust_lfo)));
        vec_set(output, i, garjan_dcblocker_process(dc, f64_mul(f64_mul(filtered, base_amp), gust)));
        i = i + 1;
    }
    Wind_set_sample_position(self, Wind_sample_position(self) + num);
    return 0;
}

# Synthesize `duration` seconds of wind audio into a fresh vec.
#must_use
fn wind_synthesize(self, duration) {
    var e = garjan_validate_duration(duration);
    if (garjan_is_err(e) == 1) { return e; }
    var num = f64_to(f64_mul(Wind_sample_rate(self), duration));
    var ga_ncheck = garjan_validate_sample_count(num);
    if (garjan_is_err(ga_ncheck) == 1) { return ga_ncheck; }
    var output = vec_new();
    var i = 0;
    while (i < num) {
        vec_push(output, 0);
        i = i + 1;
    }
    wind_process_block(self, output);
    return output;
}

# ---- serde: snapshot live state -> WindParams -> JSON, and back. ----
#must_use
fn wind_to_json(self, sb) {
    var p = garjan_alloc(sizeof(WindParams));
    if (garjan_is_err(p) == 1) { return p; }
    WindParams_set_speed(p, Wind_speed(self));
    WindParams_set_gustiness(p, Wind_gustiness(self));
    WindParams_set_sample_rate(p, Wind_sample_rate(self));
    WindParams_set_sample_position(p, Wind_sample_position(self));
    var rng = Wind_rng(self);
    WindParams_set_rng_state(p, Rng_state(rng));
    WindParams_set_rng_inc(p, Rng_inc(rng));
    var dc = Wind_dc_blocker(self);
    WindParams_set_dcb_x_prev(p, DcBlocker_x_prev(dc));
    WindParams_set_dcb_y_prev(p, DcBlocker_y_prev(dc));
    WindParams_set_dcb_r(p, DcBlocker_r(dc));
    # Scalars via the derive, then the naad components' LIVE state spliced
    # in as "dsp" -- without it a restore resumes with zeroed filter memory.
    var psb = str_builder_new();
    var pe = WindParams_to_json(p, psb);
    if (garjan_is_err(pe) == 1) { return pe; }
    var dsp = bayan_json_v_obj_new();
    bayan_json_v_obj_set(dsp, str_from("sf"), garjan_state_svf(Wind_shape_filter(self)));
    bayan_json_v_obj_set(dsp, str_from("gl"), garjan_state_lfo(Wind_gust_lfo(self)));
    bayan_json_v_obj_set(dsp, str_from("ng"), garjan_state_noise(Wind_noise_gen(self)));
    return garjan_emit_with_dsp(sb, psb, dsp);
}

# Rebuild a Wind from JSON: restore scalars + rng + dc_blocker, reconstruct naad.
#must_use
fn wind_from_json_str(json) {
    var p = WindParams_from_json_str(json);
    # Deserialize must validate what the constructor validates. Before 2.5.1
    # this path relied on a downstream naad component rejecting a bad
    # sample_rate -- which bubble's build_naad cannot do, since it only
    # calls noise_new -- and it never re-checked the enum id at all, so a
    # hostile document could restore an out-of-range one that *_new rejects.
    var vsr = garjan_validate_sample_rate(WindParams_sample_rate(p));
    if (garjan_is_err(vsr) == 1) { return vsr; }
    var self = garjan_alloc(sizeof(Wind));
    if (garjan_is_err(self) == 1) { return self; }
    Wind_set_speed(self, WindParams_speed(p));
    Wind_set_gustiness(self, WindParams_gustiness(p));
    Wind_set_sample_rate(self, WindParams_sample_rate(p));
    Wind_set_sample_position(self, WindParams_sample_position(p));

    var rng = rng_new(0);
    if (garjan_is_err(rng) == 1) { return rng; }
    Rng_set_state(rng, WindParams_rng_state(p));
    Rng_set_inc(rng, WindParams_rng_inc(p));
    Wind_set_rng(self, rng);

    var dc = garjan_dcblocker_new(WindParams_sample_rate(p));
    if (garjan_is_err(dc) == 1) { return dc; }
    DcBlocker_set_x_prev(dc, WindParams_dcb_x_prev(p));
    DcBlocker_set_y_prev(dc, WindParams_dcb_y_prev(p));
    DcBlocker_set_r(dc, WindParams_dcb_r(p));
    Wind_set_dc_blocker(self, dc);

    var b = wind_build_naad(self);
    if (garjan_is_err(b) == 1) { return b; }

    # Restore the components' live state onto the freshly built ones. A
    # document written before 2.5.0 has no "dsp" member; garjan_dsp_node
    # returns 0 and the synth resumes without it, exactly as it used to.
    var dsp = garjan_dsp_node(json);
    if (dsp != 0) {
        garjan_state_svf_load(Wind_shape_filter(self), bayan_json_v_obj_get(dsp, "sf"));
        garjan_state_lfo_load(Wind_gust_lfo(self), bayan_json_v_obj_get(dsp, "gl"));
        garjan_state_noise_load(Wind_noise_gen(self), bayan_json_v_obj_get(dsp, "ng"));
    }
    return self;
}

# --- water.cyr ---

# water.cyr -- water synthesis: streams, drips, splashes, waves.
#
# Ports rust-old/src/water.rs. The Cyrius port always uses the naad backend
# (no feature flags), so it ports the #[cfg(feature="naad-backend")] paths and
# drops the fallback. f32 -> f64. Result<Self> -> pointer / negative GARJAN_*
# code. The naad components (noise_gen,
# shape_filter, mod_lfo) are reconstructed on deserialize; water_type,
# intensity, sample_rate, sample_position, drip_freq, rng, and dc_blocker are
# serialized (via the flattened WaterParams below).
# Requires: error, logging, dsp, rng foundations + the naad bundle
# (noise_new/noise_next_sample, filter_biquad_new/filter_biquad_process_sample,
# modulation_lfo_new/modulation_lfo_next_value).

# ---- WaterType (enum) -> module-prefixed int constants (declaration order). ----
var WATER_STREAM = 0;
var WATER_DRIP   = 1;
var WATER_SPLASH = 2;
var WATER_WAVES  = 3;

# ---- WaterParams: the serializable slice (the scalar fields only, with
# water_type as an int tag and rng + dc_blocker FLATTENED to scalars so
# #derive(Serialize)'s single-pass from_json_str works). Synced to/from the
# live Water on (de)serialize. ----
#derive(accessors)
#derive(Serialize)
struct WaterParams {
    water_type: i64;
    intensity: f64;
    sample_rate: f64;
    sample_position: i64;
    drip_freq: f64;
    rng_state: i64;
    rng_inc: i64;
    dcb_x_prev: f64;
    dcb_y_prev: f64;
    dcb_r: f64;
}

# ---- Water: live synth = scalars + live rng/dc_blocker + naad component ptrs. ----
#derive(accessors)
struct Water {
    water_type;
    intensity;
    sample_rate;
    sample_position;
    drip_freq;
    rng;
    dc_blocker;
    noise_gen;
    shape_filter;
    mod_lfo;
}

# Build/refresh the naad components (noise_gen, shape_filter, mod_lfo) from
# water_type + intensity + sample_rate. Shared by water_new and
# water_from_json_str. Returns GARJAN_OK or a negative code if a naad
# constructor rejects its params. Mirrors the Rust `match water_type` that
# picks (noise_type, filter_type, filter_freq, filter_q, lfo_rate).
fn water_build_naad(self) {
    var wt = Water_water_type(self);
    var sr = Water_sample_rate(self);
    var inten = Water_intensity(self);

    # Select naad params per water type (Rust match).
    var noise_type = NOISE_WHITE;
    var filter_type = NAAD_FILTER_LOWPASS;
    var filter_freq = f64_from(1000);
    var filter_q = F64_ONE;
    var lfo_rate = F64_ONE;
    if (wt == WATER_STREAM) {
        noise_type = NOISE_PINK;
        filter_type = NAAD_FILTER_BANDPASS;
        filter_freq = f64_from(800);
        filter_q = f64_div(f64_from(3), f64_from(2));
        # 0.5 + intensity * 2.0
        lfo_rate = f64_add(F64_HALF, f64_mul(inten, F64_TWO));
    } elif (wt == WATER_DRIP) {
        noise_type = NOISE_WHITE;
        filter_type = NAAD_FILTER_BANDPASS;
        filter_freq = f64_from(1200);
        filter_q = F64_TWO;
        lfo_rate = F64_ONE;
    } elif (wt == WATER_SPLASH) {
        noise_type = NOISE_WHITE;
        filter_type = NAAD_FILTER_LOWPASS;
        filter_freq = f64_from(4000);
        filter_q = f64_div(f64_from(7), f64_from(10));
        lfo_rate = F64_ONE;
    } else {
        noise_type = NOISE_BROWN;
        filter_type = NAAD_FILTER_LOWPASS;
        filter_freq = f64_from(500);
        filter_q = F64_HALF;
        lfo_rate = f64_div(f64_from(1), f64_from(10));
    }

    var sf = filter_biquad_new(filter_type, sr, filter_freq, filter_q);
    if (garjan_is_err(sf) == 1) { return garjan_map_naad_error(sf); }
    var lfo = modulation_lfo_new(MODULATION_LFO_SINE, lfo_rate, sr);
    if (garjan_is_err(lfo) == 1) { return garjan_map_naad_error(lfo); }

    Water_set_shape_filter(self, sf);
    Water_set_mod_lfo(self, lfo);
    Water_set_noise_gen(self, noise_new(noise_type, 2749));
    return GARJAN_OK;
}

# Creates a new water synthesizer. Returns a pointer or a negative code.
#must_use
fn water_new(water_type, intensity, sample_rate) {
    if (garjan_enum_invalid(water_type, WATER_WAVES) == 1) { return GARJAN_ERR_INVALID_PARAMETER; }
    var e = garjan_validate_sample_rate(sample_rate);
    if (garjan_is_err(e) == 1) { return e; }
    var inten = f64_clamp(intensity, 0, F64_ONE);

    # drip_freq = 1200.0 + Rng::new(2749).next_f32_range(-200.0, 200.0)
    # (a THROWAWAY rng seeded 2749; the live rng is a fresh Rng::new(2749)).
    var tmp_rng = rng_new(2749);
    if (garjan_is_err(tmp_rng) == 1) { return tmp_rng; }
    var drip_freq = f64_add(f64_from(1200), rng_next_f32_range(tmp_rng, f64_neg(f64_from(200)), f64_from(200)));

    var self = garjan_alloc(sizeof(Water));
    if (garjan_is_err(self) == 1) { return self; }
    Water_set_water_type(self, water_type);
    Water_set_intensity(self, inten);
    Water_set_sample_rate(self, sample_rate);
    Water_set_sample_position(self, 0);
    Water_set_drip_freq(self, drip_freq);
    var ga_rng1 = rng_new(2749);
    if (garjan_is_err(ga_rng1) == 1) { return ga_rng1; }
    Water_set_rng(self, ga_rng1);
    var ga_dcb2 = garjan_dcblocker_new(sample_rate);
    if (garjan_is_err(ga_dcb2) == 1) { return ga_dcb2; }
    Water_set_dc_blocker(self, ga_dcb2);
    var b = water_build_naad(self);
    if (garjan_is_err(b) == 1) { return b; }
    return self;
}

# Stream: pink noise through bandpass, amplitude-modulated by a slow LFO.
fn water_process_stream(self, output) {
    var num = vec_len(output);
    var noise_gen = Water_noise_gen(self);
    var shape_filter = Water_shape_filter(self);
    var mod_lfo = Water_mod_lfo(self);
    var amp = f64_mul(Water_intensity(self), f64_div(f64_from(3), f64_from(10)));
    # modulator = 0.7 + 0.3*lfo -- both terms were rebuilt per sample. The
    # sibling water_process_waves already hoists its equivalents.
    var mod_base = f64_div(f64_from(7), f64_from(10));
    var mod_depth = f64_div(f64_from(3), f64_from(10));
    var i = 0;
    while (i < num) {
        var noise = noise_next_sample(noise_gen);
        var filtered = filter_biquad_process_sample(shape_filter, noise);
        var modulator = f64_add(mod_base, f64_mul(mod_depth, modulation_lfo_next_value(mod_lfo)));
        vec_set(output, i, f64_mul(f64_mul(filtered, amp), modulator));
        i = i + 1;
    }
    return 0;
}

# Drip: resonant decaying sine (no naad, no rng). Active only for the first
# drip_len samples of the whole stream (absolute position).
fn water_process_drip(self, output) {
    var num = vec_len(output);
    var freq = Water_drip_freq(self);
    var sr = Water_sample_rate(self);
    var omega = f64_div(f64_mul(F64_TAU, freq), sr);
    var drip_len = f64_to(f64_mul(sr, f64_div(f64_from(5), f64_from(100))));   # sr*0.05
    var base = Water_sample_position(self);
    var i = 0;
    while (i < num) {
        var abs_pos = base + i;
        if (abs_pos < drip_len) {
            var t = f64_div(f64_from(abs_pos), sr);
            var env = f64_exp(f64_mul(f64_neg(f64_from(30)), t));
            var s = f64_mul(f64_mul(f64_sin(f64_mul(omega, f64_from(abs_pos))), env), Water_intensity(self));
            vec_set(output, i, s);
        } else {
            vec_set(output, i, 0);
        }
        i = i + 1;
    }
    return 0;
}

# Splash: white noise through lowpass with a fast exponential decay envelope
# (no LFO). Envelope keyed to absolute position.
fn water_process_splash(self, output) {
    var num = vec_len(output);
    var noise_gen = Water_noise_gen(self);
    var shape_filter = Water_shape_filter(self);
    var sr = Water_sample_rate(self);
    var amp = f64_mul(Water_intensity(self), f64_div(f64_from(6), f64_from(10)));
    var base = Water_sample_position(self);
    var i = 0;
    while (i < num) {
        var abs_pos = base + i;
        var t = f64_div(f64_from(abs_pos), sr);
        var env = f64_exp(f64_mul(f64_neg(f64_from(8)), t));
        var noise = noise_next_sample(noise_gen);
        vec_set(output, i, f64_mul(f64_mul(filter_biquad_process_sample(shape_filter, noise), amp), env));
        i = i + 1;
    }
    return 0;
}

# Waves: brown noise through lowpass, slowly swelled by a wave envelope LFO.
fn water_process_waves(self, output) {
    var num = vec_len(output);
    var noise_gen = Water_noise_gen(self);
    var shape_filter = Water_shape_filter(self);
    var mod_lfo = Water_mod_lfo(self);
    var amp = f64_mul(Water_intensity(self), f64_div(f64_from(4), f64_from(10)));
    var i = 0;
    while (i < num) {
        var noise = noise_next_sample(noise_gen);
        var filtered = filter_biquad_process_sample(shape_filter, noise);
        # wave_env = 0.5 + 0.5 * lfo
        var wave_env = f64_add(F64_HALF, f64_mul(F64_HALF, modulation_lfo_next_value(mod_lfo)));
        vec_set(output, i, f64_mul(f64_mul(filtered, amp), wave_env));
        i = i + 1;
    }
    return 0;
}

# Fills `output` (a vec of f64) with water audio (streaming). Dispatches on
# water_type, then DC-blocks the whole buffer and advances the sample cursor.
fn water_process_block(self, output) {
    var wt = Water_water_type(self);
    if (wt == WATER_STREAM) {
        water_process_stream(self, output);
    } elif (wt == WATER_DRIP) {
        water_process_drip(self, output);
    } elif (wt == WATER_SPLASH) {
        water_process_splash(self, output);
    } else {
        water_process_waves(self, output);
    }

    var dc = Water_dc_blocker(self);
    var num = vec_len(output);
    var i = 0;
    while (i < num) {
        vec_set(output, i, garjan_dcblocker_process(dc, vec_get(output, i)));
        i = i + 1;
    }
    Water_set_sample_position(self, Water_sample_position(self) + num);
    return 0;
}

# Synthesize `duration` seconds of water audio into a fresh vec. Returns the
# vec pointer, or a negative code on invalid duration.
#must_use
fn water_synthesize(self, duration) {
    var e = garjan_validate_duration(duration);
    if (garjan_is_err(e) == 1) { return e; }
    var num = f64_to(f64_mul(Water_sample_rate(self), duration));
    var ga_ncheck = garjan_validate_sample_count(num);
    if (garjan_is_err(ga_ncheck) == 1) { return ga_ncheck; }
    var output = vec_new();
    var i = 0;
    while (i < num) {
        vec_push(output, 0);
        i = i + 1;
    }
    water_process_block(self, output);
    return output;
}

# ---- serde: snapshot live state -> WaterParams -> JSON, and back. ----
#must_use
fn water_to_json(self, sb) {
    var p = garjan_alloc(sizeof(WaterParams));
    if (garjan_is_err(p) == 1) { return p; }
    WaterParams_set_water_type(p, Water_water_type(self));
    WaterParams_set_intensity(p, Water_intensity(self));
    WaterParams_set_sample_rate(p, Water_sample_rate(self));
    WaterParams_set_sample_position(p, Water_sample_position(self));
    WaterParams_set_drip_freq(p, Water_drip_freq(self));
    var rng = Water_rng(self);
    WaterParams_set_rng_state(p, Rng_state(rng));
    WaterParams_set_rng_inc(p, Rng_inc(rng));
    var dc = Water_dc_blocker(self);
    WaterParams_set_dcb_x_prev(p, DcBlocker_x_prev(dc));
    WaterParams_set_dcb_y_prev(p, DcBlocker_y_prev(dc));
    WaterParams_set_dcb_r(p, DcBlocker_r(dc));
    # Scalars via the derive, then the naad components' LIVE state spliced
    # in as "dsp" -- without it a restore resumes with zeroed filter memory.
    var psb = str_builder_new();
    var pe = WaterParams_to_json(p, psb);
    if (garjan_is_err(pe) == 1) { return pe; }
    var dsp = bayan_json_v_obj_new();
    bayan_json_v_obj_set(dsp, str_from("sf"), garjan_state_biquad(Water_shape_filter(self)));
    bayan_json_v_obj_set(dsp, str_from("ml"), garjan_state_lfo(Water_mod_lfo(self)));
    bayan_json_v_obj_set(dsp, str_from("ng"), garjan_state_noise(Water_noise_gen(self)));
    return garjan_emit_with_dsp(sb, psb, dsp);
}

# Rebuild a Water from JSON: restore scalars + rng + dc_blocker state, then
# reconstruct the naad components fresh (rebuilt, not restored -- architecture note 001).
#must_use
fn water_from_json_str(json) {
    var p = WaterParams_from_json_str(json);
    # Deserialize must validate what the constructor validates. Before 2.5.1
    # this path relied on a downstream naad component rejecting a bad
    # sample_rate -- which bubble's build_naad cannot do, since it only
    # calls noise_new -- and it never re-checked the enum id at all, so a
    # hostile document could restore an out-of-range one that *_new rejects.
    var vsr = garjan_validate_sample_rate(WaterParams_sample_rate(p));
    if (garjan_is_err(vsr) == 1) { return vsr; }
    if (garjan_enum_invalid(WaterParams_water_type(p), WATER_WAVES) == 1) { return GARJAN_ERR_INVALID_PARAMETER; }
    var self = garjan_alloc(sizeof(Water));
    if (garjan_is_err(self) == 1) { return self; }
    Water_set_water_type(self, WaterParams_water_type(p));
    Water_set_intensity(self, WaterParams_intensity(p));
    Water_set_sample_rate(self, WaterParams_sample_rate(p));
    Water_set_sample_position(self, WaterParams_sample_position(p));
    Water_set_drip_freq(self, WaterParams_drip_freq(p));

    var rng = rng_new(0);
    if (garjan_is_err(rng) == 1) { return rng; }
    Rng_set_state(rng, WaterParams_rng_state(p));
    Rng_set_inc(rng, WaterParams_rng_inc(p));
    Water_set_rng(self, rng);

    var dc = garjan_dcblocker_new(WaterParams_sample_rate(p));
    if (garjan_is_err(dc) == 1) { return dc; }
    DcBlocker_set_x_prev(dc, WaterParams_dcb_x_prev(p));
    DcBlocker_set_y_prev(dc, WaterParams_dcb_y_prev(p));
    DcBlocker_set_r(dc, WaterParams_dcb_r(p));
    Water_set_dc_blocker(self, dc);

    var b = water_build_naad(self);
    if (garjan_is_err(b) == 1) { return b; }

    # Restore the components' live state onto the freshly built ones. A
    # document written before 2.5.0 has no "dsp" member; garjan_dsp_node
    # returns 0 and the synth resumes without it, exactly as it used to.
    var dsp = garjan_dsp_node(json);
    if (dsp != 0) {
        garjan_state_biquad_load(Water_shape_filter(self), bayan_json_v_obj_get(dsp, "sf"));
        garjan_state_lfo_load(Water_mod_lfo(self), bayan_json_v_obj_get(dsp, "ml"));
        garjan_state_noise_load(Water_noise_gen(self), bayan_json_v_obj_get(dsp, "ng"));
    }
    return self;
}

# --- precipitation.cyr ---

# precipitation.cyr -- extended precipitation synthesis: hail, snow,
# surface-dependent rain.
#
# Ports rust-old/src/precipitation.rs. The Cyrius port always uses the naad
# backend (no feature flags), so it ports the naad path (noise_gen +
# shape_filter) and drops the fallback. f32 -> f64. Result<Self> -> pointer /
# negative GARJAN_* code. The naad components
# (noise_gen, shape_filter) AND the modal_bank are reconstructed on
# deserialize from the serialized params (precip_type + stone_size + surface +
# sample_rate deterministically pin them). rng + dc_blocker state ARE
# serialized (via the flattened PrecipitationParams below).
# Requires: error, logging, dsp, rng, material, modal, contact foundations +
# the naad bundle (noise_new/noise_next_sample, filter_biquad_new/
# filter_biquad_process_sample).

# ---- PrecipitationType ----
var PRECIP_HAIL         = 0;
var PRECIP_SNOW         = 1;
var PRECIP_SURFACE_RAIN = 2;

# ---- StoneSize ----
var STONE_SMALL  = 0;
var STONE_MEDIUM = 1;
var STONE_LARGE  = 2;

# StoneSize config: (rate_per_sec, amplitude, decay_ms). Returned as a small
# 3-slot config struct.
#derive(accessors)
struct StoneConfig { rate; amplitude; decay_ms; }

#must_use
fn stone_size_config(s) {
    if (garjan_enum_invalid(s, STONE_LARGE) == 1) { return GARJAN_ERR_INVALID_PARAMETER; }
    var c = garjan_alloc(sizeof(StoneConfig));
    if (garjan_is_err(c) == 1) { return c; }
    if (s == STONE_SMALL) {
        StoneConfig_set_rate(c, f64_from(30));
        StoneConfig_set_amplitude(c, f64_div(f64_from(2), f64_from(10)));
        StoneConfig_set_decay_ms(c, f64_from(5));
    } elif (s == STONE_MEDIUM) {
        StoneConfig_set_rate(c, f64_from(15));
        StoneConfig_set_amplitude(c, f64_div(f64_from(4), f64_from(10)));
        StoneConfig_set_decay_ms(c, f64_from(10));
    } else {
        StoneConfig_set_rate(c, f64_from(5));
        StoneConfig_set_amplitude(c, f64_div(f64_from(7), f64_from(10)));
        StoneConfig_set_decay_ms(c, f64_from(20));
    }
    return c;
}

# ---- PrecipitationParams: the serializable slice. rng + dc_blocker FLATTENED
# to scalars. Enum-valued fields are i64. modal_bank + naad components are NOT
# serialized (rebuilt from these params). ----
#derive(accessors)
#derive(Serialize)
struct PrecipitationParams {
    precip_type: i64;
    stone_size: i64;
    surface: i64;
    sample_rate: f64;
    sample_position: i64;
    rate: f64;
    amplitude: f64;
    decay_samples: i64;
    intensity: f64;
    rng_state: i64;
    rng_inc: i64;
    dcb_x_prev: f64;
    dcb_y_prev: f64;
    dcb_r: f64;
}

# ---- Precipitation: live synth = scalars + live rng/dc_blocker + modal_bank
# ptr (0 = none) + naad component ptrs. ----
#derive(accessors)
struct Precipitation {
    precip_type;
    stone_size;
    surface;
    sample_rate;
    rng;
    dc_blocker;
    sample_position;
    rate;
    amplitude;
    decay_samples;
    intensity;
    modal_bank;
    noise_gen;
    shape_filter;
}

# Build/refresh the modal_bank + naad components from precip_type/surface/
# sample_rate. Shared by precipitation_new and precipitation_from_json_str.
# Returns GARJAN_OK or a negative code if a naad constructor rejects params.
fn precipitation_build_naad(self) {
    var sr = Precipitation_sample_rate(self);
    var precip_type = Precipitation_precip_type(self);
    var surface = Precipitation_surface(self);

    # Modal bank for hail impacts on resonant surfaces.
    var bank = 0;
    if (precip_type == PRECIP_HAIL) {
        var mat = terrain_resonant_material(surface);
        if (mat != CONTACT_NO_MATERIAL) {
            var props = material_properties(mat);
            if (garjan_is_err(props) == 1) { return props; }
            var mode_cfg = material_mode_config(mat);
            if (garjan_is_err(mode_cfg) == 1) { return mode_cfg; }
            var count = MaterialModeConfig_mode_count(mode_cfg);
            if (count > 4) { count = 4; }
            var specs = generate_modes(props, MaterialModeConfig_pattern(mode_cfg), count,
              MaterialModeConfig_damping_factor(mode_cfg));
            if (garjan_is_err(specs) == 1) { return specs; }
            var mb = modal_bank_new(specs, sr);
            if (garjan_is_err(mb) == 1) { return garjan_map_naad_error(mb); }
            bank = mb;
        }
    }
    Precipitation_set_modal_bank(self, bank);

    # Noise generator + bandpass shape filter (naad path).
    var nt = NOISE_WHITE;
    var filter_freq = f64_from(3000);
    if (precip_type == PRECIP_HAIL) {
        nt = NOISE_WHITE;
        filter_freq = f64_from(3000);
    } elif (precip_type == PRECIP_SNOW) {
        nt = NOISE_BROWN;
        filter_freq = f64_from(1500);
    } else {
        var cfg = terrain_noise_config(surface);
        if (garjan_is_err(cfg) == 1) { return cfg; }
        var pref = TerrainNoiseConfig_noise_type(cfg);
        var mapped = NOISE_WHITE;
        if (pref == CONTACT_NOISE_WHITE) { mapped = NOISE_WHITE; }
        elif (pref == CONTACT_NOISE_PINK) { mapped = NOISE_PINK; }
        else { mapped = NOISE_BROWN; }
        nt = mapped;
        filter_freq = TerrainNoiseConfig_filter_freq(cfg);
    }

    var sf = filter_biquad_new(NAAD_FILTER_BANDPASS, sr, filter_freq, f64_div(f64_from(15), f64_from(10)));
    if (garjan_is_err(sf) == 1) { return garjan_map_naad_error(sf); }
    Precipitation_set_noise_gen(self, noise_new(nt, 5050));
    Precipitation_set_shape_filter(self, sf);
    return GARJAN_OK;
}

# Creates a new extended precipitation synthesizer. Returns a pointer or a
# negative code.
#must_use
fn precipitation_new(precip_type, stone_size, surface, sample_rate) {
    if (garjan_enum_invalid(precip_type, PRECIP_SURFACE_RAIN) == 1) { return GARJAN_ERR_INVALID_PARAMETER; }
    if (garjan_enum_invalid(stone_size, STONE_LARGE) == 1) { return GARJAN_ERR_INVALID_PARAMETER; }
    if (garjan_enum_invalid(surface, MATERIAL_CERAMIC) == 1) { return GARJAN_ERR_INVALID_PARAMETER; }
    var e = garjan_validate_sample_rate(sample_rate);
    if (garjan_is_err(e) == 1) { return e; }

    var cfg = stone_size_config(stone_size);
    if (garjan_is_err(cfg) == 1) { return cfg; }
    var rate = StoneConfig_rate(cfg);
    var amplitude = StoneConfig_amplitude(cfg);
    var decay_ms = StoneConfig_decay_ms(cfg);
    # decay_samples = (decay_ms * sample_rate / 1000.0) as usize
    var decay_samples = f64_to(f64_div(f64_mul(decay_ms, sample_rate), f64_from(1000)));

    var self = garjan_alloc(sizeof(Precipitation));
    if (garjan_is_err(self) == 1) { return self; }
    Precipitation_set_precip_type(self, precip_type);
    Precipitation_set_stone_size(self, stone_size);
    Precipitation_set_surface(self, surface);
    Precipitation_set_sample_rate(self, sample_rate);
    var ga_rng1 = rng_new(5050);
    if (garjan_is_err(ga_rng1) == 1) { return ga_rng1; }
    Precipitation_set_rng(self, ga_rng1);
    var ga_dcb2 = garjan_dcblocker_new(sample_rate);
    if (garjan_is_err(ga_dcb2) == 1) { return ga_dcb2; }
    Precipitation_set_dc_blocker(self, ga_dcb2);
    Precipitation_set_sample_position(self, 0);
    Precipitation_set_rate(self, rate);
    Precipitation_set_amplitude(self, amplitude);
    Precipitation_set_decay_samples(self, decay_samples);
    Precipitation_set_intensity(self, F64_ONE);

    var b = precipitation_build_naad(self);
    if (garjan_is_err(b) == 1) { return b; }
    return self;
}

# Sets intensity (0.0-1.0).
fn precipitation_set_intensity(self, intensity) {
    Precipitation_set_intensity(self, f64_clamp(intensity, 0, F64_ONE));
    return 0;
}

# Generate one shaped noise sample (naad path: noise_gen -> shape_filter).
#inline
#must_use
fn precipitation_generate_noise(self) {
    var raw = noise_next_sample(Precipitation_noise_gen(self));
    return filter_biquad_process_sample(Precipitation_shape_filter(self), raw);
}

# Fills `output` (a vec of f64) with precipitation audio (streaming). Ports
# process_block: stochastic impacts, optional modal resonance, DC-block, then
# advance position.
fn precipitation_process_block(self, output) {
    var num_samples = vec_len(output);
    var dc = Precipitation_dc_blocker(self);
    var intensity = Precipitation_intensity(self);

    # Silent path: intensity < 0.001 -> zeros, but still advance the DC blocker.
    var thresh = f64_div(f64_from(1), f64_from(1000));
    if (f64_lt(intensity, thresh) == 1) {
        var s = 0;
        while (s < num_samples) {
            vec_set(output, s, 0);
            garjan_dcblocker_process(dc, 0);
            s = s + 1;
        }
        Precipitation_set_sample_position(self, Precipitation_sample_position(self) + num_samples);
        return 0;
    }

    # Zero the buffer.
    var z = 0;
    while (z < num_samples) {
        vec_set(output, z, 0);
        z = z + 1;
    }

    var rng = Precipitation_rng(self);
    var sr = Precipitation_sample_rate(self);
    var rate = Precipitation_rate(self);
    var amplitude = Precipitation_amplitude(self);
    var decay_samples = Precipitation_decay_samples(self);
    var bank = Precipitation_modal_bank(self);

    var effective_rate = f64_mul(rate, intensity);
    var block_size = f64_to(f64_mul(sr, f64_div(f64_from(1), f64_from(100))));   # sr*0.01
    if (block_size < 1) { block_size = 1; }
    var events_per_block = f64_mul(effective_rate, f64_div(f64_from(1), f64_from(100)));

    var block_start = 0;
    while (block_start < num_samples) {
        var block_end = block_start + block_size;
        if (block_end > num_samples) { block_end = num_samples; }
        var n_events = rng_poisson(rng, events_per_block);

        var ev = 0;
        while (ev < n_events) {
            var width = f64_from(block_end - block_start);
            var offset = f64_to(rng_next_f32_range(rng, 0, width));
            var idx = block_start + offset;
            if (idx < num_samples) {
                var amp = f64_mul(f64_mul(amplitude, intensity),
                  rng_next_f32_range(rng, f64_div(f64_from(3), f64_from(10)), F64_ONE));
                var this_decay = f64_to(f64_mul(rng_next_f32_range(rng, F64_HALF, f64_div(f64_from(15), f64_from(10))),
                    f64_from(decay_samples)));
                var span = this_decay;
                if (num_samples - idx < span) { span = num_samples - idx; }
                var j = 0;
                while (j < span) {
                    var t = f64_div(f64_from(j), f64_from(this_decay));
                    var env = f64_exp(f64_mul(f64_neg(f64_from(5)), t));
                    var noise = precipitation_generate_noise(self);
                    var sample = 0;
                    if (bank != 0) {
                        var exc = f64_mul(f64_mul(noise, env), amp);
                        sample = modal_bank_process_sample(bank, exc);
                    } else {
                        sample = f64_mul(f64_mul(noise, env), amp);
                    }
                    vec_set(output, idx + j, f64_add(vec_get(output, idx + j), sample));
                    j = j + 1;
                }
            }
            ev = ev + 1;
        }
        block_start = block_start + block_size;
    }

    # DC-block the whole buffer, then advance the cursor.
    var i = 0;
    while (i < num_samples) {
        vec_set(output, i, garjan_dcblocker_process(dc, vec_get(output, i)));
        i = i + 1;
    }
    Precipitation_set_sample_position(self, Precipitation_sample_position(self) + num_samples);
    return 0;
}

# Synthesize `duration` seconds of precipitation audio into a fresh vec.
# Returns the vec pointer, or a negative code on invalid duration.
#must_use
fn precipitation_synthesize(self, duration) {
    var e = garjan_validate_duration(duration);
    if (garjan_is_err(e) == 1) { return e; }
    var num = f64_to(f64_mul(Precipitation_sample_rate(self), duration));
    var ga_ncheck = garjan_validate_sample_count(num);
    if (garjan_is_err(ga_ncheck) == 1) { return ga_ncheck; }
    var output = vec_new();
    var i = 0;
    while (i < num) {
        vec_push(output, 0);
        i = i + 1;
    }
    precipitation_process_block(self, output);
    return output;
}

# ---- serde: snapshot live state -> PrecipitationParams -> JSON, and back. ----
#must_use
fn precipitation_to_json(self, sb) {
    var p = garjan_alloc(sizeof(PrecipitationParams));
    if (garjan_is_err(p) == 1) { return p; }
    PrecipitationParams_set_precip_type(p, Precipitation_precip_type(self));
    PrecipitationParams_set_stone_size(p, Precipitation_stone_size(self));
    PrecipitationParams_set_surface(p, Precipitation_surface(self));
    PrecipitationParams_set_sample_rate(p, Precipitation_sample_rate(self));
    PrecipitationParams_set_sample_position(p, Precipitation_sample_position(self));
    PrecipitationParams_set_rate(p, Precipitation_rate(self));
    PrecipitationParams_set_amplitude(p, Precipitation_amplitude(self));
    PrecipitationParams_set_decay_samples(p, Precipitation_decay_samples(self));
    PrecipitationParams_set_intensity(p, Precipitation_intensity(self));
    var rng = Precipitation_rng(self);
    PrecipitationParams_set_rng_state(p, Rng_state(rng));
    PrecipitationParams_set_rng_inc(p, Rng_inc(rng));
    var dc = Precipitation_dc_blocker(self);
    PrecipitationParams_set_dcb_x_prev(p, DcBlocker_x_prev(dc));
    PrecipitationParams_set_dcb_y_prev(p, DcBlocker_y_prev(dc));
    PrecipitationParams_set_dcb_r(p, DcBlocker_r(dc));
    # Scalars via the derive, then the naad components' LIVE state spliced
    # in as "dsp" -- without it a restore resumes with zeroed filter memory.
    var psb = str_builder_new();
    var pe = PrecipitationParams_to_json(p, psb);
    if (garjan_is_err(pe) == 1) { return pe; }
    var dsp = bayan_json_v_obj_new();
    bayan_json_v_obj_set(dsp, str_from("ng"), garjan_state_noise(Precipitation_noise_gen(self)));
    bayan_json_v_obj_set(dsp, str_from("sf"), garjan_state_biquad(Precipitation_shape_filter(self)));
    bayan_json_v_obj_set(dsp, str_from("mb"), garjan_state_modal(Precipitation_modal_bank(self)));
    return garjan_emit_with_dsp(sb, psb, dsp);
}

# Rebuild a Precipitation from JSON: restore scalars + rng + dc_blocker state,
# then reconstruct the modal_bank + naad components fresh (matches Rust's
# rebuilt, not restored -- architecture note 001).
#must_use
fn precipitation_from_json_str(json) {
    var p = PrecipitationParams_from_json_str(json);
    # Deserialize must validate what the constructor validates. Before 2.5.1
    # this path relied on a downstream naad component rejecting a bad
    # sample_rate -- which bubble's build_naad cannot do, since it only
    # calls noise_new -- and it never re-checked the enum id at all, so a
    # hostile document could restore an out-of-range one that *_new rejects.
    var vsr = garjan_validate_sample_rate(PrecipitationParams_sample_rate(p));
    if (garjan_is_err(vsr) == 1) { return vsr; }
    if (garjan_enum_invalid(PrecipitationParams_precip_type(p), PRECIP_SURFACE_RAIN) == 1) {
        return GARJAN_ERR_INVALID_PARAMETER;
    }
    if (garjan_enum_invalid(PrecipitationParams_stone_size(p), STONE_LARGE) == 1) {
        return GARJAN_ERR_INVALID_PARAMETER;
    }
    if (garjan_enum_invalid(PrecipitationParams_surface(p), MATERIAL_CERAMIC) == 1) {
        return GARJAN_ERR_INVALID_PARAMETER;
    }
    var self = garjan_alloc(sizeof(Precipitation));
    if (garjan_is_err(self) == 1) { return self; }
    Precipitation_set_precip_type(self, PrecipitationParams_precip_type(p));
    Precipitation_set_stone_size(self, PrecipitationParams_stone_size(p));
    Precipitation_set_surface(self, PrecipitationParams_surface(p));
    Precipitation_set_sample_rate(self, PrecipitationParams_sample_rate(p));
    Precipitation_set_sample_position(self, PrecipitationParams_sample_position(p));
    Precipitation_set_rate(self, PrecipitationParams_rate(p));
    Precipitation_set_amplitude(self, PrecipitationParams_amplitude(p));
    Precipitation_set_decay_samples(self, PrecipitationParams_decay_samples(p));
    Precipitation_set_intensity(self, PrecipitationParams_intensity(p));

    var rng = rng_new(0);
    if (garjan_is_err(rng) == 1) { return rng; }
    Rng_set_state(rng, PrecipitationParams_rng_state(p));
    Rng_set_inc(rng, PrecipitationParams_rng_inc(p));
    Precipitation_set_rng(self, rng);

    var dc = garjan_dcblocker_new(PrecipitationParams_sample_rate(p));
    if (garjan_is_err(dc) == 1) { return dc; }
    DcBlocker_set_x_prev(dc, PrecipitationParams_dcb_x_prev(p));
    DcBlocker_set_y_prev(dc, PrecipitationParams_dcb_y_prev(p));
    DcBlocker_set_r(dc, PrecipitationParams_dcb_r(p));
    Precipitation_set_dc_blocker(self, dc);

    var b = precipitation_build_naad(self);
    if (garjan_is_err(b) == 1) { return b; }

    # Restore the components' live state onto the freshly built ones. A
    # document written before 2.5.0 has no "dsp" member; garjan_dsp_node
    # returns 0 and the synth resumes without it, exactly as it used to.
    var dsp = garjan_dsp_node(json);
    if (dsp != 0) {
        garjan_state_modal_load(Precipitation_modal_bank(self), bayan_json_v_obj_get(dsp, "mb"));
        garjan_state_noise_load(Precipitation_noise_gen(self), bayan_json_v_obj_get(dsp, "ng"));
        garjan_state_biquad_load(Precipitation_shape_filter(self), bayan_json_v_obj_get(dsp, "sf"));
    }
    return self;
}

# --- bubble.cyr ---

# bubble.cyr -- bubble synthesis: underwater, boiling, viscous, pouring.
#
# Ports rust-old/src/bubble.rs. Models bubbles as stochastic resonant events:
# each bubble is a short decaying sinusoid at a random frequency near the base
# (Minnaert resonance), with a small noise pop at the onset. The Cyrius port
# always uses the naad backend (no feature flags), so it ports the
# naad-backend generate_noise (noise_gen.next_sample()) and drops the rng
# fallback. f32 -> f64. Result<Self> -> pointer / negative GARJAN_* code.
# The naad noise generator is reconstructed on deserialize; rng + dc_blocker +
# sample_position + intensity ARE serialized (via the flattened BubbleParams).
# Requires: error, logging, dsp, rng, creature foundations + the naad bundle
# (noise_new / noise_next_sample).

# ---- BubbleParams: the serializable slice (Rust's fields except the
# reconstructable naad noise_gen), with rng + dc_blocker FLATTENED so
# #derive(Serialize)'s single-pass from_json_str works. Synced to/from the
# live Bubble on (de)serialize. bubble_type is an int tag (BUBBLE_* const). ----
#derive(accessors)
#derive(Serialize)
struct BubbleParams {
    bubble_type: i64;
    sample_rate: f64;
    sample_position: i64;
    base_freq: f64;
    event_rate: f64;
    freq_spread: f64;
    decay_time: f64;
    intensity: f64;
    rng_state: i64;
    rng_inc: i64;
    dcb_x_prev: f64;
    dcb_y_prev: f64;
    dcb_r: f64;
}

# ---- Bubble: live synth = scalars + live rng/dc_blocker + naad noise ptr. ----
#derive(accessors)
struct Bubble {
    bubble_type;
    sample_rate;
    sample_position;
    base_freq;
    event_rate;
    freq_spread;
    decay_time;
    intensity;
    rng;
    dc_blocker;
    noise_gen;
}

# Build/refresh the naad noise generator (white, seed 4040). Shared by
# bubble_new and bubble_from_json_str. Rust serialized the noise_gen's live
# state; this port rebuilds it -- see architecture note 001. noise_new does not
# fail, so this always returns
# GARJAN_OK; kept for structural parity with the other synths.
fn bubble_build_naad(self) {
    Bubble_set_noise_gen(self, noise_new(NOISE_WHITE, 4040));
    return GARJAN_OK;
}

# Creates a new bubble synthesizer. Returns a pointer or a negative code.
#must_use
fn bubble_new(bubble_type, sample_rate) {
    if (garjan_enum_invalid(bubble_type, BUBBLE_POURING) == 1) { return GARJAN_ERR_INVALID_PARAMETER; }
    var e = garjan_validate_sample_rate(sample_rate);
    if (garjan_is_err(e) == 1) { return e; }
    var cfg = creature_bubble_config(bubble_type);
    if (garjan_is_err(cfg) == 1) { return cfg; }

    var self = garjan_alloc(sizeof(Bubble));
    if (garjan_is_err(self) == 1) { return self; }
    Bubble_set_bubble_type(self, bubble_type);
    Bubble_set_sample_rate(self, sample_rate);
    Bubble_set_sample_position(self, 0);
    Bubble_set_base_freq(self, BubbleConfig_base_freq(cfg));
    Bubble_set_event_rate(self, BubbleConfig_event_rate(cfg));
    Bubble_set_freq_spread(self, BubbleConfig_freq_spread(cfg));
    Bubble_set_decay_time(self, BubbleConfig_decay(cfg));
    Bubble_set_intensity(self, F64_ONE);
    var ga_rng1 = rng_new(4040);
    if (garjan_is_err(ga_rng1) == 1) { return ga_rng1; }
    Bubble_set_rng(self, ga_rng1);
    var ga_dcb2 = garjan_dcblocker_new(sample_rate);
    if (garjan_is_err(ga_dcb2) == 1) { return ga_dcb2; }
    Bubble_set_dc_blocker(self, ga_dcb2);
    var b = bubble_build_naad(self);
    if (garjan_is_err(b) == 1) { return b; }
    return self;
}

# Sets the bubble intensity (0.0 = none, 1.0 = vigorous), clamped to [0,1].
fn bubble_set_intensity(self, intensity) {
    Bubble_set_intensity(self, f64_clamp(intensity, 0, F64_ONE));
    return 0;
}

# Fills `output` (a vec of f64) with bubble audio (streaming). Ports
# process_block: stochastic Poisson-scheduled decaying-sinusoid events with an
# onset noise pop, then DC-block, then advance position.
fn bubble_process_block(self, output) {
    var num = vec_len(output);
    var inten = Bubble_intensity(self);
    var sr = Bubble_sample_rate(self);
    var rng = Bubble_rng(self);
    var dc = Bubble_dc_blocker(self);
    var noise_gen = Bubble_noise_gen(self);

    # Silent path: intensity < 0.001. Zero the buffer, still step the dc_blocker
    # once per sample (to match Rust state advancement), advance position.
    if (f64_lt(inten, f64_div(f64_from(1), f64_from(1000))) == 1) {
        var si = 0;
        while (si < num) {
            vec_set(output, si, 0);
            garjan_dcblocker_process(dc, 0);
            si = si + 1;
        }
        Bubble_set_sample_position(self, Bubble_sample_position(self) + num);
        return 0;
    }

    # Zero buffer.
    var z = 0;
    while (z < num) {
        vec_set(output, z, 0);
        z = z + 1;
    }

    # Schedule bubble events via Poisson process.
    var rate = f64_mul(Bubble_event_rate(self), inten);
    var block_size = f64_to(f64_mul(sr, f64_div(f64_from(1), f64_from(100))));   # sr*0.01
    if (block_size < 1) { block_size = 1; }
    var events_per_block = f64_mul(rate, f64_div(f64_from(1), f64_from(100)));   # rate*0.01

    var base_freq = Bubble_base_freq(self);
    var freq_spread = Bubble_freq_spread(self);
    var decay_time = Bubble_decay_time(self);
    # decay_samples = (decay_time * sr) as usize -- constant per block loop.
    var decay_samples = f64_to(f64_mul(decay_time, sr));
    # pop_len = (sr * 0.001) as usize.
    var pop_len = f64_to(f64_mul(sr, f64_div(f64_from(1), f64_from(1000))));
    # decay_time.max(0.001) for the envelope divisor.
    var decay_div = f64_max(decay_time, f64_div(f64_from(1), f64_from(1000)));

    var block_start = 0;
    while (block_start < num) {
        var block_end = block_start + block_size;
        if (block_end > num) { block_end = num; }
        var n_events = rng_poisson(rng, events_per_block);

        var ev = 0;
        while (ev < n_events) {
            var width = f64_from(block_end - block_start);
            var offset = f64_to(rng_next_f32_range(rng, 0, width));
            var idx = block_start + offset;
            if (idx < num) {
                # freq = base_freq + rand[-freq_spread, freq_spread], min 20 Hz.
                var freq = f64_add(base_freq, rng_next_f32_range(rng, f64_neg(freq_spread), freq_spread));
                freq = f64_max(freq, f64_from(20));
                var omega = f64_div(f64_mul(F64_TAU, freq), sr);
                var amp = f64_mul(inten, rng_next_f32_range(rng, f64_div(f64_from(1), f64_from(10)),
                    f64_div(f64_from(4), f64_from(10))));

                # span = decay_samples.min(num - idx).
                var span = decay_samples;
                if (num - idx < span) { span = num - idx; }
                var j = 0;
                while (j < span) {
                    var t = f64_div(f64_from(j), sr);
                    var env = f64_exp(f64_div(f64_neg(t), decay_div));
                    # Resonant tone.
                    var tone = f64_mul(f64_mul(f64_sin(f64_mul(omega, f64_from(j))), env), amp);
                    # Pop noise at onset (first pop_len samples).
                    var pop = 0;
                    if (j < pop_len) {
                        var pop_env = f64_sub(F64_ONE, f64_div(f64_from(j), f64_from(pop_len)));
                        pop = f64_mul(f64_mul(f64_mul(noise_next_sample(noise_gen), pop_env), amp),
                          f64_div(f64_from(3), f64_from(10)));
                    }
                    vec_set(output, idx + j, f64_add(vec_get(output, idx + j), f64_add(tone, pop)));
                    j = j + 1;
                }
            }
            ev = ev + 1;
        }
        block_start = block_start + block_size;
    }

    # DC blocking, then advance the sample cursor.
    var i = 0;
    while (i < num) {
        vec_set(output, i, garjan_dcblocker_process(dc, vec_get(output, i)));
        i = i + 1;
    }
    Bubble_set_sample_position(self, Bubble_sample_position(self) + num);
    return 0;
}

# Synthesize `duration` seconds of bubble audio into a fresh vec. Returns the
# vec pointer, or a negative code on invalid duration.
#must_use
fn bubble_synthesize(self, duration) {
    var e = garjan_validate_duration(duration);
    if (garjan_is_err(e) == 1) { return e; }
    var num = f64_to(f64_mul(Bubble_sample_rate(self), duration));
    var ga_ncheck = garjan_validate_sample_count(num);
    if (garjan_is_err(ga_ncheck) == 1) { return ga_ncheck; }
    var output = vec_new();
    var i = 0;
    while (i < num) {
        vec_push(output, 0);
        i = i + 1;
    }
    bubble_process_block(self, output);
    return output;
}

# ---- serde: snapshot live state -> BubbleParams -> JSON, and back. ----
#must_use
fn bubble_to_json(self, sb) {
    var p = garjan_alloc(sizeof(BubbleParams));
    if (garjan_is_err(p) == 1) { return p; }
    BubbleParams_set_bubble_type(p, Bubble_bubble_type(self));
    BubbleParams_set_sample_rate(p, Bubble_sample_rate(self));
    BubbleParams_set_sample_position(p, Bubble_sample_position(self));
    BubbleParams_set_base_freq(p, Bubble_base_freq(self));
    BubbleParams_set_event_rate(p, Bubble_event_rate(self));
    BubbleParams_set_freq_spread(p, Bubble_freq_spread(self));
    BubbleParams_set_decay_time(p, Bubble_decay_time(self));
    BubbleParams_set_intensity(p, Bubble_intensity(self));
    var rng = Bubble_rng(self);
    BubbleParams_set_rng_state(p, Rng_state(rng));
    BubbleParams_set_rng_inc(p, Rng_inc(rng));
    var dc = Bubble_dc_blocker(self);
    BubbleParams_set_dcb_x_prev(p, DcBlocker_x_prev(dc));
    BubbleParams_set_dcb_y_prev(p, DcBlocker_y_prev(dc));
    BubbleParams_set_dcb_r(p, DcBlocker_r(dc));
    # Scalars via the derive, then the naad components' LIVE state spliced
    # in as "dsp" -- without it a restore resumes with zeroed filter memory.
    var psb = str_builder_new();
    var pe = BubbleParams_to_json(p, psb);
    if (garjan_is_err(pe) == 1) { return pe; }
    var dsp = bayan_json_v_obj_new();
    bayan_json_v_obj_set(dsp, str_from("ng"), garjan_state_noise(Bubble_noise_gen(self)));
    return garjan_emit_with_dsp(sb, psb, dsp);
}

# Rebuild a Bubble from JSON: restore scalars + rng + dc_blocker state, then
# reconstruct the naad noise generator fresh (rebuilt, not restored -- architecture note 001).
#must_use
fn bubble_from_json_str(json) {
    var p = BubbleParams_from_json_str(json);
    # Deserialize must validate what the constructor validates. Before 2.5.1
    # this path relied on a downstream naad component rejecting a bad
    # sample_rate -- which bubble's build_naad cannot do, since it only
    # calls noise_new -- and it never re-checked the enum id at all, so a
    # hostile document could restore an out-of-range one that *_new rejects.
    var vsr = garjan_validate_sample_rate(BubbleParams_sample_rate(p));
    if (garjan_is_err(vsr) == 1) { return vsr; }
    if (garjan_enum_invalid(BubbleParams_bubble_type(p), BUBBLE_POURING) == 1) { return GARJAN_ERR_INVALID_PARAMETER; }
    var self = garjan_alloc(sizeof(Bubble));
    if (garjan_is_err(self) == 1) { return self; }
    Bubble_set_bubble_type(self, BubbleParams_bubble_type(p));
    Bubble_set_sample_rate(self, BubbleParams_sample_rate(p));
    Bubble_set_sample_position(self, BubbleParams_sample_position(p));
    Bubble_set_base_freq(self, BubbleParams_base_freq(p));
    Bubble_set_event_rate(self, BubbleParams_event_rate(p));
    Bubble_set_freq_spread(self, BubbleParams_freq_spread(p));
    Bubble_set_decay_time(self, BubbleParams_decay_time(p));
    Bubble_set_intensity(self, BubbleParams_intensity(p));

    var rng = rng_new(0);
    if (garjan_is_err(rng) == 1) { return rng; }
    Rng_set_state(rng, BubbleParams_rng_state(p));
    Rng_set_inc(rng, BubbleParams_rng_inc(p));
    Bubble_set_rng(self, rng);

    var dc = garjan_dcblocker_new(BubbleParams_sample_rate(p));
    if (garjan_is_err(dc) == 1) { return dc; }
    DcBlocker_set_x_prev(dc, BubbleParams_dcb_x_prev(p));
    DcBlocker_set_y_prev(dc, BubbleParams_dcb_y_prev(p));
    DcBlocker_set_r(dc, BubbleParams_dcb_r(p));
    Bubble_set_dc_blocker(self, dc);

    var b = bubble_build_naad(self);
    if (garjan_is_err(b) == 1) { return b; }

    # Restore the components' live state onto the freshly built ones. A
    # document written before 2.5.0 has no "dsp" member; garjan_dsp_node
    # returns 0 and the synth resumes without it, exactly as it used to.
    var dsp = garjan_dsp_node(json);
    if (dsp != 0) {
        garjan_state_noise_load(Bubble_noise_gen(self), bayan_json_v_obj_get(dsp, "ng"));
    }
    return self;
}

# --- impact.cyr ---

# impact.cyr -- impact & contact sound synthesis: an excitation (half-sine or
# noise burst + material transient) driven through a modal bank, DC-blocked.
#
# Ports rust-old/src/impact.rs. The Cyrius port always uses the naad backend
# (no feature flags), so it ports the naad-backend transient path (naad white
# noise through a bandpass resonance filter) and drops the rng fallback.
# f32 -> f64. Result<Self> -> pointer / negative GARJAN_* code.
#
# The live components -- modal_bank, exciter,
# transient_noise, resonance_filter, excitation_buf -- are NOT serialized; they
# are reconstructed on deserialize (in impact_build_naad) from the serialized
# material + properties + sample_rate. rng + dc_blocker state ARE serialized
# (flattened into ImpactParams). Requires: error, logging, dsp, rng, material,
# modal foundations + the naad bundle (noise_new/noise_next_sample,
# filter_biquad_new/filter_biquad_process_sample).

# ---- ImpactType (enum) -> module-prefixed int constants (declaration order). ----
var IMPACT_TAP     = 0;
var IMPACT_STRIKE  = 1;
var IMPACT_CRASH   = 2;
var IMPACT_SHATTER = 3;

# Force multiplier for an impact type (Rust ImpactType::force).
#must_use
fn impact_type_force(t) {
    if (t == IMPACT_TAP)    { return f64_div(f64_from(2), f64_from(10)); }
    if (t == IMPACT_STRIKE) { return F64_HALF; }
    if (t == IMPACT_CRASH)  { return F64_ONE; }
    return f64_div(f64_from(8), f64_from(10));   # Shatter
}

# Excitation type tag for an impact type (Rust ImpactType::excitation_config).
#must_use
fn impact_type_exc_type(t) {
    if (t == IMPACT_TAP) { return EXCITATION_HALF_SINE; }
    return EXCITATION_NOISE_BURST;   # Strike / Crash / Shatter
}

# Excitation duration in samples for an impact type (Rust excitation_config).
#must_use
fn impact_type_exc_duration(t, sample_rate) {
    if (t == IMPACT_TAP) {
        return f64_to(f64_mul(sample_rate, f64_div(f64_from(2), f64_from(1000))));   # sr*0.002
    }
    if (t == IMPACT_STRIKE) {
        return f64_to(f64_mul(sample_rate, f64_div(f64_from(3), f64_from(1000))));   # sr*0.003
    }
    # Crash / Shatter: sr*0.001
    return f64_to(f64_mul(sample_rate, f64_div(f64_from(1), f64_from(1000))));
}

# ---- ImpactParams: the serializable slice. Rust serialized `material` and
# `props` (== material.properties()) plus rng + dc_blocker + sample_position.
# We flatten material + props scalars + rng + dc_blocker so #derive(Serialize)'s
# single-pass from_json_str roundtrips exactly. ----
#derive(accessors)
#derive(Serialize)
struct ImpactParams {
    material: i64;
    prop_resonance: f64;
    prop_bandwidth: f64;
    prop_decay: f64;
    prop_brightness: f64;
    prop_transient: f64;
    sample_rate: f64;
    sample_position: i64;
    rng_state: i64;
    rng_inc: i64;
    dcb_x_prev: f64;
    dcb_y_prev: f64;
    dcb_r: f64;
}

# ---- Impact: live synth = scalars + props ptr + live rng/dc_blocker + modal
# bank + naad component ptrs + excitation buffer vec. ----
#derive(accessors)
struct Impact {
    material;
    props;
    sample_rate;
    rng;
    dc_blocker;
    sample_position;
    modal_bank;
    excitation_buf;
    transient_noise;
    resonance_filter;
    exciter;
}

# Build/refresh the reconstructable components (modal bank, resonance filter,
# transient noise, excitation buffer) from the material props + sample_rate.
# Shared by impact_new and impact_from_json_str. Returns GARJAN_OK or a
# negative code if a naad constructor / modal bank rejects its params.
fn impact_build_naad(self) {
    var sr = Impact_sample_rate(self);
    var material = Impact_material(self);
    var props = Impact_props(self);

    # Modal bank from the material's mode config + props.
    var mode_cfg = material_mode_config(material);
    if (garjan_is_err(mode_cfg) == 1) { return mode_cfg; }
    var mode_specs = generate_modes(props, MaterialModeConfig_pattern(mode_cfg),
      MaterialModeConfig_mode_count(mode_cfg),
      MaterialModeConfig_damping_factor(mode_cfg));
    if (garjan_is_err(mode_specs) == 1) { return mode_specs; }
    var modal_bank = modal_bank_new(mode_specs, sr);
    if (garjan_is_err(modal_bank) == 1) { return modal_bank; }
    Impact_set_modal_bank(self, modal_bank);

    # Resonance filter: bandpass at props.resonance, q = clamp(resonance/max(bandwidth,1), 0.1, 20).
    var resonance = MaterialProperties_resonance(props);
    var bandwidth = MaterialProperties_bandwidth(props);
    var q = f64_clamp(f64_div(resonance, f64_max(bandwidth, F64_ONE)),
      f64_div(f64_from(1), f64_from(10)), f64_from(20));
    var rf = filter_biquad_new(NAAD_FILTER_BANDPASS, sr, resonance, q);
    if (garjan_is_err(rf) == 1) { return garjan_map_naad_error(rf); }
    Impact_set_resonance_filter(self, rf);

    # Transient noise: white, seed 5381 (matches Rust NoiseGenerator::new(White, 5381)).
    Impact_set_transient_noise(self, noise_new(NOISE_WHITE, 5381));

    # Pre-allocate excitation buffer for max impact duration: ((decay*2 + 0.05) * sr).
    var pdecay = MaterialProperties_decay(props);
    var max_samples = f64_to(f64_mul(f64_add(f64_mul(pdecay, F64_TWO), f64_div(f64_from(5), f64_from(100))), sr));
    if (max_samples < 0) { max_samples = 0; }
    var ebuf = vec_new();
    var i = 0;
    while (i < max_samples) {
        vec_push(ebuf, 0);
        i = i + 1;
    }
    Impact_set_excitation_buf(self, ebuf);

    # One reusable exciter. Its type/duration/amplitude vary per impact, so it
    # is built with placeholders and reconfigured by exciter_reset in
    # impact_generate. Rust built a fresh Exciter per call (rust-old/src/
    # impact.rs:194) and dropped it; the arena here never frees, so a per-call
    # build leaked an Exciter + an Rng on every process_block.
    var exc = exciter_new(EXCITATION_IMPULSE, 0, 0);
    if (garjan_is_err(exc) == 1) { return exc; }
    Impact_set_exciter(self, exc);
    return GARJAN_OK;
}

# Creates a new impact synthesizer for the given material. Returns a pointer
# or a negative code.
#must_use
fn impact_new(material, sample_rate) {
    if (garjan_enum_invalid(material, MATERIAL_CERAMIC) == 1) { return GARJAN_ERR_INVALID_PARAMETER; }
    var e = garjan_validate_sample_rate(sample_rate);
    if (garjan_is_err(e) == 1) { return e; }

    var self = garjan_alloc(sizeof(Impact));
    if (garjan_is_err(self) == 1) { return self; }
    Impact_set_material(self, material);
    var ga_v1 = material_properties(material);
    if (garjan_is_err(ga_v1) == 1) { return ga_v1; }
    Impact_set_props(self, ga_v1);
    Impact_set_sample_rate(self, sample_rate);
    var ga_rng2 = rng_new(5381);
    if (garjan_is_err(ga_rng2) == 1) { return ga_rng2; }
    Impact_set_rng(self, ga_rng2);
    var ga_dcb3 = garjan_dcblocker_new(sample_rate);
    if (garjan_is_err(ga_dcb3) == 1) { return ga_dcb3; }
    Impact_set_dc_blocker(self, ga_dcb3);
    Impact_set_sample_position(self, 0);
    var b = impact_build_naad(self);
    if (garjan_is_err(b) == 1) { return b; }
    return self;
}

# Creates an impact synthesizer for a material interaction. The `surface`
# material provides the resonant modes; `striker` is reserved for future use.
# Currently equivalent to impact_new(surface, sample_rate).
#must_use
fn impact_new_interaction(striker, surface, sample_rate) {
    if (garjan_enum_invalid(striker, MATERIAL_CERAMIC) == 1) { return GARJAN_ERR_INVALID_PARAMETER; }
    if (garjan_enum_invalid(surface, MATERIAL_CERAMIC) == 1) { return GARJAN_ERR_INVALID_PARAMETER; }
    return impact_new(surface, sample_rate);
}

# Returns the material.
#inline
#must_use
fn impact_material(self) {
    return Impact_material(self);
}

# Core generator: fill `output` (a vec of f64) with impact audio for the given
# impact type at the given velocity. Ports generate_impact (naad-backend path).
# Does not reset state; advances sample_position by output length.
fn impact_generate(self, impact_type, velocity, output) {
    if (garjan_enum_invalid(impact_type, IMPACT_SHATTER) == 1) { return GARJAN_ERR_INVALID_PARAMETER; }
    var num_samples = vec_len(output);
    var sr = Impact_sample_rate(self);
    var props = Impact_props(self);
    var rng = Impact_rng(self);
    var ebuf = Impact_excitation_buf(self);

    # Grow the excitation buffer if the block is unexpectedly large.
    while (vec_len(ebuf) < num_samples) {
        vec_push(ebuf, 0);
    }
    # Zero the first num_samples entries.
    var z = 0;
    while (z < num_samples) {
        vec_set(ebuf, z, 0);
        z = z + 1;
    }

    # Primary excitation: build an exciter from the impact type + velocity.
    var exc_type = impact_type_exc_type(impact_type);
    var exc_dur = impact_type_exc_duration(impact_type, sr);
    var exciter = Impact_exciter(self);
    exciter_reset(exciter, exc_type, exc_dur, velocity);

    var transient_noise = Impact_transient_noise(self);
    var resonance_filter = Impact_resonance_filter(self);
    var transient_amp = MaterialProperties_transient(props);
    var transient_len = f64_to(f64_mul(sr, f64_div(f64_from(5), f64_from(1000))));   # sr*0.005
    var sample_position = Impact_sample_position(self);

    var i = 0;
    while (i < num_samples) {
        vec_set(ebuf, i, exciter_next_sample(exciter));
        var abs_pos = sample_position + i;
        if (abs_pos < transient_len) {
            var env = f64_sub(F64_ONE, f64_div(f64_from(abs_pos), f64_from(transient_len)));
            var noise = noise_next_sample(transient_noise);
            var contrib = f64_mul(f64_mul(f64_mul(filter_biquad_process_sample(resonance_filter, noise), env),
                transient_amp), velocity);
            vec_set(ebuf, i, f64_add(vec_get(ebuf, i), contrib));
        }
        i = i + 1;
    }

    # Shatter: add debris impulses into the excitation buffer.
    if (impact_type == IMPACT_SHATTER) {
        var debris_window = f64_to(f64_mul(sr, f64_div(f64_from(2), f64_from(10))));   # sr*0.2
        var n_debris = 3 + rng_poisson(rng, f64_from(5));
        var lo_offset = f64_mul(sr, f64_div(f64_from(1), f64_from(100)));              # sr*0.01
        var d = 0;
        while (d < n_debris) {
            var offset = f64_to(rng_next_f32_range(rng, lo_offset, f64_from(debris_window)));
            if (offset >= num_samples) {
                d = d + 1;
                continue;
            }
            var debris_amp = f64_mul(velocity, rng_next_f32_range(rng, f64_div(f64_from(1), f64_from(10)),
                f64_div(f64_from(4), f64_from(10))));
            var debris_dur = f64_to(rng_next_f32_range(rng, f64_from(3), f64_from(15)));
            var span = debris_dur;
            if (num_samples - offset < span) { span = num_samples - offset; }
            var j = 0;
            while (j < span) {
                var denv = f64_sub(F64_ONE, f64_div(f64_from(j), f64_from(debris_dur)));
                var dn = rng_next_f32(rng);
                vec_set(ebuf, offset + j, f64_add(vec_get(ebuf, offset + j), f64_mul(f64_mul(debris_amp, denv), dn)));
                j = j + 1;
            }
            d = d + 1;
        }
    }

    # Process excitation through the modal bank. process_block reads min(len)
    # samples; ebuf may be longer than num_samples, so pass a num_samples view
    # is not needed -- modal_bank_process_block clamps to min(len(exc),len(out)).
    var modal_bank = Impact_modal_bank(self);
    modal_bank_process_block(modal_bank, ebuf, output);

    # DC blocking, then advance the sample cursor.
    var dc = Impact_dc_blocker(self);
    var k = 0;
    while (k < num_samples) {
        vec_set(output, k, garjan_dcblocker_process(dc, vec_get(output, k)));
        k = k + 1;
    }
    Impact_set_sample_position(self, sample_position + num_samples);
    return 0;
}

# Fills output buffer with impact audio for the given impact type (streaming).
# Does not reset internal state (Rust process_block).
fn impact_process_block(self, impact_type, output) {
    return impact_generate(self, impact_type, impact_type_force(impact_type), output);
}

# Synthesize an impact sound with explicit velocity control into a fresh vec.
# velocity is clamped to [0,1]. Resets sample_position + modal bank first.
# Returns the vec pointer.
#must_use
fn impact_synthesize_velocity(self, impact_type, velocity) {
    var vel = f64_clamp(velocity, 0, F64_ONE);
    var props = Impact_props(self);
    var pdecay = MaterialProperties_decay(props);
    # duration = decay*2 + 0.05
    var duration = f64_add(f64_mul(pdecay, F64_TWO), f64_div(f64_from(5), f64_from(100)));
    var num_samples = f64_to(f64_mul(duration, Impact_sample_rate(self)));
    # The 2.4.0 rollout matched `f64_mul(<Type>_sample_rate(self), duration)` and
    # missed this one, whose operands are the other way round.
    var ga_ncheck = garjan_validate_sample_count(num_samples);
    if (garjan_is_err(ga_ncheck) == 1) { return ga_ncheck; }

    var output = vec_new();
    var i = 0;
    while (i < num_samples) {
        vec_push(output, 0);
        i = i + 1;
    }
    Impact_set_sample_position(self, 0);
    modal_bank_reset(Impact_modal_bank(self));
    impact_generate(self, impact_type, vel, output);
    return output;
}

# Synthesize an impact sound at the impact type's default force. Returns the
# vec pointer.
#must_use
fn impact_synthesize(self, impact_type) {
    return impact_synthesize_velocity(self, impact_type, impact_type_force(impact_type));
}

# ---- serde: snapshot live state -> ImpactParams -> JSON, and back. ----
#must_use
fn impact_to_json(self, sb) {
    var p = garjan_alloc(sizeof(ImpactParams));
    if (garjan_is_err(p) == 1) { return p; }
    ImpactParams_set_material(p, Impact_material(self));
    var props = Impact_props(self);
    ImpactParams_set_prop_resonance(p, MaterialProperties_resonance(props));
    ImpactParams_set_prop_bandwidth(p, MaterialProperties_bandwidth(props));
    ImpactParams_set_prop_decay(p, MaterialProperties_decay(props));
    ImpactParams_set_prop_brightness(p, MaterialProperties_brightness(props));
    ImpactParams_set_prop_transient(p, MaterialProperties_transient(props));
    ImpactParams_set_sample_rate(p, Impact_sample_rate(self));
    ImpactParams_set_sample_position(p, Impact_sample_position(self));
    var rng = Impact_rng(self);
    ImpactParams_set_rng_state(p, Rng_state(rng));
    ImpactParams_set_rng_inc(p, Rng_inc(rng));
    var dc = Impact_dc_blocker(self);
    ImpactParams_set_dcb_x_prev(p, DcBlocker_x_prev(dc));
    ImpactParams_set_dcb_y_prev(p, DcBlocker_y_prev(dc));
    ImpactParams_set_dcb_r(p, DcBlocker_r(dc));
    # Scalars via the derive, then the naad components' LIVE state spliced
    # in as "dsp" -- without it a restore resumes with zeroed filter memory.
    var psb = str_builder_new();
    var pe = ImpactParams_to_json(p, psb);
    if (garjan_is_err(pe) == 1) { return pe; }
    var dsp = bayan_json_v_obj_new();
    bayan_json_v_obj_set(dsp, str_from("rf"), garjan_state_biquad(Impact_resonance_filter(self)));
    bayan_json_v_obj_set(dsp, str_from("tn"), garjan_state_noise(Impact_transient_noise(self)));
    bayan_json_v_obj_set(dsp, str_from("mb"), garjan_state_modal(Impact_modal_bank(self)));
    bayan_json_v_obj_set(dsp, str_from("ex"), garjan_state_exciter(Impact_exciter(self)));
    return garjan_emit_with_dsp(sb, psb, dsp);
}

# Rebuild an Impact from JSON: restore material + props + rng + dc_blocker
# state, then reconstruct the modal bank / naad components fresh.
#must_use
fn impact_from_json_str(json) {
    var p = ImpactParams_from_json_str(json);
    # Deserialize must validate what the constructor validates. Before 2.5.1
    # this path relied on a downstream naad component rejecting a bad
    # sample_rate -- which bubble's build_naad cannot do, since it only
    # calls noise_new -- and it never re-checked the enum id at all, so a
    # hostile document could restore an out-of-range one that *_new rejects.
    var vsr = garjan_validate_sample_rate(ImpactParams_sample_rate(p));
    if (garjan_is_err(vsr) == 1) { return vsr; }
    if (garjan_enum_invalid(ImpactParams_material(p), MATERIAL_CERAMIC) == 1) { return GARJAN_ERR_INVALID_PARAMETER; }
    var self = garjan_alloc(sizeof(Impact));
    if (garjan_is_err(self) == 1) { return self; }
    Impact_set_material(self, ImpactParams_material(p));

    var props = material_properties_new(ImpactParams_prop_resonance(p), ImpactParams_prop_bandwidth(p),
      ImpactParams_prop_decay(p), ImpactParams_prop_brightness(p),
      ImpactParams_prop_transient(p));
    Impact_set_props(self, props);
    Impact_set_sample_rate(self, ImpactParams_sample_rate(p));
    Impact_set_sample_position(self, ImpactParams_sample_position(p));

    var rng = rng_new(0);
    if (garjan_is_err(rng) == 1) { return rng; }
    Rng_set_state(rng, ImpactParams_rng_state(p));
    Rng_set_inc(rng, ImpactParams_rng_inc(p));
    Impact_set_rng(self, rng);

    var dc = garjan_dcblocker_new(ImpactParams_sample_rate(p));
    if (garjan_is_err(dc) == 1) { return dc; }
    DcBlocker_set_x_prev(dc, ImpactParams_dcb_x_prev(p));
    DcBlocker_set_y_prev(dc, ImpactParams_dcb_y_prev(p));
    DcBlocker_set_r(dc, ImpactParams_dcb_r(p));
    Impact_set_dc_blocker(self, dc);

    var b = impact_build_naad(self);
    if (garjan_is_err(b) == 1) { return b; }

    # Restore the components' live state onto the freshly built ones. A
    # document written before 2.5.0 has no "dsp" member; garjan_dsp_node
    # returns 0 and the synth resumes without it, exactly as it used to.
    var dsp = garjan_dsp_node(json);
    if (dsp != 0) {
        garjan_state_modal_load(Impact_modal_bank(self), bayan_json_v_obj_get(dsp, "mb"));
        garjan_state_exciter_load(Impact_exciter(self), bayan_json_v_obj_get(dsp, "ex"));
        garjan_state_biquad_load(Impact_resonance_filter(self), bayan_json_v_obj_get(dsp, "rf"));
        garjan_state_noise_load(Impact_transient_noise(self), bayan_json_v_obj_get(dsp, "tn"));
    }
    return self;
}

# --- footstep.cyr ---

# footstep.cyr -- footstep synthesis: terrain-aware step sequences.
#
# Ports rust-old/src/footstep.rs. Each step combines a terrain noise layer
# (crunch/squish/clack) with optional modal resonance from the surface
# material. The Cyrius port always uses the naad backend (no feature flags):
# it ports the `#[cfg(feature="naad-backend")]` noise_gen + shape_filter path
# and drops the rng-fallback generate_noise. f32 -> f64. Result<Self> ->
# pointer / negative GARJAN_* code.
#
# serde: the naad components (noise_gen,
# shape_filter) plus the reconstructable Exciter / ModalBank are rebuilt on
# deserialize via footstep_build_naad; rng + dc_blocker + all step-timing
# scalars ARE serialized (via the flattened FootstepParams below). The main
# Footstep.rng (seed 8888) is only consumed by fire_step's jitter draw, so
# preserving its state preserves the step sequence.
#
# Requires: error, logging, dsp, rng, material, modal, contact foundations +
# the naad bundle (noise_new/noise_next_sample,
# filter_biquad_new/filter_biquad_process_sample).

# ---- FootstepParams: the serializable slice (Rust's non-component fields,
# with rng + dc_blocker FLATTENED so #derive(Serialize)'s single-pass
# from_json_str works). Enum-valued fields (terrain/movement) are i64.
# step_pending / noise_highpass are 0/1 ints. ----
#derive(accessors)
#derive(Serialize)
struct FootstepParams {
    terrain: i64;
    movement: i64;
    sample_rate: f64;
    sample_position: i64;
    base_step_interval: i64;
    step_interval_samples: i64;
    samples_since_last_step: i64;
    step_force: f64;
    step_pending: i64;
    noise_filter_freq: f64;
    noise_amplitude: f64;
    noise_highpass: i64;
    rng_state: i64;
    rng_inc: i64;
    dcb_x_prev: f64;
    dcb_y_prev: f64;
    dcb_r: f64;
}

# ---- Footstep: live synth = scalars + live rng/dc_blocker + Exciter +
# ModalBank (0 when the terrain has no resonant material) + naad component
# ptrs. ----
#derive(accessors)
struct Footstep {
    terrain;
    movement;
    sample_rate;
    rng;
    dc_blocker;
    sample_position;
    base_step_interval;
    step_interval_samples;
    samples_since_last_step;
    step_force;
    step_pending;
    modal_bank;
    exciter;
    noise_filter_freq;
    noise_amplitude;
    noise_highpass;
    noise_gen;
    shape_filter;
}

# Build/refresh the naad components (noise_gen + shape_filter) plus the
# reconstructable Exciter and ModalBank from the current scalars. Shared by
# footstep_new and footstep_from_json_str. Returns GARJAN_OK or a negative
# code if a naad constructor rejects its params.
fn footstep_build_naad(self) {
    var sr = Footstep_sample_rate(self);
    var terrain = Footstep_terrain(self);
    var movement = Footstep_movement(self);

    # Exciter: HalfSine for Sneak, NoiseBurst otherwise. duration = exc_dur*sr.
    var mc = movement_config(movement);
    if (garjan_is_err(mc) == 1) { return mc; }
    var exc_dur = MovementConfig_excitation_duration(mc);
    var exc_samples = f64_to(f64_mul(exc_dur, sr));
    var force = MovementConfig_force(mc);
    var exc_type = EXCITATION_NOISE_BURST;
    if (movement == MOVEMENT_SNEAK) { exc_type = EXCITATION_HALF_SINE; }
    var ga_exc1 = exciter_new(exc_type, exc_samples, force);
    if (garjan_is_err(ga_exc1) == 1) { return ga_exc1; }
    Footstep_set_exciter(self, ga_exc1);

    # Modal bank from the terrain's resonant material (0 = none).
    var mat = terrain_resonant_material(terrain);
    if (mat == CONTACT_NO_MATERIAL) {
        Footstep_set_modal_bank(self, 0);
    } else {
        var props = material_properties(mat);
        if (garjan_is_err(props) == 1) { return props; }
        var mode_cfg = material_mode_config(mat);
        if (garjan_is_err(mode_cfg) == 1) { return mode_cfg; }
        var specs = generate_modes(props, MaterialModeConfig_pattern(mode_cfg),
          MaterialModeConfig_mode_count(mode_cfg),
          MaterialModeConfig_damping_factor(mode_cfg));
        if (garjan_is_err(specs) == 1) { return specs; }
        var bank = modal_bank_new(specs, sr);
        if (garjan_is_err(bank) == 1) { return garjan_map_naad_error(bank); }
        Footstep_set_modal_bank(self, bank);
    }

    # Noise generator: white/pink/brown per terrain config (seed 8888).
    var noise_cfg = terrain_noise_config(terrain);
    if (garjan_is_err(noise_cfg) == 1) { return noise_cfg; }
    Footstep_set_noise_gen(self, noise_new(TerrainNoiseConfig_noise_type(noise_cfg), 8888));

    # Shape filter: highpass or lowpass per config.
    var ft = NAAD_FILTER_LOWPASS;
    if (TerrainNoiseConfig_highpass(noise_cfg) == 1) { ft = NAAD_FILTER_HIGHPASS; }
    var sf = filter_biquad_new(ft, sr, TerrainNoiseConfig_filter_freq(noise_cfg),
      TerrainNoiseConfig_filter_q(noise_cfg));
    if (garjan_is_err(sf) == 1) { return garjan_map_naad_error(sf); }
    Footstep_set_shape_filter(self, sf);
    return GARJAN_OK;
}

# Creates a new footstep synthesizer. Returns a pointer or a negative code.
#must_use
fn footstep_new(terrain, movement, sample_rate) {
    if (garjan_enum_invalid(terrain, TERRAIN_WET) == 1) { return GARJAN_ERR_INVALID_PARAMETER; }
    if (garjan_enum_invalid(movement, MOVEMENT_JUMP_LAND) == 1) { return GARJAN_ERR_INVALID_PARAMETER; }
    var e = garjan_validate_sample_rate(sample_rate);
    if (garjan_is_err(e) == 1) { return e; }

    var mc = movement_config(movement);
    if (garjan_is_err(mc) == 1) { return mc; }
    var interval = MovementConfig_step_interval(mc);
    var force = MovementConfig_force(mc);
    var step_interval_samples = 0;
    if (f64_gt(interval, 0) == 1) {
        step_interval_samples = f64_to(f64_mul(interval, sample_rate));
    }

    var noise_cfg = terrain_noise_config(terrain);
    if (garjan_is_err(noise_cfg) == 1) { return noise_cfg; }

    var self = garjan_alloc(sizeof(Footstep));
    if (garjan_is_err(self) == 1) { return self; }
    Footstep_set_terrain(self, terrain);
    Footstep_set_movement(self, movement);
    Footstep_set_sample_rate(self, sample_rate);
    var ga_rng2 = rng_new(8888);
    if (garjan_is_err(ga_rng2) == 1) { return ga_rng2; }
    Footstep_set_rng(self, ga_rng2);
    var ga_dcb3 = garjan_dcblocker_new(sample_rate);
    if (garjan_is_err(ga_dcb3) == 1) { return ga_dcb3; }
    Footstep_set_dc_blocker(self, ga_dcb3);
    Footstep_set_sample_position(self, 0);
    Footstep_set_base_step_interval(self, step_interval_samples);
    Footstep_set_step_interval_samples(self, step_interval_samples);
    # samples_since_last_step = step_interval_samples (trigger immediately)
    Footstep_set_samples_since_last_step(self, step_interval_samples);
    Footstep_set_step_force(self, force);
    var pending = 0;
    if (movement == MOVEMENT_JUMP_LAND) { pending = 1; }
    Footstep_set_step_pending(self, pending);
    Footstep_set_noise_filter_freq(self, TerrainNoiseConfig_filter_freq(noise_cfg));
    Footstep_set_noise_amplitude(self, TerrainNoiseConfig_amplitude(noise_cfg));
    Footstep_set_noise_highpass(self, TerrainNoiseConfig_highpass(noise_cfg));

    var b = footstep_build_naad(self);
    if (garjan_is_err(b) == 1) { return b; }
    return self;
}

# Manually triggers a single footstep event (sets step_pending).
fn footstep_trigger_step(self) {
    Footstep_set_step_pending(self, 1);
    return 0;
}

# fire_step: reset step counter, clear pending, trigger exciter, reset modal
# bank, and apply jitter from base interval (prevents cumulative drift).
fn footstep_fire_step(self) {
    Footstep_set_samples_since_last_step(self, 0);
    Footstep_set_step_pending(self, 0);
    exciter_trigger(Footstep_exciter(self));
    var bank = Footstep_modal_bank(self);
    if (bank != 0) { modal_bank_reset(bank); }
    var base = Footstep_base_step_interval(self);
    if (base > 0) {
        # jitter = 1.0 + rng.next_f32_range(-0.05, 0.05)
        var span = f64_div(f64_from(5), f64_from(100));
        var jitter = f64_add(F64_ONE, rng_next_f32_range(Footstep_rng(self), f64_neg(span), span));
        Footstep_set_step_interval_samples(self, f64_to(f64_mul(f64_from(base), jitter)));
    }
    return 0;
}

# generate_noise: one raw noise sample through the shape filter (naad path).
#inline
#must_use
fn footstep_generate_noise(self) {
    var raw = noise_next_sample(Footstep_noise_gen(self));
    return filter_biquad_process_sample(Footstep_shape_filter(self), raw);
}

# Fills `output` (a vec of f64) with footstep audio (streaming). Ports
# process_block: per-sample step trigger check, excitation, noise-envelope
# layer, modal resonance, mix, DC-block, advance position.
fn footstep_process_block(self, output) {
    var num = vec_len(output);
    var exciter = Footstep_exciter(self);
    var dc = Footstep_dc_blocker(self);
    var sr = Footstep_sample_rate(self);
    var step_force = Footstep_step_force(self);
    var noise_amp = Footstep_noise_amplitude(self);

    # noise-window length = (sample_rate * 0.03) as usize.
    var window_f = f64_mul(sr, f64_div(f64_from(3), f64_from(100)));
    var window = f64_to(window_f);
    var neg5 = f64_neg(f64_from(5));
    var mod03 = f64_div(f64_from(3), f64_from(10));

    var bank = Footstep_modal_bank(self);

    var i = 0;
    while (i < num) {
        # Check if a step should trigger.
        var step_interval = Footstep_step_interval_samples(self);
        var since = Footstep_samples_since_last_step(self);
        var fire = 0;
        if (Footstep_step_pending(self) == 1) {
            fire = 1;
        } elif (step_interval > 0) {
            if (since >= step_interval) { fire = 1; }
        }
        if (fire == 1) { footstep_fire_step(self); }

        # Generate excitation.
        var exc = exciter_next_sample(exciter);

        # Noise layer (terrain character): exp(-5*t) envelope over 0.03s window.
        var cur_since = Footstep_samples_since_last_step(self);
        var noise_env = 0;
        if (cur_since < window) {
            var t = f64_div(f64_from(cur_since), window_f);
            noise_env = f64_exp(f64_mul(neg5, t));
        }
        var noise = f64_mul(f64_mul(footstep_generate_noise(self), noise_env), step_force);

        # Modal resonance (or exc*0.5 when no resonant material). `bank` is
        # hoisted above the loop: footstep_fire_step resets the bank's STATE but
        # never reassigns the pointer, so it is loop-invariant.
        var resonant = 0;
        if (bank != 0) {
            resonant = modal_bank_process_sample(bank, f64_add(exc, f64_mul(noise, mod03)));
        } else {
            resonant = f64_mul(exc, F64_HALF);
        }

        var s = f64_add(resonant, f64_mul(noise, noise_amp));
        vec_set(output, i, garjan_dcblocker_process(dc, s));

        Footstep_set_samples_since_last_step(self, cur_since + 1);
        i = i + 1;
    }
    Footstep_set_sample_position(self, Footstep_sample_position(self) + num);
    return 0;
}

# Synthesize `duration` seconds of footstep audio into a fresh vec. Returns
# the vec pointer, or a negative code on invalid duration.
#must_use
fn footstep_synthesize(self, duration) {
    var e = garjan_validate_duration(duration);
    if (garjan_is_err(e) == 1) { return e; }
    var num = f64_to(f64_mul(Footstep_sample_rate(self), duration));
    var ga_ncheck = garjan_validate_sample_count(num);
    if (garjan_is_err(ga_ncheck) == 1) { return ga_ncheck; }
    var output = vec_new();
    var i = 0;
    while (i < num) {
        vec_push(output, 0);
        i = i + 1;
    }
    footstep_process_block(self, output);
    return output;
}

# ---- serde: snapshot live state -> FootstepParams -> JSON, and back. ----
#must_use
fn footstep_to_json(self, sb) {
    var p = garjan_alloc(sizeof(FootstepParams));
    if (garjan_is_err(p) == 1) { return p; }
    FootstepParams_set_terrain(p, Footstep_terrain(self));
    FootstepParams_set_movement(p, Footstep_movement(self));
    FootstepParams_set_sample_rate(p, Footstep_sample_rate(self));
    FootstepParams_set_sample_position(p, Footstep_sample_position(self));
    FootstepParams_set_base_step_interval(p, Footstep_base_step_interval(self));
    FootstepParams_set_step_interval_samples(p, Footstep_step_interval_samples(self));
    FootstepParams_set_samples_since_last_step(p, Footstep_samples_since_last_step(self));
    FootstepParams_set_step_force(p, Footstep_step_force(self));
    FootstepParams_set_step_pending(p, Footstep_step_pending(self));
    FootstepParams_set_noise_filter_freq(p, Footstep_noise_filter_freq(self));
    FootstepParams_set_noise_amplitude(p, Footstep_noise_amplitude(self));
    FootstepParams_set_noise_highpass(p, Footstep_noise_highpass(self));
    var rng = Footstep_rng(self);
    FootstepParams_set_rng_state(p, Rng_state(rng));
    FootstepParams_set_rng_inc(p, Rng_inc(rng));
    var dc = Footstep_dc_blocker(self);
    FootstepParams_set_dcb_x_prev(p, DcBlocker_x_prev(dc));
    FootstepParams_set_dcb_y_prev(p, DcBlocker_y_prev(dc));
    FootstepParams_set_dcb_r(p, DcBlocker_r(dc));
    # Scalars via the derive, then the naad components' LIVE state spliced
    # in as "dsp" -- without it a restore resumes with zeroed filter memory.
    var psb = str_builder_new();
    var pe = FootstepParams_to_json(p, psb);
    if (garjan_is_err(pe) == 1) { return pe; }
    var dsp = bayan_json_v_obj_new();
    bayan_json_v_obj_set(dsp, str_from("ng"), garjan_state_noise(Footstep_noise_gen(self)));
    bayan_json_v_obj_set(dsp, str_from("sf"), garjan_state_biquad(Footstep_shape_filter(self)));
    bayan_json_v_obj_set(dsp, str_from("mb"), garjan_state_modal(Footstep_modal_bank(self)));
    bayan_json_v_obj_set(dsp, str_from("ex"), garjan_state_exciter(Footstep_exciter(self)));
    return garjan_emit_with_dsp(sb, psb, dsp);
}

# Rebuild a Footstep from JSON: restore scalars + rng + dc_blocker state, then
# reconstruct the Exciter / ModalBank / naad components fresh.
#must_use
fn footstep_from_json_str(json) {
    var p = FootstepParams_from_json_str(json);
    # Deserialize must validate what the constructor validates. Before 2.5.1
    # this path relied on a downstream naad component rejecting a bad
    # sample_rate -- which bubble's build_naad cannot do, since it only
    # calls noise_new -- and it never re-checked the enum id at all, so a
    # hostile document could restore an out-of-range one that *_new rejects.
    var vsr = garjan_validate_sample_rate(FootstepParams_sample_rate(p));
    if (garjan_is_err(vsr) == 1) { return vsr; }
    if (garjan_enum_invalid(FootstepParams_terrain(p), TERRAIN_WET) == 1) { return GARJAN_ERR_INVALID_PARAMETER; }
    if (garjan_enum_invalid(FootstepParams_movement(p), MOVEMENT_JUMP_LAND) == 1) {
        return GARJAN_ERR_INVALID_PARAMETER;
    }
    var self = garjan_alloc(sizeof(Footstep));
    if (garjan_is_err(self) == 1) { return self; }
    Footstep_set_terrain(self, FootstepParams_terrain(p));
    Footstep_set_movement(self, FootstepParams_movement(p));
    Footstep_set_sample_rate(self, FootstepParams_sample_rate(p));
    Footstep_set_sample_position(self, FootstepParams_sample_position(p));
    Footstep_set_base_step_interval(self, FootstepParams_base_step_interval(p));
    Footstep_set_step_interval_samples(self, FootstepParams_step_interval_samples(p));
    Footstep_set_samples_since_last_step(self, FootstepParams_samples_since_last_step(p));
    Footstep_set_step_force(self, FootstepParams_step_force(p));
    Footstep_set_step_pending(self, FootstepParams_step_pending(p));
    Footstep_set_noise_filter_freq(self, FootstepParams_noise_filter_freq(p));
    Footstep_set_noise_amplitude(self, FootstepParams_noise_amplitude(p));
    Footstep_set_noise_highpass(self, FootstepParams_noise_highpass(p));

    var rng = rng_new(0);
    if (garjan_is_err(rng) == 1) { return rng; }
    Rng_set_state(rng, FootstepParams_rng_state(p));
    Rng_set_inc(rng, FootstepParams_rng_inc(p));
    Footstep_set_rng(self, rng);

    var dc = garjan_dcblocker_new(FootstepParams_sample_rate(p));
    if (garjan_is_err(dc) == 1) { return dc; }
    DcBlocker_set_x_prev(dc, FootstepParams_dcb_x_prev(p));
    DcBlocker_set_y_prev(dc, FootstepParams_dcb_y_prev(p));
    DcBlocker_set_r(dc, FootstepParams_dcb_r(p));
    Footstep_set_dc_blocker(self, dc);

    var b = footstep_build_naad(self);
    if (garjan_is_err(b) == 1) { return b; }

    # Restore the components' live state onto the freshly built ones. A
    # document written before 2.5.0 has no "dsp" member; garjan_dsp_node
    # returns 0 and the synth resumes without it, exactly as it used to.
    var dsp = garjan_dsp_node(json);
    if (dsp != 0) {
        garjan_state_modal_load(Footstep_modal_bank(self), bayan_json_v_obj_get(dsp, "mb"));
        garjan_state_exciter_load(Footstep_exciter(self), bayan_json_v_obj_get(dsp, "ex"));
        garjan_state_noise_load(Footstep_noise_gen(self), bayan_json_v_obj_get(dsp, "ng"));
        garjan_state_biquad_load(Footstep_shape_filter(self), bayan_json_v_obj_get(dsp, "sf"));
    }
    return self;
}

# --- friction.cyr ---

# friction.cyr -- friction synthesis: scraping, sliding, grinding.
#
# Ports rust-old/src/friction.rs. Models stick-slip friction: the contact
# alternates between static (stuck) and kinetic (slipping) friction, creating
# quasi-periodic excitation through a material's resonant modes. The Cyrius
# port always uses the naad backend (no feature flags): it ports the naad
# generate_noise path (noise_gen + shape_filter) and drops the rng fallback.
# f32 -> f64. Result<Self> -> pointer / negative GARJAN_* code.
#
# The naad components (noise_gen, shape_filter)
# plus the reconstructable modal_bank are NOT serialized; they are rebuilt on
# deserialize in friction_build_naad from friction_type/surface/sample_rate.
# The scalar params + rng + dc_blocker state ARE serialized (via the flattened
# FrictionParams below).
#
# Requires: error, logging, dsp, rng, material, modal, contact foundations +
# the naad bundle (noise_new/noise_next_sample, filter_biquad_new/
# filter_biquad_process_sample).

# ---- FrictionParams: the serializable slice (Rust's non-naad fields, with
# rng + dc_blocker FLATTENED so #derive(Serialize)'s single-pass from_json_str
# works). friction_type + surface are enum ints. Synced to/from the live
# Friction on (de)serialize; modal_bank is rebuilt, not serialized. ----
#derive(accessors)
#derive(Serialize)
struct FrictionParams {
    friction_type: i64;
    surface: i64;
    sample_rate: f64;
    sample_position: i64;
    slip_phase: f64;
    stick_threshold: f64;
    base_rate: f64;
    noise_mix: f64;
    velocity: f64;
    pressure: f64;
    rng_state: i64;
    rng_inc: i64;
    dcb_x_prev: f64;
    dcb_y_prev: f64;
    dcb_r: f64;
}

# ---- Friction: live synth = scalars + live rng/dc_blocker + rebuilt modal
# bank + naad component ptrs. ----
#derive(accessors)
struct Friction {
    friction_type;
    surface;
    sample_rate;
    sample_position;
    slip_phase;
    stick_threshold;
    base_rate;
    noise_mix;
    velocity;
    pressure;
    rng;
    dc_blocker;
    modal_bank;
    noise_gen;
    shape_filter;
}

# Bandpass shape-filter center frequency for a friction type (Rust match).
#must_use
fn friction_filter_freq(friction_type) {
    if (friction_type == FRICTION_SCRAPE) { return f64_from(2000); }
    if (friction_type == FRICTION_SLIDE)  { return f64_from(3000); }
    return f64_from(800);   # Grind
}

# Build/refresh the modal bank + naad components from friction_type, surface,
# and sample_rate. Shared by friction_new and friction_from_json_str. Returns
# GARJAN_OK, or a negative code if a component constructor rejects its params.
fn friction_build_naad(self) {
    var sr = Friction_sample_rate(self);
    var surface = Friction_surface(self);
    var friction_type = Friction_friction_type(self);

    # Modal bank: generate_modes(props, pattern, mode_count.min(6), damping).
    var props = material_properties(surface);
    if (garjan_is_err(props) == 1) { return props; }
    var mode_cfg = material_mode_config(surface);
    if (garjan_is_err(mode_cfg) == 1) { return mode_cfg; }
    var count = MaterialModeConfig_mode_count(mode_cfg);
    if (count > 6) { count = 6; }
    var specs = generate_modes(props, MaterialModeConfig_pattern(mode_cfg), count,
      MaterialModeConfig_damping_factor(mode_cfg));
    if (garjan_is_err(specs) == 1) { return specs; }
    var bank = modal_bank_new(specs, sr);
    if (garjan_is_err(bank) == 1) { return garjan_map_naad_error(bank); }
    Friction_set_modal_bank(self, bank);

    # Bandpass shape filter (naad), q = 1.5.
    var filter_freq = friction_filter_freq(friction_type);
    var sf = filter_biquad_new(NAAD_FILTER_BANDPASS, sr, filter_freq, f64_div(f64_from(15), f64_from(10)));
    if (garjan_is_err(sf) == 1) { return garjan_map_naad_error(sf); }
    Friction_set_shape_filter(self, sf);

    # White noise generator seeded 7777 (matches Rust).
    Friction_set_noise_gen(self, noise_new(NOISE_WHITE, 7777));
    return GARJAN_OK;
}

# Creates a new friction synthesizer. Returns a pointer or a negative code.
#must_use
fn friction_new(friction_type, surface, sample_rate) {
    if (garjan_enum_invalid(friction_type, FRICTION_GRIND) == 1) { return GARJAN_ERR_INVALID_PARAMETER; }
    if (garjan_enum_invalid(surface, MATERIAL_CERAMIC) == 1) { return GARJAN_ERR_INVALID_PARAMETER; }
    var e = garjan_validate_sample_rate(sample_rate);
    if (garjan_is_err(e) == 1) { return e; }

    # (base_rate, stick_threshold, noise_mix) per friction type (Rust match).
    var base_rate = 0;
    var stick_threshold = 0;
    var noise_mix = 0;
    if (friction_type == FRICTION_SCRAPE) {
        base_rate = f64_from(200);
        stick_threshold = f64_div(f64_from(8), f64_from(10));    # 0.8
        noise_mix = f64_div(f64_from(3), f64_from(10));          # 0.3
    } elif (friction_type == FRICTION_SLIDE) {
        base_rate = f64_from(400);
        stick_threshold = F64_HALF;                              # 0.5
        noise_mix = f64_div(f64_from(15), f64_from(100));        # 0.15
    } else {
        # Grind
        base_rate = f64_from(60);
        stick_threshold = f64_div(f64_from(12), f64_from(10));   # 1.2
        noise_mix = F64_HALF;                                    # 0.5
    }

    var self = garjan_alloc(sizeof(Friction));
    if (garjan_is_err(self) == 1) { return self; }
    Friction_set_friction_type(self, friction_type);
    Friction_set_surface(self, surface);
    Friction_set_sample_rate(self, sample_rate);
    Friction_set_sample_position(self, 0);
    Friction_set_slip_phase(self, 0);
    Friction_set_stick_threshold(self, stick_threshold);
    Friction_set_base_rate(self, base_rate);
    Friction_set_noise_mix(self, noise_mix);
    Friction_set_velocity(self, 0);
    Friction_set_pressure(self, F64_HALF);
    var ga_rng1 = rng_new(7777);
    if (garjan_is_err(ga_rng1) == 1) { return ga_rng1; }
    Friction_set_rng(self, ga_rng1);
    var ga_dcb2 = garjan_dcblocker_new(sample_rate);
    if (garjan_is_err(ga_dcb2) == 1) { return ga_dcb2; }
    Friction_set_dc_blocker(self, ga_dcb2);

    var b = friction_build_naad(self);
    if (garjan_is_err(b) == 1) { return b; }
    return self;
}

# Sets the friction velocity (0.0 = still, 1.0 = fast).
fn friction_set_velocity(self, velocity) {
    Friction_set_velocity(self, f64_clamp(velocity, 0, F64_ONE));
    return 0;
}

# Sets the contact pressure (0.0 = light, 1.0 = heavy).
fn friction_set_pressure(self, pressure) {
    Friction_set_pressure(self, f64_clamp(pressure, 0, F64_ONE));
    return 0;
}

# One shaped-noise sample: white noise through the bandpass shape filter.
#inline
#must_use
fn friction_generate_noise(self) {
    var raw = noise_next_sample(Friction_noise_gen(self));
    return filter_biquad_process_sample(Friction_shape_filter(self), raw);
}

# Fills `output` (a vec of f64) with friction audio (streaming). Ports
# process_block: per-sample stick-slip excitation + shaped noise, modal
# resonance, DC-block, then advance position.
fn friction_process_block(self, output) {
    var num = vec_len(output);
    var rng = Friction_rng(self);
    var dc = Friction_dc_blocker(self);
    var modal_bank = Friction_modal_bank(self);
    var sr = Friction_sample_rate(self);
    var base_rate = Friction_base_rate(self);
    var stick_threshold = Friction_stick_threshold(self);
    var noise_mix = Friction_noise_mix(self);

    var vel_floor = f64_div(F64_ONE, f64_from(1000));   # 0.001
    var neg_jit = f64_neg(f64_div(F64_ONE, f64_from(10)));   # -0.1
    var pos_jit = f64_div(F64_ONE, f64_from(10));            # 0.1
    var half_c = F64_HALF;
    var micro_c = f64_div(f64_from(2), f64_from(100));       # 0.02

    # Neither field is written anywhere in the loop, so read them once instead
    # of through an accessor call on every sample.
    var velocity = Friction_velocity(self);
    var pressure = Friction_pressure(self);

    var i = 0;
    while (i < num) {
        if (f64_lt(velocity, vel_floor) == 1) {
            vec_set(output, i, 0);
            garjan_dcblocker_process(dc, 0);
        } else {
            # Advance stick-slip phase: += velocity*base_rate*jitter / sample_rate.
            var jitter = f64_add(F64_ONE, rng_next_f32_range(rng, neg_jit, pos_jit));
            var phase_inc = f64_div(f64_mul(f64_mul(velocity, base_rate), jitter), sr);
            var slip_phase = f64_add(Friction_slip_phase(self), phase_inc);

            # Slip event vs micro-noise during stick.
            var excitation = 0;
            if (f64_ge(slip_phase, stick_threshold) == 1) {
                slip_phase = f64_sub(slip_phase, stick_threshold);
                excitation = f64_mul(pressure, half_c);
            } else {
                excitation = f64_mul(f64_mul(f64_mul(pressure, velocity), rng_next_f32(rng)), micro_c);
            }
            Friction_set_slip_phase(self, slip_phase);

            # Continuous shaped-noise component.
            var noise = f64_mul(f64_mul(f64_mul(friction_generate_noise(self), velocity), pressure), noise_mix);

            # Modal resonance + noise, then DC-block.
            var resonant = modal_bank_process_sample(modal_bank, excitation);
            var mixed = f64_add(resonant, noise);
            vec_set(output, i, garjan_dcblocker_process(dc, mixed));
        }
        i = i + 1;
    }
    Friction_set_sample_position(self, Friction_sample_position(self) + num);
    return 0;
}

# Synthesize `duration` seconds of friction audio into a fresh vec. Returns
# the vec pointer, or a negative code on invalid duration.
#must_use
fn friction_synthesize(self, duration) {
    var e = garjan_validate_duration(duration);
    if (garjan_is_err(e) == 1) { return e; }
    var num = f64_to(f64_mul(Friction_sample_rate(self), duration));
    var ga_ncheck = garjan_validate_sample_count(num);
    if (garjan_is_err(ga_ncheck) == 1) { return ga_ncheck; }
    var output = vec_new();
    var i = 0;
    while (i < num) {
        vec_push(output, 0);
        i = i + 1;
    }
    friction_process_block(self, output);
    return output;
}

# ---- serde: snapshot live state -> FrictionParams -> JSON, and back. ----
#must_use
fn friction_to_json(self, sb) {
    var p = garjan_alloc(sizeof(FrictionParams));
    if (garjan_is_err(p) == 1) { return p; }
    FrictionParams_set_friction_type(p, Friction_friction_type(self));
    FrictionParams_set_surface(p, Friction_surface(self));
    FrictionParams_set_sample_rate(p, Friction_sample_rate(self));
    FrictionParams_set_sample_position(p, Friction_sample_position(self));
    FrictionParams_set_slip_phase(p, Friction_slip_phase(self));
    FrictionParams_set_stick_threshold(p, Friction_stick_threshold(self));
    FrictionParams_set_base_rate(p, Friction_base_rate(self));
    FrictionParams_set_noise_mix(p, Friction_noise_mix(self));
    FrictionParams_set_velocity(p, Friction_velocity(self));
    FrictionParams_set_pressure(p, Friction_pressure(self));
    var rng = Friction_rng(self);
    FrictionParams_set_rng_state(p, Rng_state(rng));
    FrictionParams_set_rng_inc(p, Rng_inc(rng));
    var dc = Friction_dc_blocker(self);
    FrictionParams_set_dcb_x_prev(p, DcBlocker_x_prev(dc));
    FrictionParams_set_dcb_y_prev(p, DcBlocker_y_prev(dc));
    FrictionParams_set_dcb_r(p, DcBlocker_r(dc));
    # Scalars via the derive, then the naad components' LIVE state spliced
    # in as "dsp" -- without it a restore resumes with zeroed filter memory.
    var psb = str_builder_new();
    var pe = FrictionParams_to_json(p, psb);
    if (garjan_is_err(pe) == 1) { return pe; }
    var dsp = bayan_json_v_obj_new();
    bayan_json_v_obj_set(dsp, str_from("sf"), garjan_state_biquad(Friction_shape_filter(self)));
    bayan_json_v_obj_set(dsp, str_from("ng"), garjan_state_noise(Friction_noise_gen(self)));
    bayan_json_v_obj_set(dsp, str_from("mb"), garjan_state_modal(Friction_modal_bank(self)));
    return garjan_emit_with_dsp(sb, psb, dsp);
}

# Rebuild a Friction from JSON: restore scalars + rng + dc_blocker state, then
# reconstruct the modal bank + naad components fresh (matches Rust's
# skip/reconstruct semantics).
#must_use
fn friction_from_json_str(json) {
    var p = FrictionParams_from_json_str(json);
    # Deserialize must validate what the constructor validates. Before 2.5.1
    # this path relied on a downstream naad component rejecting a bad
    # sample_rate -- which bubble's build_naad cannot do, since it only
    # calls noise_new -- and it never re-checked the enum id at all, so a
    # hostile document could restore an out-of-range one that *_new rejects.
    var vsr = garjan_validate_sample_rate(FrictionParams_sample_rate(p));
    if (garjan_is_err(vsr) == 1) { return vsr; }
    if (garjan_enum_invalid(FrictionParams_friction_type(p), FRICTION_GRIND) == 1) {
        return GARJAN_ERR_INVALID_PARAMETER;
    }
    if (garjan_enum_invalid(FrictionParams_surface(p), MATERIAL_CERAMIC) == 1) { return GARJAN_ERR_INVALID_PARAMETER; }
    var self = garjan_alloc(sizeof(Friction));
    if (garjan_is_err(self) == 1) { return self; }
    Friction_set_friction_type(self, FrictionParams_friction_type(p));
    Friction_set_surface(self, FrictionParams_surface(p));
    Friction_set_sample_rate(self, FrictionParams_sample_rate(p));
    Friction_set_sample_position(self, FrictionParams_sample_position(p));
    Friction_set_slip_phase(self, FrictionParams_slip_phase(p));
    Friction_set_stick_threshold(self, FrictionParams_stick_threshold(p));
    Friction_set_base_rate(self, FrictionParams_base_rate(p));
    Friction_set_noise_mix(self, FrictionParams_noise_mix(p));
    Friction_set_velocity(self, FrictionParams_velocity(p));
    Friction_set_pressure(self, FrictionParams_pressure(p));

    var rng = rng_new(0);
    if (garjan_is_err(rng) == 1) { return rng; }
    Rng_set_state(rng, FrictionParams_rng_state(p));
    Rng_set_inc(rng, FrictionParams_rng_inc(p));
    Friction_set_rng(self, rng);

    var dc = garjan_dcblocker_new(FrictionParams_sample_rate(p));
    if (garjan_is_err(dc) == 1) { return dc; }
    DcBlocker_set_x_prev(dc, FrictionParams_dcb_x_prev(p));
    DcBlocker_set_y_prev(dc, FrictionParams_dcb_y_prev(p));
    DcBlocker_set_r(dc, FrictionParams_dcb_r(p));
    Friction_set_dc_blocker(self, dc);

    var b = friction_build_naad(self);
    if (garjan_is_err(b) == 1) { return b; }

    # Restore the components' live state onto the freshly built ones. A
    # document written before 2.5.0 has no "dsp" member; garjan_dsp_node
    # returns 0 and the synth resumes without it, exactly as it used to.
    var dsp = garjan_dsp_node(json);
    if (dsp != 0) {
        garjan_state_modal_load(Friction_modal_bank(self), bayan_json_v_obj_get(dsp, "mb"));
        garjan_state_biquad_load(Friction_shape_filter(self), bayan_json_v_obj_get(dsp, "sf"));
        garjan_state_noise_load(Friction_noise_gen(self), bayan_json_v_obj_get(dsp, "ng"));
    }
    return self;
}

# --- creak.cyr ---

# creak.cyr -- creak synthesis: doors, hinges, rope, wood stress.
#
# Ports rust-old/src/creak.rs. Models creaking as low-frequency stick-slip
# oscillation through material-specific resonant modes. Tension controls
# pitch, speed controls amplitude. The Cyrius port always uses the naad
# backend (no feature flags): generate_noise ports the naad path (pink noise
# through a lowpass shape filter), dropping the rng fallback. f32 -> f64.
# Result<Self> -> pointer / negative GARJAN_* code. The naad noise_gen +
# shape_filter AND the ModalBank are reconstructed on deserialize (rebuilt in
# creak_build_naad from `source`); rng + dc_blocker state ARE serialized (via
# the flattened CreakParams below). Rust serialized the DSP state too; this
# port does not -- see architecture note 001.
# Requires: error, logging, dsp, rng, material, modal, contact foundations +
# the naad bundle (noise_new/noise_next_sample,
# filter_biquad_new/filter_biquad_process_sample).

# ---- CreakParams: the serializable slice. source is a CREAK_* int tag; rng +
# dc_blocker are FLATTENED to scalar fields for #derive(Serialize)'s fast
# single-pass from_json_str. modal_bank / noise_gen / shape_filter are NOT
# serialized -- they are rebuilt from `source` in creak_build_naad. ----
#derive(accessors)
#derive(Serialize)
struct CreakParams {
    source: i64;
    sample_rate: f64;
    sample_position: i64;
    slip_phase: f64;
    freq_lo: f64;
    freq_hi: f64;
    noise_mix: f64;
    tension: f64;
    speed: f64;
    rng_state: i64;
    rng_inc: i64;
    dcb_x_prev: f64;
    dcb_y_prev: f64;
    dcb_r: f64;
}

# ---- Creak: live synth = scalars + live rng/dc_blocker + reconstructed
# modal_bank + naad component ptrs. ----
#derive(accessors)
struct Creak {
    source;
    sample_rate;
    sample_position;
    slip_phase;
    freq_lo;
    freq_hi;
    noise_mix;
    tension;
    speed;
    rng;
    dc_blocker;
    modal_bank;
    noise_gen;
    shape_filter;
}

# Lowpass shape-filter cutoff for a creak source (Rust filter_freq match).
#must_use
fn creak_shape_filter_freq(source) {
    if (source == CREAK_DOOR)  { return f64_from(400); }
    if (source == CREAK_HINGE) { return f64_from(800); }
    if (source == CREAK_ROPE)  { return f64_from(300); }
    return f64_from(250);   # WoodStress
}

# Build/refresh the reconstructable components from source + sample_rate:
# the modal bank (material modes) and the naad noise_gen + shape_filter.
# Shared by creak_new and creak_from_json_str. Returns GARJAN_OK or a negative
# code if a component constructor rejects its params.
fn creak_build_naad(self) {
    var source = Creak_source(self);
    var sr = Creak_sample_rate(self);

    # ---- Material + mode pattern per source (Rust source match) ----
    var mat = MATERIAL_WOOD;
    var pattern = MODE_PATTERN_BEAM;
    var mode_count = 5;
    if (source == CREAK_DOOR) {
        mat = MATERIAL_WOOD;
        pattern = MODE_PATTERN_BEAM;
        mode_count = 5;
    } elif (source == CREAK_HINGE) {
        mat = MATERIAL_METAL;
        pattern = MODE_PATTERN_PLATE;
        mode_count = 6;
    } elif (source == CREAK_ROPE) {
        mat = MATERIAL_FABRIC;
        pattern = MODE_PATTERN_HARMONIC;
        mode_count = 4;
    } else {
        # WoodStress
        mat = MATERIAL_WOOD;
        pattern = MODE_PATTERN_DAMPED;
        mode_count = 4;
    }

    var props = material_properties(mat);
    if (garjan_is_err(props) == 1) { return props; }
    var mode_cfg = material_mode_config(mat);
    if (garjan_is_err(mode_cfg) == 1) { return mode_cfg; }
    var specs = generate_modes(props, pattern, mode_count, MaterialModeConfig_damping_factor(mode_cfg));
    if (garjan_is_err(specs) == 1) { return specs; }
    var bank = modal_bank_new(specs, sr);
    if (garjan_is_err(bank) == 1) { return garjan_map_naad_error(bank); }
    Creak_set_modal_bank(self, bank);

    # ---- naad noise_gen (pink, seed 5555) + lowpass shape filter (Q 0.7) ----
    var ng = noise_new(NOISE_PINK, 5555);
    Creak_set_noise_gen(self, ng);
    var ffreq = creak_shape_filter_freq(source);
    var sf = filter_biquad_new(NAAD_FILTER_LOWPASS, sr, ffreq, f64_div(f64_from(7), f64_from(10)));
    if (garjan_is_err(sf) == 1) { return garjan_map_naad_error(sf); }
    Creak_set_shape_filter(self, sf);
    return GARJAN_OK;
}

# Creates a new creak synthesizer. Returns a pointer or a negative code.
#must_use
fn creak_new(source, sample_rate) {
    if (garjan_enum_invalid(source, CREAK_WOOD_STRESS) == 1) { return GARJAN_ERR_INVALID_PARAMETER; }
    var e = garjan_validate_sample_rate(sample_rate);
    if (garjan_is_err(e) == 1) { return e; }

    # Frequency range + noise mix per source (Rust source match).
    var freq_lo = f64_from(40);
    var freq_hi = f64_from(200);
    var noise_mix = f64_div(f64_from(1), f64_from(10));
    if (source == CREAK_DOOR) {
        freq_lo = f64_from(40);
        freq_hi = f64_from(200);
        noise_mix = f64_div(f64_from(1), f64_from(10));
    } elif (source == CREAK_HINGE) {
        freq_lo = f64_from(100);
        freq_hi = f64_from(500);
        noise_mix = f64_div(f64_from(5), f64_from(100));
    } elif (source == CREAK_ROPE) {
        freq_lo = f64_from(30);
        freq_hi = f64_from(150);
        noise_mix = f64_div(f64_from(3), f64_from(10));
    } else {
        # WoodStress
        freq_lo = f64_from(25);
        freq_hi = f64_from(105);
        noise_mix = f64_div(f64_from(15), f64_from(100));
    }

    var self = garjan_alloc(sizeof(Creak));
    if (garjan_is_err(self) == 1) { return self; }
    Creak_set_source(self, source);
    Creak_set_sample_rate(self, sample_rate);
    Creak_set_sample_position(self, 0);
    Creak_set_slip_phase(self, 0);
    Creak_set_freq_lo(self, freq_lo);
    Creak_set_freq_hi(self, freq_hi);
    Creak_set_noise_mix(self, noise_mix);
    Creak_set_tension(self, F64_HALF);
    Creak_set_speed(self, 0);
    var ga_rng1 = rng_new(5555);
    if (garjan_is_err(ga_rng1) == 1) { return ga_rng1; }
    Creak_set_rng(self, ga_rng1);
    var ga_dcb2 = garjan_dcblocker_new(sample_rate);
    if (garjan_is_err(ga_dcb2) == 1) { return ga_dcb2; }
    Creak_set_dc_blocker(self, ga_dcb2);
    var b = creak_build_naad(self);
    if (garjan_is_err(b) == 1) { return b; }
    return self;
}

# Sets the tension (0.0 = low pitch, 1.0 = high pitch). Clamped to [0, 1].
fn creak_set_tension(self, tension) {
    Creak_set_tension(self, f64_clamp(tension, 0, F64_ONE));
    return 0;
}

# Sets the speed (0.0 = silent, 1.0 = fast creak). Clamped to [0, 1].
fn creak_set_speed(self, speed) {
    Creak_set_speed(self, f64_clamp(speed, 0, F64_ONE));
    return 0;
}

# One shaped-noise sample: pink noise through the lowpass shape filter (naad
# path). Ports generate_noise; does NOT touch self.rng.
#inline
#must_use
fn creak_generate_noise(self) {
    var raw = noise_next_sample(Creak_noise_gen(self));
    return filter_biquad_process_sample(Creak_shape_filter(self), raw);
}

# Fills `output` (a vec of f64) with creak audio (streaming). Ports
# process_block: stick-slip excitation + shaped noise through the modal bank,
# DC-blocked; silent (but still advancing the dc_blocker) when speed < 0.001.
fn creak_process_block(self, output) {
    var num = vec_len(output);
    var rng = Creak_rng(self);
    var dc = Creak_dc_blocker(self);
    var bank = Creak_modal_bank(self);
    var sr = Creak_sample_rate(self);
    var freq_lo = Creak_freq_lo(self);
    var freq_hi = Creak_freq_hi(self);
    var noise_mix = Creak_noise_mix(self);

    # 0.001 speed floor, +/-0.05 jitter span (readable idioms).
    var speed_floor = f64_div(f64_from(1), f64_from(1000));
    var jitter_lo = f64_neg(f64_div(f64_from(5), f64_from(100)));
    var jitter_hi = f64_div(f64_from(5), f64_from(100));

    var i = 0;
    while (i < num) {
        var speed = Creak_speed(self);
        if (f64_lt(speed, speed_floor) == 1) {
            vec_set(output, i, 0);
            var silent = garjan_dcblocker_process(dc, 0);
        } else {
            var tension = Creak_tension(self);
            # Base frequency from tension: freq_lo + tension*(freq_hi-freq_lo).
            var freq = f64_add(freq_lo, f64_mul(tension, f64_sub(freq_hi, freq_lo)));

            # Advance slip phase with jitter for organic quality.
            var jitter = f64_add(F64_ONE, rng_next_f32_range(rng, jitter_lo, jitter_hi));
            var slip = f64_add(Creak_slip_phase(self), f64_div(f64_mul(freq, jitter), sr));
            if (f64_ge(slip, F64_ONE) == 1) {
                slip = f64_sub(slip, F64_ONE);
            }
            Creak_set_slip_phase(self, slip);

            # Asymmetric sawtooth-like excitation (fast slip, slow stick).
            var excitation = f64_mul(f64_sub(f64_mul(slip, F64_TWO), F64_ONE), speed);

            # Add noise for texture.
            var noise = f64_mul(f64_mul(creak_generate_noise(self), noise_mix), speed);

            # Through modal bank.
            var resonant = modal_bank_process_sample(bank, f64_add(excitation, noise));
            vec_set(output, i, garjan_dcblocker_process(dc, resonant));
        }
        i = i + 1;
    }
    Creak_set_sample_position(self, Creak_sample_position(self) + num);
    return 0;
}

# Synthesize `duration` seconds of creak audio into a fresh vec. Returns the
# vec pointer, or a negative code on invalid duration.
#must_use
fn creak_synthesize(self, duration) {
    var e = garjan_validate_duration(duration);
    if (garjan_is_err(e) == 1) { return e; }
    var num = f64_to(f64_mul(Creak_sample_rate(self), duration));
    var ga_ncheck = garjan_validate_sample_count(num);
    if (garjan_is_err(ga_ncheck) == 1) { return ga_ncheck; }
    var output = vec_new();
    var i = 0;
    while (i < num) {
        vec_push(output, 0);
        i = i + 1;
    }
    creak_process_block(self, output);
    return output;
}

# ---- serde: snapshot live state -> CreakParams -> JSON, and back. ----
#must_use
fn creak_to_json(self, sb) {
    var p = garjan_alloc(sizeof(CreakParams));
    if (garjan_is_err(p) == 1) { return p; }
    CreakParams_set_source(p, Creak_source(self));
    CreakParams_set_sample_rate(p, Creak_sample_rate(self));
    CreakParams_set_sample_position(p, Creak_sample_position(self));
    CreakParams_set_slip_phase(p, Creak_slip_phase(self));
    CreakParams_set_freq_lo(p, Creak_freq_lo(self));
    CreakParams_set_freq_hi(p, Creak_freq_hi(self));
    CreakParams_set_noise_mix(p, Creak_noise_mix(self));
    CreakParams_set_tension(p, Creak_tension(self));
    CreakParams_set_speed(p, Creak_speed(self));
    var rng = Creak_rng(self);
    CreakParams_set_rng_state(p, Rng_state(rng));
    CreakParams_set_rng_inc(p, Rng_inc(rng));
    var dc = Creak_dc_blocker(self);
    CreakParams_set_dcb_x_prev(p, DcBlocker_x_prev(dc));
    CreakParams_set_dcb_y_prev(p, DcBlocker_y_prev(dc));
    CreakParams_set_dcb_r(p, DcBlocker_r(dc));
    # Scalars via the derive, then the naad components' LIVE state spliced
    # in as "dsp" -- without it a restore resumes with zeroed filter memory.
    var psb = str_builder_new();
    var pe = CreakParams_to_json(p, psb);
    if (garjan_is_err(pe) == 1) { return pe; }
    var dsp = bayan_json_v_obj_new();
    bayan_json_v_obj_set(dsp, str_from("ng"), garjan_state_noise(Creak_noise_gen(self)));
    bayan_json_v_obj_set(dsp, str_from("sf"), garjan_state_biquad(Creak_shape_filter(self)));
    bayan_json_v_obj_set(dsp, str_from("mb"), garjan_state_modal(Creak_modal_bank(self)));
    return garjan_emit_with_dsp(sb, psb, dsp);
}

# Rebuild a Creak from JSON: restore scalars + rng + dc_blocker state, then
# reconstruct the modal bank + naad components fresh from `source` -- Rust
# restored their state instead (architecture note 001).
#must_use
fn creak_from_json_str(json) {
    var p = CreakParams_from_json_str(json);
    # Deserialize must validate what the constructor validates. Before 2.5.1
    # this path relied on a downstream naad component rejecting a bad
    # sample_rate -- which bubble's build_naad cannot do, since it only
    # calls noise_new -- and it never re-checked the enum id at all, so a
    # hostile document could restore an out-of-range one that *_new rejects.
    var vsr = garjan_validate_sample_rate(CreakParams_sample_rate(p));
    if (garjan_is_err(vsr) == 1) { return vsr; }
    if (garjan_enum_invalid(CreakParams_source(p), CREAK_WOOD_STRESS) == 1) { return GARJAN_ERR_INVALID_PARAMETER; }
    var self = garjan_alloc(sizeof(Creak));
    if (garjan_is_err(self) == 1) { return self; }
    Creak_set_source(self, CreakParams_source(p));
    Creak_set_sample_rate(self, CreakParams_sample_rate(p));
    Creak_set_sample_position(self, CreakParams_sample_position(p));
    Creak_set_slip_phase(self, CreakParams_slip_phase(p));
    Creak_set_freq_lo(self, CreakParams_freq_lo(p));
    Creak_set_freq_hi(self, CreakParams_freq_hi(p));
    Creak_set_noise_mix(self, CreakParams_noise_mix(p));
    Creak_set_tension(self, CreakParams_tension(p));
    Creak_set_speed(self, CreakParams_speed(p));

    var rng = rng_new(0);
    if (garjan_is_err(rng) == 1) { return rng; }
    Rng_set_state(rng, CreakParams_rng_state(p));
    Rng_set_inc(rng, CreakParams_rng_inc(p));
    Creak_set_rng(self, rng);

    var dc = garjan_dcblocker_new(CreakParams_sample_rate(p));
    if (garjan_is_err(dc) == 1) { return dc; }
    DcBlocker_set_x_prev(dc, CreakParams_dcb_x_prev(p));
    DcBlocker_set_y_prev(dc, CreakParams_dcb_y_prev(p));
    DcBlocker_set_r(dc, CreakParams_dcb_r(p));
    Creak_set_dc_blocker(self, dc);

    var b = creak_build_naad(self);
    if (garjan_is_err(b) == 1) { return b; }

    # Restore the components' live state onto the freshly built ones. A
    # document written before 2.5.0 has no "dsp" member; garjan_dsp_node
    # returns 0 and the synth resumes without it, exactly as it used to.
    var dsp = garjan_dsp_node(json);
    if (dsp != 0) {
        garjan_state_modal_load(Creak_modal_bank(self), bayan_json_v_obj_get(dsp, "mb"));
        garjan_state_noise_load(Creak_noise_gen(self), bayan_json_v_obj_get(dsp, "ng"));
        garjan_state_biquad_load(Creak_shape_filter(self), bayan_json_v_obj_get(dsp, "sf"));
    }
    return self;
}

# --- rolling.cyr ---

# rolling.cyr -- rolling synthesis: ball, wheel, boulder, barrel on surfaces.
#
# Ports rust-old/src/rolling.rs. Models continuous contact between a round
# body and a surface: material-shaped surface noise plus periodic rotation
# bumps, and (for hollow bodies) a modal bank. The Cyrius port always uses the
# naad backend (no feature flags), so it ports the naad generate_noise path
# (pink noise -> bandpass surface_filter) and drops the rng fallback. f32 ->
# f64. Result<Self> -> pointer / negative GARJAN_* code. The Rust
# live components (noise_gen, surface_filter,
# modal_bank) are reconstructed on deserialize; rng + dc_blocker state ARE
# serialized (via the flattened RollingParams below).
#
# Requires: error, logging, dsp, rng, material, modal, contact foundations +
# the naad bundle (noise_new/noise_next_sample,
# filter_biquad_new/filter_biquad_process_sample).

# ---- RollingParams: the serializable slice (exactly Rust's fields, with rng +
# dc_blocker FLATTENED so #derive(Serialize)'s single-pass from_json_str works).
# body/surface are enum ints. modal_bank / naad components are NOT serialized;
# they are rebuilt from these params in rolling_build_naad. ----
#derive(accessors)
#derive(Serialize)
struct RollingParams {
    body: i64;
    surface: i64;
    sample_rate: f64;
    sample_position: i64;
    radius: f64;
    mass_factor: f64;
    hollowness: f64;
    rotation_phase: f64;
    velocity: f64;
    rng_state: i64;
    rng_inc: i64;
    dcb_x_prev: f64;
    dcb_y_prev: f64;
    dcb_r: f64;
}

# ---- Rolling: live synth = scalars + live rng/dc_blocker + modal bank +
# naad component ptrs. modal_bank is 0 when the body is not hollow. ----
#derive(accessors)
struct Rolling {
    body;
    surface;
    sample_rate;
    sample_position;
    radius;
    mass_factor;
    hollowness;
    rotation_phase;
    velocity;
    rng;
    dc_blocker;
    modal_bank;
    noise_gen;
    surface_filter;
}

# Build/refresh the naad components + modal bank from the stored scalars.
# Shared by rolling_new and rolling_from_json_str. Returns GARJAN_OK or a
# negative code if a naad constructor / modal bank rejects its params.
fn rolling_build_naad(self) {
    var sr = Rolling_sample_rate(self);

    # Modal bank for hollow bodies (barrels are wooden). Rebuilt, not serialized.
    if (f64_gt(Rolling_hollowness(self), 0) == 1) {
        var props = material_properties(MATERIAL_WOOD);
        if (garjan_is_err(props) == 1) { return props; }
        var mode_cfg = material_mode_config(MATERIAL_WOOD);
        if (garjan_is_err(mode_cfg) == 1) { return mode_cfg; }
        var count = MaterialModeConfig_mode_count(mode_cfg);
        if (count > 6) { count = 6; }
        var specs = generate_modes(props, MaterialModeConfig_pattern(mode_cfg), count,
          MaterialModeConfig_damping_factor(mode_cfg));
        if (garjan_is_err(specs) == 1) { return specs; }
        var bank = modal_bank_new(specs, sr);
        if (garjan_is_err(bank) == 1) { return garjan_map_naad_error(bank); }
        Rolling_set_modal_bank(self, bank);
    } else {
        Rolling_set_modal_bank(self, 0);
    }

    # Surface filter: bandpass at material resonance * (1 - 0.3*mass_factor),
    # clamped to [50, 8000] Hz, Q = 1.0.
    var surf_props = material_properties(Rolling_surface(self));
    if (garjan_is_err(surf_props) == 1) { return surf_props; }
    var resonance = MaterialProperties_resonance(surf_props);
    var scale = f64_sub(F64_ONE, f64_mul(f64_div(f64_from(3), f64_from(10)), Rolling_mass_factor(self)));
    var base_cutoff = f64_mul(resonance, scale);
    var cutoff = f64_clamp(base_cutoff, f64_from(50), f64_from(8000));
    var sf = filter_biquad_new(NAAD_FILTER_BANDPASS, sr, cutoff, F64_ONE);
    if (garjan_is_err(sf) == 1) { return garjan_map_naad_error(sf); }
    Rolling_set_surface_filter(self, sf);

    Rolling_set_noise_gen(self, noise_new(NOISE_PINK, 3333));
    return GARJAN_OK;
}

# Creates a new rolling synthesizer. Returns a pointer or a negative code.
#must_use
fn rolling_new(body, surface, sample_rate) {
    if (garjan_enum_invalid(body, ROLLING_BARREL) == 1) { return GARJAN_ERR_INVALID_PARAMETER; }
    if (garjan_enum_invalid(surface, MATERIAL_CERAMIC) == 1) { return GARJAN_ERR_INVALID_PARAMETER; }
    var e = garjan_validate_sample_rate(sample_rate);
    if (garjan_is_err(e) == 1) { return e; }

    # Body properties: (radius, mass_factor, hollowness) per RollingBody.
    var radius = 0;
    var mass_factor = 0;
    var hollowness = 0;
    if (body == ROLLING_BALL) {
        radius = f64_div(f64_from(5), f64_from(100));       # 0.05
        mass_factor = f64_div(f64_from(2), f64_from(10));   # 0.2
        hollowness = 0;
    } elif (body == ROLLING_WHEEL) {
        radius = f64_div(f64_from(3), f64_from(10));        # 0.3
        mass_factor = F64_HALF;                             # 0.5
        hollowness = 0;
    } elif (body == ROLLING_BOULDER) {
        radius = F64_ONE;                                   # 1.0
        mass_factor = F64_ONE;                              # 1.0
        hollowness = 0;
    } else {
        # Barrel
        radius = f64_div(f64_from(4), f64_from(10));        # 0.4
        mass_factor = f64_div(f64_from(6), f64_from(10));   # 0.6
        hollowness = f64_div(f64_from(8), f64_from(10));    # 0.8
    }

    var self = garjan_alloc(sizeof(Rolling));
    if (garjan_is_err(self) == 1) { return self; }
    Rolling_set_body(self, body);
    Rolling_set_surface(self, surface);
    Rolling_set_sample_rate(self, sample_rate);
    Rolling_set_sample_position(self, 0);
    Rolling_set_radius(self, radius);
    Rolling_set_mass_factor(self, mass_factor);
    Rolling_set_hollowness(self, hollowness);
    Rolling_set_rotation_phase(self, 0);
    Rolling_set_velocity(self, 0);
    var ga_rng1 = rng_new(3333);
    if (garjan_is_err(ga_rng1) == 1) { return ga_rng1; }
    Rolling_set_rng(self, ga_rng1);
    var ga_dcb2 = garjan_dcblocker_new(sample_rate);
    if (garjan_is_err(ga_dcb2) == 1) { return ga_dcb2; }
    Rolling_set_dc_blocker(self, ga_dcb2);

    var b = rolling_build_naad(self);
    if (garjan_is_err(b) == 1) { return b; }
    return self;
}

# Sets the rolling velocity (0.0 = still, 1.0 = fast). Clamped to [0, 1].
fn rolling_set_velocity(self, velocity) {
    Rolling_set_velocity(self, f64_clamp(velocity, 0, F64_ONE));
    return 0;
}

# Surface noise: one pink sample through the bandpass surface_filter.
#inline
#must_use
fn rolling_generate_noise(self) {
    var raw = noise_next_sample(Rolling_noise_gen(self));
    return filter_biquad_process_sample(Rolling_surface_filter(self), raw);
}

# Fills `output` (a vec of f64) with rolling audio (streaming). Ports
# process_block: per-sample rotation phase, surface noise, rotation bumps,
# optional hollow-body resonance, then DC-block; then advance position.
fn rolling_process_block(self, output) {
    var num = vec_len(output);
    var dc = Rolling_dc_blocker(self);
    var bank = Rolling_modal_bank(self);
    var velocity = Rolling_velocity(self);
    var radius = Rolling_radius(self);
    var sr = Rolling_sample_rate(self);
    var hollowness = Rolling_hollowness(self);

    var threshold = f64_div(f64_from(1), f64_from(1000));   # 0.001
    var amp03 = f64_div(f64_from(3), f64_from(10));         # 0.3
    var amp02 = f64_div(f64_from(2), f64_from(10));         # 0.2
    var amp01 = f64_div(f64_from(1), f64_from(10));         # 0.1
    # velocity, radius and sr are all fixed before the loop, so the rotation
    # rate and the per-sample phase increment are too -- two divides and a
    # multiply that were being redone on every sample.
    var rotation_rate = f64_div(velocity, f64_mul(F64_TAU, radius));
    var phase_inc = f64_div(rotation_rate, sr);

    var i = 0;
    while (i < num) {
        if (f64_lt(velocity, threshold) == 1) {
            vec_set(output, i, 0);
            garjan_dcblocker_process(dc, 0);
        } else {
            # Advance phase, wrap at 1.
            var phase = f64_add(Rolling_rotation_phase(self), phase_inc);
            if (f64_ge(phase, F64_ONE) == 1) { phase = f64_sub(phase, F64_ONE); }
            Rolling_set_rotation_phase(self, phase);

            # Surface noise, scaled by velocity * 0.3.
            var surface_noise = f64_mul(rolling_generate_noise(self), f64_mul(velocity, amp03));

            # Rotation bumps from imperfections.
            var bump_env = f64_mul(f64_sub(F64_ONE, f64_cos(f64_mul(F64_TAU, phase))), F64_HALF);
            var bump = f64_mul(bump_env, f64_mul(velocity, amp02));

            # Hollow body resonance.
            var resonant = 0;
            if (bank != 0) {
                var excite = f64_mul(f64_add(bump, f64_mul(surface_noise, amp01)), hollowness);
                resonant = f64_mul(modal_bank_process_sample(bank, excite), F64_HALF);
            }

            var s = f64_add(f64_add(surface_noise, bump), resonant);
            vec_set(output, i, garjan_dcblocker_process(dc, s));
        }
        i = i + 1;
    }
    Rolling_set_sample_position(self, Rolling_sample_position(self) + num);
    return 0;
}

# Synthesize `duration` seconds of rolling audio into a fresh vec. Returns the
# vec pointer, or a negative code on invalid duration.
#must_use
fn rolling_synthesize(self, duration) {
    var e = garjan_validate_duration(duration);
    if (garjan_is_err(e) == 1) { return e; }
    var num = f64_to(f64_mul(Rolling_sample_rate(self), duration));
    var ga_ncheck = garjan_validate_sample_count(num);
    if (garjan_is_err(ga_ncheck) == 1) { return ga_ncheck; }
    var output = vec_new();
    var i = 0;
    while (i < num) {
        vec_push(output, 0);
        i = i + 1;
    }
    rolling_process_block(self, output);
    return output;
}

# ---- serde: snapshot live state -> RollingParams -> JSON, and back. ----
#must_use
fn rolling_to_json(self, sb) {
    var p = garjan_alloc(sizeof(RollingParams));
    if (garjan_is_err(p) == 1) { return p; }
    RollingParams_set_body(p, Rolling_body(self));
    RollingParams_set_surface(p, Rolling_surface(self));
    RollingParams_set_sample_rate(p, Rolling_sample_rate(self));
    RollingParams_set_sample_position(p, Rolling_sample_position(self));
    RollingParams_set_radius(p, Rolling_radius(self));
    RollingParams_set_mass_factor(p, Rolling_mass_factor(self));
    RollingParams_set_hollowness(p, Rolling_hollowness(self));
    RollingParams_set_rotation_phase(p, Rolling_rotation_phase(self));
    RollingParams_set_velocity(p, Rolling_velocity(self));
    var rng = Rolling_rng(self);
    RollingParams_set_rng_state(p, Rng_state(rng));
    RollingParams_set_rng_inc(p, Rng_inc(rng));
    var dc = Rolling_dc_blocker(self);
    RollingParams_set_dcb_x_prev(p, DcBlocker_x_prev(dc));
    RollingParams_set_dcb_y_prev(p, DcBlocker_y_prev(dc));
    RollingParams_set_dcb_r(p, DcBlocker_r(dc));
    # Scalars via the derive, then the naad components' LIVE state spliced
    # in as "dsp" -- without it a restore resumes with zeroed filter memory.
    var psb = str_builder_new();
    var pe = RollingParams_to_json(p, psb);
    if (garjan_is_err(pe) == 1) { return pe; }
    var dsp = bayan_json_v_obj_new();
    bayan_json_v_obj_set(dsp, str_from("sf"), garjan_state_biquad(Rolling_surface_filter(self)));
    bayan_json_v_obj_set(dsp, str_from("ng"), garjan_state_noise(Rolling_noise_gen(self)));
    bayan_json_v_obj_set(dsp, str_from("mb"), garjan_state_modal(Rolling_modal_bank(self)));
    return garjan_emit_with_dsp(sb, psb, dsp);
}

# Rebuild a Rolling from JSON: restore scalars + rng + dc_blocker state, then
# reconstruct the naad components + modal bank fresh (matches Rust's skip +
# reconstruct semantics).
#must_use
fn rolling_from_json_str(json) {
    var p = RollingParams_from_json_str(json);
    # Deserialize must validate what the constructor validates. Before 2.5.1
    # this path relied on a downstream naad component rejecting a bad
    # sample_rate -- which bubble's build_naad cannot do, since it only
    # calls noise_new -- and it never re-checked the enum id at all, so a
    # hostile document could restore an out-of-range one that *_new rejects.
    var vsr = garjan_validate_sample_rate(RollingParams_sample_rate(p));
    if (garjan_is_err(vsr) == 1) { return vsr; }
    if (garjan_enum_invalid(RollingParams_body(p), ROLLING_BARREL) == 1) { return GARJAN_ERR_INVALID_PARAMETER; }
    if (garjan_enum_invalid(RollingParams_surface(p), MATERIAL_CERAMIC) == 1) { return GARJAN_ERR_INVALID_PARAMETER; }
    var self = garjan_alloc(sizeof(Rolling));
    if (garjan_is_err(self) == 1) { return self; }
    Rolling_set_body(self, RollingParams_body(p));
    Rolling_set_surface(self, RollingParams_surface(p));
    Rolling_set_sample_rate(self, RollingParams_sample_rate(p));
    Rolling_set_sample_position(self, RollingParams_sample_position(p));
    Rolling_set_radius(self, RollingParams_radius(p));
    Rolling_set_mass_factor(self, RollingParams_mass_factor(p));
    Rolling_set_hollowness(self, RollingParams_hollowness(p));
    Rolling_set_rotation_phase(self, RollingParams_rotation_phase(p));
    Rolling_set_velocity(self, RollingParams_velocity(p));

    var rng = rng_new(0);
    if (garjan_is_err(rng) == 1) { return rng; }
    Rng_set_state(rng, RollingParams_rng_state(p));
    Rng_set_inc(rng, RollingParams_rng_inc(p));
    Rolling_set_rng(self, rng);

    var dc = garjan_dcblocker_new(RollingParams_sample_rate(p));
    if (garjan_is_err(dc) == 1) { return dc; }
    DcBlocker_set_x_prev(dc, RollingParams_dcb_x_prev(p));
    DcBlocker_set_y_prev(dc, RollingParams_dcb_y_prev(p));
    DcBlocker_set_r(dc, RollingParams_dcb_r(p));
    Rolling_set_dc_blocker(self, dc);

    var b = rolling_build_naad(self);
    if (garjan_is_err(b) == 1) { return b; }

    # Restore the components' live state onto the freshly built ones. A
    # document written before 2.5.0 has no "dsp" member; garjan_dsp_node
    # returns 0 and the synth resumes without it, exactly as it used to.
    var dsp = garjan_dsp_node(json);
    if (dsp != 0) {
        garjan_state_modal_load(Rolling_modal_bank(self), bayan_json_v_obj_get(dsp, "mb"));
        garjan_state_biquad_load(Rolling_surface_filter(self), bayan_json_v_obj_get(dsp, "sf"));
        garjan_state_noise_load(Rolling_noise_gen(self), bayan_json_v_obj_get(dsp, "ng"));
    }
    return self;
}

# --- foliage.cyr ---

# foliage.cyr -- foliage synthesis: leaf rustle, grass swish, branch snap.
#
# Ports rust-old/src/foliage.rs. Models vegetation sounds as continuous
# wind-driven rustle (pink noise -> bandpass, LFO-modulated) plus stochastic
# micro-events (individual leaf/twig contacts), and a one-shot branch snap
# (modal bank driven by a noise-burst exciter). The Cyrius port always uses
# the naad backend (no feature flags): rustle_noise/rustle_filter/wind_lfo are
# reconstructed on deserialize; the snap ModalBank + Exciter are likewise
# rebuilt in foliage_build_naad from the serialized params (matching Rust's
# reconstruct-on-deserialize policy). f32 -> f64. Result<Self> -> pointer / negative
# GARJAN_* code. rng + dc_blocker + exciter state ARE serialized.
# Requires: error, logging, dsp, rng, material, modal, contact foundations +
# the naad bundle (noise_new/noise_next_sample, filter_biquad_new/
# filter_biquad_process_sample, modulation_lfo_new/modulation_lfo_next_value).

# ---- FoliageParams: the serializable slice (Rust's non-reconstructed fields,
# flattened so #derive(Serialize)'s single-pass from_json_str works). The snap
# ModalBank + naad components are NOT here (rebuilt in foliage_build_naad); the
# Exciter's live state (position/active/rng) IS carried for exact roundtrip. ----
#derive(accessors)
#derive(Serialize)
struct FoliageParams {
    foliage_type: i64;
    sample_rate: f64;
    sample_position: i64;
    wind_speed: f64;
    contact_intensity: f64;
    snap_pending: i64;
    event_rate: f64;
    event_duration_samples: i64;
    rng_state: i64;
    rng_inc: i64;
    dcb_x_prev: f64;
    dcb_y_prev: f64;
    dcb_r: f64;
    exc_position: i64;
    exc_active: i64;
    exc_rng_state: i64;
    exc_rng_inc: i64;
}

# ---- Foliage: live synth = scalars + live rng/dc_blocker + snap modal/exciter
# + naad component ptrs. snap_modal is a pointer or 0 (Option<ModalBank>::None). ----
#derive(accessors)
struct Foliage {
    foliage_type;
    sample_rate;
    sample_position;
    wind_speed;
    contact_intensity;
    snap_pending;
    event_rate;
    event_duration_samples;
    rng;
    dc_blocker;
    snap_modal;
    snap_exciter;
    rustle_noise;
    rustle_filter;
    wind_lfo;
}

# Build/refresh the naad + reconstructable components from foliage_type +
# sample_rate. Shared by foliage_new and foliage_from_json_str. Builds the snap
# ModalBank (only for BranchSnap), the rustle noise/bandpass, and the wind LFO.
# Returns GARJAN_OK, or a negative code if a naad constructor rejects its params.
fn foliage_build_naad(self) {
    var sr = Foliage_sample_rate(self);
    var ftype = Foliage_foliage_type(self);

    # Branch snap modal bank (only for BranchSnap; else 0 == None).
    var bank = 0;
    if (ftype == FOLIAGE_BRANCH_SNAP) {
        var props = material_properties(MATERIAL_WOOD);
        if (garjan_is_err(props) == 1) { return props; }
        var mode_cfg = material_mode_config(MATERIAL_WOOD);
        if (garjan_is_err(mode_cfg) == 1) { return mode_cfg; }
        var specs = generate_modes(props, MaterialModeConfig_pattern(mode_cfg),
          MaterialModeConfig_mode_count(mode_cfg),
          MaterialModeConfig_damping_factor(mode_cfg));
        if (garjan_is_err(specs) == 1) { return specs; }
        var mb = modal_bank_new(specs, sr);
        if (garjan_is_err(mb) == 1) { return garjan_map_naad_error(mb); }
        bank = mb;
    }
    Foliage_set_snap_modal(self, bank);

    # Rustle bed: pink noise through a bandpass whose center depends on type.
    var freq = f64_from(1000);
    if (ftype == FOLIAGE_LEAF_RUSTLE) {
        freq = f64_from(4000);
    } elif (ftype == FOLIAGE_GRASS_SWISH) {
        freq = f64_from(2000);
    }
    var rf = filter_biquad_new(NAAD_FILTER_BANDPASS, sr, freq, f64_div(f64_from(15), f64_from(10)));
    if (garjan_is_err(rf) == 1) { return garjan_map_naad_error(rf); }
    Foliage_set_rustle_filter(self, rf);
    Foliage_set_rustle_noise(self, noise_new(NOISE_PINK, 4444));

    # Wind LFO: slow sine, rate depends on type.
    var rate = f64_div(f64_from(1), f64_from(10));
    if (ftype == FOLIAGE_LEAF_RUSTLE) {
        rate = f64_div(f64_from(2), f64_from(10));
    } elif (ftype == FOLIAGE_GRASS_SWISH) {
        rate = f64_div(f64_from(15), f64_from(100));
    }
    var lfo = modulation_lfo_new(MODULATION_LFO_SINE, rate, sr);
    if (garjan_is_err(lfo) == 1) { return garjan_map_naad_error(lfo); }
    Foliage_set_wind_lfo(self, lfo);
    return GARJAN_OK;
}

# Creates a new foliage synthesizer. Returns a pointer or a negative code.
#must_use
fn foliage_new(foliage_type, sample_rate) {
    if (garjan_enum_invalid(foliage_type, FOLIAGE_BRANCH_SNAP) == 1) { return GARJAN_ERR_INVALID_PARAMETER; }
    var e = garjan_validate_sample_rate(sample_rate);
    if (garjan_is_err(e) == 1) { return e; }

    # (event_rate, event_dur_ms) by type.
    var event_rate = 0;
    var event_dur_ms = 0;
    if (foliage_type == FOLIAGE_LEAF_RUSTLE) {
        event_rate = f64_from(20);
        event_dur_ms = F64_TWO;
    } elif (foliage_type == FOLIAGE_GRASS_SWISH) {
        event_rate = f64_from(12);
        event_dur_ms = f64_from(10);
    }
    # event_duration_samples = (event_dur_ms * sample_rate / 1000.0) as usize
    var event_duration_samples = f64_to(f64_div(f64_mul(event_dur_ms, sample_rate), f64_from(1000)));

    var self = garjan_alloc(sizeof(Foliage));
    if (garjan_is_err(self) == 1) { return self; }
    Foliage_set_foliage_type(self, foliage_type);
    Foliage_set_sample_rate(self, sample_rate);
    Foliage_set_sample_position(self, 0);
    Foliage_set_wind_speed(self, 0);
    Foliage_set_contact_intensity(self, 0);
    Foliage_set_snap_pending(self, 0);
    Foliage_set_event_rate(self, event_rate);
    Foliage_set_event_duration_samples(self, event_duration_samples);
    var ga_rng1 = rng_new(4444);
    if (garjan_is_err(ga_rng1) == 1) { return ga_rng1; }
    Foliage_set_rng(self, ga_rng1);
    var ga_dcb2 = garjan_dcblocker_new(sample_rate);
    if (garjan_is_err(ga_dcb2) == 1) { return ga_dcb2; }
    Foliage_set_dc_blocker(self, ga_dcb2);

    # Snap exciter: NoiseBurst with duration (sample_rate * 0.002) as usize, amp 0.8.
    var burst_dur = f64_to(f64_mul(sample_rate, f64_div(f64_from(2), f64_from(1000))));
    var exc = exciter_new(EXCITATION_NOISE_BURST, burst_dur, f64_div(f64_from(8), f64_from(10)));
    if (garjan_is_err(exc) == 1) { return exc; }
    Foliage_set_snap_exciter(self, exc);

    var b = foliage_build_naad(self);
    if (garjan_is_err(b) == 1) { return b; }
    return self;
}

# Sets the wind speed (0.0 = calm, 1.0 = strong wind), clamped.
fn foliage_set_wind_speed(self, speed) {
    Foliage_set_wind_speed(self, f64_clamp(speed, 0, F64_ONE));
    return 0;
}

# Sets the contact intensity (0.0 = none, 1.0 = heavy movement), clamped.
fn foliage_set_contact_intensity(self, intensity) {
    Foliage_set_contact_intensity(self, f64_clamp(intensity, 0, F64_ONE));
    return 0;
}

# Triggers a branch snap (one-shot). Only has effect for BranchSnap type.
fn foliage_trigger_snap(self) {
    if (Foliage_foliage_type(self) == FOLIAGE_BRANCH_SNAP) {
        Foliage_set_snap_pending(self, 1);
    }
    return 0;
}

# Rustle path: continuous LFO-modulated bandpassed pink noise + stochastic
# micro-events. Ports process_rustle (naad branch). Mutates `output` in place.
fn foliage_process_rustle(self, output) {
    var num_samples = vec_len(output);
    var wind_speed = Foliage_wind_speed(self);
    var contact_intensity = Foliage_contact_intensity(self);
    var event_rate = Foliage_event_rate(self);
    var sr = Foliage_sample_rate(self);
    var rng = Foliage_rng(self);
    var rustle_noise = Foliage_rustle_noise(self);
    var rustle_filter = Foliage_rustle_filter(self);
    var wind_lfo = Foliage_wind_lfo(self);
    var event_dur = Foliage_event_duration_samples(self);

    # total_rate = wind_speed*event_rate + contact_intensity*event_rate*2.0
    var total_rate = f64_add(f64_mul(wind_speed, event_rate), f64_mul(f64_mul(contact_intensity, event_rate), F64_TWO));
    var block_size = f64_to(f64_mul(sr, f64_div(f64_from(1), f64_from(100))));   # sr*0.01
    var events_per_block = f64_mul(total_rate, f64_div(f64_from(1), f64_from(100)));

    # Continuous rustle bed.
    var wind_amp = f64_mul(wind_speed, f64_div(f64_from(15), f64_from(100)));    # wind_speed*0.15
    var c03 = f64_div(f64_from(3), f64_from(10));
    var c07 = f64_div(f64_from(7), f64_from(10));
    var i = 0;
    while (i < num_samples) {
        var noise = noise_next_sample(rustle_noise);
        var filtered = filter_biquad_process_sample(rustle_filter, noise);
        # lfo = 0.7 + 0.3 * wind_lfo.next_value()
        var lfo = f64_add(c07, f64_mul(c03, modulation_lfo_next_value(wind_lfo)));
        vec_set(output, i, f64_mul(f64_mul(filtered, wind_amp), lfo));
        i = i + 1;
    }

    # Stochastic micro-events.
    if (f64_gt(total_rate, 0) == 1) {
        if (event_dur > 0) {
            var step = block_size;
            if (step < 1) { step = 1; }
            var block_start = 0;
            while (block_start < num_samples) {
                var block_end = block_start + block_size;
                if (block_end > num_samples) { block_end = num_samples; }
                var n_events = rng_poisson(rng, events_per_block);
                var ev = 0;
                while (ev < n_events) {
                    var width = f64_from(block_end - block_start);
                    var offset = f64_to(rng_next_f32_range(rng, 0, width));
                    var idx = block_start + offset;
                    if (idx < num_samples) {
                        var amp = rng_next_f32_range(rng, f64_div(f64_from(5), f64_from(100)),
                          f64_div(f64_from(15), f64_from(100)));
                        var span = event_dur;
                        if (num_samples - idx < span) { span = num_samples - idx; }
                        var j = 0;
                        while (j < span) {
                            var env = f64_sub(F64_ONE, f64_div(f64_from(j), f64_from(event_dur)));
                            var contrib = f64_mul(amp, f64_mul(env, rng_next_f32(rng)));
                            vec_set(output, idx + j, f64_add(vec_get(output, idx + j), contrib));
                            j = j + 1;
                        }
                    }
                    ev = ev + 1;
                }
                block_start = block_start + step;
            }
        }
    }
    return 0;
}

# Branch-snap path: fire the noise-burst exciter through the wood modal bank.
# Ports process_branch_snap. Mutates `output` in place.
fn foliage_process_branch_snap(self, output) {
    var exciter = Foliage_snap_exciter(self);
    var bank = Foliage_snap_modal(self);

    if (Foliage_snap_pending(self) == 1) {
        Foliage_set_snap_pending(self, 0);
        exciter_trigger(exciter);
        if (bank != 0) { modal_bank_reset(bank); }
    }

    var num = vec_len(output);
    var i = 0;
    while (i < num) {
        var exc = exciter_next_sample(exciter);
        var s = 0;
        if (bank != 0) {
            s = modal_bank_process_sample(bank, exc);
        } else {
            s = f64_mul(exc, F64_HALF);
        }
        vec_set(output, i, s);
        i = i + 1;
    }
    return 0;
}

# Fills `output` (a vec of f64) with foliage audio (streaming). Ports
# process_block: type-dispatched synthesis, then DC-block, then advance position.
fn foliage_process_block(self, output) {
    if (Foliage_foliage_type(self) == FOLIAGE_BRANCH_SNAP) {
        foliage_process_branch_snap(self, output);
    } else {
        foliage_process_rustle(self, output);
    }

    var dc = Foliage_dc_blocker(self);
    var num = vec_len(output);
    var i = 0;
    while (i < num) {
        vec_set(output, i, garjan_dcblocker_process(dc, vec_get(output, i)));
        i = i + 1;
    }
    Foliage_set_sample_position(self, Foliage_sample_position(self) + num);
    return 0;
}

# Synthesize `duration` seconds of foliage audio into a fresh vec. Returns the
# vec pointer, or a negative code on invalid duration.
#must_use
fn foliage_synthesize(self, duration) {
    var e = garjan_validate_duration(duration);
    if (garjan_is_err(e) == 1) { return e; }
    var num = f64_to(f64_mul(Foliage_sample_rate(self), duration));
    var ga_ncheck = garjan_validate_sample_count(num);
    if (garjan_is_err(ga_ncheck) == 1) { return ga_ncheck; }
    var output = vec_new();
    var i = 0;
    while (i < num) {
        vec_push(output, 0);
        i = i + 1;
    }
    foliage_process_block(self, output);
    return output;
}

# ---- serde: snapshot live state -> FoliageParams -> JSON, and back. ----
#must_use
fn foliage_to_json(self, sb) {
    var p = garjan_alloc(sizeof(FoliageParams));
    if (garjan_is_err(p) == 1) { return p; }
    FoliageParams_set_foliage_type(p, Foliage_foliage_type(self));
    FoliageParams_set_sample_rate(p, Foliage_sample_rate(self));
    FoliageParams_set_sample_position(p, Foliage_sample_position(self));
    FoliageParams_set_wind_speed(p, Foliage_wind_speed(self));
    FoliageParams_set_contact_intensity(p, Foliage_contact_intensity(self));
    FoliageParams_set_snap_pending(p, Foliage_snap_pending(self));
    FoliageParams_set_event_rate(p, Foliage_event_rate(self));
    FoliageParams_set_event_duration_samples(p, Foliage_event_duration_samples(self));

    var rng = Foliage_rng(self);
    FoliageParams_set_rng_state(p, Rng_state(rng));
    FoliageParams_set_rng_inc(p, Rng_inc(rng));

    var dc = Foliage_dc_blocker(self);
    FoliageParams_set_dcb_x_prev(p, DcBlocker_x_prev(dc));
    FoliageParams_set_dcb_y_prev(p, DcBlocker_y_prev(dc));
    FoliageParams_set_dcb_r(p, DcBlocker_r(dc));

    var exc = Foliage_snap_exciter(self);
    FoliageParams_set_exc_position(p, Exciter_position(exc));
    FoliageParams_set_exc_active(p, Exciter_active(exc));
    var exc_rng = Exciter_rng(exc);
    FoliageParams_set_exc_rng_state(p, Rng_state(exc_rng));
    FoliageParams_set_exc_rng_inc(p, Rng_inc(exc_rng));

    # Scalars via the derive, then the naad components' LIVE state spliced
    # in as "dsp" -- without it a restore resumes with zeroed filter memory.
    var psb = str_builder_new();
    var pe = FoliageParams_to_json(p, psb);
    if (garjan_is_err(pe) == 1) { return pe; }
    var dsp = bayan_json_v_obj_new();
    bayan_json_v_obj_set(dsp, str_from("rf"), garjan_state_biquad(Foliage_rustle_filter(self)));
    bayan_json_v_obj_set(dsp, str_from("rn"), garjan_state_noise(Foliage_rustle_noise(self)));
    bayan_json_v_obj_set(dsp, str_from("wl"), garjan_state_lfo(Foliage_wind_lfo(self)));
    bayan_json_v_obj_set(dsp, str_from("se"), garjan_state_exciter(Foliage_snap_exciter(self)));
    bayan_json_v_obj_set(dsp, str_from("sm"), garjan_state_modal(Foliage_snap_modal(self)));
    return garjan_emit_with_dsp(sb, psb, dsp);
}

# Rebuild a Foliage from JSON: restore scalars + rng + dc_blocker + exciter
# state, then reconstruct the naad + modal components fresh (matches Rust's
# rebuilt, not restored -- architecture note 001). Returns the synth pointer.
#must_use
fn foliage_from_json_str(json) {
    var p = FoliageParams_from_json_str(json);
    # Deserialize must validate what the constructor validates. Before 2.5.1
    # this path relied on a downstream naad component rejecting a bad
    # sample_rate -- which bubble's build_naad cannot do, since it only
    # calls noise_new -- and it never re-checked the enum id at all, so a
    # hostile document could restore an out-of-range one that *_new rejects.
    var vsr = garjan_validate_sample_rate(FoliageParams_sample_rate(p));
    if (garjan_is_err(vsr) == 1) { return vsr; }
    if (garjan_enum_invalid(FoliageParams_foliage_type(p), FOLIAGE_BRANCH_SNAP) == 1) {
        return GARJAN_ERR_INVALID_PARAMETER;
    }
    var self = garjan_alloc(sizeof(Foliage));
    if (garjan_is_err(self) == 1) { return self; }
    Foliage_set_foliage_type(self, FoliageParams_foliage_type(p));
    Foliage_set_sample_rate(self, FoliageParams_sample_rate(p));
    Foliage_set_sample_position(self, FoliageParams_sample_position(p));
    Foliage_set_wind_speed(self, FoliageParams_wind_speed(p));
    Foliage_set_contact_intensity(self, FoliageParams_contact_intensity(p));
    Foliage_set_snap_pending(self, FoliageParams_snap_pending(p));
    Foliage_set_event_rate(self, FoliageParams_event_rate(p));
    Foliage_set_event_duration_samples(self, FoliageParams_event_duration_samples(p));

    var rng = rng_new(0);
    if (garjan_is_err(rng) == 1) { return rng; }
    Rng_set_state(rng, FoliageParams_rng_state(p));
    Rng_set_inc(rng, FoliageParams_rng_inc(p));
    Foliage_set_rng(self, rng);

    var dc = garjan_dcblocker_new(FoliageParams_sample_rate(p));
    if (garjan_is_err(dc) == 1) { return dc; }
    DcBlocker_set_x_prev(dc, FoliageParams_dcb_x_prev(p));
    DcBlocker_set_y_prev(dc, FoliageParams_dcb_y_prev(p));
    DcBlocker_set_r(dc, FoliageParams_dcb_r(p));
    Foliage_set_dc_blocker(self, dc);

    # Rebuild the exciter, restoring its live state.
    var burst_dur = f64_to(f64_mul(FoliageParams_sample_rate(p), f64_div(f64_from(2), f64_from(1000))));
    var exc = exciter_new(EXCITATION_NOISE_BURST, burst_dur, f64_div(f64_from(8), f64_from(10)));
    if (garjan_is_err(exc) == 1) { return exc; }
    Exciter_set_position(exc, FoliageParams_exc_position(p));
    Exciter_set_active(exc, FoliageParams_exc_active(p));
    var exc_rng = Exciter_rng(exc);
    Rng_set_state(exc_rng, FoliageParams_exc_rng_state(p));
    Rng_set_inc(exc_rng, FoliageParams_exc_rng_inc(p));
    Foliage_set_snap_exciter(self, exc);

    var b = foliage_build_naad(self);
    if (garjan_is_err(b) == 1) { return b; }

    # Restore the components' live state onto the freshly built ones. A
    # document written before 2.5.0 has no "dsp" member; garjan_dsp_node
    # returns 0 and the synth resumes without it, exactly as it used to.
    var dsp = garjan_dsp_node(json);
    if (dsp != 0) {
        garjan_state_exciter_load(Foliage_snap_exciter(self), bayan_json_v_obj_get(dsp, "se"));
        garjan_state_modal_load(Foliage_snap_modal(self), bayan_json_v_obj_get(dsp, "sm"));
        garjan_state_biquad_load(Foliage_rustle_filter(self), bayan_json_v_obj_get(dsp, "rf"));
        garjan_state_noise_load(Foliage_rustle_noise(self), bayan_json_v_obj_get(dsp, "rn"));
        garjan_state_lfo_load(Foliage_wind_lfo(self), bayan_json_v_obj_get(dsp, "wl"));
    }
    return self;
}

# --- whoosh.cyr ---

# whoosh.cyr -- whoosh synthesis: object pass-by / swing (aerodynamic noise).
#
# Ports rust-old/src/whoosh.rs. The Cyrius port always uses the naad backend
# (no feature flags), so it ports the #[cfg(feature="naad-backend")] path
# (pink NoiseGenerator + two biquads) and drops the rng-only fallback in
# generate_noise_hi/lo. f32 -> f64. Result<Self> -> pointer / negative
# GARJAN_* code. The Rust naad components are #[cfg]-gated and rebuilt on
# deserialize; the scalar params + rng + dc_blocker state ARE serialized via
# the flattened WhooshParams below.
# Requires: error, logging, dsp, rng foundations + aero.cyr (aero_whoosh_config,
# WHOOSH_*) + the naad bundle (noise_new/noise_next_sample,
# filter_biquad_new/filter_biquad_process_sample).

# ---- WhooshParams: the serializable slice (exactly Rust's fields, minus the
# reconstructable naad components, with rng + dc_blocker FLATTENED so
# #derive(Serialize)'s single-pass from_json_str works). ----
#derive(accessors)
#derive(Serialize)
struct WhooshParams {
    whoosh_type: i64;
    sample_rate: f64;
    sample_position: i64;
    envelope_samples: i64;
    brightness: f64;
    low_content: f64;
    active: i64;
    trigger_position: i64;
    speed: f64;
    rng_state: i64;
    rng_inc: i64;
    dcb_x_prev: f64;
    dcb_y_prev: f64;
    dcb_r: f64;
}

# ---- Whoosh: live synth = scalars + live rng/dc_blocker + naad component ptrs. ----
#derive(accessors)
struct Whoosh {
    whoosh_type;
    sample_rate;
    sample_position;
    envelope_samples;
    brightness;
    low_content;
    active;
    trigger_position;
    speed;
    rng;
    dc_blocker;
    noise_gen;
    hi_filter;
    lo_filter;
}

# Build/refresh the naad components from sample_rate + brightness/low_content.
# Shared by whoosh_new and whoosh_from_json_str. Returns GARJAN_OK or a
# negative code if a naad constructor rejects its params.
fn whoosh_build_naad(self) {
    var sr = Whoosh_sample_rate(self);
    var brightness = Whoosh_brightness(self);
    var low_content = Whoosh_low_content(self);

    # hi_filter: highpass, freq = clamp(brightness*4000, 200, 8000), q = 0.7
    var hi_freq = f64_clamp(f64_mul(brightness, f64_from(4000)), f64_from(200), f64_from(8000));
    var hi_q = f64_div(f64_from(7), f64_from(10));
    var hf = filter_biquad_new(NAAD_FILTER_HIGHPASS, sr, hi_freq, hi_q);
    if (garjan_is_err(hf) == 1) { return garjan_map_naad_error(hf); }

    # lo_filter: lowpass, freq = clamp(300 + low_content*500, 100, 1000), q = 0.5
    var lo_freq = f64_clamp(f64_add(f64_from(300), f64_mul(low_content, f64_from(500))), f64_from(100), f64_from(1000));
    var lf = filter_biquad_new(NAAD_FILTER_LOWPASS, sr, lo_freq, F64_HALF);
    if (garjan_is_err(lf) == 1) { return garjan_map_naad_error(lf); }

    Whoosh_set_hi_filter(self, hf);
    Whoosh_set_lo_filter(self, lf);
    Whoosh_set_noise_gen(self, noise_new(NOISE_PINK, 1111));
    return GARJAN_OK;
}

# Creates a new whoosh synthesizer. Returns a pointer or a negative code.
#must_use
fn whoosh_new(whoosh_type, sample_rate) {
    if (garjan_enum_invalid(whoosh_type, WHOOSH_THROW) == 1) { return GARJAN_ERR_INVALID_PARAMETER; }
    var e = garjan_validate_sample_rate(sample_rate);
    if (garjan_is_err(e) == 1) { return e; }

    var cfg = aero_whoosh_config(whoosh_type);
    if (garjan_is_err(cfg) == 1) { return cfg; }
    var env_dur = WhooshConfig_duration(cfg);
    var brightness = WhooshConfig_brightness(cfg);
    var low_content = WhooshConfig_low_freq(cfg);
    var envelope_samples = f64_to(f64_mul(env_dur, sample_rate));

    var self = garjan_alloc(sizeof(Whoosh));
    if (garjan_is_err(self) == 1) { return self; }
    Whoosh_set_whoosh_type(self, whoosh_type);
    Whoosh_set_sample_rate(self, sample_rate);
    Whoosh_set_sample_position(self, 0);
    Whoosh_set_envelope_samples(self, envelope_samples);
    Whoosh_set_brightness(self, brightness);
    Whoosh_set_low_content(self, low_content);
    Whoosh_set_active(self, 0);
    Whoosh_set_trigger_position(self, 0);
    # speed default = 0.5
    Whoosh_set_speed(self, F64_HALF);
    var ga_rng1 = rng_new(1111);
    if (garjan_is_err(ga_rng1) == 1) { return ga_rng1; }
    Whoosh_set_rng(self, ga_rng1);
    var ga_dcb2 = garjan_dcblocker_new(sample_rate);
    if (garjan_is_err(ga_dcb2) == 1) { return ga_dcb2; }
    Whoosh_set_dc_blocker(self, ga_dcb2);

    var b = whoosh_build_naad(self);
    if (garjan_is_err(b) == 1) { return b; }
    return self;
}

# Sets the speed (0.0-1.0). Higher speed = brighter and shorter.
fn whoosh_set_speed(self, speed) {
    Whoosh_set_speed(self, f64_clamp(speed, 0, F64_ONE));
    return 0;
}

# Triggers a whoosh event.
fn whoosh_trigger(self) {
    Whoosh_set_active(self, 1);
    Whoosh_set_trigger_position(self, 0);
    return 0;
}

# Fills `output` (a vec of f64) with whoosh audio (streaming). Ports
# process_block: hump-shaped sin^2 envelope over an effective length scaled
# by speed, hi (pink->highpass) + lo (pink->lowpass) layers, DC-blocked.
fn whoosh_process_block(self, output) {
    var num = vec_len(output);
    var noise_gen = Whoosh_noise_gen(self);
    var hi_filter = Whoosh_hi_filter(self);
    var lo_filter = Whoosh_lo_filter(self);
    var dc = Whoosh_dc_blocker(self);
    var brightness = Whoosh_brightness(self);
    var low_content = Whoosh_low_content(self);
    var speed = Whoosh_speed(self);

    # speed_scale = 0.5 + speed*0.5; effective_len = (envelope_samples / speed_scale) as usize
    var speed_scale = f64_add(F64_HALF, f64_mul(speed, F64_HALF));
    var effective_len = f64_to(f64_div(f64_from(Whoosh_envelope_samples(self)), speed_scale));
    var denom = effective_len;
    if (denom < 1) { denom = 1; }

    var i = 0;
    while (i < num) {
        if (Whoosh_active(self) == 0) {
            vec_set(output, i, 0);
            garjan_dcblocker_process(dc, 0);
        } else {
            var t = f64_div(f64_from(Whoosh_trigger_position(self)), f64_from(denom));
            var env = 0;
            if (f64_lt(t, F64_ONE) == 1) {
                var s = f64_sin(f64_mul(F64_PI, t));
                env = f64_mul(s, s);
            } else {
                Whoosh_set_active(self, 0);
                env = 0;
            }

            # High-frequency whoosh layer: pink noise -> highpass, *env*brightness.
            var hraw = noise_next_sample(noise_gen);
            var hi = f64_mul(f64_mul(filter_biquad_process_sample(hi_filter, hraw), env), brightness);

            # Low-frequency rumble layer: pink noise -> lowpass, *env*low_content.
            var lraw = noise_next_sample(noise_gen);
            var lo = f64_mul(f64_mul(filter_biquad_process_sample(lo_filter, lraw), env), low_content);

            var mixed = f64_mul(f64_add(hi, lo), speed);
            vec_set(output, i, garjan_dcblocker_process(dc, mixed));

            Whoosh_set_trigger_position(self, Whoosh_trigger_position(self) + 1);
        }
        i = i + 1;
    }
    Whoosh_set_sample_position(self, Whoosh_sample_position(self) + num);
    return 0;
}

# Synthesize a single whoosh event of `duration` seconds into a fresh vec.
# Ports synthesize: validate, alloc zeros, trigger, process_block. Returns
# the vec pointer, or a negative code on invalid duration.
#must_use
fn whoosh_synthesize(self, duration) {
    var e = garjan_validate_duration(duration);
    if (garjan_is_err(e) == 1) { return e; }
    var num = f64_to(f64_mul(Whoosh_sample_rate(self), duration));
    var ga_ncheck = garjan_validate_sample_count(num);
    if (garjan_is_err(ga_ncheck) == 1) { return ga_ncheck; }
    var output = vec_new();
    var i = 0;
    while (i < num) {
        vec_push(output, 0);
        i = i + 1;
    }
    whoosh_trigger(self);
    whoosh_process_block(self, output);
    return output;
}

# ---- serde: snapshot live state -> WhooshParams -> JSON, and back. ----
#must_use
fn whoosh_to_json(self, sb) {
    var p = garjan_alloc(sizeof(WhooshParams));
    if (garjan_is_err(p) == 1) { return p; }
    WhooshParams_set_whoosh_type(p, Whoosh_whoosh_type(self));
    WhooshParams_set_sample_rate(p, Whoosh_sample_rate(self));
    WhooshParams_set_sample_position(p, Whoosh_sample_position(self));
    WhooshParams_set_envelope_samples(p, Whoosh_envelope_samples(self));
    WhooshParams_set_brightness(p, Whoosh_brightness(self));
    WhooshParams_set_low_content(p, Whoosh_low_content(self));
    WhooshParams_set_active(p, Whoosh_active(self));
    WhooshParams_set_trigger_position(p, Whoosh_trigger_position(self));
    WhooshParams_set_speed(p, Whoosh_speed(self));
    var rng = Whoosh_rng(self);
    WhooshParams_set_rng_state(p, Rng_state(rng));
    WhooshParams_set_rng_inc(p, Rng_inc(rng));
    var dc = Whoosh_dc_blocker(self);
    WhooshParams_set_dcb_x_prev(p, DcBlocker_x_prev(dc));
    WhooshParams_set_dcb_y_prev(p, DcBlocker_y_prev(dc));
    WhooshParams_set_dcb_r(p, DcBlocker_r(dc));
    # Scalars via the derive, then the naad components' LIVE state spliced
    # in as "dsp" -- without it a restore resumes with zeroed filter memory.
    var psb = str_builder_new();
    var pe = WhooshParams_to_json(p, psb);
    if (garjan_is_err(pe) == 1) { return pe; }
    var dsp = bayan_json_v_obj_new();
    bayan_json_v_obj_set(dsp, str_from("hf"), garjan_state_biquad(Whoosh_hi_filter(self)));
    bayan_json_v_obj_set(dsp, str_from("lf"), garjan_state_biquad(Whoosh_lo_filter(self)));
    bayan_json_v_obj_set(dsp, str_from("ng"), garjan_state_noise(Whoosh_noise_gen(self)));
    return garjan_emit_with_dsp(sb, psb, dsp);
}

# Rebuild a Whoosh from JSON: restore scalars + rng + dc_blocker state, then
# reconstruct the naad components fresh (matches Rust's cfg+reconstruct).
#must_use
fn whoosh_from_json_str(json) {
    var p = WhooshParams_from_json_str(json);
    # Deserialize must validate what the constructor validates. Before 2.5.1
    # this path relied on a downstream naad component rejecting a bad
    # sample_rate -- which bubble's build_naad cannot do, since it only
    # calls noise_new -- and it never re-checked the enum id at all, so a
    # hostile document could restore an out-of-range one that *_new rejects.
    var vsr = garjan_validate_sample_rate(WhooshParams_sample_rate(p));
    if (garjan_is_err(vsr) == 1) { return vsr; }
    if (garjan_enum_invalid(WhooshParams_whoosh_type(p), WHOOSH_THROW) == 1) { return GARJAN_ERR_INVALID_PARAMETER; }
    var self = garjan_alloc(sizeof(Whoosh));
    if (garjan_is_err(self) == 1) { return self; }
    Whoosh_set_whoosh_type(self, WhooshParams_whoosh_type(p));
    Whoosh_set_sample_rate(self, WhooshParams_sample_rate(p));
    Whoosh_set_sample_position(self, WhooshParams_sample_position(p));
    Whoosh_set_envelope_samples(self, WhooshParams_envelope_samples(p));
    Whoosh_set_brightness(self, WhooshParams_brightness(p));
    Whoosh_set_low_content(self, WhooshParams_low_content(p));
    Whoosh_set_active(self, WhooshParams_active(p));
    Whoosh_set_trigger_position(self, WhooshParams_trigger_position(p));
    Whoosh_set_speed(self, WhooshParams_speed(p));

    var rng = rng_new(0);
    if (garjan_is_err(rng) == 1) { return rng; }
    Rng_set_state(rng, WhooshParams_rng_state(p));
    Rng_set_inc(rng, WhooshParams_rng_inc(p));
    Whoosh_set_rng(self, rng);

    var dc = garjan_dcblocker_new(WhooshParams_sample_rate(p));
    if (garjan_is_err(dc) == 1) { return dc; }
    DcBlocker_set_x_prev(dc, WhooshParams_dcb_x_prev(p));
    DcBlocker_set_y_prev(dc, WhooshParams_dcb_y_prev(p));
    DcBlocker_set_r(dc, WhooshParams_dcb_r(p));
    Whoosh_set_dc_blocker(self, dc);

    var b = whoosh_build_naad(self);
    if (garjan_is_err(b) == 1) { return b; }

    # Restore the components' live state onto the freshly built ones. A
    # document written before 2.5.0 has no "dsp" member; garjan_dsp_node
    # returns 0 and the synth resumes without it, exactly as it used to.
    var dsp = garjan_dsp_node(json);
    if (dsp != 0) {
        garjan_state_biquad_load(Whoosh_hi_filter(self), bayan_json_v_obj_get(dsp, "hf"));
        garjan_state_biquad_load(Whoosh_lo_filter(self), bayan_json_v_obj_get(dsp, "lf"));
        garjan_state_noise_load(Whoosh_noise_gen(self), bayan_json_v_obj_get(dsp, "ng"));
    }
    return self;
}

# --- whistle.cyr ---

# whistle.cyr -- wind whistle synthesis: air through gaps, pipes, bottles, wires.
#
# Ports rust-old/src/whistle.rs. Models the tonal sound of wind passing through
# or over openings; each WhistleSource has a characteristic resonant frequency
# and bandwidth. Wind speed controls amplitude and adds slight pitch modulation.
#
# The Cyrius port always uses the naad backend (no feature flags), so it ports
# process_block's naad path and drops the sine-oscillator fallback. f32 -> f64.
# Result<Self> -> pointer / negative GARJAN_* code. The Rust naad components
# (noise_gen / resonance_filter / pitch_lfo) are reconstructed on deserialize;
# rng + dc_blocker state ARE serialized (via the flattened WhistleParams below).
# Requires: error, logging, dsp, rng, aero foundations + the naad bundle
# (noise_new/noise_next_sample, filter_svf_new/filter_svf_set_params/
# filter_svf_process_sample + SvfOutput_band_pass, modulation_lfo_new/
# modulation_lfo_next_value).

# ---- WhistleParams: the serializable slice (exactly Rust's non-naad fields,
# with rng + dc_blocker FLATTENED so #derive(Serialize)'s single-pass
# from_json_str works). Synced to/from the live Whistle on (de)serialize.
# `source` is a WHISTLE_* int tag. ----
#derive(accessors)
#derive(Serialize)
struct WhistleParams {
    source: i64;
    sample_rate: f64;
    sample_position: i64;
    base_freq: f64;
    bandwidth: f64;
    noise_mix: f64;
    wind_speed: f64;
    rng_state: i64;
    rng_inc: i64;
    dcb_x_prev: f64;
    dcb_y_prev: f64;
    dcb_r: f64;
}

# ---- Whistle: live synth = scalars + live rng/dc_blocker + naad component ptrs. ----
#derive(accessors)
struct Whistle {
    source;
    sample_rate;
    sample_position;
    base_freq;
    bandwidth;
    noise_mix;
    wind_speed;
    rng;
    dc_blocker;
    noise_gen;
    resonance_filter;
    pitch_lfo;
}

# Build/refresh the naad components from sample_rate + source params. Shared by
# whistle_new and whistle_from_json_str. Returns GARJAN_OK or a negative code
# if a naad constructor rejects its params. The resonance filter Q mirrors the
# Rust: (base_freq / bandwidth.max(1.0)).clamp(0.5, 50.0).
fn whistle_build_naad(self) {
    var sr = Whistle_sample_rate(self);
    var base_freq = Whistle_base_freq(self);
    var bandwidth = Whistle_bandwidth(self);

    var q = f64_clamp(f64_div(base_freq, f64_max(bandwidth, F64_ONE)), F64_HALF, f64_from(50));
    var rf = filter_svf_new(base_freq, q, sr);
    if (garjan_is_err(rf) == 1) { return garjan_map_naad_error(rf); }

    # pitch LFO: sine, 3.0 Hz.
    var lfo = modulation_lfo_new(MODULATION_LFO_SINE, f64_from(3), sr);
    if (garjan_is_err(lfo) == 1) { return garjan_map_naad_error(lfo); }

    Whistle_set_resonance_filter(self, rf);
    Whistle_set_pitch_lfo(self, lfo);
    Whistle_set_noise_gen(self, noise_new(NOISE_WHITE, 2222));
    return GARJAN_OK;
}

# Creates a new wind whistle synthesizer. Returns a pointer or a negative code.
#must_use
fn whistle_new(source, sample_rate) {
    if (garjan_enum_invalid(source, WHISTLE_WIRE) == 1) { return GARJAN_ERR_INVALID_PARAMETER; }
    var e = garjan_validate_sample_rate(sample_rate);
    if (garjan_is_err(e) == 1) { return e; }

    var cfg = aero_whistle_config(source);
    if (garjan_is_err(cfg) == 1) { return cfg; }

    var self = garjan_alloc(sizeof(Whistle));
    if (garjan_is_err(self) == 1) { return self; }
    Whistle_set_source(self, source);
    Whistle_set_sample_rate(self, sample_rate);
    Whistle_set_sample_position(self, 0);
    Whistle_set_base_freq(self, WhistleConfig_base_freq(cfg));
    Whistle_set_bandwidth(self, WhistleConfig_bandwidth(cfg));
    Whistle_set_noise_mix(self, WhistleConfig_noise_mix(cfg));
    Whistle_set_wind_speed(self, 0);
    var ga_rng1 = rng_new(2222);
    if (garjan_is_err(ga_rng1) == 1) { return ga_rng1; }
    Whistle_set_rng(self, ga_rng1);
    var ga_dcb2 = garjan_dcblocker_new(sample_rate);
    if (garjan_is_err(ga_dcb2) == 1) { return ga_dcb2; }
    Whistle_set_dc_blocker(self, ga_dcb2);
    var b = whistle_build_naad(self);
    if (garjan_is_err(b) == 1) { return b; }
    return self;
}

# Sets the wind speed (0.0 = calm/silent, 1.0 = strong). Clamped to [0,1].
fn whistle_set_wind_speed(self, speed) {
    Whistle_set_wind_speed(self, f64_clamp(speed, 0, F64_ONE));
    return 0;
}

# Fills `output` (a vec of f64) with whistle audio (streaming). Ports
# process_block's naad path: per-sample LFO wobble -> retune the SVF ->
# band-pass filtered white noise blended with broadband noise -> DC-block.
fn whistle_process_block(self, output) {
    var num = vec_len(output);
    var noise_gen = Whistle_noise_gen(self);
    var resonance_filter = Whistle_resonance_filter(self);
    var pitch_lfo = Whistle_pitch_lfo(self);
    var dc = Whistle_dc_blocker(self);
    var base_freq = Whistle_base_freq(self);
    var bandwidth = Whistle_bandwidth(self);
    var noise_mix = Whistle_noise_mix(self);
    var wind_speed = Whistle_wind_speed(self);
    var sr = Whistle_sample_rate(self);

    # Constant per-block scalars.
    var wobble_scale = f64_div(f64_from(5), f64_from(100));   # 0.05
    var broad_scale = f64_div(f64_from(1), f64_from(10));     # 0.1
    var res_scale = f64_div(f64_from(4), f64_from(10));       # 0.4
    var freq_lo = f64_from(20);
    var freq_hi = f64_mul(sr, f64_div(f64_from(45), f64_from(100)));   # sr*0.45
    var q = f64_clamp(f64_div(base_freq, f64_max(bandwidth, F64_ONE)), F64_HALF, f64_from(50));
    var silence_threshold = f64_div(f64_from(1), f64_from(1000));      # 0.001

    var i = 0;
    while (i < num) {
        if (f64_lt(wind_speed, silence_threshold) == 1) {
            vec_set(output, i, 0);
            garjan_dcblocker_process(dc, 0);
        } else {
            var wobble = f64_mul(f64_mul(modulation_lfo_next_value(pitch_lfo), wind_speed), wobble_scale);
            var modulated_freq = f64_mul(base_freq, f64_add(F64_ONE, wobble));
            var clamped_freq = f64_clamp(modulated_freq, freq_lo, freq_hi);
            filter_svf_set_params(resonance_filter, clamped_freq, q);

            var noise = noise_next_sample(noise_gen);
            var svf_out = filter_svf_process_sample(resonance_filter, noise);
            var resonant = SvfOutput_band_pass(svf_out);

            var broad_noise = f64_mul(f64_mul(f64_mul(noise, noise_mix), wind_speed), broad_scale);
            var sample = f64_add(f64_mul(f64_mul(resonant, wind_speed), res_scale), broad_noise);
            vec_set(output, i, garjan_dcblocker_process(dc, sample));
        }
        i = i + 1;
    }

    Whistle_set_sample_position(self, Whistle_sample_position(self) + num);
    return 0;
}

# Synthesize `duration` seconds of whistle audio into a fresh vec. Returns the
# vec pointer, or a negative code on invalid duration.
#must_use
fn whistle_synthesize(self, duration) {
    var e = garjan_validate_duration(duration);
    if (garjan_is_err(e) == 1) { return e; }
    var num = f64_to(f64_mul(Whistle_sample_rate(self), duration));
    var ga_ncheck = garjan_validate_sample_count(num);
    if (garjan_is_err(ga_ncheck) == 1) { return ga_ncheck; }
    var output = vec_new();
    var i = 0;
    while (i < num) {
        vec_push(output, 0);
        i = i + 1;
    }
    whistle_process_block(self, output);
    return output;
}

# ---- serde: snapshot live state -> WhistleParams -> JSON, and back. ----
#must_use
fn whistle_to_json(self, sb) {
    var p = garjan_alloc(sizeof(WhistleParams));
    if (garjan_is_err(p) == 1) { return p; }
    WhistleParams_set_source(p, Whistle_source(self));
    WhistleParams_set_sample_rate(p, Whistle_sample_rate(self));
    WhistleParams_set_sample_position(p, Whistle_sample_position(self));
    WhistleParams_set_base_freq(p, Whistle_base_freq(self));
    WhistleParams_set_bandwidth(p, Whistle_bandwidth(self));
    WhistleParams_set_noise_mix(p, Whistle_noise_mix(self));
    WhistleParams_set_wind_speed(p, Whistle_wind_speed(self));
    var rng = Whistle_rng(self);
    WhistleParams_set_rng_state(p, Rng_state(rng));
    WhistleParams_set_rng_inc(p, Rng_inc(rng));
    var dc = Whistle_dc_blocker(self);
    WhistleParams_set_dcb_x_prev(p, DcBlocker_x_prev(dc));
    WhistleParams_set_dcb_y_prev(p, DcBlocker_y_prev(dc));
    WhistleParams_set_dcb_r(p, DcBlocker_r(dc));
    # Scalars via the derive, then the naad components' LIVE state spliced
    # in as "dsp" -- without it a restore resumes with zeroed filter memory.
    var psb = str_builder_new();
    var pe = WhistleParams_to_json(p, psb);
    if (garjan_is_err(pe) == 1) { return pe; }
    var dsp = bayan_json_v_obj_new();
    bayan_json_v_obj_set(dsp, str_from("rf"), garjan_state_svf(Whistle_resonance_filter(self)));
    bayan_json_v_obj_set(dsp, str_from("pl"), garjan_state_lfo(Whistle_pitch_lfo(self)));
    bayan_json_v_obj_set(dsp, str_from("ng"), garjan_state_noise(Whistle_noise_gen(self)));
    return garjan_emit_with_dsp(sb, psb, dsp);
}

# Rebuild a Whistle from JSON: restore scalars + rng + dc_blocker state, then
# reconstruct the naad components fresh (matches Rust's cfg+reconstruct).
#must_use
fn whistle_from_json_str(json) {
    var p = WhistleParams_from_json_str(json);
    # Deserialize must validate what the constructor validates. Before 2.5.1
    # this path relied on a downstream naad component rejecting a bad
    # sample_rate -- which bubble's build_naad cannot do, since it only
    # calls noise_new -- and it never re-checked the enum id at all, so a
    # hostile document could restore an out-of-range one that *_new rejects.
    var vsr = garjan_validate_sample_rate(WhistleParams_sample_rate(p));
    if (garjan_is_err(vsr) == 1) { return vsr; }
    if (garjan_enum_invalid(WhistleParams_source(p), WHISTLE_WIRE) == 1) { return GARJAN_ERR_INVALID_PARAMETER; }
    var self = garjan_alloc(sizeof(Whistle));
    if (garjan_is_err(self) == 1) { return self; }
    Whistle_set_source(self, WhistleParams_source(p));
    Whistle_set_sample_rate(self, WhistleParams_sample_rate(p));
    Whistle_set_sample_position(self, WhistleParams_sample_position(p));
    Whistle_set_base_freq(self, WhistleParams_base_freq(p));
    Whistle_set_bandwidth(self, WhistleParams_bandwidth(p));
    Whistle_set_noise_mix(self, WhistleParams_noise_mix(p));
    Whistle_set_wind_speed(self, WhistleParams_wind_speed(p));

    var rng = rng_new(0);
    if (garjan_is_err(rng) == 1) { return rng; }
    Rng_set_state(rng, WhistleParams_rng_state(p));
    Rng_set_inc(rng, WhistleParams_rng_inc(p));
    Whistle_set_rng(self, rng);

    var dc = garjan_dcblocker_new(WhistleParams_sample_rate(p));
    if (garjan_is_err(dc) == 1) { return dc; }
    DcBlocker_set_x_prev(dc, WhistleParams_dcb_x_prev(p));
    DcBlocker_set_y_prev(dc, WhistleParams_dcb_y_prev(p));
    DcBlocker_set_r(dc, WhistleParams_dcb_r(p));
    Whistle_set_dc_blocker(self, dc);

    var b = whistle_build_naad(self);
    if (garjan_is_err(b) == 1) { return b; }

    # Restore the components' live state onto the freshly built ones. A
    # document written before 2.5.0 has no "dsp" member; garjan_dsp_node
    # returns 0 and the synth resumes without it, exactly as it used to.
    var dsp = garjan_dsp_node(json);
    if (dsp != 0) {
        garjan_state_svf_load(Whistle_resonance_filter(self), bayan_json_v_obj_get(dsp, "rf"));
        garjan_state_lfo_load(Whistle_pitch_lfo(self), bayan_json_v_obj_get(dsp, "pl"));
        garjan_state_noise_load(Whistle_noise_gen(self), bayan_json_v_obj_get(dsp, "ng"));
    }
    return self;
}

# --- cloth.cyr ---

# cloth.cyr -- cloth flapping synthesis: flags, capes, sails, tarps.
#
# Ports rust-old/src/cloth.rs. Models fabric flapping as a stochastic impulse
# train at a wind-dependent rate; each flap is a short noise burst shaped by
# the cloth material's spectral character (a bandpass), optionally fed through
# a modal bank for heavy cloth (Sail). The Cyrius port always uses the naad
# backend (no feature flags), so generate_noise() = noise_next_sample through
# shape_filter (the non-naad rng.next_f32 fallback is dropped). f32 -> f64.
# Result<Self> -> pointer / negative GARJAN_* code.
#
# The naad components (noise_gen, shape_filter) plus the
# Option<ModalBank> are all reconstructable from cloth_type + sample_rate, so
# they are NOT serialized; they are rebuilt in cloth_build_naad on deserialize.
# rng + dc_blocker state ARE serialized (via the flattened ClothParams below).
# Requires: error, logging, dsp, rng, material, modal, aero foundations + the
# naad bundle (noise_new/noise_next_sample, filter_biquad_new/process_sample).

# ---- ClothParams: the serializable slice (the scalar fields only, with
# rng + dc_blocker FLATTENED to scalars so #derive(Serialize)'s single-pass
# from_json_str works). cloth_type is a CLOTH_* int. Synced to/from the live
# Cloth on (de)serialize. ----
#derive(accessors)
#derive(Serialize)
struct ClothParams {
    cloth_type: i64;
    sample_rate: f64;
    sample_position: i64;
    base_flap_rate: f64;
    amplitude: f64;
    wind_speed: f64;
    rng_state: i64;
    rng_inc: i64;
    dcb_x_prev: f64;
    dcb_y_prev: f64;
    dcb_r: f64;
}

# ---- Cloth: live synth = scalars + live rng/dc_blocker + optional modal_bank
# + naad component ptrs. modal_bank is 0 when use_modal is false. ----
#derive(accessors)
struct Cloth {
    cloth_type;
    sample_rate;
    sample_position;
    base_flap_rate;
    amplitude;
    wind_speed;
    filter_freq;
    use_modal;
    rng;
    dc_blocker;
    modal_bank;
    noise_gen;
    shape_filter;
}

# Build/refresh the reconstructable components (modal bank + naad noise/filter)
# from cloth_type + sample_rate. Shared by cloth_new and cloth_from_json_str.
# Returns GARJAN_OK, or a negative code if a constructor rejects its params.
fn cloth_build_naad(self) {
    var sr = Cloth_sample_rate(self);
    var use_modal = Cloth_use_modal(self);

    # Modal resonance for heavy cloth (Sail): Fabric material, generate_modes.
    var bank = 0;
    if (use_modal == 1) {
        var props = material_properties(MATERIAL_FABRIC);
        if (garjan_is_err(props) == 1) { return props; }
        var mode_cfg = material_mode_config(MATERIAL_FABRIC);
        if (garjan_is_err(mode_cfg) == 1) { return mode_cfg; }
        var specs = generate_modes(props, MaterialModeConfig_pattern(mode_cfg),
          MaterialModeConfig_mode_count(mode_cfg),
          MaterialModeConfig_damping_factor(mode_cfg));
        if (garjan_is_err(specs) == 1) { return specs; }
        bank = modal_bank_new(specs, sr);
        if (garjan_is_err(bank) == 1) { return bank; }
    }
    Cloth_set_modal_bank(self, bank);

    # naad: white noise generator + bandpass shape filter (Q = 1.5).
    Cloth_set_noise_gen(self, noise_new(NOISE_WHITE, 6666));
    var sf = filter_biquad_new(NAAD_FILTER_BANDPASS, sr, Cloth_filter_freq(self), f64_div(f64_from(15), f64_from(10)));
    if (garjan_is_err(sf) == 1) { return garjan_map_naad_error(sf); }
    Cloth_set_shape_filter(self, sf);
    return GARJAN_OK;
}

# Creates a new cloth flapping synthesizer. Returns a pointer or negative code.
#must_use
fn cloth_new(cloth_type, sample_rate) {
    if (garjan_enum_invalid(cloth_type, CLOTH_TARP) == 1) { return GARJAN_ERR_INVALID_PARAMETER; }
    var e = garjan_validate_sample_rate(sample_rate);
    if (garjan_is_err(e) == 1) { return e; }
    var config = aero_cloth_config(cloth_type);
    if (garjan_is_err(config) == 1) { return config; }
    var base_flap_rate = ClothConfig_flap_rate(config);
    var amplitude = ClothConfig_amplitude(config);
    var filter_freq = ClothConfig_filter_freq(config);
    var use_modal = ClothConfig_use_modal(config);

    var self = garjan_alloc(sizeof(Cloth));
    if (garjan_is_err(self) == 1) { return self; }
    Cloth_set_cloth_type(self, cloth_type);
    Cloth_set_sample_rate(self, sample_rate);
    Cloth_set_sample_position(self, 0);
    Cloth_set_base_flap_rate(self, base_flap_rate);
    Cloth_set_amplitude(self, amplitude);
    Cloth_set_wind_speed(self, 0);
    Cloth_set_filter_freq(self, filter_freq);
    Cloth_set_use_modal(self, use_modal);
    var ga_rng1 = rng_new(6666);
    if (garjan_is_err(ga_rng1) == 1) { return ga_rng1; }
    Cloth_set_rng(self, ga_rng1);
    var ga_dcb2 = garjan_dcblocker_new(sample_rate);
    if (garjan_is_err(ga_dcb2) == 1) { return ga_dcb2; }
    Cloth_set_dc_blocker(self, ga_dcb2);
    var b = cloth_build_naad(self);
    if (garjan_is_err(b) == 1) { return b; }
    return self;
}

# Sets the wind speed (0.0 = still, 1.0 = strong wind).
fn cloth_set_wind_speed(self, speed) {
    Cloth_set_wind_speed(self, f64_clamp(speed, 0, F64_ONE));
    return 0;
}

# One shaped noise sample: white noise through the bandpass shape filter.
#inline
#must_use
fn cloth_generate_noise(self) {
    var raw = noise_next_sample(Cloth_noise_gen(self));
    return filter_biquad_process_sample(Cloth_shape_filter(self), raw);
}

# Fills `output` (a vec of f64) with cloth flapping audio (streaming). Ports
# process_block: below the wind threshold it emits silence (still ticking the
# DC blocker), otherwise it schedules flap events via a Poisson process.
fn cloth_process_block(self, output) {
    var num = vec_len(output);
    var dc = Cloth_dc_blocker(self);
    var wind = Cloth_wind_speed(self);

    # Below threshold: silence, but keep the DC blocker's state advancing.
    var threshold = f64_div(f64_from(1), f64_from(1000));   # 0.001
    if (f64_lt(wind, threshold) == 1) {
        var s = 0;
        while (s < num) {
            vec_set(output, s, 0);
            garjan_dcblocker_process(dc, 0);
            s = s + 1;
        }
        Cloth_set_sample_position(self, Cloth_sample_position(self) + num);
        return 0;
    }

    var rng = Cloth_rng(self);
    var amplitude = Cloth_amplitude(self);
    var sr = Cloth_sample_rate(self);
    var modal_bank = Cloth_modal_bank(self);

    var flap_rate = f64_mul(Cloth_base_flap_rate(self), wind);
    var block_size = f64_to(f64_mul(sr, f64_div(f64_from(1), f64_from(100))));   # sr*0.01
    var flaps_per_block = f64_mul(flap_rate, f64_div(f64_from(1), f64_from(100)));

    # Initialize output to zero.
    var z = 0;
    while (z < num) {
        vec_set(output, z, 0);
        z = z + 1;
    }

    var step = block_size;
    if (step < 1) { step = 1; }

    # Flap-envelope constants, hoisted: the duration range was rebuilt per flap
    # and the attack/decay/dry-mix terms on every sample of every flap tail.
    var dur_lo = f64_div(f64_from(5), f64_from(1000));    # 0.005 s
    var dur_hi = f64_div(f64_from(2), f64_from(100));     # 0.02 s
    var attack_end = f64_div(f64_from(1), f64_from(10));  # 0.1
    var neg_five = f64_neg(f64_from(5));
    var dry_mix = f64_div(f64_from(3), f64_from(10));     # 0.3

    var block_start = 0;
    while (block_start < num) {
        var block_end = block_start + block_size;
        if (block_end > num) { block_end = num; }
        var n_flaps = rng_poisson(rng, flaps_per_block);
        # Block width is fixed for the whole flap loop below.
        var width = f64_from(block_end - block_start);
        var c = 0;
        while (c < n_flaps) {
            var offset = f64_to(rng_next_f32_range(rng, 0, width));
            var idx = block_start + offset;
            if (idx < num) {
                # Each flap: noise burst with fast attack, medium decay.
                var flap_amp = f64_mul(amplitude, f64_mul(wind, rng_next_f32_range(rng, F64_HALF, F64_ONE)));
                var flap_dur = f64_to(f64_mul(sr, rng_next_f32_range(rng, dur_lo, dur_hi)));
                # Fixed for this flap's envelope; converted once, not per sample.
                var flap_dur_f = f64_from(flap_dur);
                var span = flap_dur;
                if (num - idx < span) { span = num - idx; }
                var j = 0;
                while (j < span) {
                    var t = f64_div(f64_from(j), flap_dur_f);
                    # Fast attack (t < 0.1 -> t/0.1), longer decay (exp(-5*(t-0.1))).
                    var env = 0;
                    if (f64_lt(t, attack_end) == 1) {
                        env = f64_div(t, attack_end);
                    } else {
                        env = f64_exp(f64_mul(neg_five, f64_sub(t, attack_end)));
                    }
                    var noise = cloth_generate_noise(self);
                    var exc = f64_mul(noise, f64_mul(env, flap_amp));
                    # Feed through modal bank for heavy cloth (Sail).
                    var out = exc;
                    if (modal_bank != 0) {
                        out = f64_add(modal_bank_process_sample(modal_bank, exc),
                          f64_mul(exc, dry_mix));
                    }
                    vec_set(output, idx + j, f64_add(vec_get(output, idx + j), out));
                    j = j + 1;
                }
            }
            c = c + 1;
        }
        block_start = block_start + step;
    }

    # DC blocking, then advance the sample cursor.
    var i = 0;
    while (i < num) {
        vec_set(output, i, garjan_dcblocker_process(dc, vec_get(output, i)));
        i = i + 1;
    }
    Cloth_set_sample_position(self, Cloth_sample_position(self) + num);
    return 0;
}

# Synthesize `duration` seconds of cloth audio into a fresh vec. Returns the
# vec pointer, or a negative code on invalid duration.
#must_use
fn cloth_synthesize(self, duration) {
    var e = garjan_validate_duration(duration);
    if (garjan_is_err(e) == 1) { return e; }
    var num = f64_to(f64_mul(Cloth_sample_rate(self), duration));
    var ga_ncheck = garjan_validate_sample_count(num);
    if (garjan_is_err(ga_ncheck) == 1) { return ga_ncheck; }
    var output = vec_new();
    var i = 0;
    while (i < num) {
        vec_push(output, 0);
        i = i + 1;
    }
    cloth_process_block(self, output);
    return output;
}

# ---- serde: snapshot live state -> ClothParams -> JSON, and back. ----
#must_use
fn cloth_to_json(self, sb) {
    var p = garjan_alloc(sizeof(ClothParams));
    if (garjan_is_err(p) == 1) { return p; }
    ClothParams_set_cloth_type(p, Cloth_cloth_type(self));
    ClothParams_set_sample_rate(p, Cloth_sample_rate(self));
    ClothParams_set_sample_position(p, Cloth_sample_position(self));
    ClothParams_set_base_flap_rate(p, Cloth_base_flap_rate(self));
    ClothParams_set_amplitude(p, Cloth_amplitude(self));
    ClothParams_set_wind_speed(p, Cloth_wind_speed(self));
    var rng = Cloth_rng(self);
    ClothParams_set_rng_state(p, Rng_state(rng));
    ClothParams_set_rng_inc(p, Rng_inc(rng));
    var dc = Cloth_dc_blocker(self);
    ClothParams_set_dcb_x_prev(p, DcBlocker_x_prev(dc));
    ClothParams_set_dcb_y_prev(p, DcBlocker_y_prev(dc));
    ClothParams_set_dcb_r(p, DcBlocker_r(dc));
    # Scalars via the derive, then the naad components' LIVE state spliced
    # in as "dsp" -- without it a restore resumes with zeroed filter memory.
    var psb = str_builder_new();
    var pe = ClothParams_to_json(p, psb);
    if (garjan_is_err(pe) == 1) { return pe; }
    var dsp = bayan_json_v_obj_new();
    bayan_json_v_obj_set(dsp, str_from("ng"), garjan_state_noise(Cloth_noise_gen(self)));
    bayan_json_v_obj_set(dsp, str_from("sf"), garjan_state_biquad(Cloth_shape_filter(self)));
    bayan_json_v_obj_set(dsp, str_from("mb"), garjan_state_modal(Cloth_modal_bank(self)));
    return garjan_emit_with_dsp(sb, psb, dsp);
}

# Rebuild a Cloth from JSON: restore scalars + rng + dc_blocker state, then
# reconstruct the modal bank + naad components fresh (matches Rust's
# rebuilt, not restored -- architecture note 001). filter_freq / use_modal are re-derived from cloth_type.
#must_use
fn cloth_from_json_str(json) {
    var p = ClothParams_from_json_str(json);
    # Deserialize must validate what the constructor validates. Before 2.5.1
    # this path relied on a downstream naad component rejecting a bad
    # sample_rate -- which bubble's build_naad cannot do, since it only
    # calls noise_new -- and it never re-checked the enum id at all, so a
    # hostile document could restore an out-of-range one that *_new rejects.
    var vsr = garjan_validate_sample_rate(ClothParams_sample_rate(p));
    if (garjan_is_err(vsr) == 1) { return vsr; }
    if (garjan_enum_invalid(ClothParams_cloth_type(p), CLOTH_TARP) == 1) { return GARJAN_ERR_INVALID_PARAMETER; }
    var self = garjan_alloc(sizeof(Cloth));
    if (garjan_is_err(self) == 1) { return self; }
    var cloth_type = ClothParams_cloth_type(p);
    Cloth_set_cloth_type(self, cloth_type);
    Cloth_set_sample_rate(self, ClothParams_sample_rate(p));
    Cloth_set_sample_position(self, ClothParams_sample_position(p));
    Cloth_set_base_flap_rate(self, ClothParams_base_flap_rate(p));
    Cloth_set_amplitude(self, ClothParams_amplitude(p));
    Cloth_set_wind_speed(self, ClothParams_wind_speed(p));

    # Re-derive filter_freq + use_modal from the cloth_type config.
    var config = aero_cloth_config(cloth_type);
    if (garjan_is_err(config) == 1) { return config; }
    Cloth_set_filter_freq(self, ClothConfig_filter_freq(config));
    Cloth_set_use_modal(self, ClothConfig_use_modal(config));

    var rng = rng_new(0);
    if (garjan_is_err(rng) == 1) { return rng; }
    Rng_set_state(rng, ClothParams_rng_state(p));
    Rng_set_inc(rng, ClothParams_rng_inc(p));
    Cloth_set_rng(self, rng);

    var dc = garjan_dcblocker_new(ClothParams_sample_rate(p));
    if (garjan_is_err(dc) == 1) { return dc; }
    DcBlocker_set_x_prev(dc, ClothParams_dcb_x_prev(p));
    DcBlocker_set_y_prev(dc, ClothParams_dcb_y_prev(p));
    DcBlocker_set_r(dc, ClothParams_dcb_r(p));
    Cloth_set_dc_blocker(self, dc);

    var b = cloth_build_naad(self);
    if (garjan_is_err(b) == 1) { return b; }

    # Restore the components' live state onto the freshly built ones. A
    # document written before 2.5.0 has no "dsp" member; garjan_dsp_node
    # returns 0 and the synth resumes without it, exactly as it used to.
    var dsp = garjan_dsp_node(json);
    if (dsp != 0) {
        garjan_state_modal_load(Cloth_modal_bank(self), bayan_json_v_obj_get(dsp, "mb"));
        garjan_state_noise_load(Cloth_noise_gen(self), bayan_json_v_obj_get(dsp, "ng"));
        garjan_state_biquad_load(Cloth_shape_filter(self), bayan_json_v_obj_get(dsp, "sf"));
    }
    return self;
}

# --- insect.cyr ---

# insect.cyr -- insect sound synthesis: wing buzz, cricket chirp, cicada drone.
#
# Ports rust-old/src/insect.rs. The Cyrius port always uses the naad backend
# (no feature flags), so it ports the #[cfg(feature="naad-backend")] path and
# drops the fallback. f32 -> f64. Result<Self> -> pointer / negative GARJAN_*
# code. The naad components (noise_gen +
# shape_filter) are reconstructed on deserialize; all scalar params + the rng,
# dc_blocker, and the 8 precomputed swarm detunings ARE serialized (via the
# flattened InsectParams below).
#
# Requires: error, logging, dsp, rng, creature foundations + the naad bundle
# (noise_new/noise_next_sample, filter_biquad_new/filter_biquad_process_sample)
# + stdlib math (F64_TAU, f64_clamp) and ganita.

# ---- InsectParams: the serializable slice (exactly Rust's fields, with rng,
# dc_blocker, and the [f32;8] swarm_detunings FLATTENED to scalar fields so
# #derive(Serialize)'s single-pass from_json_str works). insect_type is an
# int tag. Synced to/from the live Insect on (de)serialize. ----
#derive(accessors)
#derive(Serialize)
struct InsectParams {
    insect_type: i64;
    sample_rate: f64;
    sample_position: i64;
    base_freq: f64;
    mod_rate: f64;
    chirp_rate: f64;
    amplitude: f64;
    intensity: f64;
    swarm_count: i64;
    det0: f64;
    det1: f64;
    det2: f64;
    det3: f64;
    det4: f64;
    det5: f64;
    det6: f64;
    det7: f64;
    rng_state: i64;
    rng_inc: i64;
    dcb_x_prev: f64;
    dcb_y_prev: f64;
    dcb_r: f64;
}

# ---- Insect: live synth = scalars + the 8 detunings + live rng/dc_blocker +
# naad component ptrs. ----
#derive(accessors)
struct Insect {
    insect_type;
    sample_rate;
    sample_position;
    base_freq;
    mod_rate;
    chirp_rate;
    amplitude;
    intensity;
    swarm_count;
    det0;
    det1;
    det2;
    det3;
    det4;
    det5;
    det6;
    det7;
    rng;
    dc_blocker;
    noise_gen;
    shape_filter;
}

# Read swarm detuning `voice` (0..7) from the live Insect.
#must_use
fn insect_detune(self, voice) {
    if (voice == 0) { return Insect_det0(self); }
    if (voice == 1) { return Insect_det1(self); }
    if (voice == 2) { return Insect_det2(self); }
    if (voice == 3) { return Insect_det3(self); }
    if (voice == 4) { return Insect_det4(self); }
    if (voice == 5) { return Insect_det5(self); }
    if (voice == 6) { return Insect_det6(self); }
    return Insect_det7(self);
}

# Build/refresh the naad components from sample_rate + base_freq. Shared by
# insect_new and insect_from_json_str (rebuilt, not restored -- architecture note 001).
# Returns GARJAN_OK or a negative code if a naad constructor rejects params.
fn insect_build_naad(self) {
    var sr = Insect_sample_rate(self);
    var base = Insect_base_freq(self);
    # q = (base_freq / 200.0).clamp(1.0, 20.0)
    var q = f64_clamp(f64_div(base, f64_from(200)), F64_ONE, f64_from(20));
    var sf = filter_biquad_new(NAAD_FILTER_BANDPASS, sr, base, q);
    if (garjan_is_err(sf) == 1) { return garjan_map_naad_error(sf); }
    Insect_set_shape_filter(self, sf);
    Insect_set_noise_gen(self, noise_new(NOISE_WHITE, 9999));
    return GARJAN_OK;
}

# Creates a new single insect synthesizer. Returns a pointer or a negative
# code. Preserves the Rust rng call order: a fresh det_rng(12321) draws the 8
# detunings BEFORE the main rng(9999) is created.
#must_use
fn insect_new(insect_type, sample_rate) {
    if (garjan_enum_invalid(insect_type, INSECT_CICADA_DRONE) == 1) { return GARJAN_ERR_INVALID_PARAMETER; }
    var e = garjan_validate_sample_rate(sample_rate);
    if (garjan_is_err(e) == 1) { return e; }

    var cfg = creature_insect_config(insect_type);
    if (garjan_is_err(cfg) == 1) { return cfg; }
    var base_freq = InsectConfig_base_freq(cfg);
    var mod_rate = InsectConfig_mod_rate(cfg);
    var chirp_rate = InsectConfig_chirp_rate(cfg);
    var amplitude = InsectConfig_amplitude(cfg);

    # Pre-compute swarm detunings (det_rng seeded 12321), +/- 8% each.
    var det_rng = rng_new(12321);
    if (garjan_is_err(det_rng) == 1) { return det_rng; }
    var lo = f64_neg(f64_div(f64_from(8), f64_from(100)));
    var hi = f64_div(f64_from(8), f64_from(100));

    var self = garjan_alloc(sizeof(Insect));
    if (garjan_is_err(self) == 1) { return self; }
    Insect_set_det0(self, rng_next_f32_range(det_rng, lo, hi));
    Insect_set_det1(self, rng_next_f32_range(det_rng, lo, hi));
    Insect_set_det2(self, rng_next_f32_range(det_rng, lo, hi));
    Insect_set_det3(self, rng_next_f32_range(det_rng, lo, hi));
    Insect_set_det4(self, rng_next_f32_range(det_rng, lo, hi));
    Insect_set_det5(self, rng_next_f32_range(det_rng, lo, hi));
    Insect_set_det6(self, rng_next_f32_range(det_rng, lo, hi));
    Insect_set_det7(self, rng_next_f32_range(det_rng, lo, hi));

    Insect_set_insect_type(self, insect_type);
    Insect_set_sample_rate(self, sample_rate);
    Insect_set_sample_position(self, 0);
    Insect_set_base_freq(self, base_freq);
    Insect_set_mod_rate(self, mod_rate);
    Insect_set_chirp_rate(self, chirp_rate);
    Insect_set_amplitude(self, amplitude);
    Insect_set_intensity(self, F64_ONE);
    Insect_set_swarm_count(self, 1);
    var ga_rng1 = rng_new(9999);
    if (garjan_is_err(ga_rng1) == 1) { return ga_rng1; }
    Insect_set_rng(self, ga_rng1);
    var ga_dcb2 = garjan_dcblocker_new(sample_rate);
    if (garjan_is_err(ga_dcb2) == 1) { return ga_dcb2; }
    Insect_set_dc_blocker(self, ga_dcb2);

    var b = insect_build_naad(self);
    if (garjan_is_err(b) == 1) { return b; }
    return self;
}

# Creates a swarm of insects (1-8 overlapping instances with detuning).
# Returns a pointer or a negative code.
#must_use
fn insect_new_swarm(insect_type, count, sample_rate) {
    var self = insect_new(insect_type, sample_rate);
    if (garjan_is_err(self) == 1) { return self; }
    var c = count;
    if (c < 1) { c = 1; }
    if (c > 8) { c = 8; }
    Insect_set_swarm_count(self, c);
    return self;
}

# Sets the intensity (0.0 = silent, 1.0 = full volume).
fn insect_set_intensity(self, intensity) {
    Insect_set_intensity(self, f64_clamp(intensity, 0, F64_ONE));
    return 0;
}

# Synthesizes one voice's contribution at time `t` and frequency `freq`.
# Mirrors Rust synthesize_voice (naad path for CicadaDrone).
#must_use
# `phase_offset` and `freq` are per-VOICE invariants -- they do not vary with
# `t` -- so insect_process_block computes them once per block and passes them
# in. Recomputing them here cost an 8-branch insect_detune plus a divide and
# two multiplies on every sample of every voice: at swarm 8 that is 352,800
# redundant evaluations per second of audio, and the CicadaDrone branch does
# not even read `freq`.
fn insect_synthesize_voice(self, t, freq, phase_offset) {
    var ty = Insect_insect_type(self);
    var mod_rate = Insect_mod_rate(self);

    if (ty == INSECT_WING_BUZZ) {
        # carrier = sin(TAU*freq*t + phase_offset)
        var wb_carrier = f64_sin(f64_add(f64_mul(F64_TAU, f64_mul(freq, t)), phase_offset));
        # modulator = 0.5 + 0.5 * sin(TAU*mod_rate*t + phase_offset*2)
        var wb_ph2 = f64_mul(phase_offset, F64_TWO);
        var wb_ms = f64_sin(f64_add(f64_mul(F64_TAU, f64_mul(mod_rate, t)), wb_ph2));
        var wb_mod = f64_add(F64_HALF, f64_mul(F64_HALF, wb_ms));
        return f64_mul(wb_carrier, wb_mod);
    } elif (ty == INSECT_CRICKET_CHIRP) {
        # chirp_phase = (chirp_rate*t + phase_offset*0.1) % 1.0
        var cc_arg = f64_add(f64_mul(Insect_chirp_rate(self), t),
          f64_mul(phase_offset, f64_div(F64_ONE, f64_from(10))));
        var cc_phase = f64_fmod(cc_arg, F64_ONE);
        if (f64_lt(cc_phase, f64_div(f64_from(4), f64_from(10))) == 1) {
            var cc_pulse = f64_sin(f64_add(f64_mul(F64_TAU, f64_mul(mod_rate, t)), phase_offset));
            var cc_carrier = f64_sin(f64_add(f64_mul(F64_TAU, f64_mul(freq, t)), phase_offset));
            var cc_gate = 0;
            if (f64_gt(cc_pulse, 0) == 1) { cc_gate = cc_pulse; }
            return f64_mul(cc_carrier, cc_gate);
        }
        return 0;
    } else {
        # CicadaDrone: broadband rattle -- filtered noise with slow AM.
        # modulator = 0.6 + 0.4 * sin(TAU*mod_rate*t + phase_offset)
        var cd_six = f64_div(f64_from(6), f64_from(10));
        var cd_four = f64_div(f64_from(4), f64_from(10));
        var cd_ms = f64_sin(f64_add(f64_mul(F64_TAU, f64_mul(mod_rate, t)), phase_offset));
        var cd_mod = f64_add(cd_six, f64_mul(cd_four, cd_ms));
        var cd_noise = noise_next_sample(Insect_noise_gen(self));
        var cd_filt = filter_biquad_process_sample(Insect_shape_filter(self), cd_noise);
        return f64_mul(cd_filt, cd_mod);
    }
}

# Fills `output` (a vec of f64) with insect audio (streaming). Ports
# process_block: per-sample voice sum, amplitude/intensity/swarm scaling,
# DC-block, then advance position. Below intensity 0.001 emits silence but
# still advances the dc_blocker to keep its state faithful to the Rust.
fn insect_process_block(self, output) {
    var num = vec_len(output);
    var dc = Insect_dc_blocker(self);

    # Silent path (intensity < 0.001): zero output, pump dc_blocker with 0.
    if (f64_lt(Insect_intensity(self), f64_div(F64_ONE, f64_from(1000))) == 1) {
        var s = 0;
        while (s < num) {
            vec_set(output, s, 0);
            garjan_dcblocker_process(dc, 0);
            s = s + 1;
        }
        Insect_set_sample_position(self, Insect_sample_position(self) + num);
        return 0;
    }

    var sr = Insect_sample_rate(self);
    var base_freq = Insect_base_freq(self);
    var amplitude = Insect_amplitude(self);
    var intensity = Insect_intensity(self);
    var swarm_count = Insect_swarm_count(self);
    var pos = Insect_sample_position(self);
    # inv_swarm = 1.0 / swarm_count
    var inv_swarm = f64_div(F64_ONE, f64_from(swarm_count));

    # Per-voice invariants, computed once per block instead of once per sample.
    # 64 bytes = 8 f64 slots; swarm_count is clamped to 1..8 on every path that
    # sets it (insect_new_swarm, and insect_from_json_str since 2.0.2).
    var freqs[64];
    var phases[64];
    # 64 bytes = 8 f64 slots. swarm_count is clamped to 1..8 on every path that
    # sets it, so this is defence in depth -- but the margin is ZERO, and a
    # future cap raised without resizing these would corrupt the stack silently.
    if (swarm_count > 8) { swarm_count = 8; }
    if (swarm_count < 1) { swarm_count = 1; }
    var phase_step = f64_div(f64_from(37), f64_from(100));
    var v = 0;
    while (v < swarm_count) {
        # detune = 1.0 + swarm_detunings[voice]; freq = base_freq * detune
        var detune = f64_add(F64_ONE, insect_detune(self, v));
        store64(&freqs + v * 8, f64_mul(base_freq, detune));
        store64(&phases + v * 8, f64_mul(f64_from(v), phase_step));
        v = v + 1;
    }

    # The inner loop runs once per voice per sample -- 352,800 times per second
    # of audio at swarm 8 -- so the insect type is branched on ONCE here rather
    # than inside it, and every accessor read is hoisted. Measured: an accessor
    # read costs ~0.54 ms per 352,800 calls, so the four that used to sit in the
    # inner loop were ~2 ms/s on their own. (Constant construction is NOT
    # hoisted: cycc already constant-folds `f64_div(f64_from(6), f64_from(10))`,
    # measured at the same cost as an empty loop.)
    #
    # The three branches reproduce insect_synthesize_voice exactly, term for
    # term; that function is retained as the readable reference.
    var ty = Insect_insect_type(self);
    var mod_rate = Insect_mod_rate(self);

    var i = 0;
    if (ty == INSECT_WING_BUZZ) {
        while (i < num) {
            var t = f64_div(f64_from(pos + i), sr);
            # voice-invariant within this sample; was rebuilt once per voice
            var mod_arg = f64_mul(F64_TAU, f64_mul(mod_rate, t));
            var out = 0;
            var voice = 0;
            while (voice < swarm_count) {
                var ph = load64(&phases + voice * 8);
                var fq = load64(&freqs + voice * 8);
                var carrier = f64_sin(f64_add(f64_mul(F64_TAU, f64_mul(fq, t)), ph));
                var ms = f64_sin(f64_add(mod_arg, f64_mul(ph, F64_TWO)));
                out = f64_add(out, f64_mul(carrier, f64_add(F64_HALF, f64_mul(F64_HALF, ms))));
                voice = voice + 1;
            }
            var scaled = f64_mul(f64_mul(f64_mul(out, amplitude), intensity), inv_swarm);
            vec_set(output, i, garjan_dcblocker_process(dc, scaled));
            i = i + 1;
        }
    } elif (ty == INSECT_CRICKET_CHIRP) {
        var chirp_rate = Insect_chirp_rate(self);
        while (i < num) {
            var t = f64_div(f64_from(pos + i), sr);
            # both voice-invariant within this sample
            var mod_arg = f64_mul(F64_TAU, f64_mul(mod_rate, t));
            var chirp_t = f64_mul(chirp_rate, t);
            var out = 0;
            var voice = 0;
            while (voice < swarm_count) {
                var ph = load64(&phases + voice * 8);
                var fq = load64(&freqs + voice * 8);
                var arg = f64_add(chirp_t,
                  f64_mul(ph, f64_div(F64_ONE, f64_from(10))));
                var phase = f64_fmod(arg, F64_ONE);
                if (f64_lt(phase, f64_div(f64_from(4), f64_from(10))) == 1) {
                    var pulse = f64_sin(f64_add(mod_arg, ph));
                    var carrier = f64_sin(f64_add(f64_mul(F64_TAU, f64_mul(fq, t)), ph));
                    var gate = 0;
                    if (f64_gt(pulse, 0) == 1) { gate = pulse; }
                    out = f64_add(out, f64_mul(carrier, gate));
                }
                voice = voice + 1;
            }
            var scaled = f64_mul(f64_mul(f64_mul(out, amplitude), intensity), inv_swarm);
            vec_set(output, i, garjan_dcblocker_process(dc, scaled));
            i = i + 1;
        }
    } else {
        # CicadaDrone -- the slowest type, and the one the benchmark measures.
        # noise_gen and shape_filter are shared across voices (as in Rust), so
        # each voice advances the same streams; the order is preserved exactly.
        var noise_gen = Insect_noise_gen(self);
        var shape_filter = Insect_shape_filter(self);
        while (i < num) {
            var t = f64_div(f64_from(pos + i), sr);
            # voice-invariant within this sample; was rebuilt for all 8 voices
            var mod_arg = f64_mul(F64_TAU, f64_mul(mod_rate, t));
            var out = 0;
            var voice = 0;
            while (voice < swarm_count) {
                var ph = load64(&phases + voice * 8);
                var ms = f64_sin(f64_add(mod_arg, ph));
                var md = f64_add(f64_div(f64_from(6), f64_from(10)),
                  f64_mul(f64_div(f64_from(4), f64_from(10)), ms));
                var filt = filter_biquad_process_sample(shape_filter, noise_next_sample(noise_gen));
                out = f64_add(out, f64_mul(filt, md));
                voice = voice + 1;
            }
            var scaled = f64_mul(f64_mul(f64_mul(out, amplitude), intensity), inv_swarm);
            vec_set(output, i, garjan_dcblocker_process(dc, scaled));
            i = i + 1;
        }
    }
    Insect_set_sample_position(self, pos + num);
    return 0;
}

# Synthesize `duration` seconds of insect audio into a fresh vec. Returns the
# vec pointer, or a negative code on invalid duration.
#must_use
fn insect_synthesize(self, duration) {
    var e = garjan_validate_duration(duration);
    if (garjan_is_err(e) == 1) { return e; }
    var num = f64_to(f64_mul(Insect_sample_rate(self), duration));
    var ga_ncheck = garjan_validate_sample_count(num);
    if (garjan_is_err(ga_ncheck) == 1) { return ga_ncheck; }
    var output = vec_new();
    var i = 0;
    while (i < num) {
        vec_push(output, 0);
        i = i + 1;
    }
    insect_process_block(self, output);
    return output;
}

# ---- serde: snapshot live state -> InsectParams -> JSON, and back. ----
#must_use
fn insect_to_json(self, sb) {
    var p = garjan_alloc(sizeof(InsectParams));
    if (garjan_is_err(p) == 1) { return p; }
    InsectParams_set_insect_type(p, Insect_insect_type(self));
    InsectParams_set_sample_rate(p, Insect_sample_rate(self));
    InsectParams_set_sample_position(p, Insect_sample_position(self));
    InsectParams_set_base_freq(p, Insect_base_freq(self));
    InsectParams_set_mod_rate(p, Insect_mod_rate(self));
    InsectParams_set_chirp_rate(p, Insect_chirp_rate(self));
    InsectParams_set_amplitude(p, Insect_amplitude(self));
    InsectParams_set_intensity(p, Insect_intensity(self));
    InsectParams_set_swarm_count(p, Insect_swarm_count(self));
    InsectParams_set_det0(p, Insect_det0(self));
    InsectParams_set_det1(p, Insect_det1(self));
    InsectParams_set_det2(p, Insect_det2(self));
    InsectParams_set_det3(p, Insect_det3(self));
    InsectParams_set_det4(p, Insect_det4(self));
    InsectParams_set_det5(p, Insect_det5(self));
    InsectParams_set_det6(p, Insect_det6(self));
    InsectParams_set_det7(p, Insect_det7(self));
    var rng = Insect_rng(self);
    InsectParams_set_rng_state(p, Rng_state(rng));
    InsectParams_set_rng_inc(p, Rng_inc(rng));
    var dc = Insect_dc_blocker(self);
    InsectParams_set_dcb_x_prev(p, DcBlocker_x_prev(dc));
    InsectParams_set_dcb_y_prev(p, DcBlocker_y_prev(dc));
    InsectParams_set_dcb_r(p, DcBlocker_r(dc));
    # Scalars via the derive, then the naad components' LIVE state spliced
    # in as "dsp" -- without it a restore resumes with zeroed filter memory.
    var psb = str_builder_new();
    var pe = InsectParams_to_json(p, psb);
    if (garjan_is_err(pe) == 1) { return pe; }
    var dsp = bayan_json_v_obj_new();
    bayan_json_v_obj_set(dsp, str_from("sf"), garjan_state_biquad(Insect_shape_filter(self)));
    bayan_json_v_obj_set(dsp, str_from("ng"), garjan_state_noise(Insect_noise_gen(self)));
    return garjan_emit_with_dsp(sb, psb, dsp);
}

# Rebuild an Insect from JSON: restore scalars + the 8 detunings + rng +
# dc_blocker state, then reconstruct the naad components fresh.
#must_use
fn insect_from_json_str(json) {
    var p = InsectParams_from_json_str(json);
    # Deserialize must validate what the constructor validates. Before 2.5.1
    # this path relied on a downstream naad component rejecting a bad
    # sample_rate -- which bubble's build_naad cannot do, since it only
    # calls noise_new -- and it never re-checked the enum id at all, so a
    # hostile document could restore an out-of-range one that *_new rejects.
    var vsr = garjan_validate_sample_rate(InsectParams_sample_rate(p));
    if (garjan_is_err(vsr) == 1) { return vsr; }
    if (garjan_enum_invalid(InsectParams_insect_type(p), INSECT_CICADA_DRONE) == 1) {
        return GARJAN_ERR_INVALID_PARAMETER;
    }
    var self = garjan_alloc(sizeof(Insect));
    if (garjan_is_err(self) == 1) { return self; }
    Insect_set_insect_type(self, InsectParams_insect_type(p));
    Insect_set_sample_rate(self, InsectParams_sample_rate(p));
    Insect_set_sample_position(self, InsectParams_sample_position(p));
    Insect_set_base_freq(self, InsectParams_base_freq(p));
    Insect_set_mod_rate(self, InsectParams_mod_rate(p));
    Insect_set_chirp_rate(self, InsectParams_chirp_rate(p));
    Insect_set_amplitude(self, InsectParams_amplitude(p));
    Insect_set_intensity(self, InsectParams_intensity(p));
    # swarm_count carries a 1..8 invariant that insect_new_swarm enforces and
    # that insect_detune's eight det0..det7 fields physically encode; restore it
    # here too. Deserialize was the one path that set the field raw, and it is
    # the bound of the per-sample inner voice loop (insect_process_block), so an
    # unclamped value turned one process_block into an effectively unbounded
    # loop -- with insect_detune saturating every index >= 7 to det7 rather than
    # trapping, so nothing downstream noticed.
    var sc = InsectParams_swarm_count(p);
    if (sc < 1) { sc = 1; }
    if (sc > 8) { sc = 8; }
    Insect_set_swarm_count(self, sc);
    Insect_set_det0(self, InsectParams_det0(p));
    Insect_set_det1(self, InsectParams_det1(p));
    Insect_set_det2(self, InsectParams_det2(p));
    Insect_set_det3(self, InsectParams_det3(p));
    Insect_set_det4(self, InsectParams_det4(p));
    Insect_set_det5(self, InsectParams_det5(p));
    Insect_set_det6(self, InsectParams_det6(p));
    Insect_set_det7(self, InsectParams_det7(p));

    var rng = rng_new(0);
    if (garjan_is_err(rng) == 1) { return rng; }
    Rng_set_state(rng, InsectParams_rng_state(p));
    Rng_set_inc(rng, InsectParams_rng_inc(p));
    Insect_set_rng(self, rng);

    var dc = garjan_dcblocker_new(InsectParams_sample_rate(p));
    if (garjan_is_err(dc) == 1) { return dc; }
    DcBlocker_set_x_prev(dc, InsectParams_dcb_x_prev(p));
    DcBlocker_set_y_prev(dc, InsectParams_dcb_y_prev(p));
    DcBlocker_set_r(dc, InsectParams_dcb_r(p));
    Insect_set_dc_blocker(self, dc);

    var b = insect_build_naad(self);
    if (garjan_is_err(b) == 1) { return b; }

    # Restore the components' live state onto the freshly built ones. A
    # document written before 2.5.0 has no "dsp" member; garjan_dsp_node
    # returns 0 and the synth resumes without it, exactly as it used to.
    var dsp = garjan_dsp_node(json);
    if (dsp != 0) {
        garjan_state_biquad_load(Insect_shape_filter(self), bayan_json_v_obj_get(dsp, "sf"));
        garjan_state_noise_load(Insect_noise_gen(self), bayan_json_v_obj_get(dsp, "ng"));
    }
    return self;
}

# --- wingflap.cyr ---

# wingflap.cyr -- bird wing flap synthesis: aerodynamic displacement sounds.
#
# Ports rust-old/src/wingflap.rs. Models bird wings as periodic air
# displacement events: each flap is a short filtered noise burst, with rate
# and character set by bird size. The Cyrius port always uses the naad
# backend (no feature flags), so generate_noise() = noise_next_sample through
# shape_filter (the non-naad rng.next_f32 fallback is dropped). f32 -> f64.
# Result<Self> -> pointer / negative GARJAN_* code.
#
# The naad components (noise_gen, shape_filter) are
# reconstructable from filter_freq + sample_rate, so they are NOT serialized;
# they are rebuilt in wingflap_build_naad on deserialize. rng + dc_blocker
# state ARE serialized (via the flattened WingFlapParams below).
# Requires: error, logging, dsp, rng foundations + the naad bundle
# (noise_new/noise_next_sample, filter_biquad_new/filter_biquad_process_sample).

# ---- BirdSize (enum) -> integer constants (declaration order). ----
var BIRD_SIZE_SMALL  = 0;
var BIRD_SIZE_MEDIUM = 1;
var BIRD_SIZE_LARGE  = 2;

# ---- WingFlapParams: the serializable slice (the scalar fields only, with
# rng + dc_blocker FLATTENED to scalars so #derive(Serialize)'s single-pass
# from_json_str works). bird_size is a BIRD_SIZE_* int. filter_freq is carried
# so build_naad can reconstruct the bandpass shape filter. Synced to/from the
# live WingFlap on (de)serialize. ----
#derive(accessors)
#derive(Serialize)
struct WingFlapParams {
    bird_size: i64;
    sample_rate: f64;
    sample_position: i64;
    flap_rate: f64;
    flap_duration_samples: i64;
    amplitude: f64;
    flap_phase: f64;
    intensity: f64;
    filter_freq: f64;
    rng_state: i64;
    rng_inc: i64;
    dcb_x_prev: f64;
    dcb_y_prev: f64;
    dcb_r: f64;
}

# ---- WingFlap: live synth = scalars + live rng/dc_blocker + naad ptrs. ----
#derive(accessors)
struct WingFlap {
    bird_size;
    sample_rate;
    sample_position;
    flap_rate;
    flap_duration_samples;
    amplitude;
    flap_phase;
    intensity;
    filter_freq;
    rng;
    dc_blocker;
    noise_gen;
    shape_filter;
}

# Returns the flap_rate_hz for a bird size (BirdSize::config field 0).
#must_use
fn wingflap_config_flap_rate(bird_size) {
    if (bird_size == BIRD_SIZE_SMALL) { return f64_from(12); }
    if (bird_size == BIRD_SIZE_MEDIUM) { return f64_from(6); }
    return f64_div(f64_from(25), f64_from(10));
}

# Returns the flap_duration_s for a bird size (BirdSize::config field 1).
#must_use
fn wingflap_config_flap_duration(bird_size) {
    if (bird_size == BIRD_SIZE_SMALL) { return f64_div(f64_from(15), f64_from(1000)); }
    if (bird_size == BIRD_SIZE_MEDIUM) { return f64_div(f64_from(3), f64_from(100)); }
    return f64_div(f64_from(6), f64_from(100));
}

# Returns the filter_freq for a bird size (BirdSize::config field 2).
#must_use
fn wingflap_config_filter_freq(bird_size) {
    if (bird_size == BIRD_SIZE_SMALL) { return f64_from(4000); }
    if (bird_size == BIRD_SIZE_MEDIUM) { return f64_from(2000); }
    return f64_from(800);
}

# Returns the amplitude for a bird size (BirdSize::config field 3).
#must_use
fn wingflap_config_amplitude(bird_size) {
    if (bird_size == BIRD_SIZE_SMALL) { return f64_div(f64_from(15), f64_from(100)); }
    if (bird_size == BIRD_SIZE_MEDIUM) { return f64_div(f64_from(25), f64_from(100)); }
    return f64_div(f64_from(4), f64_from(10));
}

# Build/refresh the naad components from filter_freq + sample_rate. Shared by
# wingflap_new and wingflap_from_json_str. Returns GARJAN_OK, or a negative
# code if a naad constructor rejects its params.
fn wingflap_build_naad(self) {
    var sr = WingFlap_sample_rate(self);
    # naad: pink noise generator + bandpass shape filter (Q = 1.0).
    WingFlap_set_noise_gen(self, noise_new(NOISE_PINK, 7070));
    var sf = filter_biquad_new(NAAD_FILTER_BANDPASS, sr, WingFlap_filter_freq(self), F64_ONE);
    if (garjan_is_err(sf) == 1) { return garjan_map_naad_error(sf); }
    WingFlap_set_shape_filter(self, sf);
    return GARJAN_OK;
}

# Creates a new wing flap synthesizer. Returns a pointer or a negative code.
#must_use
fn wingflap_new(bird_size, sample_rate) {
    if (garjan_enum_invalid(bird_size, BIRD_SIZE_LARGE) == 1) { return GARJAN_ERR_INVALID_PARAMETER; }
    var e = garjan_validate_sample_rate(sample_rate);
    if (garjan_is_err(e) == 1) { return e; }

    var flap_rate = wingflap_config_flap_rate(bird_size);
    var flap_duration_s = wingflap_config_flap_duration(bird_size);
    var flap_duration_samples = f64_to(f64_mul(flap_duration_s, sample_rate));
    var filter_freq = wingflap_config_filter_freq(bird_size);
    var amplitude = wingflap_config_amplitude(bird_size);

    var self = garjan_alloc(sizeof(WingFlap));
    if (garjan_is_err(self) == 1) { return self; }
    WingFlap_set_bird_size(self, bird_size);
    WingFlap_set_sample_rate(self, sample_rate);
    WingFlap_set_sample_position(self, 0);
    WingFlap_set_flap_rate(self, flap_rate);
    WingFlap_set_flap_duration_samples(self, flap_duration_samples);
    WingFlap_set_amplitude(self, amplitude);
    WingFlap_set_flap_phase(self, 0);
    WingFlap_set_intensity(self, F64_ONE);
    WingFlap_set_filter_freq(self, filter_freq);
    var ga_rng1 = rng_new(7070);
    if (garjan_is_err(ga_rng1) == 1) { return ga_rng1; }
    WingFlap_set_rng(self, ga_rng1);
    var ga_dcb2 = garjan_dcblocker_new(sample_rate);
    if (garjan_is_err(ga_dcb2) == 1) { return ga_dcb2; }
    WingFlap_set_dc_blocker(self, ga_dcb2);
    var b = wingflap_build_naad(self);
    if (garjan_is_err(b) == 1) { return b; }
    return self;
}

# Sets the flapping intensity (0.0 = still, 1.0 = active flight).
fn wingflap_set_intensity(self, intensity) {
    WingFlap_set_intensity(self, f64_clamp(intensity, 0, F64_ONE));
    return 0;
}

# Generate one shaped noise sample: pink noise through the bandpass filter.
#must_use
fn wingflap_generate_noise(self) {
    var raw = noise_next_sample(WingFlap_noise_gen(self));
    return filter_biquad_process_sample(WingFlap_shape_filter(self), raw);
}

# Fills `output` (a vec of f64) with wing flap audio (streaming). Ports
# process_block: phase-driven flap bursts through a bandpass, DC-blocked.
fn wingflap_process_block(self, output) {
    var num = vec_len(output);
    var dc = WingFlap_dc_blocker(self);
    var intensity = WingFlap_intensity(self);

    # intensity < 0.001: silence, but still advance the dc_blocker each sample.
    var thresh = f64_div(F64_ONE, f64_from(1000));
    if (f64_lt(intensity, thresh) == 1) {
        var z = 0;
        while (z < num) {
            vec_set(output, z, 0);
            garjan_dcblocker_process(dc, 0);
            z = z + 1;
        }
        WingFlap_set_sample_position(self, WingFlap_sample_position(self) + num);
        return 0;
    }

    var sr = WingFlap_sample_rate(self);
    var flap_rate = WingFlap_flap_rate(self);
    var flap_dur = f64_from(WingFlap_flap_duration_samples(self));
    var amplitude = WingFlap_amplitude(self);
    var attack = f64_div(f64_from(15), f64_from(100));   # 0.15
    var neg4 = f64_neg(f64_from(4));

    var i = 0;
    while (i < num) {
        # Advance flap phase: flap_phase += flap_rate * intensity / sample_rate.
        var phase = f64_add(WingFlap_flap_phase(self), f64_div(f64_mul(flap_rate, intensity), sr));
        if (f64_ge(phase, F64_ONE) == 1) {
            phase = f64_sub(phase, F64_ONE);
        }
        WingFlap_set_flap_phase(self, phase);

        # flap_progress = flap_phase * sample_rate / flap_rate.
        var flap_progress = f64_div(f64_mul(phase, sr), flap_rate);
        var sample = 0;
        if (f64_lt(flap_progress, flap_dur) == 1) {
            var t = f64_div(flap_progress, flap_dur);
            # Envelope: fast attack, smooth decay.
            var env = 0;
            if (f64_lt(t, attack) == 1) {
                env = f64_div(t, attack);
            } else {
                env = f64_exp(f64_mul(neg4, f64_sub(t, attack)));
            }
            var noise = wingflap_generate_noise(self);
            sample = f64_mul(f64_mul(f64_mul(noise, env), amplitude), intensity);
        }

        sample = garjan_dcblocker_process(dc, sample);
        vec_set(output, i, sample);
        i = i + 1;
    }
    WingFlap_set_sample_position(self, WingFlap_sample_position(self) + num);
    return 0;
}

# Synthesize `duration` seconds of wing flap audio into a fresh vec. Returns
# the vec pointer, or a negative code on invalid duration.
#must_use
fn wingflap_synthesize(self, duration) {
    var e = garjan_validate_duration(duration);
    if (garjan_is_err(e) == 1) { return e; }
    var num = f64_to(f64_mul(WingFlap_sample_rate(self), duration));
    var ga_ncheck = garjan_validate_sample_count(num);
    if (garjan_is_err(ga_ncheck) == 1) { return ga_ncheck; }
    var output = vec_new();
    var i = 0;
    while (i < num) {
        vec_push(output, 0);
        i = i + 1;
    }
    wingflap_process_block(self, output);
    return output;
}

# ---- serde: snapshot live state -> WingFlapParams -> JSON, and back. ----
#must_use
fn wingflap_to_json(self, sb) {
    var p = garjan_alloc(sizeof(WingFlapParams));
    if (garjan_is_err(p) == 1) { return p; }
    WingFlapParams_set_bird_size(p, WingFlap_bird_size(self));
    WingFlapParams_set_sample_rate(p, WingFlap_sample_rate(self));
    WingFlapParams_set_sample_position(p, WingFlap_sample_position(self));
    WingFlapParams_set_flap_rate(p, WingFlap_flap_rate(self));
    WingFlapParams_set_flap_duration_samples(p, WingFlap_flap_duration_samples(self));
    WingFlapParams_set_amplitude(p, WingFlap_amplitude(self));
    WingFlapParams_set_flap_phase(p, WingFlap_flap_phase(self));
    WingFlapParams_set_intensity(p, WingFlap_intensity(self));
    WingFlapParams_set_filter_freq(p, WingFlap_filter_freq(self));
    var rng = WingFlap_rng(self);
    WingFlapParams_set_rng_state(p, Rng_state(rng));
    WingFlapParams_set_rng_inc(p, Rng_inc(rng));
    var dc = WingFlap_dc_blocker(self);
    WingFlapParams_set_dcb_x_prev(p, DcBlocker_x_prev(dc));
    WingFlapParams_set_dcb_y_prev(p, DcBlocker_y_prev(dc));
    WingFlapParams_set_dcb_r(p, DcBlocker_r(dc));
    # Scalars via the derive, then the naad components' LIVE state spliced
    # in as "dsp" -- without it a restore resumes with zeroed filter memory.
    var psb = str_builder_new();
    var pe = WingFlapParams_to_json(p, psb);
    if (garjan_is_err(pe) == 1) { return pe; }
    var dsp = bayan_json_v_obj_new();
    bayan_json_v_obj_set(dsp, str_from("ng"), garjan_state_noise(WingFlap_noise_gen(self)));
    bayan_json_v_obj_set(dsp, str_from("sf"), garjan_state_biquad(WingFlap_shape_filter(self)));
    return garjan_emit_with_dsp(sb, psb, dsp);
}

# Rebuild a WingFlap from JSON: restore scalars + rng + dc_blocker state, then
# reconstruct the naad components fresh (rebuilt, not restored -- architecture note 001).
#must_use
fn wingflap_from_json_str(json) {
    var p = WingFlapParams_from_json_str(json);
    # Deserialize must validate what the constructor validates. Before 2.5.1
    # this path relied on a downstream naad component rejecting a bad
    # sample_rate -- which bubble's build_naad cannot do, since it only
    # calls noise_new -- and it never re-checked the enum id at all, so a
    # hostile document could restore an out-of-range one that *_new rejects.
    var vsr = garjan_validate_sample_rate(WingFlapParams_sample_rate(p));
    if (garjan_is_err(vsr) == 1) { return vsr; }
    if (garjan_enum_invalid(WingFlapParams_bird_size(p), BIRD_SIZE_LARGE) == 1) { return GARJAN_ERR_INVALID_PARAMETER; }
    var self = garjan_alloc(sizeof(WingFlap));
    if (garjan_is_err(self) == 1) { return self; }
    WingFlap_set_bird_size(self, WingFlapParams_bird_size(p));
    WingFlap_set_sample_rate(self, WingFlapParams_sample_rate(p));
    WingFlap_set_sample_position(self, WingFlapParams_sample_position(p));
    WingFlap_set_flap_rate(self, WingFlapParams_flap_rate(p));
    WingFlap_set_flap_duration_samples(self, WingFlapParams_flap_duration_samples(p));
    WingFlap_set_amplitude(self, WingFlapParams_amplitude(p));
    WingFlap_set_flap_phase(self, WingFlapParams_flap_phase(p));
    WingFlap_set_intensity(self, WingFlapParams_intensity(p));
    WingFlap_set_filter_freq(self, WingFlapParams_filter_freq(p));

    var rng = rng_new(0);
    if (garjan_is_err(rng) == 1) { return rng; }
    Rng_set_state(rng, WingFlapParams_rng_state(p));
    Rng_set_inc(rng, WingFlapParams_rng_inc(p));
    WingFlap_set_rng(self, rng);

    var dc = garjan_dcblocker_new(WingFlapParams_sample_rate(p));
    if (garjan_is_err(dc) == 1) { return dc; }
    DcBlocker_set_x_prev(dc, WingFlapParams_dcb_x_prev(p));
    DcBlocker_set_y_prev(dc, WingFlapParams_dcb_y_prev(p));
    DcBlocker_set_r(dc, WingFlapParams_dcb_r(p));
    WingFlap_set_dc_blocker(self, dc);

    var b = wingflap_build_naad(self);
    if (garjan_is_err(b) == 1) { return b; }

    # Restore the components' live state onto the freshly built ones. A
    # document written before 2.5.0 has no "dsp" member; garjan_dsp_node
    # returns 0 and the synth resumes without it, exactly as it used to.
    var dsp = garjan_dsp_node(json);
    if (dsp != 0) {
        garjan_state_noise_load(WingFlap_noise_gen(self), bayan_json_v_obj_get(dsp, "ng"));
        garjan_state_biquad_load(WingFlap_shape_filter(self), bayan_json_v_obj_get(dsp, "sf"));
    }
    return self;
}

# --- underwater.cyr ---

# underwater.cyr -- underwater ambience: low-freq rumble + filtered surface
# noise, an LFO amplitude wobble, and stochastic decaying-sinusoid bubbles.
#
# Ports rust-old/src/underwater.rs. The Cyrius port always uses the naad
# backend (no feature flags), so it ports the naad-backend code path and
# drops the fallback. f32 -> f64. Result<Self> -> pointer / negative GARJAN_*
# code. The naad components (noise gens,
# biquads, LFO) are reconstructed on deserialize; depth/params + rng +
# dc_blocker state ARE serialized (via the flattened UnderwaterParams below).
# Requires: error, logging, dsp, rng foundations + the naad bundle
# (noise_new/noise_next_sample, filter_biquad_new/filter_biquad_process_sample,
# modulation_lfo_new/modulation_lfo_next_value).

# ---- UnderwaterDepth (enum) -> module-prefixed int constants, decl order. ----
var UNDERWATER_DEPTH_SHALLOW = 0;
var UNDERWATER_DEPTH_MEDIUM  = 1;
var UNDERWATER_DEPTH_DEEP    = 2;

# ---- UnderwaterParams: the serializable slice (the scalar fields only,
# with rng + dc_blocker FLATTENED so #derive(Serialize)'s single-pass
# from_json_str works). Synced to/from the live Underwater on (de)serialize.
# depth is an enum -> i64 tag. lp_cutoff is carried so build_naad can
# reconstruct the surface filter without re-deriving from depth. ----
#derive(accessors)
#derive(Serialize)
struct UnderwaterParams {
    depth: i64;
    sample_rate: f64;
    sample_position: i64;
    rumble_amp: f64;
    bubble_rate: f64;
    surface_noise_amp: f64;
    lp_cutoff: f64;
    intensity: f64;
    rng_state: i64;
    rng_inc: i64;
    dcb_x_prev: f64;
    dcb_y_prev: f64;
    dcb_r: f64;
}

# ---- Underwater: live synth = scalars + live rng/dc_blocker + naad ptrs. ----
#derive(accessors)
struct Underwater {
    depth;
    sample_rate;
    sample_position;
    rumble_amp;
    bubble_rate;
    surface_noise_amp;
    lp_cutoff;
    intensity;
    rng;
    dc_blocker;
    rumble_noise;
    rumble_filter;
    surface_noise;
    surface_filter;
    mod_lfo;
}

# Look up depth config (lp_cutoff, rumble_amp, bubble_rate, surface_noise_amp)
# and stash it on `self`. Mirrors UnderwaterDepth::config's match.
fn underwater_apply_config(self, depth) {
    var lp_cutoff = f64_from(3000);
    var rumble_amp = f64_div(f64_from(15), f64_from(100));
    var bubble_rate = f64_from(5);
    var surface_amp = f64_div(f64_from(2), f64_from(10));
    if (depth == UNDERWATER_DEPTH_MEDIUM) {
        lp_cutoff = f64_from(1200);
        rumble_amp = f64_div(f64_from(25), f64_from(100));
        bubble_rate = f64_from(2);
        surface_amp = f64_div(f64_from(8), f64_from(100));
    } elif (depth == UNDERWATER_DEPTH_DEEP) {
        lp_cutoff = f64_from(400);
        rumble_amp = f64_div(f64_from(35), f64_from(100));
        bubble_rate = f64_div(f64_from(5), f64_from(10));
        surface_amp = f64_div(f64_from(2), f64_from(100));
    }
    Underwater_set_lp_cutoff(self, lp_cutoff);
    Underwater_set_rumble_amp(self, rumble_amp);
    Underwater_set_bubble_rate(self, bubble_rate);
    Underwater_set_surface_noise_amp(self, surface_amp);
    return GARJAN_OK;
}

# Build/refresh the naad components from sample_rate + lp_cutoff. Shared by
# underwater_new and underwater_from_json_str. Returns GARJAN_OK or a negative
# code if a naad constructor rejects its params.
fn underwater_build_naad(self) {
    var sr = Underwater_sample_rate(self);
    # rumble filter: lowpass @ 200 Hz, Q 0.5.
    var rf = filter_biquad_new(NAAD_FILTER_LOWPASS, sr, f64_from(200), F64_HALF);
    if (garjan_is_err(rf) == 1) { return garjan_map_naad_error(rf); }
    # surface filter: lowpass @ lp_cutoff, Q 0.7.
    var sf = filter_biquad_new(NAAD_FILTER_LOWPASS, sr, Underwater_lp_cutoff(self), f64_div(f64_from(7), f64_from(10)));
    if (garjan_is_err(sf) == 1) { return garjan_map_naad_error(sf); }
    # mod LFO: sine @ 0.08 Hz.
    var lfo = modulation_lfo_new(MODULATION_LFO_SINE, f64_div(f64_from(8), f64_from(100)), sr);
    if (garjan_is_err(lfo) == 1) { return garjan_map_naad_error(lfo); }
    Underwater_set_rumble_filter(self, rf);
    Underwater_set_surface_filter(self, sf);
    Underwater_set_mod_lfo(self, lfo);
    Underwater_set_rumble_noise(self, noise_new(NOISE_BROWN, 6060));
    Underwater_set_surface_noise(self, noise_new(NOISE_PINK, 6061));
    return GARJAN_OK;
}

# Creates a new underwater ambience synthesizer. Returns a pointer or a
# negative code.
#must_use
fn underwater_new(depth, sample_rate) {
    if (garjan_enum_invalid(depth, UNDERWATER_DEPTH_DEEP) == 1) { return GARJAN_ERR_INVALID_PARAMETER; }
    var e = garjan_validate_sample_rate(sample_rate);
    if (garjan_is_err(e) == 1) { return e; }

    var self = garjan_alloc(sizeof(Underwater));
    if (garjan_is_err(self) == 1) { return self; }
    Underwater_set_depth(self, depth);
    Underwater_set_sample_rate(self, sample_rate);
    Underwater_set_sample_position(self, 0);
    underwater_apply_config(self, depth);
    Underwater_set_intensity(self, F64_ONE);
    var ga_rng1 = rng_new(6060);
    if (garjan_is_err(ga_rng1) == 1) { return ga_rng1; }
    Underwater_set_rng(self, ga_rng1);
    var ga_dcb2 = garjan_dcblocker_new(sample_rate);
    if (garjan_is_err(ga_dcb2) == 1) { return ga_dcb2; }
    Underwater_set_dc_blocker(self, ga_dcb2);
    var b = underwater_build_naad(self);
    if (garjan_is_err(b) == 1) { return b; }
    return self;
}

# Sets intensity, clamped to [0, 1].
fn underwater_set_intensity(self, intensity) {
    Underwater_set_intensity(self, f64_clamp(intensity, 0, F64_ONE));
    return 0;
}

# Fills `output` (a vec of f64) with underwater audio (streaming). Ports
# process_block: continuous rumble+surface layers with an LFO wobble, then
# stochastic decaying-sinusoid bubbles, then DC-block, then advance position.
fn underwater_process_block(self, output) {
    var num = vec_len(output);
    var dc = Underwater_dc_blocker(self);
    var inten = Underwater_intensity(self);

    # intensity < 0.001: silent buffer, but still tick the dc_blocker and
    # advance the cursor (matches Rust's early return exactly).
    if (f64_lt(inten, f64_div(f64_from(1), f64_from(1000))) == 1) {
        var z = 0;
        while (z < num) {
            vec_set(output, z, 0);
            garjan_dcblocker_process(dc, 0);
            z = z + 1;
        }
        Underwater_set_sample_position(self, Underwater_sample_position(self) + num);
        return 0;
    }

    var rumble_noise = Underwater_rumble_noise(self);
    var rumble_filter = Underwater_rumble_filter(self);
    var surface_noise = Underwater_surface_noise(self);
    var surface_filter = Underwater_surface_filter(self);
    var mod_lfo = Underwater_mod_lfo(self);
    var rng = Underwater_rng(self);
    var sr = Underwater_sample_rate(self);

    var rumble_amp = Underwater_rumble_amp(self);
    var surface_amp = Underwater_surface_noise_amp(self);

    # Continuous layers: (rumble + surface) * intensity * modulator, where
    # modulator = 0.8 + 0.2 * lfo.next_value().
    var lfo_base = f64_div(f64_from(8), f64_from(10));
    var lfo_depth = f64_div(f64_from(2), f64_from(10));
    var i = 0;
    while (i < num) {
        var rumble = f64_mul(filter_biquad_process_sample(rumble_filter, noise_next_sample(rumble_noise)), rumble_amp);
        var surface = f64_mul(filter_biquad_process_sample(surface_filter, noise_next_sample(surface_noise)),
          surface_amp);
        var modulator = f64_add(lfo_base, f64_mul(lfo_depth, modulation_lfo_next_value(mod_lfo)));
        vec_set(output, i, f64_mul(f64_mul(f64_add(rumble, surface), inten), modulator));
        i = i + 1;
    }

    # Stochastic bubble events.
    var block_size = f64_to(f64_mul(sr, f64_div(f64_from(1), f64_from(100))));   # sr*0.01
    if (block_size < 1) { block_size = 1; }
    var bubbles_per_block = f64_mul(f64_mul(Underwater_bubble_rate(self), inten), f64_div(f64_from(1), f64_from(100)));

    # decay = (sr * 0.02) as usize -- span cap, constant across bubbles.
    var decay = f64_to(f64_mul(sr, f64_div(f64_from(2), f64_from(100))));
    # envelope divisor 0.02 (t / 0.02).
    var decay_div = f64_div(f64_from(2), f64_from(100));

    var block_start = 0;
    while (block_start < num) {
        var block_end = block_start + block_size;
        if (block_end > num) { block_end = num; }
        var n_bubbles = rng_poisson(rng, bubbles_per_block);

        var b = 0;
        while (b < n_bubbles) {
            var width = f64_from(block_end - block_start);
            var offset = f64_to(rng_next_f32_range(rng, 0, width));
            var idx = block_start + offset;
            if (idx < num) {
                # Bubble: decaying sinusoid (same model as bubble.rs).
                var freq = rng_next_f32_range(rng, f64_from(200), f64_from(800));
                var omega = f64_div(f64_mul(F64_TAU, freq), sr);
                var amp = f64_mul(inten, rng_next_f32_range(rng, f64_div(f64_from(5), f64_from(100)),
                    f64_div(f64_from(15), f64_from(100))));

                # span = decay.min(num - idx).
                var span = decay;
                if (num - idx < span) { span = num - idx; }
                var j = 0;
                while (j < span) {
                    var t = f64_div(f64_from(j), sr);
                    var env = f64_exp(f64_div(f64_neg(t), decay_div));
                    var contrib = f64_mul(f64_mul(f64_sin(f64_mul(omega, f64_from(j))), env), amp);
                    vec_set(output, idx + j, f64_add(vec_get(output, idx + j), contrib));
                    j = j + 1;
                }
            }
            b = b + 1;
        }
        block_start = block_start + block_size;
    }

    # DC-block the whole buffer, then advance the sample cursor.
    i = 0;
    while (i < num) {
        vec_set(output, i, garjan_dcblocker_process(dc, vec_get(output, i)));
        i = i + 1;
    }
    Underwater_set_sample_position(self, Underwater_sample_position(self) + num);
    return 0;
}

# Synthesize `duration` seconds of underwater audio into a fresh vec. Returns
# the vec pointer, or a negative code on invalid duration.
#must_use
fn underwater_synthesize(self, duration) {
    var e = garjan_validate_duration(duration);
    if (garjan_is_err(e) == 1) { return e; }
    var num = f64_to(f64_mul(Underwater_sample_rate(self), duration));
    var ga_ncheck = garjan_validate_sample_count(num);
    if (garjan_is_err(ga_ncheck) == 1) { return ga_ncheck; }
    var output = vec_new();
    var i = 0;
    while (i < num) {
        vec_push(output, 0);
        i = i + 1;
    }
    underwater_process_block(self, output);
    return output;
}

# ---- serde: snapshot live state -> UnderwaterParams -> JSON, and back. ----
#must_use
fn underwater_to_json(self, sb) {
    var p = garjan_alloc(sizeof(UnderwaterParams));
    if (garjan_is_err(p) == 1) { return p; }
    UnderwaterParams_set_depth(p, Underwater_depth(self));
    UnderwaterParams_set_sample_rate(p, Underwater_sample_rate(self));
    UnderwaterParams_set_sample_position(p, Underwater_sample_position(self));
    UnderwaterParams_set_rumble_amp(p, Underwater_rumble_amp(self));
    UnderwaterParams_set_bubble_rate(p, Underwater_bubble_rate(self));
    UnderwaterParams_set_surface_noise_amp(p, Underwater_surface_noise_amp(self));
    UnderwaterParams_set_lp_cutoff(p, Underwater_lp_cutoff(self));
    UnderwaterParams_set_intensity(p, Underwater_intensity(self));
    var rng = Underwater_rng(self);
    UnderwaterParams_set_rng_state(p, Rng_state(rng));
    UnderwaterParams_set_rng_inc(p, Rng_inc(rng));
    var dc = Underwater_dc_blocker(self);
    UnderwaterParams_set_dcb_x_prev(p, DcBlocker_x_prev(dc));
    UnderwaterParams_set_dcb_y_prev(p, DcBlocker_y_prev(dc));
    UnderwaterParams_set_dcb_r(p, DcBlocker_r(dc));
    # Scalars via the derive, then the naad components' LIVE state spliced
    # in as "dsp" -- without it a restore resumes with zeroed filter memory.
    var psb = str_builder_new();
    var pe = UnderwaterParams_to_json(p, psb);
    if (garjan_is_err(pe) == 1) { return pe; }
    var dsp = bayan_json_v_obj_new();
    bayan_json_v_obj_set(dsp, str_from("rf"), garjan_state_biquad(Underwater_rumble_filter(self)));
    bayan_json_v_obj_set(dsp, str_from("sf"), garjan_state_biquad(Underwater_surface_filter(self)));
    bayan_json_v_obj_set(dsp, str_from("ml"), garjan_state_lfo(Underwater_mod_lfo(self)));
    bayan_json_v_obj_set(dsp, str_from("rn"), garjan_state_noise(Underwater_rumble_noise(self)));
    bayan_json_v_obj_set(dsp, str_from("sn"), garjan_state_noise(Underwater_surface_noise(self)));
    return garjan_emit_with_dsp(sb, psb, dsp);
}

# Rebuild an Underwater from JSON: restore scalars + rng + dc_blocker state,
# then reconstruct the naad components fresh (rebuilt, not restored -- architecture note 001).
#must_use
fn underwater_from_json_str(json) {
    var p = UnderwaterParams_from_json_str(json);
    # Deserialize must validate what the constructor validates. Before 2.5.1
    # this path relied on a downstream naad component rejecting a bad
    # sample_rate -- which bubble's build_naad cannot do, since it only
    # calls noise_new -- and it never re-checked the enum id at all, so a
    # hostile document could restore an out-of-range one that *_new rejects.
    var vsr = garjan_validate_sample_rate(UnderwaterParams_sample_rate(p));
    if (garjan_is_err(vsr) == 1) { return vsr; }
    if (garjan_enum_invalid(UnderwaterParams_depth(p), UNDERWATER_DEPTH_DEEP) == 1) {
        return GARJAN_ERR_INVALID_PARAMETER;
    }
    var self = garjan_alloc(sizeof(Underwater));
    if (garjan_is_err(self) == 1) { return self; }
    Underwater_set_depth(self, UnderwaterParams_depth(p));
    Underwater_set_sample_rate(self, UnderwaterParams_sample_rate(p));
    Underwater_set_sample_position(self, UnderwaterParams_sample_position(p));
    Underwater_set_rumble_amp(self, UnderwaterParams_rumble_amp(p));
    Underwater_set_bubble_rate(self, UnderwaterParams_bubble_rate(p));
    Underwater_set_surface_noise_amp(self, UnderwaterParams_surface_noise_amp(p));
    Underwater_set_lp_cutoff(self, UnderwaterParams_lp_cutoff(p));
    Underwater_set_intensity(self, UnderwaterParams_intensity(p));

    var rng = rng_new(0);
    if (garjan_is_err(rng) == 1) { return rng; }
    Rng_set_state(rng, UnderwaterParams_rng_state(p));
    Rng_set_inc(rng, UnderwaterParams_rng_inc(p));
    Underwater_set_rng(self, rng);

    var dc = garjan_dcblocker_new(UnderwaterParams_sample_rate(p));
    if (garjan_is_err(dc) == 1) { return dc; }
    DcBlocker_set_x_prev(dc, UnderwaterParams_dcb_x_prev(p));
    DcBlocker_set_y_prev(dc, UnderwaterParams_dcb_y_prev(p));
    DcBlocker_set_r(dc, UnderwaterParams_dcb_r(p));
    Underwater_set_dc_blocker(self, dc);

    var b = underwater_build_naad(self);
    if (garjan_is_err(b) == 1) { return b; }

    # Restore the components' live state onto the freshly built ones. A
    # document written before 2.5.0 has no "dsp" member; garjan_dsp_node
    # returns 0 and the synth resumes without it, exactly as it used to.
    var dsp = garjan_dsp_node(json);
    if (dsp != 0) {
        garjan_state_biquad_load(Underwater_rumble_filter(self), bayan_json_v_obj_get(dsp, "rf"));
        garjan_state_biquad_load(Underwater_surface_filter(self), bayan_json_v_obj_get(dsp, "sf"));
        garjan_state_lfo_load(Underwater_mod_lfo(self), bayan_json_v_obj_get(dsp, "ml"));
        garjan_state_noise_load(Underwater_rumble_noise(self), bayan_json_v_obj_get(dsp, "rn"));
        garjan_state_noise_load(Underwater_surface_noise(self), bayan_json_v_obj_get(dsp, "sn"));
    }
    return self;
}

# --- surf.cyr ---

# surf.cyr -- surf zone synthesis: breaking waves with approach, crash, wash.
#
# Ports rust-old/src/surf.rs. Models ocean surf as a cyclic process: a wave
# approaches (rumble builds), breaks (broadband crash), and washes back
# (receding hiss). The Cyrius port always uses the naad backend (no feature
# flags), so it ports the #[cfg(feature="naad-backend")] path and drops the
# fallback. f32 -> f64. Result<Self> -> pointer / negative GARJAN_* code. The
# naad components (crash/wash/rumble noise +
# filters) are reconstructed on deserialize; intensity, sample_rate,
# sample_position, wave_period_samples, break_amp, wash_amp, volume,
# wave_phase, rng, and dc_blocker are serialized (via the flattened SurfParams
# below).
# Requires: error, logging, dsp, rng foundations + the naad bundle
# (noise_new/noise_next_sample, filter_biquad_new/filter_biquad_process_sample).

# ---- SurfIntensity (enum) -> module-prefixed int constants (declaration order). ----
var SURF_CALM     = 0;
var SURF_MODERATE = 1;
var SURF_HEAVY    = 2;
var SURF_STORM    = 3;

# ---- SurfParams: the serializable slice (the scalar fields only, with
# intensity as an int tag and rng + dc_blocker FLATTENED to scalars so
# #derive(Serialize)'s single-pass from_json_str works). Synced to/from the
# live Surf on (de)serialize. ----
#derive(accessors)
#derive(Serialize)
struct SurfParams {
    intensity: i64;
    sample_rate: f64;
    sample_position: i64;
    wave_period_samples: i64;
    break_amp: f64;
    wash_amp: f64;
    volume: f64;
    wave_phase: f64;
    rng_state: i64;
    rng_inc: i64;
    dcb_x_prev: f64;
    dcb_y_prev: f64;
    dcb_r: f64;
}

# ---- Surf: live synth = scalars + live rng/dc_blocker + naad component ptrs. ----
#derive(accessors)
struct Surf {
    intensity;
    sample_rate;
    sample_position;
    wave_period_samples;
    break_amp;
    wash_amp;
    volume;
    wave_phase;
    rng;
    dc_blocker;
    crash_noise;
    crash_filter;
    wash_noise;
    wash_filter;
    rumble_noise;
    rumble_filter;
}

# Build/refresh the naad components (crash/wash/rumble noise + filters) from
# sample_rate. Shared by surf_new and surf_from_json_str. Returns GARJAN_OK or
# a negative code if a naad constructor rejects its params. Mirrors the Rust
# fixed noise seeds + filter configs (crash: BandPass 2000/0.8; wash: LowPass
# 3000/0.5; rumble: LowPass 200/0.5).
fn surf_build_naad(self) {
    var sr = Surf_sample_rate(self);

    var cf = filter_biquad_new(NAAD_FILTER_BANDPASS, sr, f64_from(2000), f64_div(f64_from(8), f64_from(10)));
    if (garjan_is_err(cf) == 1) { return garjan_map_naad_error(cf); }
    var wf = filter_biquad_new(NAAD_FILTER_LOWPASS, sr, f64_from(3000), F64_HALF);
    if (garjan_is_err(wf) == 1) { return garjan_map_naad_error(wf); }
    var rf = filter_biquad_new(NAAD_FILTER_LOWPASS, sr, f64_from(200), F64_HALF);
    if (garjan_is_err(rf) == 1) { return garjan_map_naad_error(rf); }

    Surf_set_crash_noise(self, noise_new(NOISE_WHITE, 8080));
    Surf_set_crash_filter(self, cf);
    Surf_set_wash_noise(self, noise_new(NOISE_PINK, 8081));
    Surf_set_wash_filter(self, wf);
    Surf_set_rumble_noise(self, noise_new(NOISE_BROWN, 8082));
    Surf_set_rumble_filter(self, rf);
    return GARJAN_OK;
}

# Resolve SurfIntensity -> wave_period_s config value. (period, break_amp,
# wash_amp) split across the three surf_config_* helpers below.
#must_use
fn surf_config_period(intensity) {
    if (intensity == SURF_CALM) { return f64_from(8); }
    if (intensity == SURF_MODERATE) { return f64_from(6); }
    if (intensity == SURF_HEAVY) { return f64_div(f64_from(9), F64_TWO); }
    return f64_from(3);
}

#must_use
fn surf_config_break_amp(intensity) {
    if (intensity == SURF_CALM) { return f64_div(f64_from(15), f64_from(100)); }
    if (intensity == SURF_MODERATE) { return f64_div(f64_from(35), f64_from(100)); }
    if (intensity == SURF_HEAVY) { return f64_div(f64_from(55), f64_from(100)); }
    return f64_div(f64_from(75), f64_from(100));
}

#must_use
fn surf_config_wash_amp(intensity) {
    if (intensity == SURF_CALM) { return f64_div(f64_from(8), f64_from(100)); }
    if (intensity == SURF_MODERATE) { return f64_div(f64_from(2), f64_from(10)); }
    if (intensity == SURF_HEAVY) { return f64_div(f64_from(35), f64_from(100)); }
    return F64_HALF;
}

# Creates a new surf zone synthesizer. Returns a pointer or a negative code.
#must_use
fn surf_new(intensity, sample_rate) {
    if (garjan_enum_invalid(intensity, SURF_STORM) == 1) { return GARJAN_ERR_INVALID_PARAMETER; }
    var e = garjan_validate_sample_rate(sample_rate);
    if (garjan_is_err(e) == 1) { return e; }

    var period = surf_config_period(intensity);
    var break_amp = surf_config_break_amp(intensity);
    var wash_amp = surf_config_wash_amp(intensity);
    # wave_period_samples = (period * sample_rate) as usize
    var wave_period_samples = f64_to(f64_mul(period, sample_rate));

    var self = garjan_alloc(sizeof(Surf));
    if (garjan_is_err(self) == 1) { return self; }
    Surf_set_intensity(self, intensity);
    Surf_set_sample_rate(self, sample_rate);
    Surf_set_sample_position(self, 0);
    Surf_set_wave_period_samples(self, wave_period_samples);
    Surf_set_break_amp(self, break_amp);
    Surf_set_wash_amp(self, wash_amp);
    Surf_set_volume(self, F64_ONE);
    Surf_set_wave_phase(self, 0);
    var ga_rng1 = rng_new(8080);
    if (garjan_is_err(ga_rng1) == 1) { return ga_rng1; }
    Surf_set_rng(self, ga_rng1);
    var ga_dcb2 = garjan_dcblocker_new(sample_rate);
    if (garjan_is_err(ga_dcb2) == 1) { return ga_dcb2; }
    Surf_set_dc_blocker(self, ga_dcb2);
    var b = surf_build_naad(self);
    if (garjan_is_err(b) == 1) { return b; }
    return self;
}

# Sets the volume (0.0 = silent, 1.0 = full). Clamps to [0, 1].
fn surf_set_volume(self, volume) {
    Surf_set_volume(self, f64_clamp(volume, 0, F64_ONE));
    return 0;
}

# Fills `output` (a vec of f64) with surf audio (streaming). Ports
# process_block: per-sample wave phase advance + phase-dependent envelopes,
# three naad noise layers, volume, then DC-block, then advance position.
fn surf_process_block(self, output) {
    var num = vec_len(output);
    var volume = Surf_volume(self);
    var dc = Surf_dc_blocker(self);

    # Silent fast-path: volume < 0.001. Still ticks the DC blocker per sample
    # (Rust does dc_blocker.process(0.0) in the loop) to keep state parity.
    if (f64_lt(volume, f64_div(F64_ONE, f64_from(1000))) == 1) {
        var si = 0;
        while (si < num) {
            vec_set(output, si, 0);
            garjan_dcblocker_process(dc, 0);
            si = si + 1;
        }
        Surf_set_sample_position(self, Surf_sample_position(self) + num);
        return 0;
    }

    var rng = Surf_rng(self);
    var crash_noise = Surf_crash_noise(self);
    var crash_filter = Surf_crash_filter(self);
    var wash_noise = Surf_wash_noise(self);
    var wash_filter = Surf_wash_filter(self);
    var rumble_noise = Surf_rumble_noise(self);
    var rumble_filter = Surf_rumble_filter(self);
    var break_amp = Surf_break_amp(self);
    var wash_amp = Surf_wash_amp(self);

    var period = f64_from(Surf_wave_period_samples(self));
    var wave_phase = Surf_wave_phase(self);

    # Envelope breakpoints and gains. Every one of these was rebuilt on each of
    # the 44,100 samples per second of audio; several appear twice per sample.
    var p30 = f64_div(f64_from(3), f64_from(10));
    var p20 = f64_div(f64_from(2), f64_from(10));
    var p25 = f64_div(f64_from(25), f64_from(100));
    var p55 = f64_div(f64_from(55), f64_from(100));
    var p45 = f64_div(f64_from(45), f64_from(100));
    var neg_three = f64_neg(f64_from(3));
    var jit_lo = f64_neg(f64_div(F64_ONE, f64_from(10)));
    var jit_hi = f64_div(F64_ONE, f64_from(10));
    # period only changes on a wave-cycle boundary, so the reciprocal only needs
    # recomputing there -- it was a divide per sample.
    var inv_period = f64_div(F64_ONE, period);

    var i = 0;
    while (i < num) {
        # Advance wave phase by 1/period.
        wave_phase = f64_add(wave_phase, inv_period);
        if (f64_ge(wave_phase, F64_ONE) == 1) {
            wave_phase = f64_sub(wave_phase, F64_ONE);
            # New jitter per wave cycle: 1.0 + rng.next_f32_range(-0.1, 0.1)
            var jitter = f64_add(F64_ONE, rng_next_f32_range(rng, jit_lo, jit_hi));
            period = f64_mul(f64_from(Surf_wave_period_samples(self)), jitter);
            inv_period = f64_div(F64_ONE, period);
        }

        var p = wave_phase;

        # Approach rumble: builds 0.0..0.3, decays 0.3..0.5, else 0.
        var rumble_env = 0;
        if (f64_lt(p, p30) == 1) {
            rumble_env = f64_div(p, p30);
        } elif (f64_lt(p, F64_HALF) == 1) {
            rumble_env = f64_sub(F64_ONE, f64_div(f64_sub(p, p30), p20));
        }

        # Break crash: peaks at 0.35, sin^2 window over (0.25, 0.55), else 0.
        var crash_env = 0;
        if (f64_gt(p, p25) == 1) {
            if (f64_lt(p, p55) == 1) {
                var ct = f64_div(f64_sub(p, p25), p30);
                var cs = f64_sin(f64_mul(F64_PI, ct));
                crash_env = f64_mul(cs, cs);
            }
        }

        # Wash: builds after crash, exp(-3*t) over 0.45..1.0, else 0.
        var wash_env = 0;
        if (f64_gt(p, p45) == 1) {
            var wt = f64_div(f64_sub(p, p45), p55);
            wash_env = f64_exp(f64_mul(neg_three, wt));
        }

        # Noise layers (naad backend). rumble scaled by *0.5 extra.
        var rn = noise_next_sample(rumble_noise);
        var rumble = f64_mul(f64_mul(f64_mul(filter_biquad_process_sample(rumble_filter, rn), rumble_env), break_amp),
          F64_HALF);
        var cn = noise_next_sample(crash_noise);
        var crash = f64_mul(f64_mul(filter_biquad_process_sample(crash_filter, cn), crash_env), break_amp);
        var wn = noise_next_sample(wash_noise);
        var wash = f64_mul(f64_mul(filter_biquad_process_sample(wash_filter, wn), wash_env), wash_amp);
        var sample = f64_add(f64_add(rumble, crash), wash);

        sample = f64_mul(sample, volume);
        sample = garjan_dcblocker_process(dc, sample);
        vec_set(output, i, sample);
        i = i + 1;
    }

    # Persist the advanced phase; advance the sample cursor.
    Surf_set_wave_phase(self, wave_phase);
    Surf_set_sample_position(self, Surf_sample_position(self) + num);
    return 0;
}

# Synthesize `duration` seconds of surf audio into a fresh vec. Returns the vec
# pointer, or a negative code on invalid duration.
#must_use
fn surf_synthesize(self, duration) {
    var e = garjan_validate_duration(duration);
    if (garjan_is_err(e) == 1) { return e; }
    var num = f64_to(f64_mul(Surf_sample_rate(self), duration));
    var ga_ncheck = garjan_validate_sample_count(num);
    if (garjan_is_err(ga_ncheck) == 1) { return ga_ncheck; }
    var output = vec_new();
    var i = 0;
    while (i < num) {
        vec_push(output, 0);
        i = i + 1;
    }
    surf_process_block(self, output);
    return output;
}

# ---- serde: snapshot live state -> SurfParams -> JSON, and back. ----
#must_use
fn surf_to_json(self, sb) {
    var p = garjan_alloc(sizeof(SurfParams));
    if (garjan_is_err(p) == 1) { return p; }
    SurfParams_set_intensity(p, Surf_intensity(self));
    SurfParams_set_sample_rate(p, Surf_sample_rate(self));
    SurfParams_set_sample_position(p, Surf_sample_position(self));
    SurfParams_set_wave_period_samples(p, Surf_wave_period_samples(self));
    SurfParams_set_break_amp(p, Surf_break_amp(self));
    SurfParams_set_wash_amp(p, Surf_wash_amp(self));
    SurfParams_set_volume(p, Surf_volume(self));
    SurfParams_set_wave_phase(p, Surf_wave_phase(self));
    var rng = Surf_rng(self);
    SurfParams_set_rng_state(p, Rng_state(rng));
    SurfParams_set_rng_inc(p, Rng_inc(rng));
    var dc = Surf_dc_blocker(self);
    SurfParams_set_dcb_x_prev(p, DcBlocker_x_prev(dc));
    SurfParams_set_dcb_y_prev(p, DcBlocker_y_prev(dc));
    SurfParams_set_dcb_r(p, DcBlocker_r(dc));
    # Scalars via the derive, then the naad components' LIVE state spliced
    # in as "dsp" -- without it a restore resumes with zeroed filter memory.
    var psb = str_builder_new();
    var pe = SurfParams_to_json(p, psb);
    if (garjan_is_err(pe) == 1) { return pe; }
    var dsp = bayan_json_v_obj_new();
    bayan_json_v_obj_set(dsp, str_from("cn"), garjan_state_noise(Surf_crash_noise(self)));
    bayan_json_v_obj_set(dsp, str_from("cf"), garjan_state_biquad(Surf_crash_filter(self)));
    bayan_json_v_obj_set(dsp, str_from("wn"), garjan_state_noise(Surf_wash_noise(self)));
    bayan_json_v_obj_set(dsp, str_from("wf"), garjan_state_biquad(Surf_wash_filter(self)));
    bayan_json_v_obj_set(dsp, str_from("rn"), garjan_state_noise(Surf_rumble_noise(self)));
    bayan_json_v_obj_set(dsp, str_from("rf"), garjan_state_biquad(Surf_rumble_filter(self)));
    return garjan_emit_with_dsp(sb, psb, dsp);
}

# Rebuild a Surf from JSON: restore scalars + rng + dc_blocker state, then
# reconstruct the naad components fresh (rebuilt, not restored -- architecture note 001).
#must_use
fn surf_from_json_str(json) {
    var p = SurfParams_from_json_str(json);
    # Deserialize must validate what the constructor validates. Before 2.5.1
    # this path relied on a downstream naad component rejecting a bad
    # sample_rate -- which bubble's build_naad cannot do, since it only
    # calls noise_new -- and it never re-checked the enum id at all, so a
    # hostile document could restore an out-of-range one that *_new rejects.
    var vsr = garjan_validate_sample_rate(SurfParams_sample_rate(p));
    if (garjan_is_err(vsr) == 1) { return vsr; }
    if (garjan_enum_invalid(SurfParams_intensity(p), SURF_STORM) == 1) { return GARJAN_ERR_INVALID_PARAMETER; }
    var self = garjan_alloc(sizeof(Surf));
    if (garjan_is_err(self) == 1) { return self; }
    Surf_set_intensity(self, SurfParams_intensity(p));
    Surf_set_sample_rate(self, SurfParams_sample_rate(p));
    Surf_set_sample_position(self, SurfParams_sample_position(p));
    Surf_set_wave_period_samples(self, SurfParams_wave_period_samples(p));
    Surf_set_break_amp(self, SurfParams_break_amp(p));
    Surf_set_wash_amp(self, SurfParams_wash_amp(p));
    Surf_set_volume(self, SurfParams_volume(p));
    Surf_set_wave_phase(self, SurfParams_wave_phase(p));

    var rng = rng_new(0);
    if (garjan_is_err(rng) == 1) { return rng; }
    Rng_set_state(rng, SurfParams_rng_state(p));
    Rng_set_inc(rng, SurfParams_rng_inc(p));
    Surf_set_rng(self, rng);

    var dc = garjan_dcblocker_new(SurfParams_sample_rate(p));
    if (garjan_is_err(dc) == 1) { return dc; }
    DcBlocker_set_x_prev(dc, SurfParams_dcb_x_prev(p));
    DcBlocker_set_y_prev(dc, SurfParams_dcb_y_prev(p));
    DcBlocker_set_r(dc, SurfParams_dcb_r(p));
    Surf_set_dc_blocker(self, dc);

    var b = surf_build_naad(self);
    if (garjan_is_err(b) == 1) { return b; }

    # Restore the components' live state onto the freshly built ones. A
    # document written before 2.5.0 has no "dsp" member; garjan_dsp_node
    # returns 0 and the synth resumes without it, exactly as it used to.
    var dsp = garjan_dsp_node(json);
    if (dsp != 0) {
        garjan_state_noise_load(Surf_crash_noise(self), bayan_json_v_obj_get(dsp, "cn"));
        garjan_state_biquad_load(Surf_crash_filter(self), bayan_json_v_obj_get(dsp, "cf"));
        garjan_state_noise_load(Surf_wash_noise(self), bayan_json_v_obj_get(dsp, "wn"));
        garjan_state_biquad_load(Surf_wash_filter(self), bayan_json_v_obj_get(dsp, "wf"));
        garjan_state_noise_load(Surf_rumble_noise(self), bayan_json_v_obj_get(dsp, "rn"));
        garjan_state_biquad_load(Surf_rumble_filter(self), bayan_json_v_obj_get(dsp, "rf"));
    }
    return self;
}

# --- texture.cyr ---

# texture.cyr -- ambient texture synthesis: continuous environmental backgrounds.
#
# Ports rust-old/src/texture.rs. Textures are layered multi-band noise with a
# characteristic spectral shape (forest ambience, city hum, ocean surf, cave
# drip, desert wind, night). The Cyrius port always uses the naad backend (no
# feature flags), so it ports process_block_naad and drops the fallback.
# f32 -> f64. Result<Self> -> pointer / negative GARJAN_* code. The Rust
# naad components (3 noise gens, 3 biquad filters,
# 1 LFO) are reconstructed on deserialize; rng + dc_blocker state ARE
# serialized (via the flattened AmbientTextureParams below).
#
# Requires: error, logging, dsp, rng foundations + the naad bundle
# (noise_new/noise_next_sample, filter_biquad_new/filter_biquad_process_sample,
# modulation_lfo_new/modulation_lfo_next_value).

# ================================================================
# TextureType (enum) -> integer constants, declaration order.
# ================================================================
var TEXTURE_TYPE_FOREST = 0;
var TEXTURE_TYPE_CITY   = 1;
var TEXTURE_TYPE_OCEAN  = 2;
var TEXTURE_TYPE_CAVE   = 3;
var TEXTURE_TYPE_DESERT = 4;
var TEXTURE_TYPE_NIGHT  = 5;

# ---- AmbientTextureParams: the serializable slice (exactly Rust's fields,
# with rng + dc_blocker FLATTENED so #derive(Serialize)'s single-pass
# from_json_str works). texture_type is an int tag. ----
#derive(accessors)
#derive(Serialize)
struct AmbientTextureParams {
    texture_type: i64;
    level: f64;
    sample_rate: f64;
    sample_position: i64;
    rng_state: i64;
    rng_inc: i64;
    dcb_x_prev: f64;
    dcb_y_prev: f64;
    dcb_r: f64;
}

# ---- AmbientTexture: live synth = scalars + live rng/dc_blocker + naad
# component ptrs (3 noise, 3 filter, 1 lfo). ----
#derive(accessors)
struct AmbientTexture {
    texture_type;
    level;
    sample_rate;
    sample_position;
    rng;
    dc_blocker;
    low_noise;
    mid_noise;
    high_noise;
    low_filter;
    mid_filter;
    high_filter;
    mod_lfo;
}

# Modulation LFO rate (Hz) for a texture type. Ports the mod_rate match.
#must_use
fn texture_mod_rate(texture_type) {
    if (texture_type == TEXTURE_TYPE_FOREST) { return f64_div(f64_from(2), f64_from(10)); }
    if (texture_type == TEXTURE_TYPE_CITY) { return f64_div(f64_from(1), f64_from(10)); }
    if (texture_type == TEXTURE_TYPE_OCEAN) { return f64_div(f64_from(8), f64_from(100)); }
    if (texture_type == TEXTURE_TYPE_CAVE) { return f64_div(f64_from(2), f64_from(100)); }
    if (texture_type == TEXTURE_TYPE_DESERT) { return f64_div(f64_from(15), f64_from(100)); }
    return f64_div(f64_from(5), f64_from(100));
}

# Build/refresh the naad components from sample_rate + texture_type. Shared by
# texture_new and texture_from_json_str. Returns GARJAN_OK or a negative code
# if a naad constructor rejects its params.
fn texture_build_naad(self) {
    var sr = AmbientTexture_sample_rate(self);

    # low: brown noise through lowpass 300 Hz, Q 0.7.
    var lf = filter_biquad_new(NAAD_FILTER_LOWPASS, sr, f64_from(300), f64_div(f64_from(7), f64_from(10)));
    if (garjan_is_err(lf) == 1) { return garjan_map_naad_error(lf); }
    # mid: pink noise through bandpass 1500 Hz, Q 1.0.
    var mf = filter_biquad_new(NAAD_FILTER_BANDPASS, sr, f64_from(1500), F64_ONE);
    if (garjan_is_err(mf) == 1) { return garjan_map_naad_error(mf); }
    # high: white noise through highpass 4000 Hz, Q 0.7.
    var hf = filter_biquad_new(NAAD_FILTER_HIGHPASS, sr, f64_from(4000), f64_div(f64_from(7), f64_from(10)));
    if (garjan_is_err(hf) == 1) { return garjan_map_naad_error(hf); }

    var rate = texture_mod_rate(AmbientTexture_texture_type(self));
    var lfo = modulation_lfo_new(MODULATION_LFO_SINE, rate, sr);
    if (garjan_is_err(lfo) == 1) { return garjan_map_naad_error(lfo); }

    AmbientTexture_set_low_filter(self, lf);
    AmbientTexture_set_mid_filter(self, mf);
    AmbientTexture_set_high_filter(self, hf);
    AmbientTexture_set_mod_lfo(self, lfo);
    AmbientTexture_set_low_noise(self, noise_new(NOISE_BROWN, 9001));
    AmbientTexture_set_mid_noise(self, noise_new(NOISE_PINK, 9002));
    AmbientTexture_set_high_noise(self, noise_new(NOISE_WHITE, 9003));
    return GARJAN_OK;
}

# Creates a new ambient texture. Returns a pointer or a negative code.
#must_use
fn texture_new(texture_type, level, sample_rate) {
    if (garjan_enum_invalid(texture_type, TEXTURE_TYPE_NIGHT) == 1) { return GARJAN_ERR_INVALID_PARAMETER; }
    var e = garjan_validate_sample_rate(sample_rate);
    if (garjan_is_err(e) == 1) { return e; }
    var lvl = f64_clamp(level, 0, F64_ONE);

    var self = garjan_alloc(sizeof(AmbientTexture));
    if (garjan_is_err(self) == 1) { return self; }
    AmbientTexture_set_texture_type(self, texture_type);
    AmbientTexture_set_level(self, lvl);
    AmbientTexture_set_sample_rate(self, sample_rate);
    AmbientTexture_set_sample_position(self, 0);
    var ga_rng1 = rng_new(9001);
    if (garjan_is_err(ga_rng1) == 1) { return ga_rng1; }
    AmbientTexture_set_rng(self, ga_rng1);
    var ga_dcb2 = garjan_dcblocker_new(sample_rate);
    if (garjan_is_err(ga_dcb2) == 1) { return ga_dcb2; }
    AmbientTexture_set_dc_blocker(self, ga_dcb2);
    var b = texture_build_naad(self);
    if (garjan_is_err(b) == 1) { return b; }
    return self;
}

# Alias matching Rust's AmbientTexture::new — same signature/behaviour.
#must_use
fn ambient_texture_new(texture_type, level, sample_rate) {
    return texture_new(texture_type, level, sample_rate);
}

# Band mix ratios (low, mid, high) for a texture type, written into the
# caller's 24-byte buffer (three f64 slots at +0/+8/+16). Ports the band_mix
# match. Allocation-free, so the streaming path can call it per block against
# a stack buffer -- the arena never frees, and this is called once per
# process_block.
fn texture_band_mix_into(out, texture_type) {
    var low = f64_div(f64_from(2), f64_from(10));
    var mid = F64_HALF;
    var high = f64_div(f64_from(3), f64_from(10));
    if (texture_type == TEXTURE_TYPE_FOREST) {
        low = f64_div(f64_from(2), f64_from(10));
        mid = F64_HALF;
        high = f64_div(f64_from(3), f64_from(10));
    } elif (texture_type == TEXTURE_TYPE_CITY) {
        low = F64_HALF;
        mid = f64_div(f64_from(3), f64_from(10));
        high = f64_div(f64_from(2), f64_from(10));
    } elif (texture_type == TEXTURE_TYPE_OCEAN) {
        low = f64_div(f64_from(6), f64_from(10));
        mid = f64_div(f64_from(3), f64_from(10));
        high = f64_div(f64_from(1), f64_from(10));
    } elif (texture_type == TEXTURE_TYPE_CAVE) {
        low = f64_div(f64_from(3), f64_from(10));
        mid = f64_div(f64_from(1), f64_from(10));
        high = f64_div(f64_from(5), f64_from(100));
    } elif (texture_type == TEXTURE_TYPE_DESERT) {
        low = f64_div(f64_from(1), f64_from(10));
        mid = f64_div(f64_from(2), f64_from(10));
        high = f64_div(f64_from(1), f64_from(10));
    } elif (texture_type == TEXTURE_TYPE_NIGHT) {
        low = f64_div(f64_from(1), f64_from(10));
        mid = f64_div(f64_from(2), f64_from(10));
        high = f64_div(f64_from(15), f64_from(100));
    }
    store64(out, low);
    store64(out + 8, mid);
    store64(out + 16, high);
    return 0;
}

# Owning form: the same table in a freshly allocated 3-slot buffer. Retained
# for callers that want an owned buffer; the hot path uses the _into form.
#must_use
fn texture_band_mix(texture_type) {
    var m = garjan_alloc(24);
    if (garjan_is_err(m) == 1) { return m; }
    texture_band_mix_into(m, texture_type);
    return m;
}

# Fills `output` (a vec of f64) with ambient texture audio (streaming). Ports
# process_block: naad multi-band synthesis, then DC-block, then advance.
fn texture_process_block(self, output) {
    var num = vec_len(output);
    var low_noise = AmbientTexture_low_noise(self);
    var mid_noise = AmbientTexture_mid_noise(self);
    var high_noise = AmbientTexture_high_noise(self);
    var low_filter = AmbientTexture_low_filter(self);
    var mid_filter = AmbientTexture_mid_filter(self);
    var high_filter = AmbientTexture_high_filter(self);
    var lfo = AmbientTexture_mod_lfo(self);
    var level = AmbientTexture_level(self);

    # 24 bytes = three f64 slots. Stack, not arena: this runs once per block.
    var mixbuf[24];
    texture_band_mix_into(&mixbuf, AmbientTexture_texture_type(self));
    var low_mix = load64(&mixbuf);
    var mid_mix = load64(&mixbuf + 8);
    var high_mix = load64(&mixbuf + 16);

    # 0.7 and 0.3 for the modulator: modulator = 0.7 + 0.3*lfo.
    var mod_base = f64_div(f64_from(7), f64_from(10));
    var mod_depth = f64_div(f64_from(3), f64_from(10));

    # DC-blocked inline rather than in a second pass: the loop writes each index
    # exactly once, in order, so the blocker sees identical inputs in identical
    # order. Bit-identical, minus a vec_get + vec_set per sample.
    var dc = AmbientTexture_dc_blocker(self);
    var i = 0;
    while (i < num) {
        var modulator = f64_add(mod_base, f64_mul(mod_depth, modulation_lfo_next_value(lfo)));

        var low = filter_biquad_process_sample(low_filter, noise_next_sample(low_noise));
        var mid = filter_biquad_process_sample(mid_filter, noise_next_sample(mid_noise));
        var high = filter_biquad_process_sample(high_filter, noise_next_sample(high_noise));

        var mixed = f64_add(f64_add(f64_mul(low, low_mix), f64_mul(mid, mid_mix)), f64_mul(high, high_mix));
        vec_set(output, i, garjan_dcblocker_process(dc, f64_mul(f64_mul(mixed, level), modulator)));
        i = i + 1;
    }

    AmbientTexture_set_sample_position(self, AmbientTexture_sample_position(self) + num);
    return 0;
}

# Synthesize `duration` seconds of ambient texture audio into a fresh vec.
# Returns the vec pointer, or a negative code on invalid duration.
#must_use
fn texture_synthesize(self, duration) {
    var e = garjan_validate_duration(duration);
    if (garjan_is_err(e) == 1) { return e; }
    var num = f64_to(f64_mul(AmbientTexture_sample_rate(self), duration));
    var ga_ncheck = garjan_validate_sample_count(num);
    if (garjan_is_err(ga_ncheck) == 1) { return ga_ncheck; }
    var output = vec_new();
    var i = 0;
    while (i < num) {
        vec_push(output, 0);
        i = i + 1;
    }
    texture_process_block(self, output);
    return output;
}

# ---- serde: snapshot live state -> AmbientTextureParams -> JSON, and back. ----
#must_use
fn texture_to_json(self, sb) {
    var p = garjan_alloc(sizeof(AmbientTextureParams));
    if (garjan_is_err(p) == 1) { return p; }
    AmbientTextureParams_set_texture_type(p, AmbientTexture_texture_type(self));
    AmbientTextureParams_set_level(p, AmbientTexture_level(self));
    AmbientTextureParams_set_sample_rate(p, AmbientTexture_sample_rate(self));
    AmbientTextureParams_set_sample_position(p, AmbientTexture_sample_position(self));
    var rng = AmbientTexture_rng(self);
    AmbientTextureParams_set_rng_state(p, Rng_state(rng));
    AmbientTextureParams_set_rng_inc(p, Rng_inc(rng));
    var dc = AmbientTexture_dc_blocker(self);
    AmbientTextureParams_set_dcb_x_prev(p, DcBlocker_x_prev(dc));
    AmbientTextureParams_set_dcb_y_prev(p, DcBlocker_y_prev(dc));
    AmbientTextureParams_set_dcb_r(p, DcBlocker_r(dc));
    # Scalars via the derive, then the naad components' LIVE state spliced
    # in as "dsp" -- without it a restore resumes with zeroed filter memory.
    var psb = str_builder_new();
    var pe = AmbientTextureParams_to_json(p, psb);
    if (garjan_is_err(pe) == 1) { return pe; }
    var dsp = bayan_json_v_obj_new();
    bayan_json_v_obj_set(dsp, str_from("lf"), garjan_state_biquad(AmbientTexture_low_filter(self)));
    bayan_json_v_obj_set(dsp, str_from("mf"), garjan_state_biquad(AmbientTexture_mid_filter(self)));
    bayan_json_v_obj_set(dsp, str_from("hf"), garjan_state_biquad(AmbientTexture_high_filter(self)));
    bayan_json_v_obj_set(dsp, str_from("ml"), garjan_state_lfo(AmbientTexture_mod_lfo(self)));
    bayan_json_v_obj_set(dsp, str_from("ln"), garjan_state_noise(AmbientTexture_low_noise(self)));
    bayan_json_v_obj_set(dsp, str_from("mn"), garjan_state_noise(AmbientTexture_mid_noise(self)));
    bayan_json_v_obj_set(dsp, str_from("hn"), garjan_state_noise(AmbientTexture_high_noise(self)));
    return garjan_emit_with_dsp(sb, psb, dsp);
}

# Rebuild an AmbientTexture from JSON: restore scalars + rng + dc_blocker
# state, then reconstruct the naad components fresh.
#must_use
fn texture_from_json_str(json) {
    var p = AmbientTextureParams_from_json_str(json);
    # Deserialize must validate what the constructor validates. Before 2.5.1
    # this path relied on a downstream naad component rejecting a bad
    # sample_rate -- which bubble's build_naad cannot do, since it only
    # calls noise_new -- and it never re-checked the enum id at all, so a
    # hostile document could restore an out-of-range one that *_new rejects.
    var vsr = garjan_validate_sample_rate(AmbientTextureParams_sample_rate(p));
    if (garjan_is_err(vsr) == 1) { return vsr; }
    if (garjan_enum_invalid(AmbientTextureParams_texture_type(p), TEXTURE_TYPE_NIGHT) == 1) {
        return GARJAN_ERR_INVALID_PARAMETER;
    }
    var self = garjan_alloc(sizeof(AmbientTexture));
    if (garjan_is_err(self) == 1) { return self; }
    AmbientTexture_set_texture_type(self, AmbientTextureParams_texture_type(p));
    AmbientTexture_set_level(self, AmbientTextureParams_level(p));
    AmbientTexture_set_sample_rate(self, AmbientTextureParams_sample_rate(p));
    AmbientTexture_set_sample_position(self, AmbientTextureParams_sample_position(p));

    var rng = rng_new(0);
    if (garjan_is_err(rng) == 1) { return rng; }
    Rng_set_state(rng, AmbientTextureParams_rng_state(p));
    Rng_set_inc(rng, AmbientTextureParams_rng_inc(p));
    AmbientTexture_set_rng(self, rng);

    var dc = garjan_dcblocker_new(AmbientTextureParams_sample_rate(p));
    if (garjan_is_err(dc) == 1) { return dc; }
    DcBlocker_set_x_prev(dc, AmbientTextureParams_dcb_x_prev(p));
    DcBlocker_set_y_prev(dc, AmbientTextureParams_dcb_y_prev(p));
    DcBlocker_set_r(dc, AmbientTextureParams_dcb_r(p));
    AmbientTexture_set_dc_blocker(self, dc);

    var b = texture_build_naad(self);
    if (garjan_is_err(b) == 1) { return b; }

    # Restore the components' live state onto the freshly built ones. A
    # document written before 2.5.0 has no "dsp" member; garjan_dsp_node
    # returns 0 and the synth resumes without it, exactly as it used to.
    var dsp = garjan_dsp_node(json);
    if (dsp != 0) {
        garjan_state_biquad_load(AmbientTexture_low_filter(self), bayan_json_v_obj_get(dsp, "lf"));
        garjan_state_biquad_load(AmbientTexture_mid_filter(self), bayan_json_v_obj_get(dsp, "mf"));
        garjan_state_biquad_load(AmbientTexture_high_filter(self), bayan_json_v_obj_get(dsp, "hf"));
        garjan_state_lfo_load(AmbientTexture_mod_lfo(self), bayan_json_v_obj_get(dsp, "ml"));
        garjan_state_noise_load(AmbientTexture_low_noise(self), bayan_json_v_obj_get(dsp, "ln"));
        garjan_state_noise_load(AmbientTexture_mid_noise(self), bayan_json_v_obj_get(dsp, "mn"));
        garjan_state_noise_load(AmbientTexture_high_noise(self), bayan_json_v_obj_get(dsp, "hn"));
    }
    return self;
}

# --- bridge.cyr ---

# bridge.cyr -- science-crate bridges: convert physical simulation outputs to
# garjan synthesizer parameters. Pure functions over primitives (no deps on the
# science crates). Ports rust-old/src/bridge.rs. f32 -> f64. Option<RainIntensity>
# -> RAIN_INTENSITY_* const or BRIDGE_NO_RAIN (-1). All fns are bridge_-prefixed
# to avoid any collision with goonj's acoustics helpers. Requires: weather.cyr
# (RAIN_INTENSITY_*), aero.cyr (WHOOSH_*).

var BRIDGE_NO_RAIN = (0 - 1);   # Option<RainIntensity>::None
var BRIDGE_F32_MAX = 0x47EFFFFFE0000000;   # f32::MAX (~3.4e38) as f64: "no thunder" distance

# ---- Weather bridges (badal) ----

# Rain rate (mm/hr) -> RainIntensity, or BRIDGE_NO_RAIN if <= 0.
#must_use
fn bridge_rain_intensity_from_rate(rate_mm_hr) {
    if (f64_le(rate_mm_hr, 0) == 1) { return BRIDGE_NO_RAIN; }
    if (f64_lt(rate_mm_hr, f64_div(f64_from(25), f64_from(10))) == 1) { return RAIN_INTENSITY_LIGHT; }      # < 2.5
    if (f64_lt(rate_mm_hr, f64_div(f64_from(75), f64_from(10))) == 1) { return RAIN_INTENSITY_MODERATE; }   # < 7.5
    if (f64_lt(rate_mm_hr, f64_from(50)) == 1) { return RAIN_INTENSITY_HEAVY; }
    return RAIN_INTENSITY_TORRENTIAL;
}

# Snow-liquid ratio -> amplitude scale = 1 / max(ratio, 1).
#must_use
fn bridge_snow_amplitude_scale(snow_liquid_ratio) {
    return f64_div(F64_ONE, f64_max(snow_liquid_ratio, F64_ONE));
}

# Wind speed m/s -> raw value for Wind::new (just max with 0).
#must_use
fn bridge_wind_speed_raw(speed_ms) {
    return f64_max(speed_ms, 0);
}

# Wind speed m/s -> normalized 0..1 (20 m/s => 1.0).
#must_use
fn bridge_wind_speed_normalized(speed_ms) {
    return f64_clamp(f64_div(speed_ms, f64_from(20)), 0, F64_ONE);
}

# Beaufort number (0-12) -> normalized 0..1.
#must_use
fn bridge_wind_from_beaufort(beaufort) {
    return f64_clamp(f64_div(f64_from(beaufort), f64_from(12)), 0, F64_ONE);
}

# Thermal wind shear (m/s per km) -> gustiness 0..1.
#must_use
fn bridge_gustiness_from_shear(shear_ms_per_km) {
    return f64_clamp(f64_div(shear_ms_per_km, f64_from(20)), 0, F64_ONE);
}

# Atmospheric stability -> gustiness modifier (unstable +0.3, stable -0.2).
#must_use
fn bridge_gustiness_stability_modifier(unstable) {
    if (unstable == 1) { return f64_div(f64_from(3), f64_from(10)); }
    return f64_neg(f64_div(f64_from(2), f64_from(10)));
}

# Severe-weather threat level (0-5) -> (thunder_distance_m, wind_speed_ms,
# rain_intensity). Fills the three out-pointers; rain = BRIDGE_NO_RAIN for None.
fn bridge_weather_from_threat_level(level, out_dist, out_wind, out_rain) {
    if (level <= 1) {
        store64(out_dist, BRIDGE_F32_MAX);
        store64(out_wind, f64_from(5));
        store64(out_rain, BRIDGE_NO_RAIN);
    } elif (level == 2) {
        store64(out_dist, f64_from(3000));
        store64(out_wind, f64_from(8));
        store64(out_rain, RAIN_INTENSITY_MODERATE);
    } elif (level == 3) {
        store64(out_dist, f64_from(1500));
        store64(out_wind, f64_from(14));
        store64(out_rain, RAIN_INTENSITY_HEAVY);
    } elif (level == 4) {
        store64(out_dist, f64_from(500));
        store64(out_wind, f64_from(22));
        store64(out_rain, RAIN_INTENSITY_TORRENTIAL);
    } else {
        store64(out_dist, f64_from(100));
        store64(out_wind, f64_from(30));
        store64(out_rain, RAIN_INTENSITY_TORRENTIAL);
    }
    return 0;
}

# ---- Thunder bridges (goonj) ----

# Thunder distance from flash delay + temperature: t * (331.3 + 0.606*T_celsius).
#must_use
fn bridge_thunder_distance_from_flash(time_since_flash_s, temperature_celsius) {
    var c = f64_add(f64_div(f64_from(3313), f64_from(10)),
      f64_mul(f64_div(f64_from(606), f64_from(1000)), temperature_celsius));
    return f64_mul(time_since_flash_s, c);
}

# Distance-dependent LP cutoff for thunder rumble: clamp(5000/(1+dist*0.002), 60, 5000).
#must_use
fn bridge_thunder_distance_cutoff(distance_m) {
    var denom = f64_add(F64_ONE, f64_mul(distance_m, f64_div(f64_from(2), f64_from(1000))));
    return f64_clamp(f64_div(f64_from(5000), denom), f64_from(60), f64_from(5000));
}

# SPL drop with distance -> linear gain factor.
#must_use
fn bridge_gain_from_distance(distance_ref, distance) {
    if (f64_le(distance, distance_ref) == 1) { return F64_ONE; }
    return f64_div(distance_ref, distance);
}

# ---- Fire bridges (ushma) ----

# Flame temperature (K) -> fire intensity 0..1: clamp((T-500)/2500, 0, 1).
#must_use
fn bridge_fire_intensity_from_temperature(flame_temp_k) {
    return f64_clamp(f64_div(f64_sub(flame_temp_k, f64_from(500)), f64_from(2500)), 0, F64_ONE);
}

# Convective flux (W) -> intensity 0..1: clamp(W/50000, 0, 1).
#must_use
fn bridge_fire_intensity_from_convection(watts) {
    return f64_clamp(f64_div(watts, f64_from(50000)), 0, F64_ONE);
}

# Blended fire intensity: clamp(0.6*thermal + 0.4*convective, 0, 1).
#must_use
fn bridge_fire_intensity_blended(flame_temp_k, convection_watts) {
    var thermal = bridge_fire_intensity_from_temperature(flame_temp_k);
    var convective = bridge_fire_intensity_from_convection(convection_watts);
    var blend = f64_add(f64_mul(f64_div(f64_from(6), f64_from(10)), thermal),
      f64_mul(f64_div(f64_from(4), f64_from(10)), convective));
    return f64_clamp(blend, 0, F64_ONE);
}

# ---- Foliage bridges (vanaspati) ----

# Seasonal growth modifier -> foliage contact intensity (clamp 0..1).
#must_use
fn bridge_foliage_contact_from_growth(growth_modifier) {
    return f64_clamp(growth_modifier, 0, F64_ONE);
}

# Shannon diversity index -> foliage contact intensity: clamp(H/2, 0, 1).
#must_use
fn bridge_foliage_contact_from_diversity(shannon_h) {
    return f64_clamp(f64_div(shannon_h, f64_from(2)), 0, F64_ONE);
}

# True (1) if the season is bare (growth < 0.1) -> use BranchSnap over LeafRustle.
#must_use
fn bridge_is_bare_season(growth_modifier) {
    if (f64_lt(growth_modifier, f64_div(f64_from(1), f64_from(10))) == 1) { return 1; }
    return 0;
}

# ---- Whoosh bridges (pavan) ----

# Reynolds number -> WhooshType: turbulent (>500k) = Vehicle, else Projectile.
#must_use
fn bridge_whoosh_type_from_reynolds(reynolds) {
    if (f64_gt(reynolds, f64_from(500000)) == 1) { return WHOOSH_VEHICLE; }
    return WHOOSH_PROJECTILE;
}

# --- builder.cyr ---

# builder.cyr -- fluent builders for the multi-parameter synthesizers.
#
# Ports rust-old/src/builder.rs (PrecipitationBuilder, FootstepBuilder,
# FrictionBuilder). Fluent setters mutate self and return the pointer. build()
# calls the synth constructor and returns its pointer or a negative code.
# Builders are all-scalar/enum -> #derive(Serialize). Requires: precipitation,
# footstep, friction synths + contact (TERRAIN_*/MOVEMENT_*/FRICTION_*) +
# material (MATERIAL_*).

# ---- PrecipitationBuilder ----
#derive(accessors)
#derive(Serialize)
struct PrecipitationBuilder {
    sample_rate: f64;
    precip_type: i64;
    stone_size: i64;
    surface: i64;
}

# Defaults: Hail, Medium, Gravel.
#must_use
fn precipitation_builder_new(sample_rate) {
    var b = garjan_alloc(sizeof(PrecipitationBuilder));
    if (garjan_is_err(b) == 1) { return b; }
    PrecipitationBuilder_set_sample_rate(b, sample_rate);
    PrecipitationBuilder_set_precip_type(b, PRECIP_HAIL);
    PrecipitationBuilder_set_stone_size(b, STONE_MEDIUM);
    PrecipitationBuilder_set_surface(b, TERRAIN_GRAVEL);
    return b;
}

#must_use
fn precipitation_builder_precip_type(b, t) { PrecipitationBuilder_set_precip_type(b, t); return b; }
#must_use
fn precipitation_builder_stone_size(b, s) { PrecipitationBuilder_set_stone_size(b, s); return b; }
#must_use
fn precipitation_builder_surface(b, t) { PrecipitationBuilder_set_surface(b, t); return b; }

# Build the Precipitation synth (pointer or negative code).
#must_use
fn precipitation_builder_build(b) {
    return precipitation_new(
      PrecipitationBuilder_precip_type(b),
      PrecipitationBuilder_stone_size(b),
      PrecipitationBuilder_surface(b),
      PrecipitationBuilder_sample_rate(b));
}

# ---- FootstepBuilder ----
#derive(accessors)
#derive(Serialize)
struct FootstepBuilder {
    sample_rate: f64;
    terrain: i64;
    movement: i64;
}

# Defaults: Gravel, Walk.
#must_use
fn footstep_builder_new(sample_rate) {
    var b = garjan_alloc(sizeof(FootstepBuilder));
    if (garjan_is_err(b) == 1) { return b; }
    FootstepBuilder_set_sample_rate(b, sample_rate);
    FootstepBuilder_set_terrain(b, TERRAIN_GRAVEL);
    FootstepBuilder_set_movement(b, MOVEMENT_WALK);
    return b;
}

#must_use
fn footstep_builder_terrain(b, t) { FootstepBuilder_set_terrain(b, t); return b; }
#must_use
fn footstep_builder_movement(b, m) { FootstepBuilder_set_movement(b, m); return b; }

#must_use
fn footstep_builder_build(b) {
    return footstep_new(
      FootstepBuilder_terrain(b),
      FootstepBuilder_movement(b),
      FootstepBuilder_sample_rate(b));
}

# ---- FrictionBuilder ----
#derive(accessors)
#derive(Serialize)
struct FrictionBuilder {
    sample_rate: f64;
    friction_type: i64;
    surface: i64;
}

# Defaults: Scrape, Wood.
#must_use
fn friction_builder_new(sample_rate) {
    var b = garjan_alloc(sizeof(FrictionBuilder));
    if (garjan_is_err(b) == 1) { return b; }
    FrictionBuilder_set_sample_rate(b, sample_rate);
    FrictionBuilder_set_friction_type(b, FRICTION_SCRAPE);
    FrictionBuilder_set_surface(b, MATERIAL_WOOD);
    return b;
}

#must_use
fn friction_builder_friction_type(b, t) { FrictionBuilder_set_friction_type(b, t); return b; }
#must_use
fn friction_builder_surface(b, m) { FrictionBuilder_set_surface(b, m); return b; }

#must_use
fn friction_builder_build(b) {
    return friction_new(
      FrictionBuilder_friction_type(b),
      FrictionBuilder_surface(b),
      FrictionBuilder_sample_rate(b));
}
