# modal.cyr -- modal synthesis: a bank of damped complex resonators.
#
# Ports rust-old/src/modal.rs (ModeSpec, ModePattern, ModalBank [SoA],
# generate_modes, ExcitationType, Exciter). f32 -> f64. Result<Self> ->
# pointer / negative GARJAN_* code. Vec<f32> -> stdlib vec. enum-with-data
# ExcitationType -> EXCITATION_* int + a duration_samples field on Exciter.
# Requires: error.cyr (codes/is_finite, JSON helpers), dsp.cyr (garjan_validate_sample_rate,
# the "dsp" state emitters), rng.cyr (Rng), material.cyr (MaterialProperties, used by
# generate_modes).
# ModalBank/Exciter hold vec/pointer fields -> #derive(Serialize) can't express
# them. Their codecs are hand-rolled at the end of this file (ADR-0013). Inside a host
# synth's document their live state travels in its "dsp" member instead (ADR-0008).

# ---- ModePattern ----
var MODE_PATTERN_HARMONIC     = 0;   # f_k = f0*k (strings, tubes)
var MODE_PATTERN_BEAM         = 1;   # free-free beam (wood, marimba)
var MODE_PATTERN_PLATE        = 2;   # f_k = f0*k^1.7 (metal, glass, ceramic)
var MODE_PATTERN_STIFF_STRING = 3;   # f0*k*sqrt(1 + B*k^2)
var MODE_PATTERN_DAMPED       = 4;   # all near f0 with small random spread

# ---- ModeSpec (frequency Hz, amplitude linear, decay T60 s) ----
#derive(accessors)
#derive(Serialize)
struct ModeSpec {
    frequency: f64;
    amplitude: f64;
    decay: f64;
}

# Builds one ModeSpec: frequency in Hz, linear amplitude, decay as T60 in s. Values are
# stored as given. Returns it, or GARJAN_ERR_ALLOCATION.
#must_use
fn modal_modespec_new(frequency, amplitude, decay) {
    var s = garjan_alloc(sizeof(ModeSpec));
    if (garjan_is_err(s) == 1) { return s; }
    ModeSpec_set_frequency(s, frequency);
    ModeSpec_set_amplitude(s, amplitude);
    ModeSpec_set_decay(s, decay);
    return s;
}

# Free-free beam mode ratios (B_k/B_1)^2, k = 1..16. Values as num/1000.
#must_use
fn modal_beam_ratio(k) {
    if (k == 1)  { return F64_ONE; }
    if (k == 2)  { return f64_div(f64_from(2757),   f64_from(1000)); }
    if (k == 3)  { return f64_div(f64_from(5404),   f64_from(1000)); }
    if (k == 4)  { return f64_div(f64_from(8933),   f64_from(1000)); }
    if (k == 5)  { return f64_div(f64_from(13344),  f64_from(1000)); }
    if (k == 6)  { return f64_div(f64_from(18637),  f64_from(1000)); }
    if (k == 7)  { return f64_div(f64_from(24812),  f64_from(1000)); }
    if (k == 8)  { return f64_div(f64_from(31870),  f64_from(1000)); }
    if (k == 9)  { return f64_div(f64_from(39810),  f64_from(1000)); }
    if (k == 10) { return f64_div(f64_from(48632),  f64_from(1000)); }
    if (k == 11) { return f64_div(f64_from(58336),  f64_from(1000)); }
    if (k == 12) { return f64_div(f64_from(68922),  f64_from(1000)); }
    if (k == 13) { return f64_div(f64_from(80390),  f64_from(1000)); }
    if (k == 14) { return f64_div(f64_from(92741),  f64_from(1000)); }
    if (k == 15) { return f64_div(f64_from(105973), f64_from(1000)); }
    return f64_div(f64_from(120088), f64_from(1000));   # k == 16
}

# ---- ModalBank (SoA: 7 parallel vecs + sample_rate) ----
# frequency and decay are the inputs of each surviving mode, as given, which Rust's bank
# did not keep. The codec writes them instead of coeff_re/coeff_im, so a load rebuilds the
# coefficients through modal_bank_new, bit for bit (ADR-0013).
#derive(accessors)
struct ModalBank { state_re; state_im; coeff_re; coeff_im; amplitude; sample_rate; frequency; decay; }

# Build from a vec of ModeSpec pointers. Excludes modes < 20 Hz, >= Nyquist,
# or with decay <= 0. Returns a pointer, or a negative code on bad sample_rate.
#must_use
fn modal_bank_new(specs, sample_rate) {
    var e = garjan_validate_sample_rate(sample_rate);
    if (garjan_is_err(e) == 1) { return e; }
    var nyquist = f64_mul(sample_rate, F64_HALF);
    var decay_floor = f64_div(f64_from(1), f64_from(1000));       # 0.001
    var neg6908 = f64_neg(f64_div(f64_from(6908), f64_from(1000)));  # -6.908
    var radius_cap = f64_div(f64_from(9999), f64_from(10000));    # 0.9999

    var state_re = vec_new();
    var state_im = vec_new();
    var coeff_re = vec_new();
    var coeff_im = vec_new();
    var amplitude = vec_new();
    var frequency = vec_new();
    var decay = vec_new();
    if (state_re == 0 || state_im == 0 || coeff_re == 0 || coeff_im == 0 || amplitude == 0) {
        return GARJAN_ERR_ALLOCATION;
    }
    if (frequency == 0 || decay == 0) { return GARJAN_ERR_ALLOCATION; }

    var n = vec_len(specs);
    var i = 0;
    while (i < n) {
        var spec = vec_get(specs, i);
        var freq = ModeSpec_frequency(spec);
        var dec = ModeSpec_decay(spec);
        if (f64_ge(freq, f64_from(20)) == 1) {
            if (f64_lt(freq, nyquist) == 1) {
                if (f64_gt(dec, 0) == 1) {
                    var omega = f64_div(f64_mul(F64_TAU, freq), sample_rate);
                    var d = f64_max(dec, decay_floor);
                    var radius = f64_clamp(f64_exp(f64_div(neg6908, f64_mul(d, sample_rate))), 0, radius_cap);
                    vec_push(coeff_re, f64_mul(radius, f64_cos(omega)));
                    vec_push(coeff_im, f64_mul(radius, f64_sin(omega)));
                    vec_push(amplitude, ModeSpec_amplitude(spec));
                    vec_push(frequency, freq);
                    vec_push(decay, dec);
                    vec_push(state_re, 0);
                    vec_push(state_im, 0);
                }
            }
        }
        i = i + 1;
    }

    var self = garjan_alloc(sizeof(ModalBank));
    if (garjan_is_err(self) == 1) { return self; }
    ModalBank_set_state_re(self, state_re);
    ModalBank_set_state_im(self, state_im);
    ModalBank_set_coeff_re(self, coeff_re);
    ModalBank_set_coeff_im(self, coeff_im);
    ModalBank_set_amplitude(self, amplitude);
    ModalBank_set_sample_rate(self, sample_rate);
    ModalBank_set_frequency(self, frequency);
    ModalBank_set_decay(self, decay);
    return self;
}

# Returns the number of modes in the bank.
#inline
#must_use
fn modal_bank_mode_count(self) {
    return vec_len(ModalBank_amplitude(self));
}

# Process one excitation sample through all modes (SoA loop).
#must_use
fn modal_bank_process_sample(self, excitation) {
    var cre = ModalBank_coeff_re(self);
    var cim = ModalBank_coeff_im(self);
    var sre = ModalBank_state_re(self);
    var sim = ModalBank_state_im(self);
    var amp = ModalBank_amplitude(self);
    var n = vec_len(amp);
    var out = 0;
    var i = 0;
    while (i < n) {
        var cr = vec_get(cre, i);
        var ci = vec_get(cim, i);
        var xr = vec_get(sre, i);
        var xi = vec_get(sim, i);
        var new_re = f64_sub(f64_add(excitation, f64_mul(cr, xr)), f64_mul(ci, xi));
        var new_im = f64_add(f64_mul(ci, xr), f64_mul(cr, xi));
        vec_set(sre, i, new_re);
        vec_set(sim, i, new_im);
        out = f64_add(out, f64_mul(vec_get(amp, i), new_re));
        i = i + 1;
    }
    return out;
}

# Process a block: output[i] = process_sample(excitation[i]) for min(len) samples.
fn modal_bank_process_block(self, excitation, output) {
    var len = vec_len(excitation);
    var olen = vec_len(output);
    if (olen < len) { len = olen; }
    var i = 0;
    while (i < len) {
        vec_set(output, i, modal_bank_process_sample(self, vec_get(excitation, i)));
        i = i + 1;
    }
    return 0;
}

# Reset all mode states to zero.
fn modal_bank_reset(self) {
    var sre = ModalBank_state_re(self);
    var sim = ModalBank_state_im(self);
    var n = vec_len(sre);
    var i = 0;
    while (i < n) {
        vec_set(sre, i, 0);
        vec_set(sim, i, 0);
        i = i + 1;
    }
    return 0;
}

# ---- Mode generation ----
# Generates a vec of ModeSpec pointers for a material's properties + pattern.
#must_use
fn generate_modes(props, pattern, count, damping_factor) {
    if (garjan_enum_invalid(pattern, MODE_PATTERN_DAMPED) == 1) { return GARJAN_ERR_INVALID_PARAMETER; }
    var f0 = MaterialProperties_resonance(props);
    var brightness = MaterialProperties_brightness(props);
    var pdecay = MaterialProperties_decay(props);
    # rolloff_exp = 2.0 - 1.5 * brightness
    var rolloff_exp = f64_sub(f64_from(2), f64_mul(f64_div(f64_from(15), f64_from(10)), brightness));
    var rng = rng_new(garjan_f64_to_u64(f64_mul(f0, f64_from(1000))));
    if (garjan_is_err(rng) == 1) { return rng; }

    var half = F64_HALF;
    var c1_5056 = f64_div(f64_from(15056), f64_from(10000));
    var plate_exp = f64_div(f64_from(17), f64_from(10));       # 1.7
    var stiff_b = f64_div(f64_from(1), f64_from(1000));        # 0.001
    var damp_span = f64_div(f64_from(1), f64_from(10));        # 0.1
    var decay_floor = stiff_b;                                 # 0.001
    var freq_cap = f64_from(20000);

    var out = vec_new();
    if (out == 0) { return GARJAN_ERR_ALLOCATION; }
    var k = 1;
    while (k <= count) {
        var kf = f64_from(k);
        var freq = 0;
        if (pattern == MODE_PATTERN_HARMONIC) {
            freq = f64_mul(f0, kf);
        } elif (pattern == MODE_PATTERN_BEAM) {
            if (k <= 16) {
                freq = f64_mul(f0, modal_beam_ratio(k));
            } else {
                var kfp = f64_add(kf, half);
                freq = f64_div(f64_mul(f0, f64_mul(kfp, kfp)), f64_mul(c1_5056, c1_5056));
            }
        } elif (pattern == MODE_PATTERN_PLATE) {
            freq = f64_mul(f0, f64_pow(kf, plate_exp));
        } elif (pattern == MODE_PATTERN_STIFF_STRING) {
            var inner = f64_add(F64_ONE, f64_mul(stiff_b, f64_mul(kf, kf)));
            freq = f64_mul(f0, f64_mul(kf, f64_sqrt(inner)));
        } else {
            # Damped: f0 * (1 + range(-0.1, 0.1))
            freq = f64_mul(f0, f64_add(F64_ONE, rng_next_f32_range(rng, f64_neg(damp_span), damp_span)));
        }

        if (f64_gt(freq, freq_cap) == 1) {
            k = k + 1;
            continue;
        }

        var amplitude = f64_div(F64_ONE, f64_pow(kf, rolloff_exp));
        var freq_ratio = f64_div(freq, f0);
        var fm1 = f64_sub(freq_ratio, F64_ONE);
        var decay = f64_div(pdecay, f64_add(F64_ONE, f64_mul(damping_factor, f64_mul(fm1, fm1))));
        decay = f64_max(decay, decay_floor);
        var ga_spec1 = modal_modespec_new(freq, amplitude, decay);
        if (garjan_is_err(ga_spec1) == 1) { return ga_spec1; }
        vec_push(out, ga_spec1);
        k = k + 1;
    }
    return out;
}

# ---- ExcitationType (data-carrying variant duration lives on Exciter) ----
# Seed for every Exciter's internal Rng. Shared by exciter_new and
# exciter_reset so the two produce identical excitation sequences.
var EXCITER_RNG_SEED = 31337;

var EXCITATION_IMPULSE    = 0;
var EXCITATION_NOISE_BURST = 1;
var EXCITATION_HALF_SINE  = 2;

# ---- Exciter (drives a modal bank). rng is a live pointer; serde hand-rolled. ----
#derive(accessors)
struct Exciter { excitation_type; duration_samples; amplitude; position; active; rng; }

# Builds an idle Exciter of an EXCITATION_* type, with its length in samples; exciter_trigger
# starts it. Values are stored as given. Returns it, GARJAN_ERR_INVALID_PARAMETER for an
# out-of-range type or a negative duration (a usize in Rust), or GARJAN_ERR_ALLOCATION.
#must_use
fn exciter_new(excitation_type, duration_samples, amplitude) {
    if (garjan_enum_invalid(excitation_type, EXCITATION_HALF_SINE) == 1) { return GARJAN_ERR_INVALID_PARAMETER; }
    if (duration_samples < 0) { return GARJAN_ERR_INVALID_PARAMETER; }
    var self = garjan_alloc(sizeof(Exciter));
    if (garjan_is_err(self) == 1) { return self; }
    Exciter_set_excitation_type(self, excitation_type);
    Exciter_set_duration_samples(self, duration_samples);
    Exciter_set_amplitude(self, amplitude);
    Exciter_set_position(self, 0);
    Exciter_set_active(self, 0);
    var ga_rng2 = rng_new(EXCITER_RNG_SEED);
    if (garjan_is_err(ga_rng2) == 1) { return ga_rng2; }
    Exciter_set_rng(self, ga_rng2);
    return self;
}

# Reconfigure an existing Exciter in place and restart it: exactly equivalent
# to exciter_new(type, dur, amp) followed by exciter_trigger, minus the two
# allocations (Exciter + its Rng). The rng is re-seeded to EXCITER_RNG_SEED so
# the excitation sequence is bit-identical to a freshly built exciter's --
# callers in a per-block path use this instead of building a new one, because
# the arena never frees.
fn exciter_reset(self, excitation_type, duration_samples, amplitude) {
    if (garjan_enum_invalid(excitation_type, EXCITATION_HALF_SINE) == 1) { return GARJAN_ERR_INVALID_PARAMETER; }
    if (duration_samples < 0) { return GARJAN_ERR_INVALID_PARAMETER; }
    Exciter_set_excitation_type(self, excitation_type);
    Exciter_set_duration_samples(self, duration_samples);
    Exciter_set_amplitude(self, amplitude);
    rng_seed(Exciter_rng(self), EXCITER_RNG_SEED);
    Exciter_set_position(self, 0);
    Exciter_set_active(self, 1);
    return 0;
}

# Trigger: restart excitation from the beginning.
fn exciter_trigger(self) {
    Exciter_set_position(self, 0);
    Exciter_set_active(self, 1);
    return 0;
}

# Next excitation sample; 0.0 when spent.
#must_use
fn exciter_next_sample(self) {
    if (Exciter_active(self) == 0) { return 0; }
    var ty = Exciter_excitation_type(self);
    var pos = Exciter_position(self);
    var amp = Exciter_amplitude(self);
    var dur = Exciter_duration_samples(self);
    var sample = 0;
    if (ty == EXCITATION_IMPULSE) {
        if (pos == 0) {
            Exciter_set_active(self, 0);
            sample = amp;
        } else {
            sample = 0;
        }
    } elif (ty == EXCITATION_NOISE_BURST) {
        if (pos < dur) {
            sample = f64_mul(amp, rng_next_f32(Exciter_rng(self)));
        } else {
            Exciter_set_active(self, 0);
            sample = 0;
        }
    } else {
        # HalfSine
        if (pos < dur) {
            var t = f64_div(f64_from(pos), f64_from(dur));
            sample = f64_mul(amp, f64_sin(f64_mul(F64_PI, t)));
        } else {
            Exciter_set_active(self, 0);
            sample = 0;
        }
    }
    Exciter_set_position(self, pos + 1);
    return sample;
}

# Returns 1 while an excitation is in progress, otherwise 0.
#inline
#must_use
fn exciter_is_active(self) {
    return Exciter_active(self);
}

# ================================================================
# serde (ADR-0013). Rust derived Serialize and Deserialize on both types; the port
# hand-rolls them, because both hold vec and pointer fields.
# ================================================================

# The bank's one scalar, for the derived float writer. Internal to the codec.
#derive(accessors)
#derive(Serialize)
struct ModalBankParams {
    sample_rate: f64;
}

# Serializes a modal bank into str_builder `sb`:
#   {"sample_rate":..,"modes":[{"frequency":..,"amplitude":..,"decay":..},..],"dsp":{"mb":[..]}}
# One mode per surviving resonator, then its live state as raw bit patterns, re then im per
# mode, the form a host synth's "dsp" carries. Returns GARJAN_OK or a negative code.
#must_use
fn modal_bank_to_json(self, sb) {
    var p = garjan_alloc(sizeof(ModalBankParams));
    if (garjan_is_err(p) == 1) { return p; }
    ModalBankParams_set_sample_rate(p, ModalBank_sample_rate(self));
    var psb = str_builder_new();
    if (psb == 0) { return GARJAN_ERR_ALLOCATION; }
    var pe = ModalBankParams_to_json(p, psb);
    if (garjan_is_err(pe) == 1) { return pe; }
    # The live state first, so a refused allocation leaves `sb` untouched.
    var dsp = bayan_json_v_obj_new();
    var de = garjan_dsp_put(dsp, "mb", garjan_state_modal(self));
    if (garjan_is_err(de) == 1) { return de; }
    var body = bayan_json_v_build(dsp);
    if (body == 0) { return GARJAN_ERR_ALLOCATION; }

    var he = garjan_emit_array_head(sb, psb, "modes");
    if (garjan_is_err(he) == 1) { return he; }
    var ms[sizeof(ModeSpec)];    # one mode at a time: no allocation per mode
    var freq = ModalBank_frequency(self);
    var amp = ModalBank_amplitude(self);
    var dec = ModalBank_decay(self);
    var n = vec_len(amp);
    var i = 0;
    while (i < n) {
        if (i > 0) { str_builder_add_cstr(sb, ","); }
        ModeSpec_set_frequency(&ms, vec_get(freq, i));
        ModeSpec_set_amplitude(&ms, vec_get(amp, i));
        ModeSpec_set_decay(&ms, vec_get(dec, i));
        var me = ModeSpec_to_json(&ms, sb);
        if (garjan_is_err(me) == 1) { return me; }
        i = i + 1;
    }
    str_builder_add_cstr(sb, "],\"dsp\":");
    str_builder_add(sb, body);
    str_builder_add_cstr(sb, "}");
    return GARJAN_OK;
}

# Restores a modal bank from modal_bank_to_json's document. The modes go back through
# modal_bank_new, which re-derives every coefficient, so only a bank the constructor can
# build loads. Returns a pointer, or GARJAN_ERR_INVALID_PARAMETER for a document
# garjan_json_open refuses, a missing or non-finite member, an invalid sample rate, a mode
# the constructor would drop (below 20 Hz, at or above Nyquist, or a decay not above 0), or
# a "dsp" state that is missing, not 2 integers per mode, or not finite; or
# GARJAN_ERR_ALLOCATION.
#must_use
fn modal_bank_from_json_str(json) {
    var dsp = garjan_json_open(json);    # also refuses a "modes" that is not an array
    if (garjan_is_err(dsp) == 1) { return dsp; }
    var root = bayan_json_v_parse_buf(json, strlen(json));
    var w[24];    # sample_rate, then one mode's frequency, amplitude, decay
    var wp = &w;
    if (garjan_is_err(garjan_json_read_f64(root, "sample_rate", wp)) == 1) { return GARJAN_ERR_INVALID_PARAMETER; }
    var sr = load64(wp);
    var arr = garjan_json_get(root, "modes");
    if (arr == 0) { return GARJAN_ERR_INVALID_PARAMETER; }
    var n = bayan_json_v_arr_len(arr);

    var specs = vec_new();
    if (specs == 0) { return GARJAN_ERR_ALLOCATION; }
    var i = 0;
    while (i < n) {
        var node = bayan_json_v_arr_get(arr, i);
        var bad = 0;
        bad = bad + garjan_is_err(garjan_json_read_f64(node, "frequency", wp));
        bad = bad + garjan_is_err(garjan_json_read_f64(node, "amplitude", wp + 8));
        bad = bad + garjan_is_err(garjan_json_read_f64(node, "decay", wp + 16));
        if (bad > 0) { return GARJAN_ERR_INVALID_PARAMETER; }
        var spec = modal_modespec_new(load64(wp), load64(wp + 8), load64(wp + 16));
        if (garjan_is_err(spec) == 1) { return spec; }
        vec_push(specs, spec);
        i = i + 1;
    }
    var bank = modal_bank_new(specs, sr);
    if (garjan_is_err(bank) == 1) { return bank; }
    # The writer writes only the modes a constructor kept, so a dropped one was never written.
    if (modal_bank_mode_count(bank) != n) { return GARJAN_ERR_INVALID_PARAMETER; }

    # A missing "dsp" or "mb" gives 0, whose tag is not JTAG_ARR. An empty bank needs the tag
    # check: any non-array has length 0, as its state does.
    var mb = garjan_json_get(dsp, "mb");
    if (bayan_json_v_tag(mb) != JTAG_ARR) { return GARJAN_ERR_INVALID_PARAMETER; }
    if (bayan_json_v_arr_len(mb) != n * 2) { return GARJAN_ERR_INVALID_PARAMETER; }
    i = 0;
    while (i < n * 2) {
        if (bayan_json_v_tag(bayan_json_v_arr_get(mb, i)) != JTAG_INT) { return GARJAN_ERR_INVALID_PARAMETER; }
        i = i + 1;
    }
    var le = garjan_state_modal_load(bank, mb);    # refuses a non-finite value
    if (garjan_is_err(le) == 1) { return le; }
    return bank;
}

# The exciter's fields, flattened for the derived codec writer. Internal to the codec.
#derive(accessors)
#derive(Serialize)
struct ExciterParams {
    excitation_type: i64;
    duration_samples: i64;
    amplitude: f64;
    position: i64;
    active: i64;
    rng_state: i64;
    rng_inc: i64;
}

# Serializes an exciter into str_builder `sb` as one flat object: its type, duration,
# amplitude, position, active flag, and its Rng's state and increment. Returns GARJAN_OK or
# a negative code.
#must_use
fn exciter_to_json(self, sb) {
    var p = garjan_alloc(sizeof(ExciterParams));
    if (garjan_is_err(p) == 1) { return p; }
    ExciterParams_set_excitation_type(p, Exciter_excitation_type(self));
    ExciterParams_set_duration_samples(p, Exciter_duration_samples(self));
    ExciterParams_set_amplitude(p, Exciter_amplitude(self));
    ExciterParams_set_position(p, Exciter_position(self));
    ExciterParams_set_active(p, Exciter_active(self));
    var rng = Exciter_rng(self);
    ExciterParams_set_rng_state(p, Rng_state(rng));
    ExciterParams_set_rng_inc(p, Rng_inc(rng));
    return ExciterParams_to_json(p, sb);
}

# Restores an exciter from exciter_to_json's document. Returns a pointer, or
# GARJAN_ERR_INVALID_PARAMETER for a document garjan_json_open refuses (an "active" other
# than 0 or 1 among them), a missing member, an out-of-range type, a negative duration or
# position, an active exciter no sequence of calls reaches, or an Rng rng_restore refuses;
# or GARJAN_ERR_ALLOCATION.
#must_use
fn exciter_from_json_str(json) {
    var chk = garjan_json_open(json);
    if (garjan_is_err(chk) == 1) { return chk; }
    var root = bayan_json_v_parse_buf(json, strlen(json));
    var w[56];    # the seven members, in ExciterParams order
    var wp = &w;
    var bad = 0;
    bad = bad + garjan_is_err(garjan_json_read_int(root, "excitation_type", wp));
    bad = bad + garjan_is_err(garjan_json_read_int(root, "duration_samples", wp + 8));
    bad = bad + garjan_is_err(garjan_json_read_f64(root, "amplitude", wp + 16));
    bad = bad + garjan_is_err(garjan_json_read_int(root, "position", wp + 24));
    bad = bad + garjan_is_err(garjan_json_read_int(root, "active", wp + 32));
    bad = bad + garjan_is_err(garjan_json_read_int(root, "rng_state", wp + 40));
    bad = bad + garjan_is_err(garjan_json_read_int(root, "rng_inc", wp + 48));
    if (bad > 0) { return GARJAN_ERR_INVALID_PARAMETER; }
    var ty = load64(wp);
    var dur = load64(wp + 8);
    var pos = load64(wp + 24);
    var active = load64(wp + 32);
    if (pos < 0) { return GARJAN_ERR_INVALID_PARAMETER; }    # a usize in Rust
    # While active, the position never passes the duration, and an impulse is spent after
    # its first sample. An impulse active past 0 would report active forever.
    if (active == 1) {
        if (ty == EXCITATION_IMPULSE) {
            if (pos != 0) { return GARJAN_ERR_INVALID_PARAMETER; }
        } elif (pos > dur) {
            return GARJAN_ERR_INVALID_PARAMETER;
        }
    }
    var ex = exciter_new(ty, dur, load64(wp + 16));    # refuses the type and a negative duration
    if (garjan_is_err(ex) == 1) { return ex; }
    var rr = rng_restore(Exciter_rng(ex), load64(wp + 40), load64(wp + 48));
    if (garjan_is_err(rr) == 1) { return rr; }
    Exciter_set_position(ex, pos);
    Exciter_set_active(ex, active);
    return ex;
}
