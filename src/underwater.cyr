# underwater.cyr -- underwater ambience: low-freq rumble + filtered surface
# noise, an LFO amplitude wobble, and stochastic decaying-sinusoid bubbles.
#
# Ports rust-old/src/underwater.rs. The Cyrius port always uses the naad
# backend (no feature flags), so it ports the naad-backend code path and
# drops the fallback. f32 -> f64. Result<Self> -> pointer / negative GARJAN_*
# code. The Rust `#[serde(skip)]`-equivalent naad components (noise gens,
# biquads, LFO) are reconstructed on deserialize; depth/params + rng +
# dc_blocker state ARE serialized (via the flattened UnderwaterParams below).
# Requires: error, logging, dsp, rng foundations + the naad bundle
# (noise_new/noise_next_sample, filter_biquad_new/filter_biquad_process_sample,
# modulation_lfo_new/modulation_lfo_next_value).

# ---- UnderwaterDepth (enum) -> module-prefixed int constants, decl order. ----
var UNDERWATER_DEPTH_SHALLOW = 0;
var UNDERWATER_DEPTH_MEDIUM  = 1;
var UNDERWATER_DEPTH_DEEP    = 2;

# ---- UnderwaterParams: the serializable slice (Rust's non-skipped fields,
# with rng + dc_blocker FLATTENED so #derive(Serialize)'s single-pass
# from_json_str works). Synced to/from the live Underwater on (de)serialize.
# depth is an enum -> i64 tag. lp_cutoff is carried so build_naad can
# reconstruct the surface filter without re-deriving from depth. ----
#derive(accessors)
#derive(Serialize)
struct UnderwaterParams {
    depth: i64;
    sample_rate: f64;
    sample_position: i64;
    rumble_amp: f64;
    bubble_rate: f64;
    surface_noise_amp: f64;
    lp_cutoff: f64;
    intensity: f64;
    rng_state: i64;
    rng_inc: i64;
    dcb_x_prev: f64;
    dcb_y_prev: f64;
    dcb_r: f64;
}

# ---- Underwater: live synth = scalars + live rng/dc_blocker + naad ptrs. ----
#derive(accessors)
struct Underwater {
    depth;
    sample_rate;
    sample_position;
    rumble_amp;
    bubble_rate;
    surface_noise_amp;
    lp_cutoff;
    intensity;
    rng;
    dc_blocker;
    rumble_noise;
    rumble_filter;
    surface_noise;
    surface_filter;
    mod_lfo;
}

# Look up depth config (lp_cutoff, rumble_amp, bubble_rate, surface_noise_amp)
# and stash it on `self`. Mirrors UnderwaterDepth::config's match.
fn underwater_apply_config(self, depth) {
    var lp_cutoff = f64_from(3000);
    var rumble_amp = f64_div(f64_from(15), f64_from(100));
    var bubble_rate = f64_from(5);
    var surface_amp = f64_div(f64_from(2), f64_from(10));
    if (depth == UNDERWATER_DEPTH_MEDIUM) {
        lp_cutoff = f64_from(1200);
        rumble_amp = f64_div(f64_from(25), f64_from(100));
        bubble_rate = f64_from(2);
        surface_amp = f64_div(f64_from(8), f64_from(100));
    } elif (depth == UNDERWATER_DEPTH_DEEP) {
        lp_cutoff = f64_from(400);
        rumble_amp = f64_div(f64_from(35), f64_from(100));
        bubble_rate = f64_div(f64_from(5), f64_from(10));
        surface_amp = f64_div(f64_from(2), f64_from(100));
    }
    Underwater_set_lp_cutoff(self, lp_cutoff);
    Underwater_set_rumble_amp(self, rumble_amp);
    Underwater_set_bubble_rate(self, bubble_rate);
    Underwater_set_surface_noise_amp(self, surface_amp);
    return GARJAN_OK;
}

# Build/refresh the naad components from sample_rate + lp_cutoff. Shared by
# underwater_new and underwater_from_json_str. Returns GARJAN_OK or a negative
# code if a naad constructor rejects its params.
fn underwater_build_naad(self) {
    var sr = Underwater_sample_rate(self);
    # rumble filter: lowpass @ 200 Hz, Q 0.5.
    var rf = filter_biquad_new(FILTER_LOWPASS, sr, f64_from(200), F64_HALF);
    if (garjan_is_err(rf) == 1) { return garjan_map_naad_error(rf); }
    # surface filter: lowpass @ lp_cutoff, Q 0.7.
    var sf = filter_biquad_new(FILTER_LOWPASS, sr, Underwater_lp_cutoff(self), f64_div(f64_from(7), f64_from(10)));
    if (garjan_is_err(sf) == 1) { return garjan_map_naad_error(sf); }
    # mod LFO: sine @ 0.08 Hz.
    var lfo = modulation_lfo_new(MODULATION_LFO_SINE, f64_div(f64_from(8), f64_from(100)), sr);
    if (garjan_is_err(lfo) == 1) { return garjan_map_naad_error(lfo); }
    Underwater_set_rumble_filter(self, rf);
    Underwater_set_surface_filter(self, sf);
    Underwater_set_mod_lfo(self, lfo);
    Underwater_set_rumble_noise(self, noise_new(NOISE_BROWN, 6060));
    Underwater_set_surface_noise(self, noise_new(NOISE_PINK, 6061));
    return GARJAN_OK;
}

# Creates a new underwater ambience synthesizer. Returns a pointer or a
# negative code.
#must_use
fn underwater_new(depth, sample_rate) {
    var e = garjan_validate_sample_rate(sample_rate);
    if (garjan_is_err(e) == 1) { return e; }

    var self = alloc(sizeof(Underwater));
    Underwater_set_depth(self, depth);
    Underwater_set_sample_rate(self, sample_rate);
    Underwater_set_sample_position(self, 0);
    underwater_apply_config(self, depth);
    Underwater_set_intensity(self, F64_ONE);
    Underwater_set_rng(self, rng_new(6060));
    Underwater_set_dc_blocker(self, garjan_dcblocker_new(sample_rate));
    var b = underwater_build_naad(self);
    if (garjan_is_err(b) == 1) { return b; }
    return self;
}

# Sets intensity, clamped to [0, 1].
fn underwater_set_intensity(self, intensity) {
    Underwater_set_intensity(self, f64_clamp(intensity, 0, F64_ONE));
    return 0;
}

# Fills `output` (a vec of f64) with underwater audio (streaming). Ports
# process_block: continuous rumble+surface layers with an LFO wobble, then
# stochastic decaying-sinusoid bubbles, then DC-block, then advance position.
fn underwater_process_block(self, output) {
    var num = vec_len(output);
    var dc = Underwater_dc_blocker(self);
    var inten = Underwater_intensity(self);

    # intensity < 0.001: silent buffer, but still tick the dc_blocker and
    # advance the cursor (matches Rust's early return exactly).
    if (f64_lt(inten, f64_div(f64_from(1), f64_from(1000))) == 1) {
        var z = 0;
        while (z < num) {
            vec_set(output, z, 0);
            garjan_dcblocker_process(dc, 0);
            z = z + 1;
        }
        Underwater_set_sample_position(self, Underwater_sample_position(self) + num);
        return 0;
    }

    var rumble_noise = Underwater_rumble_noise(self);
    var rumble_filter = Underwater_rumble_filter(self);
    var surface_noise = Underwater_surface_noise(self);
    var surface_filter = Underwater_surface_filter(self);
    var mod_lfo = Underwater_mod_lfo(self);
    var rng = Underwater_rng(self);
    var sr = Underwater_sample_rate(self);

    var rumble_amp = Underwater_rumble_amp(self);
    var surface_amp = Underwater_surface_noise_amp(self);

    # Continuous layers: (rumble + surface) * intensity * modulator, where
    # modulator = 0.8 + 0.2 * lfo.next_value().
    var lfo_base = f64_div(f64_from(8), f64_from(10));
    var lfo_depth = f64_div(f64_from(2), f64_from(10));
    var i = 0;
    while (i < num) {
        var rumble = f64_mul(filter_biquad_process_sample(rumble_filter, noise_next_sample(rumble_noise)), rumble_amp);
        var surface = f64_mul(filter_biquad_process_sample(surface_filter, noise_next_sample(surface_noise)),
                              surface_amp);
        var modulator = f64_add(lfo_base, f64_mul(lfo_depth, modulation_lfo_next_value(mod_lfo)));
        vec_set(output, i, f64_mul(f64_mul(f64_add(rumble, surface), inten), modulator));
        i = i + 1;
    }

    # Stochastic bubble events.
    var block_size = f64_to(f64_mul(sr, f64_div(f64_from(1), f64_from(100))));   # sr*0.01
    if (block_size < 1) { block_size = 1; }
    var bubbles_per_block = f64_mul(f64_mul(Underwater_bubble_rate(self), inten), f64_div(f64_from(1), f64_from(100)));

    # decay = (sr * 0.02) as usize -- span cap, constant across bubbles.
    var decay = f64_to(f64_mul(sr, f64_div(f64_from(2), f64_from(100))));
    # envelope divisor 0.02 (t / 0.02).
    var decay_div = f64_div(f64_from(2), f64_from(100));

    var block_start = 0;
    while (block_start < num) {
        var block_end = block_start + block_size;
        if (block_end > num) { block_end = num; }
        var n_bubbles = rng_poisson(rng, bubbles_per_block);

        var b = 0;
        while (b < n_bubbles) {
            var width = f64_from(block_end - block_start);
            var offset = f64_to(rng_next_f32_range(rng, 0, width));
            var idx = block_start + offset;
            if (idx < num) {
                # Bubble: decaying sinusoid (same model as bubble.rs).
                var freq = rng_next_f32_range(rng, f64_from(200), f64_from(800));
                var omega = f64_div(f64_mul(F64_TAU, freq), sr);
                var amp = f64_mul(inten, rng_next_f32_range(rng, f64_div(f64_from(5), f64_from(100)),
                                                            f64_div(f64_from(15), f64_from(100))));

                # span = decay.min(num - idx).
                var span = decay;
                if (num - idx < span) { span = num - idx; }
                var j = 0;
                while (j < span) {
                    var t = f64_div(f64_from(j), sr);
                    var env = f64_exp(f64_div(f64_neg(t), decay_div));
                    var contrib = f64_mul(f64_mul(f64_sin(f64_mul(omega, f64_from(j))), env), amp);
                    vec_set(output, idx + j, f64_add(vec_get(output, idx + j), contrib));
                    j = j + 1;
                }
            }
            b = b + 1;
        }
        block_start = block_start + block_size;
    }

    # DC-block the whole buffer, then advance the sample cursor.
    i = 0;
    while (i < num) {
        vec_set(output, i, garjan_dcblocker_process(dc, vec_get(output, i)));
        i = i + 1;
    }
    Underwater_set_sample_position(self, Underwater_sample_position(self) + num);
    return 0;
}

# Synthesize `duration` seconds of underwater audio into a fresh vec. Returns
# the vec pointer, or a negative code on invalid duration.
#must_use
fn underwater_synthesize(self, duration) {
    var e = garjan_validate_duration(duration);
    if (garjan_is_err(e) == 1) { return e; }
    var num = f64_to(f64_mul(Underwater_sample_rate(self), duration));
    var output = vec_new();
    var i = 0;
    while (i < num) {
        vec_push(output, 0);
        i = i + 1;
    }
    underwater_process_block(self, output);
    return output;
}

# ---- serde: snapshot live state -> UnderwaterParams -> JSON, and back. ----
#must_use
fn underwater_to_json(self, sb) {
    var p = alloc(sizeof(UnderwaterParams));
    UnderwaterParams_set_depth(p, Underwater_depth(self));
    UnderwaterParams_set_sample_rate(p, Underwater_sample_rate(self));
    UnderwaterParams_set_sample_position(p, Underwater_sample_position(self));
    UnderwaterParams_set_rumble_amp(p, Underwater_rumble_amp(self));
    UnderwaterParams_set_bubble_rate(p, Underwater_bubble_rate(self));
    UnderwaterParams_set_surface_noise_amp(p, Underwater_surface_noise_amp(self));
    UnderwaterParams_set_lp_cutoff(p, Underwater_lp_cutoff(self));
    UnderwaterParams_set_intensity(p, Underwater_intensity(self));
    var rng = Underwater_rng(self);
    UnderwaterParams_set_rng_state(p, Rng_state(rng));
    UnderwaterParams_set_rng_inc(p, Rng_inc(rng));
    var dc = Underwater_dc_blocker(self);
    UnderwaterParams_set_dcb_x_prev(p, DcBlocker_x_prev(dc));
    UnderwaterParams_set_dcb_y_prev(p, DcBlocker_y_prev(dc));
    UnderwaterParams_set_dcb_r(p, DcBlocker_r(dc));
    return UnderwaterParams_to_json(p, sb);
}

# Rebuild an Underwater from JSON: restore scalars + rng + dc_blocker state,
# then reconstruct the naad components fresh (matches Rust skip+reconstruct).
#must_use
fn underwater_from_json_str(json) {
    var p = UnderwaterParams_from_json_str(json);
    var self = alloc(sizeof(Underwater));
    Underwater_set_depth(self, UnderwaterParams_depth(p));
    Underwater_set_sample_rate(self, UnderwaterParams_sample_rate(p));
    Underwater_set_sample_position(self, UnderwaterParams_sample_position(p));
    Underwater_set_rumble_amp(self, UnderwaterParams_rumble_amp(p));
    Underwater_set_bubble_rate(self, UnderwaterParams_bubble_rate(p));
    Underwater_set_surface_noise_amp(self, UnderwaterParams_surface_noise_amp(p));
    Underwater_set_lp_cutoff(self, UnderwaterParams_lp_cutoff(p));
    Underwater_set_intensity(self, UnderwaterParams_intensity(p));

    var rng = rng_new(0);
    Rng_set_state(rng, UnderwaterParams_rng_state(p));
    Rng_set_inc(rng, UnderwaterParams_rng_inc(p));
    Underwater_set_rng(self, rng);

    var dc = garjan_dcblocker_new(UnderwaterParams_sample_rate(p));
    DcBlocker_set_x_prev(dc, UnderwaterParams_dcb_x_prev(p));
    DcBlocker_set_y_prev(dc, UnderwaterParams_dcb_y_prev(p));
    DcBlocker_set_r(dc, UnderwaterParams_dcb_r(p));
    Underwater_set_dc_blocker(self, dc);

    underwater_build_naad(self);
    return self;
}
