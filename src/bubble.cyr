# bubble.cyr -- bubble synthesis: underwater, boiling, viscous, pouring.
#
# Ports rust-old/src/bubble.rs. Models bubbles as stochastic resonant events:
# each bubble is a short decaying sinusoid at a random frequency near the base
# (Minnaert resonance), with a small noise pop at the onset. The Cyrius port
# always uses the naad backend (no feature flags), so it ports the
# naad-backend generate_noise (noise_gen.next_sample()) and drops the rng
# fallback. f32 -> f64. Result<Self> -> pointer / negative GARJAN_* code.
# The naad noise generator is reconstructed on deserialize; rng + dc_blocker +
# sample_position + intensity ARE serialized (via the flattened BubbleParams).
# Requires: error, logging, dsp, rng, creature foundations + the naad bundle
# (noise_new / noise_next_sample).

# ---- BubbleParams: the serializable slice (Rust's fields except the
# reconstructable naad noise_gen), with rng + dc_blocker FLATTENED so
# #derive(Serialize)'s single-pass from_json_str works. Synced to/from the
# live Bubble on (de)serialize. bubble_type is an int tag (BUBBLE_* const). ----
#derive(accessors)
#derive(Serialize)
struct BubbleParams {
    bubble_type: i64;
    sample_rate: f64;
    sample_position: i64;
    base_freq: f64;
    event_rate: f64;
    freq_spread: f64;
    decay_time: f64;
    intensity: f64;
    rng_state: i64;
    rng_inc: i64;
    dcb_x_prev: f64;
    dcb_y_prev: f64;
    dcb_r: f64;
}

# ---- Bubble: live synth = scalars + live rng/dc_blocker + naad noise ptr. ----
#derive(accessors)
struct Bubble {
    bubble_type;
    sample_rate;
    sample_position;
    base_freq;
    event_rate;
    freq_spread;
    decay_time;
    intensity;
    rng;
    dc_blocker;
    noise_gen;
}

# Build/refresh the naad noise generator (white, seed 4040). Shared by
# bubble_new and bubble_from_json_str. Rust serialized the noise_gen's live
# state; this port rebuilds it -- see architecture note 001. noise_new does not
# fail, so this always returns
# GARJAN_OK; kept for structural parity with the other synths.
fn bubble_build_naad(self) {
    Bubble_set_noise_gen(self, noise_new(NOISE_WHITE, 4040));
    return GARJAN_OK;
}

# Creates a new bubble synthesizer. Returns a pointer or a negative code.
#must_use
fn bubble_new(bubble_type, sample_rate) {
    var e = garjan_validate_sample_rate(sample_rate);
    if (garjan_is_err(e) == 1) { return e; }
    var cfg = creature_bubble_config(bubble_type);
    if (garjan_is_err(cfg) == 1) { return cfg; }

    var self = garjan_alloc(sizeof(Bubble));
    if (garjan_is_err(self) == 1) { return self; }
    Bubble_set_bubble_type(self, bubble_type);
    Bubble_set_sample_rate(self, sample_rate);
    Bubble_set_sample_position(self, 0);
    Bubble_set_base_freq(self, BubbleConfig_base_freq(cfg));
    Bubble_set_event_rate(self, BubbleConfig_event_rate(cfg));
    Bubble_set_freq_spread(self, BubbleConfig_freq_spread(cfg));
    Bubble_set_decay_time(self, BubbleConfig_decay(cfg));
    Bubble_set_intensity(self, F64_ONE);
    var ga_rng1 = rng_new(4040);
    if (garjan_is_err(ga_rng1) == 1) { return ga_rng1; }
    Bubble_set_rng(self, ga_rng1);
    var ga_dcb2 = garjan_dcblocker_new(sample_rate);
    if (garjan_is_err(ga_dcb2) == 1) { return ga_dcb2; }
    Bubble_set_dc_blocker(self, ga_dcb2);
    var b = bubble_build_naad(self);
    if (garjan_is_err(b) == 1) { return b; }
    return self;
}

# Sets the bubble intensity (0.0 = none, 1.0 = vigorous), clamped to [0,1].
fn bubble_set_intensity(self, intensity) {
    Bubble_set_intensity(self, f64_clamp(intensity, 0, F64_ONE));
    return 0;
}

# Fills `output` (a vec of f64) with bubble audio (streaming). Ports
# process_block: stochastic Poisson-scheduled decaying-sinusoid events with an
# onset noise pop, then DC-block, then advance position.
fn bubble_process_block(self, output) {
    var num = vec_len(output);
    var inten = Bubble_intensity(self);
    var sr = Bubble_sample_rate(self);
    var rng = Bubble_rng(self);
    var dc = Bubble_dc_blocker(self);
    var noise_gen = Bubble_noise_gen(self);

    # Silent path: intensity < 0.001. Zero the buffer, still step the dc_blocker
    # once per sample (to match Rust state advancement), advance position.
    if (f64_lt(inten, f64_div(f64_from(1), f64_from(1000))) == 1) {
        var si = 0;
        while (si < num) {
            vec_set(output, si, 0);
            garjan_dcblocker_process(dc, 0);
            si = si + 1;
        }
        Bubble_set_sample_position(self, Bubble_sample_position(self) + num);
        return 0;
    }

    # Zero buffer.
    var z = 0;
    while (z < num) {
        vec_set(output, z, 0);
        z = z + 1;
    }

    # Schedule bubble events via Poisson process.
    var rate = f64_mul(Bubble_event_rate(self), inten);
    var block_size = f64_to(f64_mul(sr, f64_div(f64_from(1), f64_from(100))));   # sr*0.01
    if (block_size < 1) { block_size = 1; }
    var events_per_block = f64_mul(rate, f64_div(f64_from(1), f64_from(100)));   # rate*0.01

    var base_freq = Bubble_base_freq(self);
    var freq_spread = Bubble_freq_spread(self);
    var decay_time = Bubble_decay_time(self);
    # decay_samples = (decay_time * sr) as usize -- constant per block loop.
    var decay_samples = f64_to(f64_mul(decay_time, sr));
    # pop_len = (sr * 0.001) as usize.
    var pop_len = f64_to(f64_mul(sr, f64_div(f64_from(1), f64_from(1000))));
    # decay_time.max(0.001) for the envelope divisor.
    var decay_div = f64_max(decay_time, f64_div(f64_from(1), f64_from(1000)));

    var block_start = 0;
    while (block_start < num) {
        var block_end = block_start + block_size;
        if (block_end > num) { block_end = num; }
        var n_events = rng_poisson(rng, events_per_block);

        var ev = 0;
        while (ev < n_events) {
            var width = f64_from(block_end - block_start);
            var offset = f64_to(rng_next_f32_range(rng, 0, width));
            var idx = block_start + offset;
            if (idx < num) {
                # freq = base_freq + rand[-freq_spread, freq_spread], min 20 Hz.
                var freq = f64_add(base_freq, rng_next_f32_range(rng, f64_neg(freq_spread), freq_spread));
                freq = f64_max(freq, f64_from(20));
                var omega = f64_div(f64_mul(F64_TAU, freq), sr);
                var amp = f64_mul(inten, rng_next_f32_range(rng, f64_div(f64_from(1), f64_from(10)),
                    f64_div(f64_from(4), f64_from(10))));

                # span = decay_samples.min(num - idx).
                var span = decay_samples;
                if (num - idx < span) { span = num - idx; }
                var j = 0;
                while (j < span) {
                    var t = f64_div(f64_from(j), sr);
                    var env = f64_exp(f64_div(f64_neg(t), decay_div));
                    # Resonant tone.
                    var tone = f64_mul(f64_mul(f64_sin(f64_mul(omega, f64_from(j))), env), amp);
                    # Pop noise at onset (first pop_len samples).
                    var pop = 0;
                    if (j < pop_len) {
                        var pop_env = f64_sub(F64_ONE, f64_div(f64_from(j), f64_from(pop_len)));
                        pop = f64_mul(f64_mul(f64_mul(noise_next_sample(noise_gen), pop_env), amp),
                          f64_div(f64_from(3), f64_from(10)));
                    }
                    vec_set(output, idx + j, f64_add(vec_get(output, idx + j), f64_add(tone, pop)));
                    j = j + 1;
                }
            }
            ev = ev + 1;
        }
        block_start = block_start + block_size;
    }

    # DC blocking, then advance the sample cursor.
    var i = 0;
    while (i < num) {
        vec_set(output, i, garjan_dcblocker_process(dc, vec_get(output, i)));
        i = i + 1;
    }
    Bubble_set_sample_position(self, Bubble_sample_position(self) + num);
    return 0;
}

# Synthesize `duration` seconds of bubble audio into a fresh vec. Returns the
# vec pointer, or a negative code on invalid duration.
#must_use
fn bubble_synthesize(self, duration) {
    var e = garjan_validate_duration(duration);
    if (garjan_is_err(e) == 1) { return e; }
    var num = f64_to(f64_mul(Bubble_sample_rate(self), duration));
    var output = vec_new();
    var i = 0;
    while (i < num) {
        vec_push(output, 0);
        i = i + 1;
    }
    bubble_process_block(self, output);
    return output;
}

# ---- serde: snapshot live state -> BubbleParams -> JSON, and back. ----
#must_use
fn bubble_to_json(self, sb) {
    var p = garjan_alloc(sizeof(BubbleParams));
    if (garjan_is_err(p) == 1) { return p; }
    BubbleParams_set_bubble_type(p, Bubble_bubble_type(self));
    BubbleParams_set_sample_rate(p, Bubble_sample_rate(self));
    BubbleParams_set_sample_position(p, Bubble_sample_position(self));
    BubbleParams_set_base_freq(p, Bubble_base_freq(self));
    BubbleParams_set_event_rate(p, Bubble_event_rate(self));
    BubbleParams_set_freq_spread(p, Bubble_freq_spread(self));
    BubbleParams_set_decay_time(p, Bubble_decay_time(self));
    BubbleParams_set_intensity(p, Bubble_intensity(self));
    var rng = Bubble_rng(self);
    BubbleParams_set_rng_state(p, Rng_state(rng));
    BubbleParams_set_rng_inc(p, Rng_inc(rng));
    var dc = Bubble_dc_blocker(self);
    BubbleParams_set_dcb_x_prev(p, DcBlocker_x_prev(dc));
    BubbleParams_set_dcb_y_prev(p, DcBlocker_y_prev(dc));
    BubbleParams_set_dcb_r(p, DcBlocker_r(dc));
    return BubbleParams_to_json(p, sb);
}

# Rebuild a Bubble from JSON: restore scalars + rng + dc_blocker state, then
# reconstruct the naad noise generator fresh (rebuilt, not restored -- architecture note 001).
#must_use
fn bubble_from_json_str(json) {
    var p = BubbleParams_from_json_str(json);
    var self = garjan_alloc(sizeof(Bubble));
    if (garjan_is_err(self) == 1) { return self; }
    Bubble_set_bubble_type(self, BubbleParams_bubble_type(p));
    Bubble_set_sample_rate(self, BubbleParams_sample_rate(p));
    Bubble_set_sample_position(self, BubbleParams_sample_position(p));
    Bubble_set_base_freq(self, BubbleParams_base_freq(p));
    Bubble_set_event_rate(self, BubbleParams_event_rate(p));
    Bubble_set_freq_spread(self, BubbleParams_freq_spread(p));
    Bubble_set_decay_time(self, BubbleParams_decay_time(p));
    Bubble_set_intensity(self, BubbleParams_intensity(p));

    var rng = rng_new(0);
    if (garjan_is_err(rng) == 1) { return rng; }
    Rng_set_state(rng, BubbleParams_rng_state(p));
    Rng_set_inc(rng, BubbleParams_rng_inc(p));
    Bubble_set_rng(self, rng);

    var dc = garjan_dcblocker_new(BubbleParams_sample_rate(p));
    if (garjan_is_err(dc) == 1) { return dc; }
    DcBlocker_set_x_prev(dc, BubbleParams_dcb_x_prev(p));
    DcBlocker_set_y_prev(dc, BubbleParams_dcb_y_prev(p));
    DcBlocker_set_r(dc, BubbleParams_dcb_r(p));
    Bubble_set_dc_blocker(self, dc);

    var b = bubble_build_naad(self);
    if (garjan_is_err(b) == 1) { return b; }
    return self;
}
