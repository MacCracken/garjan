# dsp.cyr -- shared DSP utilities: DC blocker + parameter validators.
#
# Ports rust-old/src/dsp.rs (DcBlocker + validate_duration/validate_sample_rate
# + map_naad_error). f32 -> f64 throughout. The Rust validators emitted a
# tracing::warn! behind the `logging` feature; the Cyrius port wires that for
# real via src/logging.cyr (garjan_log_warn). Result<()> -> GARJAN_OK / negative
# code. Requires: error.cyr (codes + garjan_is_finite), logging.cyr (warn/error).

# ================================================================
# DcBlocker -- one-pole highpass removing DC offset:
#   y[n] = x[n] - x[n-1] + R * y[n-1],  R ~ 10 Hz cutoff at any sample rate.
# Fields are TYPED for #derive(Serialize) (untyped f64 would serialize as its
# raw bit pattern and fail to roundtrip).
# ================================================================
#derive(accessors)
#derive(Serialize)
struct DcBlocker {
    x_prev: f64;
    y_prev: f64;
    r: f64;
}

# R = clamp(1 - TAU*10/sample_rate, 0.9, 0.9999).
#must_use
fn garjan_dcblocker_new(sample_rate) {
    var raw = f64_sub(F64_ONE, f64_div(f64_mul(F64_TAU, f64_from(10)), sample_rate));
    var r = f64_clamp(raw, 0x3FECCCCCCCCCCCCD, 0x3FEFFF2E48E8A71E);   # 0.9 .. 0.9999
    var self = garjan_alloc(sizeof(DcBlocker));
    if (garjan_is_err(self) == 1) { return self; }
    DcBlocker_set_x_prev(self, 0);
    DcBlocker_set_y_prev(self, 0);
    DcBlocker_set_r(self, r);
    return self;
}

# Process one sample, removing DC offset.
fn garjan_dcblocker_process(self, x) {
    var y = f64_add(f64_sub(x, DcBlocker_x_prev(self)), f64_mul(DcBlocker_r(self), DcBlocker_y_prev(self)));
    DcBlocker_set_x_prev(self, x);
    DcBlocker_set_y_prev(self, y);
    return y;
}

# ================================================================
# Validators -- GARJAN_OK if positive and finite, else log + ERR code.
# Port validate_duration / validate_sample_rate (Result<()> -> code).
# ================================================================
# ================================================================
# Upper bounds on caller-supplied size parameters.
#
# rust-old/src/dsp.rs validated duration and sample_rate as positive-and-finite
# ONLY, so these caps are a deliberate divergence from the oracle -- ADR-0007.
# Without them a positive, finite duration of 1e8 s sizes a 4.4-trillion-sample
# buffer and the process dies allocating it.
#
# The binding constraint is the SAMPLE COUNT, not either input alone: 600 s is
# fine at 44.1 kHz (26.5 M samples) and ruinous at 768 kHz (461 M). Chosen so
# the worst case stays inside ALLOC_MAX (2 GiB) even with the ~3x overhead the
# vec doubling costs -- 44.1 M samples is ~353 MB ideal, ~1.05 GB as built.
# Generous for real use; tighten freely.
# ================================================================
var GARJAN_MIN_SAMPLE_RATE_HZ = 1;          # below this is not audio
var GARJAN_MAX_SAMPLE_RATE_HZ = 768000;     # highest standard hi-res rate
var GARJAN_MAX_DURATION_S     = 600;        # 10 minutes per synthesize call
var GARJAN_MAX_SAMPLES        = 44100000;   # 1000 s at 44.1 kHz

# Checks a synthesize duration: positive, finite and at most GARJAN_MAX_DURATION_S.
# Returns GARJAN_OK, or logs a warning and returns GARJAN_ERR_INVALID_PARAMETER.
#must_use
fn garjan_validate_duration(duration) {
    if (f64_le(duration, 0) == 1) {
        garjan_log_warn("garjan: invalid duration (must be positive and finite)");
        return GARJAN_ERR_INVALID_PARAMETER;
    }
    if (garjan_is_finite(duration) == 0) {
        garjan_log_warn("garjan: invalid duration (must be positive and finite)");
        return GARJAN_ERR_INVALID_PARAMETER;
    }
    if (f64_gt(duration, f64_from(GARJAN_MAX_DURATION_S)) == 1) {
        garjan_log_warn("garjan: duration exceeds GARJAN_MAX_DURATION_S");
        return GARJAN_ERR_INVALID_PARAMETER;
    }
    return GARJAN_OK;
}

# Checks a sample rate: finite and from GARJAN_MIN_SAMPLE_RATE_HZ to GARJAN_MAX_SAMPLE_RATE_HZ.
# Returns GARJAN_OK, or logs a warning and returns GARJAN_ERR_INVALID_PARAMETER.
#must_use
fn garjan_validate_sample_rate(sample_rate) {
    if (f64_le(sample_rate, 0) == 1) {
        garjan_log_warn("garjan: invalid sample_rate (must be positive and finite)");
        return GARJAN_ERR_INVALID_PARAMETER;
    }
    if (garjan_is_finite(sample_rate) == 0) {
        garjan_log_warn("garjan: invalid sample_rate (must be positive and finite)");
        return GARJAN_ERR_INVALID_PARAMETER;
    }
    if (f64_lt(sample_rate, f64_from(GARJAN_MIN_SAMPLE_RATE_HZ)) == 1) {
        garjan_log_warn("garjan: sample_rate below GARJAN_MIN_SAMPLE_RATE_HZ");
        return GARJAN_ERR_INVALID_PARAMETER;
    }
    if (f64_gt(sample_rate, f64_from(GARJAN_MAX_SAMPLE_RATE_HZ)) == 1) {
        garjan_log_warn("garjan: sample_rate above GARJAN_MAX_SAMPLE_RATE_HZ");
        return GARJAN_ERR_INVALID_PARAMETER;
    }
    return GARJAN_OK;
}

# Guard the buffer size a synthesize call is about to allocate. duration and
# sample_rate are each individually in range, but their PRODUCT is what gets
# allocated, so it needs its own bound.
#must_use
fn garjan_validate_sample_count(num) {
    if (num < 0) {
        garjan_log_warn("garjan: negative sample count");
        return GARJAN_ERR_INVALID_PARAMETER;
    }
    if (num > GARJAN_MAX_SAMPLES) {
        garjan_log_warn("garjan: sample count exceeds GARJAN_MAX_SAMPLES");
        return GARJAN_ERR_INVALID_PARAMETER;
    }
    return GARJAN_OK;
}

# Builds a vec of `n` zeros in one allocation. Returns it, GARJAN_ERR_INVALID_PARAMETER for
# n below 0 or above GARJAN_MAX_SAMPLES, or GARJAN_ERR_ALLOCATION.
# lib/vec.cyr has no capacity constructor, and growing by pushes keeps every outgrown
# buffer in an arena that never frees: about three times the audio itself. This writes
# vec's [data][len][cap] header directly, as naad_vec_zeros does; tests/dsp.tcyr pins it.
#must_use
fn garjan_vec_zeros(n) {
    # Every caller asks for at most GARJAN_MAX_SAMPLES; past 2^61 the byte size would wrap.
    if (n < 0 || n > GARJAN_MAX_SAMPLES) { return GARJAN_ERR_INVALID_PARAMETER; }
    var v = vec_new();
    if (v == 0) { return GARJAN_ERR_ALLOCATION; }
    if (n > vec_cap(v)) {
        var grown = garjan_alloc(n * 8);
        if (garjan_is_err(grown) == 1) { return grown; }
        store64(v, grown);
        store64(v + 16, n);
    }
    var data = load64(v);
    var i = 0;
    while (i < n) {
        store64(data + i * 8, 0);
        i = i + 1;
    }
    store64(v + 8, n);
    return v;
}

# Checks a synthesize call and builds its zeroed output buffer: `duration` must pass
# garjan_validate_duration, and duration x sample_rate garjan_validate_sample_count.
# Returns the buffer, or the first failing check's code. Every *_synthesize starts here,
# so a new guard lands in one place, not in a 21-site rollout.
#must_use
fn garjan_synth_buffer(sample_rate, duration) {
    var e = garjan_validate_duration(duration);
    if (garjan_is_err(e) == 1) { return e; }
    var num = f64_to(f64_mul(sample_rate, duration));
    var c = garjan_validate_sample_count(num);
    if (garjan_is_err(c) == 1) { return c; }
    return garjan_vec_zeros(num);
}

# naad's noise_new, checked. naad 2.3.3's cannot fail: it faults on a refused allocation
# (dependency-watch.md). Once naad returns that failure, garjan reports it here instead of
# storing it as a component pointer (ADR-0005). Returns the generator or GARJAN_ERR_ALLOCATION.
#must_use
fn garjan_noise_new(noise_type, seed) {
    var ng = noise_new(noise_type, seed);
    if (ng == 0 || garjan_is_err(ng) == 1) { return GARJAN_ERR_ALLOCATION; }
    return ng;
}

# ================================================================
# map_naad_error -- log a naad backend init failure and map it to a garjan
# error code. Ports dsp::map_naad_error. Call after a naad constructor:
#   var f = filter_biquad_new(...);
#   if (garjan_is_err(f) == 1) { return garjan_map_naad_error(f); }
# ================================================================
#must_use
fn garjan_map_naad_error(code) {
    if (garjan_is_err(code) == 1) {
        garjan_log_error("garjan: naad backend component init failed");
        return GARJAN_ERR_SYNTHESIS_FAILED;
    }
    return GARJAN_OK;
}

# ================================================================
# naad component state transfer (2.5.0).
#
# `*_build_naad` rebuilds naad's components from the stored scalars, which
# loses their LIVE state -- biquad delay memory, SVF integrators, LFO phase,
# noise-generator position. Rust derived Serialize over those fields, so a Rust
# save/restore resumed seamlessly; the port did not. See architecture note 001.
#
# Two implementation choices worth knowing before editing:
#
# 1. State is stored as raw i64 BIT PATTERNS via bayan_json_v_int, not as JSON
#    floats. In Cyrius an f64 *is* an i64 bit pattern, so this is exact by
#    construction -- no decimal formatting to lose. These values are opaque
#    machine state, never read by a human.
#
# 2. bayan's object API is ASYMMETRIC, deliberately (there is a banner in
#    lib/bayan.cyr): `bayan_json_v_obj_set` takes its key as a **Str**, while
#    `garjan_json_get` takes a **cstring**. Passing a cstring to obj_set
#    builds a tree that SEGFAULTS when serialized. Use str_from() on set.
# ================================================================

# ---- BiquadFilter: z1/z2 delay memory (coefficients are re-derived) ----
#must_use
fn garjan_state_biquad(f) {
    var a = bayan_json_v_arr_new();
    if (a == 0) { return 0; }
    var bad = 0;
    bad = bad + garjan_arr_push_int(a, BiquadFilter_z1(f));
    bad = bad + garjan_arr_push_int(a, BiquadFilter_z2(f));
    if (bad > 0) { return 0; }    # a refused node: hand bayan no null
    return a;
}

# Restores a biquad's delay memory from garjan_state_biquad's array. A missing or short
# node leaves the filter as built, which is how a pre-2.5.0 document loads. Returns 0,
# or GARJAN_ERR_INVALID_PARAMETER for a non-finite value.
fn garjan_state_biquad_load(f, n) {
    if (n == 0) { return 0; }
    if (bayan_json_v_arr_len(n) < 2) { return 0; }
    var z1 = bayan_json_v_int(bayan_json_v_arr_get(n, 0));
    var z2 = bayan_json_v_int(bayan_json_v_arr_get(n, 1));
    if (garjan_is_finite(z1) == 0 || garjan_is_finite(z2) == 0) { return GARJAN_ERR_INVALID_PARAMETER; }
    BiquadFilter_set_z1(f, z1);
    BiquadFilter_set_z2(f, z2);
    return 0;
}

# ---- StateVariableFilter: the two integrator states ----
#must_use
fn garjan_state_svf(f) {
    var a = bayan_json_v_arr_new();
    if (a == 0) { return 0; }
    var bad = 0;
    bad = bad + garjan_arr_push_int(a, StateVariableFilter_ic1eq(f));
    bad = bad + garjan_arr_push_int(a, StateVariableFilter_ic2eq(f));
    if (bad > 0) { return 0; }    # a refused node: hand bayan no null
    return a;
}

# Restores an SVF's integrator state from garjan_state_svf's array. A missing or short
# node leaves the filter as built. Returns 0, or GARJAN_ERR_INVALID_PARAMETER for a
# non-finite value.
fn garjan_state_svf_load(f, n) {
    if (n == 0) { return 0; }
    if (bayan_json_v_arr_len(n) < 2) { return 0; }
    var c1 = bayan_json_v_int(bayan_json_v_arr_get(n, 0));
    var c2 = bayan_json_v_int(bayan_json_v_arr_get(n, 1));
    if (garjan_is_finite(c1) == 0 || garjan_is_finite(c2) == 0) { return GARJAN_ERR_INVALID_PARAMETER; }
    StateVariableFilter_set_ic1eq(f, c1);
    StateVariableFilter_set_ic2eq(f, c2);
    return 0;
}

# ---- Lfo: phase, sample-and-hold value, and its own rng state ----
#must_use
fn garjan_state_lfo(l) {
    var a = bayan_json_v_arr_new();
    if (a == 0) { return 0; }
    var bad = 0;
    bad = bad + garjan_arr_push_int(a, Lfo_phase(l));
    bad = bad + garjan_arr_push_int(a, Lfo_sh_value(l));
    bad = bad + garjan_arr_push_int(a, load64(Lfo_rng(l)));
    if (bad > 0) { return 0; }    # a refused node: hand bayan no null
    return a;
}

# Restores an LFO's phase, sample-and-hold value and rng from garjan_state_lfo's array.
# A missing or short node leaves it as built. Returns 0, or GARJAN_ERR_INVALID_PARAMETER
# for a non-finite value or a zero generator state.
fn garjan_state_lfo_load(l, n) {
    if (n == 0) { return 0; }
    if (bayan_json_v_arr_len(n) < 3) { return 0; }
    var phase = bayan_json_v_int(bayan_json_v_arr_get(n, 0));
    var held = bayan_json_v_int(bayan_json_v_arr_get(n, 1));
    var state = bayan_json_v_int(bayan_json_v_arr_get(n, 2));
    if (garjan_is_finite(phase) == 0 || garjan_is_finite(held) == 0) { return GARJAN_ERR_INVALID_PARAMETER; }
    if (state == 0) { return GARJAN_ERR_INVALID_PARAMETER; }    # xorshift's fixed point
    Lfo_set_phase(l, phase);
    Lfo_set_sh_value(l, held);
    store64(Lfo_rng(l), state);
    return 0;
}

# ---- NoiseGenerator ----
# The xorshift32 state lives BEHIND the `rng` pointer, so it is load64/store64
# rather than an accessor. Which of the remaining fields matter depends on the
# generator's type -- white uses only the rng, brown adds brown_prev, pink adds
# the counter, running sum and all 16 octave values -- so the 16 octaves are
# emitted only for pink and the loader reads however many are present.
#must_use
fn garjan_state_noise(ng) {
    var a = bayan_json_v_arr_new();
    if (a == 0) { return 0; }
    var bad = 0;
    bad = bad + garjan_arr_push_int(a, load64(NoiseGenerator_rng(ng)));
    bad = bad + garjan_arr_push_int(a, NoiseGenerator_brown_prev(ng));
    bad = bad + garjan_arr_push_int(a, NoiseGenerator_pink_counter(ng));
    bad = bad + garjan_arr_push_int(a, NoiseGenerator_pink_running_sum(ng));
    if (NoiseGenerator_noise_type(ng) == NOISE_PINK) {
        var oc = NoiseGenerator_pink_octaves(ng);
        var i = 0;
        while (i < vec_len(oc)) {
            bad = bad + garjan_arr_push_int(a, vec_get(oc, i));
            i = i + 1;
        }
    }
    if (bad > 0) { return 0; }    # a refused node: hand bayan no null
    return a;
}

# Restores a noise generator from garjan_state_noise's array: rng, brown and pink state,
# then the pink octaves. A missing or short node leaves it as built, and octaves past
# the generator's own are ignored. Returns 0, or GARJAN_ERR_INVALID_PARAMETER for a
# non-finite value or a zero generator state.
fn garjan_state_noise_load(ng, n) {
    if (n == 0) { return 0; }
    var len = bayan_json_v_arr_len(n);
    if (len < 4) { return 0; }
    var i = 0;
    while (i < len) {
        if (i != 0 && i != 2 && garjan_is_finite(bayan_json_v_int(bayan_json_v_arr_get(n, i))) == 0) {
            return GARJAN_ERR_INVALID_PARAMETER;
        }
        i = i + 1;
    }
    if (bayan_json_v_int(bayan_json_v_arr_get(n, 0)) == 0) { return GARJAN_ERR_INVALID_PARAMETER; }
    store64(NoiseGenerator_rng(ng), bayan_json_v_int(bayan_json_v_arr_get(n, 0)));
    NoiseGenerator_set_brown_prev(ng, bayan_json_v_int(bayan_json_v_arr_get(n, 1)));
    NoiseGenerator_set_pink_counter(ng, bayan_json_v_int(bayan_json_v_arr_get(n, 2)));
    NoiseGenerator_set_pink_running_sum(ng, bayan_json_v_int(bayan_json_v_arr_get(n, 3)));
    var oc = NoiseGenerator_pink_octaves(ng);
    i = 0;
    while (i + 4 < len) {
        if (i < vec_len(oc)) {
            vec_set(oc, i, bayan_json_v_int(bayan_json_v_arr_get(n, i + 4)));
        }
        i = i + 1;
    }
    return 0;
}

# Appends integer `x` to JSON array `a` as a new node. Returns 0, or 1 when the node could
# not be allocated, so callers can count failures instead of handing bayan a null.
fn garjan_arr_push_int(a, x) {
    var node = bayan_json_v_int_new(x);
    if (node == 0) { return 1; }
    bayan_json_v_arr_push(a, node);
    return 0;
}

# Sets member `key` (a literal) of the "dsp" object to `node`. Returns GARJAN_OK, or
# GARJAN_ERR_ALLOCATION when the object, the node or the key could not be allocated:
# bayan's builder faults on a null, so none is ever stored (ADR-0005).
fn garjan_dsp_put(dsp, key, node) {
    if (dsp == 0 || node == 0) { return GARJAN_ERR_ALLOCATION; }
    var k = str_from(key);
    if (k == 0) { return GARJAN_ERR_ALLOCATION; }
    bayan_json_v_obj_set(dsp, k, node);
    return GARJAN_OK;
}

# ---- splice ----
# Emit a #derive(Serialize) params object with a "dsp" member added before its
# closing brace. The derive-generated parser IGNORES keys it does not know
# (verified), so `*Params_from_json_str` still reads the scalars out of the
# combined document and the value-tree parser reads "dsp" from the same string.
fn garjan_emit_with_dsp(sb, params_sb, dsp) {
    var s = str_builder_build(params_sb);
    if (s == 0) { return GARJAN_ERR_ALLOCATION; }
    if (str_len(s) < 2) { return GARJAN_ERR_INVALID_PARAMETER; }    # not an object to extend
    var head = str_from_buf(str_data(s), str_len(s) - 1);           # drop the '}'
    if (head == 0) { return GARJAN_ERR_ALLOCATION; }
    var body = bayan_json_v_build(dsp);
    if (body == 0) { return GARJAN_ERR_ALLOCATION; }
    str_builder_add(sb, head);
    str_builder_add_cstr(sb, ",\"dsp\":");
    str_builder_add(sb, body);
    str_builder_add_cstr(sb, "}");
    return 0;
}

# ---- ModalBank: the per-resonator state pair, interleaved re/im ----
# Length varies with how many modes survived construction (< 20 Hz, >= Nyquist
# and non-positive decay are excluded), so the loader writes only as many as the
# rebuilt bank actually has. `mb` may legitimately be 0 -- footstep and rolling
# leave it unset for non-resonant materials.
#must_use
fn garjan_state_modal(mb) {
    var a = bayan_json_v_arr_new();
    if (a == 0) { return 0; }
    var bad = 0;
    if (mb == 0) { return a; }
    var re = ModalBank_state_re(mb);
    var im = ModalBank_state_im(mb);
    var i = 0;
    while (i < vec_len(re)) {
        bad = bad + garjan_arr_push_int(a, vec_get(re, i));
        bad = bad + garjan_arr_push_int(a, vec_get(im, i));
        i = i + 1;
    }
    if (bad > 0) { return 0; }    # a refused node: hand bayan no null
    return a;
}

# Restores a modal bank's re/im pairs from garjan_state_modal's array. Pairs past the
# bank's modes are ignored, and a null bank or missing node is a no-op. Returns 0, or
# GARJAN_ERR_INVALID_PARAMETER for a non-finite value.
fn garjan_state_modal_load(mb, n) {
    if (mb == 0) { return 0; }
    if (n == 0) { return 0; }
    var re = ModalBank_state_re(mb);
    var im = ModalBank_state_im(mb);
    var cnt = bayan_json_v_arr_len(n) / 2;
    var i = 0;
    while (i < cnt * 2) {
        if (garjan_is_finite(bayan_json_v_int(bayan_json_v_arr_get(n, i))) == 0) {
            return GARJAN_ERR_INVALID_PARAMETER;
        }
        i = i + 1;
    }
    i = 0;
    while (i < cnt) {
        if (i < vec_len(re)) {
            vec_set(re, i, bayan_json_v_int(bayan_json_v_arr_get(n, i * 2)));
            vec_set(im, i, bayan_json_v_int(bayan_json_v_arr_get(n, i * 2 + 1)));
        }
        i = i + 1;
    }
    return 0;
}

# ---- Exciter: playback position, active flag, and its Rng (a garjan Rng
# struct, not a bare xorshift word like the naad components use) ----
#must_use
fn garjan_state_exciter(ex) {
    var a = bayan_json_v_arr_new();
    if (a == 0) { return 0; }
    var bad = 0;
    if (ex == 0) { return a; }
    bad = bad + garjan_arr_push_int(a, Exciter_position(ex));
    bad = bad + garjan_arr_push_int(a, Exciter_active(ex));
    var r = Exciter_rng(ex);
    bad = bad + garjan_arr_push_int(a, Rng_state(r));
    bad = bad + garjan_arr_push_int(a, Rng_inc(r));
    if (bad > 0) { return 0; }    # a refused node: hand bayan no null
    return a;
}

# Restores an exciter's position, active flag and rng from garjan_state_exciter's array.
# A null exciter or a missing or short node is a no-op. Returns 0, or
# GARJAN_ERR_INVALID_PARAMETER for a negative position, a non-0/1 flag or an even rng increment.
fn garjan_state_exciter_load(ex, n) {
    if (ex == 0) { return 0; }
    if (n == 0) { return 0; }
    if (bayan_json_v_arr_len(n) < 4) { return 0; }
    var pos = bayan_json_v_int(bayan_json_v_arr_get(n, 0));
    var active = bayan_json_v_int(bayan_json_v_arr_get(n, 1));
    if (pos < 0) { return GARJAN_ERR_INVALID_PARAMETER; }                       # a usize in Rust
    if (active != 0 && active != 1) { return GARJAN_ERR_INVALID_PARAMETER; }    # a bool in Rust
    var rr = rng_restore(Exciter_rng(ex), bayan_json_v_int(bayan_json_v_arr_get(n, 2)),
      bayan_json_v_int(bayan_json_v_arr_get(n, 3)));
    if (garjan_is_err(rr) == 1) { return rr; }
    Exciter_set_position(ex, pos);
    Exciter_set_active(ex, active);
    return 0;
}
